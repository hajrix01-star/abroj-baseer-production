<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="baseer_pos_print_bridge.ActionpadKitchenSend"
       t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('actionpad')]" position="inside">
            <button t-if="pos.config.baseer_direct_print_enabled and this.currentOrder and (!this.currentOrder.isEmpty() or this.currentOrder.uiState.baseerPreparationAction) and !this.currentOrder.uiState.isReprinting"
                    class="baseer-send-to-kitchen h-100 button btn btn-lg d-flex align-items-center flex-fill position-relative px-3 highlight btn-primary justify-content-between"
                    t-on-click="() => doBaseerSubmitOrder.call()"
                    t-att-aria-label="this.baseerKitchenSendLabel"
                    t-att-title="this.baseerKitchenSendLabel"
                    t-att-disabled="doBaseerSubmitOrder.status === 'loading'">
                <div t-if="!(this.baseerPreparationCategoryCount.length > 2)"
                     class="text-truncate text-start"><t t-esc="this.baseerKitchenSendLabel"/></div>
                <div t-attf-class="{{ !(this.baseerPreparationCategoryCount.length > 2) ? 'd-flex flex-column align-items-end gap-1' : 'row row-cols-2 g-1 gx-2' }} {{ this.baseerPreparationCategoryOverflow ? 'mt-n3' : ''}}">
                    <t t-foreach="this.baseerPreparationCategoryCount" t-as="categoryCountLine" t-key="categoryCountLine_index">
                        <div class="d-flex align-items-center justify-content-between small"
                             t-att-class="{ 'gap-2' : !(this.baseerPreparationCategoryCount.length > 2) }">
                            <div class="flex-grow-1"/>
                            <label class="product-category-label px-2"><t t-esc="categoryCountLine.name"/></label>
                            <label class="rounded px-2 py-0" style="background-color:rgba(0, 0, 0, 0.3);"><t t-esc="this.env.utils.formatProductQty(categoryCountLine.count, false)"/></label>
                        </div>
                    </t>
                    <t t-if="this.baseerPreparationCategoryOverflow">
                        <div class="position-absolute bottom-0 start-50 translate-middle-x">...</div>
                    </t>
                </div>
            </button>
        </xpath>
    </t>
</templates>
