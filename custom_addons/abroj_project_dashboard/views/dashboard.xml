<odoo>
    <record id="action_dashboard" model="ir.actions.client"><field name="name">أبرج داشبورد</field><field name="tag">abroj_project_dashboard</field></record>
    <menuitem id="menu_dashboard" name="أبرج داشبورد" parent="project.menu_main_pm" action="action_dashboard" sequence="1" groups="project.group_project_user"/>
    <record id="project_form_dashboard" model="ir.ui.view">
        <field name="name">project.form.abroj.dashboard</field><field name="model">project.project</field><field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="المراحل"><field name="task_ids" readonly="1"><list><field name="name"/><field name="state"/><field name="x_abroj_progress"/></list></field></page><page string="التقارير اليومية"><field name="abroj_daily_line_ids" readonly="1"><list><field name="report_id"/><field name="task_id"/><field name="progress_from"/><field name="progress_to"/><field name="notes"/></list></field></page><page string="المكتبة"><field name="abroj_gallery_widget" widget="abroj_gallery" nolabel="1"/></page><page string="لوحة أبرج"><group><field name="abroj_type"/><field name="abroj_currency_id" invisible="1"/><field name="abroj_progress"/><field name="abroj_budget"/><field name="abroj_actual"/><field name="abroj_over"/><field name="abroj_contract_value"/><field name="abroj_use_manual_progress"/><field name="abroj_manual_progress" invisible="not abroj_use_manual_progress"/><field name="abroj_closed_date"/></group><field name="abroj_budget_line_ids"><list editable="bottom"><field name="name"/><field name="currency_id" column_invisible="True"/><field name="budget"/><field name="manual_actual"/><field name="actual"/></list></field></page></xpath></field>
    </record>
    <record id="contracting_project_form_gallery" model="ir.ui.view">
        <field name="name">project.form.abroj.contracting.gallery</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="abroj_contracting.project_form"/>
        <field name="arch" type="xml"><xpath expr="//group[field[@name='profit']]" position="inside"><field name="abroj_currency_id" invisible="1"/><field name="abroj_progress"/><field name="abroj_budget"/><field name="abroj_actual"/><field name="abroj_over"/></xpath><xpath expr="//field[@name='subcontractor_ids']" position="before"><group><field name="contract_value"/><field name="contracting_goal_ar"/><field name="contracting_goal_en"/><field name="contract_payment_schedule_ar"/><field name="contract_payment_schedule_en"/><field name="contracting_start"/><field name="contracting_end"/><field name="value_type"/><field name="estimated_cost"/><field name="contract_vat_percent"/><field name="contract_retention_percent"/></group></xpath><xpath expr="//page[field[@name='subcontractor_ids']]" position="attributes"><attribute name="string">العقود والاتفاقيات</attribute></xpath><xpath expr="//page[@name='contractors']" position="before"><page string="المراحل"><field name="task_ids" readonly="1"><list><field name="name"/><field name="state"/><field name="x_abroj_progress"/></list></field></page></xpath><xpath expr="//page[@name='invoices_costs']" position="before"><page string="المكتبة"><field name="abroj_gallery_widget" widget="abroj_gallery" nolabel="1"/></page></xpath><xpath expr="//page[@name='logs']" position="before"><page string="التقارير اليومية"><field name="abroj_daily_line_ids" readonly="1"><list><field name="report_id"/><field name="task_id"/><field name="progress_from"/><field name="progress_to"/><field name="notes"/></list></field></page></xpath></field>
    </record>
    <record id="task_form_dashboard" model="ir.ui.view"><field name="name">task.form.abroj.start</field><field name="model">project.task</field><field name="inherit_id" ref="project.view_task_form2"/><field name="arch" type="xml"><field name="date_deadline" position="attributes"><attribute name="readonly">x_abroj_date_start</attribute></field><field name="date_deadline" position="before"><field name="x_abroj_date_start"/><field name="x_abroj_duration_days"/></field></field></record>
    <record id="task_list_dashboard" model="ir.ui.view"><field name="name">task.list.abroj.duration</field><field name="model">project.task</field><field name="inherit_id" ref="project.view_task_tree2"/><field name="arch" type="xml"><field name="date_deadline" position="before"><field name="x_abroj_date_start" optional="show"/><field name="x_abroj_duration_days" optional="show"/></field></field></record>
</odoo>
