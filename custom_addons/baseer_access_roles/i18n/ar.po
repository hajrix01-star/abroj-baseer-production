#. module: baseer_access_roles
#. odoo-python
#: code:addons/baseer_access_roles/models/advance_entry.py:0
msgid "An assigned owner, accountant or cashier role is required."
msgstr "يلزم تعيين صلاحية المالك أو المحاسب أو الكاشير."

#. module: baseer_access_roles
#. odoo-python
#: code:addons/baseer_access_roles/models/advance_entry.py:0
msgid "The company is outside your authorized companies."
msgstr "الشركة ليست ضمن الشركات المسموح لك بها."

#. module: baseer_access_roles
#. odoo-python
#: code:addons/baseer_access_roles/models/advance_entry.py:0
