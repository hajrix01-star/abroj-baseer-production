<odoo>
    <record id="action_dashboard" model="ir.actions.client"><field name="name">لوحة التحكم</field><field name="tag">abroj_project_dashboard</field></record>
    <menuitem id="menu_dashboard" name="لوحة التحكم" parent="project.menu_main_pm" action="action_dashboard" sequence="1" groups="project.group_project_user"/>
    <record id="project_form_dashboard" model="ir.ui.view">
        <field name="name">project.form.abroj.dashboard</field><field name="model">project.project</field><field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="الملفات والصور"><field name="abroj_gallery_widget" widget="abroj_gallery" nolabel="1"/></page><page string="لوحة أبرج"><group><field name="abroj_type"/><field name="abroj_currency_id" invisible="1"/><field name="abroj_budget"/><field name="abroj_contract_value"/><field name="abroj_use_manual_progress"/><field name="abroj_manual_progress" invisible="not abroj_use_manual_progress"/><field name="abroj_closed_date"/></group><field name="abroj_budget_line_ids"><list editable="bottom"><field name="name"/><field name="currency_id" column_invisible="True"/><field name="budget"/><field name="manual_actual"/><field name="actual"/></list></field></page></xpath></field>
    </record>
    <record id="contracting_project_form_gallery" model="ir.ui.view">
        <field name="name">project.form.abroj.contracting.gallery</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="abroj_contracting.project_form"/>
        <field name="arch" type="xml"><xpath expr="//group[field[@name='cash_balance']]/field[@name='total_received']" position="replace"/><xpath expr="//group[field[@name='cash_balance']]/field[@name='total_paid']" position="replace"/><xpath expr="//notebook" position="inside"><page string="الملفات والصور"><field name="abroj_gallery_widget" widget="abroj_gallery" nolabel="1"/></page></xpath></field>
    </record>
    <record id="task_form_dashboard" model="ir.ui.view"><field name="name">task.form.abroj.start</field><field name="model">project.task</field><field name="inherit_id" ref="project.view_task_form2"/><field name="arch" type="xml"><field name="date_deadline" position="attributes"><attribute name="readonly">x_abroj_date_start</attribute></field><field name="date_deadline" position="before"><field name="x_abroj_date_start"/><field name="x_abroj_duration_days"/></field></field></record>
    <record id="task_list_dashboard" model="ir.ui.view"><field name="name">task.list.abroj.duration</field><field name="model">project.task</field><field name="inherit_id" ref="project.view_task_tree2"/><field name="arch" type="xml"><field name="date_deadline" position="before"><field name="x_abroj_date_start" optional="show"/><field name="x_abroj_duration_days" optional="show"/></field></field></record>
</odoo>
