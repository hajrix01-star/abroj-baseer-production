<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Odoo keeps ownership of the authentication form, MFA, passkeys and reset flow. -->
  <template id="login_layout" inherit_id="website.login_layout" name="Baseer branded login" priority="30">
    <xpath expr="//div[hasclass('oe_website_login_container')]" position="replace">
      <t t-set="is_ar" t-value="request.env.lang.startswith('ar')"/>
      <main class="baseer-login" t-att-dir="'rtl' if is_ar else 'ltr'" t-att-lang="'ar' if is_ar else 'en'">
        <section class="baseer-side">
          <div class="baseer-side-top"><a href="https://abroj.sa" class="baseer-back"><span aria-hidden="true">←</span> <t t-if="is_ar">أبرج للمشاريع المتكاملة</t><t t-else="">Abroj Integrated Construction</t></a><span class="baseer-status"><i aria-hidden="true"/> <t t-if="is_ar">بوابة الموظفين</t><t t-else="">EMPLOYEE PORTAL</t></span></div>
          <div class="baseer-message"><img src="/baseer_abroj_login/static/src/img/baseer-logo-white.png" alt="Baseer"/><p><t t-if="is_ar">منصة أبرج لإدارة العمل.</t><t t-else="">Abroj's workplace management platform.</t></p><small><t t-if="is_ar">وصول آمن إلى بيئة العمل الداخلية.</t><t t-else="">Secure access to your internal workspace.</t></small></div>
          <div class="baseer-side-footer"><span>© ABROJ</span><a t-att-href="'/website/lang/en?r=/web/login' if is_ar else '/website/lang/ar?r=/web/login'"><t t-if="is_ar">English</t><t t-else="">العربية</t></a></div>
        </section>
        <section class="baseer-form"><div class="baseer-card"><p class="eyebrow">BASEER / <t t-if="is_ar">بصير</t><t t-else="">SIGN IN</t></p><h1><t t-if="is_ar">أهلاً بعودتك.</t><t t-else="">Welcome back.</t></h1><p class="baseer-intro"><t t-if="is_ar">سجّل دخولك للانتقال إلى مساحة عملك.</t><t t-else="">Sign in to continue to your workspace.</t></p><div class="baseer-form-content"><t t-out="0"/></div></div></section>
      </main>
    </xpath>
  </template>
  <template id="login_labels" inherit_id="web.login" name="Baseer login labels" priority="30">
    <xpath expr="//label[@for='login']" position="replace"><label for="login" class="form-label d-flex justify-content-between"><t t-if="request.env.lang.startswith('ar')">البريد الإلكتروني</t><t t-else="">Email</t></label></xpath>
    <xpath expr="//input[@id='login']" position="attributes"><attribute name="t-att-placeholder">'أدخل بريدك الإلكتروني' if request.env.lang.startswith('ar') else 'Enter your email'</attribute></xpath>
    <xpath expr="//label[@for='password']" position="replace"><label for="password" class="form-label"><t t-if="request.env.lang.startswith('ar')">كلمة المرور</t><t t-else="">Password</t></label></xpath>
    <xpath expr="//input[@id='password']" position="attributes"><attribute name="t-att-placeholder">'أدخل كلمة المرور' if request.env.lang.startswith('ar') else 'Enter your password'</attribute></xpath>
    <xpath expr="//button[@type='submit' and hasclass('btn-primary')]" position="replace"><button type="submit" class="btn btn-primary"><t t-if="request.env.lang.startswith('ar')">تسجيل الدخول</t><t t-else="">Log in</t></button></xpath>
  </template>
</odoo>
