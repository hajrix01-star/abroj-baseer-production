    [ "$schema" = "$(cat "$backup/bwork-schema-restored.sha256")" ] || return 1
    filestore="$(bwork_recovery_filestore_hash)" || return 1
    [ "$filestore" = "$(cat "$backup/bwork-filestore-before.sha256")" ] || return 1
