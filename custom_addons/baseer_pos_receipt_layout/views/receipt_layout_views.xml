<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_receipt_profile" model="ir.ui.view">
        <field name="name">res.company.form.baseer.receipt.profile</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="POS receipt defaults" groups="base.group_system">
                    <field name="baseer_receipt_profile_enabled"/>
                    <group invisible="not baseer_receipt_profile_enabled">
                        <field name="baseer_receipt_profile_printer_id" domain="[('active', '=', True), ('allowed_company_ids', 'in', id)]"/>
                        <field name="baseer_receipt_profile_copies"/>
                        <field name="baseer_receipt_profile_layout_mode"/>
                        <field name="baseer_receipt_profile_close_report"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_pos_config_form_receipt_layout" model="ir.ui.view">
        <field name="name">pos.config.form.baseer.receipt.layout</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="baseer_pos_print_bridge.view_pos_config_form_direct_print"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='baseer_native_receipt_enabled']" position="after">
                <field name="baseer_receipt_layout_mode"
                       string="Customer receipt layout"
                       help="Choose the look of the printed customer receipt. It does not change totals or taxes."/>
            </xpath>
        </field>
    </record>
</odoo>
