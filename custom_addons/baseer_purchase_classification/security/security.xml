<odoo>
    <data noupdate="1">
        <record id="baseer_purchase_reporting_rule_company_rule" model="ir.rule">
            <field name="name">Purchase reporting rules: company</field>
            <field name="model_id" ref="model_baseer_purchase_reporting_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
        <record id="baseer_purchase_line_classification_case_company_rule" model="ir.rule">
            <field name="name">Purchase classification cases: company</field>
            <field name="model_id" ref="model_baseer_purchase_line_classification_case"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
        <record id="baseer_purchase_line_classification_company_rule" model="ir.rule">
            <field name="name">Purchase classification snapshots: company</field>
            <field name="model_id" ref="model_baseer_purchase_line_classification"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
        <record id="baseer_purchase_line_classification_leg_company_rule" model="ir.rule">
            <field name="name">Purchase classification allocations: company</field>
            <field name="model_id" ref="model_baseer_purchase_line_classification_leg"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
    </data>
</odoo>
