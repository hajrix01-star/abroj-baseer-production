<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="baseer_pos_receipt_layout.OrderReceipt"
       t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
            <attribute name="t-attf-class">pos-receipt p-2 #{order.config.baseer_receipt_layout_mode === 'baseer_80' ? 'baseer-pos-receipt-80' : ''}</attribute>
        </xpath>
        <xpath expr="//ReceiptHeader" position="after">
            <div t-if="order.config.baseer_receipt_layout_mode === 'baseer_80'"
                 class="baseer-receipt-fiscal-title text-center">
                <span>إيصال العميل</span>
                <span class="baseer-receipt-fiscal-title-en">Customer Receipt</span>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('before-footer')]" position="before">
            <div t-if="order.config.baseer_receipt_layout_mode === 'baseer_80'"
                 class="baseer-receipt-summary-label text-center">
                <span>ملخص الفاتورة</span>
                <span class="baseer-receipt-summary-label-en">Invoice Summary</span>
            </div>
        </xpath>
        <!-- Display-only ordering: copy the native groups; never mutate tax data. -->
        <xpath expr="//div[hasclass('pos-receipt-taxes')]/t/div[not(@t-foreach)]/span[1]" position="replace">
            <span t-if="order.config.baseer_receipt_layout_mode === 'baseer_80'" class="text-nowrap mw-100">المجموع الفرعي</span>
            <span t-else="" class="text-nowrap mw-100">Subtotal</span>
        </xpath>
        <xpath expr="//div[@t-foreach='subtotal.tax_groups']" position="before">
            <t t-set="isBaseerReceipt" t-value="order.config.baseer_receipt_layout_mode === 'baseer_80'"/>
            <t t-set="isTobaccoGroup" t-value="(group) => (group.group_name || '').toLowerCase().includes('tobacco') || (group.group_name || '').includes('تبغ')"/>
            <t t-set="receiptTaxGroups" t-value="isBaseerReceipt ? [...subtotal.tax_groups.filter(isTobaccoGroup), ...subtotal.tax_groups.filter((group) => !isTobaccoGroup(group))] : subtotal.tax_groups"/>
        </xpath>
        <xpath expr="//div[@t-foreach='subtotal.tax_groups']" position="attributes">
            <attribute name="t-foreach">receiptTaxGroups</attribute>
        </xpath>
        <xpath expr="//span[@t-esc='tax_group.group_name']" position="replace">
            <t t-set="isVatGroup" t-value="(tax_group.group_name || '').toUpperCase().startsWith('VAT') || (tax_group.group_name || '').includes('القيمة المضافة')"/>
            <span t-if="isBaseerReceipt &amp;&amp; isVatGroup">VAT</span>
            <span t-else="" t-esc="tax_group.group_name"/>
        </xpath>
        <xpath expr="//t[@t-if='showTaxGroupLabels']" position="attributes">
            <attribute name="t-if">showTaxGroupLabels &amp;&amp; !(isBaseerReceipt &amp;&amp; (isVatGroup || isTobaccoGroup(tax_group)))</attribute>
        </xpath>
        <xpath expr="//t[@id='tax_base']" position="attributes">
            <attribute name="t-if">!taxTotals.same_tax_base &amp;&amp; !(isBaseerReceipt &amp;&amp; (isVatGroup || isTobaccoGroup(tax_group)))</attribute>
        </xpath>
    </t>

    <t t-name="baseer_pos_receipt_layout.ReceiptHeader"
       t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-customer')]" position="attributes">
            <attribute name="t-attf-class">pos-receipt-customer mt-2 #{order.config.baseer_receipt_layout_mode === 'baseer_80' ? 'baseer-receipt-customer' : ''}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-customer')]" position="after">
            <div t-if="order.config.baseer_receipt_layout_mode === 'baseer_80' and order.partner_id and order.partner_id.phone"
                 class="baseer-receipt-customer-mobile text-center">
                <span class="baseer-receipt-customer-mobile-label">الجوال / Mobile</span>
                <span class="baseer-receipt-customer-mobile-number" dir="ltr"
                      t-esc="order.partner_id.phone"/>
            </div>
        </xpath>
    </t>
</templates>
