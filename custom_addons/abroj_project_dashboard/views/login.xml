<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="abroj_login_layout" inherit_id="web.login_layout" name="Abroj Login Layout" priority="40">
        <xpath expr="//t[@t-call]" position="replace">
            <t t-set="abroj_lang" t-value="request.params.get('abroj_lang') or 'ar'"/>
            <t t-set="LL" t-value="request.params.get('abroj_labels') or {}"/>
            <t t-set="abroj_other" t-value="'en' if abroj_lang == 'ar' else 'ar'"/>
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;', 'lang': abroj_lang, 'dir': 'rtl' if abroj_lang == 'ar' else 'ltr'}"/>
                <t t-set="body_classname" t-value="'abroj-login-body'"/>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <div t-attf-class="abroj-login #{'abroj-rtl' if abroj_lang == 'ar' else 'abroj-ltr'}" t-att-dir="'rtl' if abroj_lang == 'ar' else 'ltr'">
                    <div class="abroj-login__pane">
                        <a t-if="LL.get('switch')" class="abroj-login__lang" t-att-lang="abroj_other" t-attf-href="#{request.httprequest.path}?lang=#{abroj_other}#{'&amp;redirect=' + quote_plus(redirect) if redirect else ''}">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
                            <span t-out="LL.get('switch')"/>
                        </a>
                        <div class="abroj-login__logo">
                            <img src="/abroj_project_dashboard/static/pwa/logo-navy.png" alt="أبرج"/>
                        </div>
                        <div t-attf-class="abroj-login__card o_database_list {{login_card_classes}}">
                            <t t-out="0"/>
                        </div>
                    </div>
                    <div class="abroj-login__photo" aria-hidden="true">
                        <img src="/abroj_project_dashboard/static/src/login/img/courtyard.jpg" alt=""/>
                        <div class="abroj-login__badge">
                            <div class="abroj-login__badge-box">ABROJ PROJECT</div>
                            <div class="abroj-login__badge-tag" t-out="LL.get('tagline')"/>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template id="abroj_login" inherit_id="web.login" name="Abroj Login Form" priority="40">
        <xpath expr="//form" position="before">
            <t t-set="L" t-value="request.params.get('abroj_labels') or {}"/>
            <h1 class="abroj-login__title" t-out="L['title']"/>
            <p class="abroj-login__welcome" t-out="L['welcome']"/>
        </xpath>
        <xpath expr="//div[hasclass('field-login')]" position="before">
            <t t-set="abroj_target" t-value="request.params.get('abroj_target') or 'app'"/>
            <fieldset class="abroj-login__target">
                <legend class="visually-hidden" t-out="L['target_label']"/>
                <label t-attf-class="abroj-login__opt #{'is-active' if abroj_target == 'app' else ''}">
                    <input type="radio" name="abroj_target" value="app" t-att-checked="'checked' if abroj_target == 'app' else None"/>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                    <span t-out="L['target_app']"/>
                </label>
                <label t-attf-class="abroj-login__opt #{'is-active' if abroj_target == 'odoo' else ''}">
                    <input type="radio" name="abroj_target" value="odoo" t-att-checked="'checked' if abroj_target == 'odoo' else None"/>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                    <span t-out="L['target_odoo']"/>
                </label>
            </fieldset>
        </xpath>
        <xpath expr="//div[hasclass('field-login')]/label" position="replace">
            <label for="login" class="form-label" t-out="L['login']"/>
        </xpath>
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="placeholder">name@abroj.sa</attribute>
            <attribute name="dir">ltr</attribute>
        </xpath>
        <xpath expr="//label[@for='password']" position="replace">
            <label for="password" class="form-label" t-out="L['password']"/>
        </xpath>
        <xpath expr="//input[@name='password']" position="attributes">
            <attribute name="placeholder">••••••••</attribute>
            <attribute name="dir">ltr</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_show_password')]" position="attributes">
            <attribute name="t-att-aria-label">L['show']</attribute>
        </xpath>
        <xpath expr="//p[hasclass('alert-danger')]" position="before">
            <div class="abroj-login__row">
                <label class="abroj-login__remember">
                    <input type="checkbox" name="remember" value="1" id="abroj_remember" checked="checked"/>
                    <span t-out="L['remember']"/>
                </label>
                <a t-if="reset_password_enabled" class="abroj-login__forgot" t-attf-href="/web/reset_password?{{ keep_query() }}" t-out="L['forgot']"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit']" position="replace">
            <button type="submit" class="btn btn-primary abroj-login__submit" t-out="L['submit']"/>
        </xpath>
        <xpath expr="//form" position="inside">
            <input type="hidden" name="lang" t-att-value="request.params.get('abroj_lang')"/>
        </xpath>
        <xpath expr="//div[@id='oe_structure_login_bottom']" position="after">
            <p class="abroj-login__footer" t-out="L['footer']"/>
        </xpath>
    </template>
    <template id="abroj_switch" name="Abroj App Switch">
        <t t-call="web.login_layout">
            <h1 class="abroj-login__title" t-out="switch_title"/>
            <p class="abroj-login__welcome" t-out="user_name"/>
            <div class="abroj-login__switch">
                <a class="abroj-login__choice" href="/abroj/app">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                    <span t-out="L['target_app']"/>
                </a>
                <a class="abroj-login__choice" href="/odoo">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                    <span t-out="L['target_odoo']"/>
                </a>
            </div>
            <p class="abroj-login__footer" t-out="L['footer']"/>
        </t>
    </template>
</odoo>
