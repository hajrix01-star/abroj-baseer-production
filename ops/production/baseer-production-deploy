        -v "$bwork_recovery_helper:/mnt/bwork-recovery.py:ro" \
        -v "$old_release:/mnt/bwork-recovery-old:ro" --entrypoint timeout odoo \
        300 python3 /mnt/bwork-recovery.py "${flags[@]}"
