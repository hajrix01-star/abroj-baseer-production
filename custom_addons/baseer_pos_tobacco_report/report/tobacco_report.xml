<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_pos_tobacco_fees" model="report.paperformat">
        <field name="name">POS Tobacco Fee Register A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">14</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_pos_tobacco_fees" model="ir.actions.report">
        <field name="name">POS Tobacco Fee Register</field>
        <field name="model">baseer.pos.tobacco.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baseer_pos_tobacco_report.report_pos_tobacco_fees</field>
        <field name="report_file">baseer_pos_tobacco_report.report_pos_tobacco_fees</field>
        <field name="paperformat_id" ref="paperformat_pos_tobacco_fees"/>
        <field name="print_report_name">'رسوم التبغ لـ %s-%s' % (object.month, object.year) if object.date_from == object._month_range()[0] and object.date_to == object._month_range()[1] else 'رسوم التبغ من %s إلى %s' % (object.date_from.strftime('%d-%m-%Y'), object.date_to.strftime('%d-%m-%Y'))</field>
    </record>

    <record id="action_report_pos_tobacco_fees" model="ir.actions.report" context="{'lang': 'ar_001'}">
        <field name="print_report_name">'رسوم التبغ لـ %s-%s' % (object.month, object.year) if object.date_from == object._month_range()[0] and object.date_to == object._month_range()[1] else 'رسوم التبغ من %s إلى %s' % (object.date_from.strftime('%d-%m-%Y'), object.date_to.strftime('%d-%m-%Y'))</field>
    </record>

    <template id="report_pos_tobacco_fees">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="report_data['company']"/>
            <t t-set="o" t-value="report_data['wizard']"/>
                <div class="page" t-att-dir="'rtl' if report_data['is_rtl'] else 'ltr'">
                    <style>
                        @page {size: A4 portrait; margin: 14mm 10mm 20mm 10mm;}
                        .page {width: 190mm; max-width: 190mm; margin: 0 auto;}
                        .btf-report {font-family: DejaVu Sans, Arial, sans-serif; color: #26343d; font-size: 10px;}
                        .btf-report h2 {font-size: 18px; margin: 0 0 8px; text-align: center;}
                        .btf-report .btf-header {text-align: center; margin-bottom: 10px; page-break-inside: avoid;}
                        .btf-report .btf-header img {display: block; max-height: 64px; max-width: 180px; width: auto; height: auto; margin: 0 auto 4px;}
                        .btf-report .btf-company {font-weight: bold; font-size: 12px;}
                        .btf-report .btf-company-details {font-size: 10px;}
                        .btf-report .btf-company-details p {margin: 0;}
                        .btf-report .btf-vat {color: #66747a; font-size: 9px;}
                        .btf-report .btf-period {width: auto; margin: 0 auto 12px; table-layout: auto;}
                        .btf-report .btf-period td {border: 0; padding: 0 7px; white-space: nowrap;}
                        .btf-report table {width: 100%; border-collapse: collapse; table-layout: fixed;}
                        .btf-report.btf-rtl table {direction: rtl;}
                        .btf-report.btf-ltr table {direction: ltr;}
                        .btf-report thead {display: table-header-group;}
                        .btf-report th, .btf-report td {border: 1px solid #d9dfe2; padding: 5px; vertical-align: top; overflow-wrap: anywhere;}
                        .btf-report th {background: #edf3f2; font-weight: bold;}
                        .btf-report.btf-rtl th, .btf-report.btf-rtl td {text-align: right;}
                        .btf-report.btf-ltr th, .btf-report.btf-ltr td {text-align: left;}
                        .btf-report.btf-rtl .btf-number, .btf-report.btf-ltr .btf-number {direction: ltr; unicode-bidi: isolate; text-align: right; white-space: nowrap;}
                        .btf-report.btf-rtl .btf-id, .btf-report.btf-ltr .btf-id {direction: ltr; unicode-bidi: isolate; text-align: center;}
                        .btf-report .btf-total {font-weight: bold; background: #f2f5f4;}
                        .btf-report .btf-final-group {page-break-inside: avoid; break-inside: avoid;}
                        .btf-report .btf-exception {color: #9a4b20; font-weight: bold;}
                        .btf-report .btf-muted {color: #66747a;}
                    </style>
                    <main t-att-class="'btf-report btf-rtl' if report_data['is_rtl'] else 'btf-report btf-ltr'">
                        <div class="btf-header">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Company logo"/>
                            <div t-if="company.company_details" class="btf-company-details" t-field="company.company_details"/>
                            <div t-else="" class="btf-company" t-esc="company.name"/>
                            <div t-if="company.vat" class="btf-vat">
                                <span t-esc="report_data['labels']['tax_number']"/>
                                <span dir="ltr" t-esc="company.vat"/>
                            </div>
                        </div>
                        <h2 t-esc="report_data['labels']['title']"/>
                        <table class="btf-period" t-att-dir="'rtl' if report_data['is_rtl'] else 'ltr'"><tr>
                            <td><strong t-esc="report_data['labels']['from']"/> <span dir="ltr" t-esc="report_data['from_text']"/></td>
                            <td><strong t-esc="report_data['labels']['to']"/> <span dir="ltr" t-esc="report_data['to_text']"/></td>
                            <td><strong t-esc="report_data['labels']['currency']"/> <span dir="ltr" t-esc="report_data['currency']"/></td>
                        </tr></table>
                        <table>
                            <thead>
                                <tr>
                                    <th class="btf-id" t-att-style="'width: 15%;' if report_data['show_products'] else 'width: 18%;'" t-esc="report_data['labels']['date']"/>
                                    <th class="btf-id" t-att-style="'width: 16%;' if report_data['show_products'] else 'width: 18%;'" t-esc="report_data['labels']['order']"/>
                                    <th t-if="report_data['show_products']" style="width: 25%;" t-esc="report_data['labels']['product']"/>
                                    <th t-att-style="'width: 10%;' if report_data['show_products'] else 'width: 14%;'" t-esc="report_data['labels']['type']"/>
                                    <th class="btf-number" t-att-style="'width: 11%;' if report_data['show_products'] else 'width: 15%;'" t-esc="report_data['labels']['debit']"/>
                                    <th class="btf-number" t-att-style="'width: 11%;' if report_data['show_products'] else 'width: 15%;'" t-esc="report_data['labels']['credit']"/>
                                    <th class="btf-number" t-att-style="'width: 12%;' if report_data['show_products'] else 'width: 20%;'" t-esc="report_data['labels']['running']"/>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td t-att-colspan="6 if report_data['show_products'] else 5" class="btf-muted" t-esc="report_data['labels']['opening']"/>
                                    <td class="btf-number" t-esc="report_data['opening']"/>
                                </tr>
                                <t t-if="not report_data['rows']">
                                    <tr><td t-att-colspan="7 if report_data['show_products'] else 6" t-esc="report_data['labels']['empty']"/></tr>
                                </t>
                                <t t-foreach="report_data['rows'][:-4]" t-as="row">
                                    <tr>
                                        <td class="btf-id" t-esc="row['date']"/>
                                        <td class="btf-id" t-esc="row['order']"/>
                                        <td t-if="report_data['show_products']" t-esc="row['products']"/>
                                        <td t-esc="row['type']"/>
                                        <td class="btf-number" t-esc="row['debit']"/>
                                        <td class="btf-number" t-esc="row['credit']"/>
                                        <td class="btf-number" t-esc="row['running']"/>
                                    </tr>
                                </t>
                            </tbody>
                            <tbody class="btf-final-group">
                                <t t-foreach="report_data['rows'][-4:]" t-as="row">
                                    <tr>
                                        <td class="btf-id" t-esc="row['date']"/>
                                        <td class="btf-id" t-esc="row['order']"/>
                                        <td t-if="report_data['show_products']" t-esc="row['products']"/>
                                        <td t-esc="row['type']"/>
                                        <td class="btf-number" t-esc="row['debit']"/>
                                        <td class="btf-number" t-esc="row['credit']"/>
                                        <td class="btf-number" t-esc="row['running']"/>
                                    </tr>
                                </t>
                                <tr class="btf-total">
                                    <td t-att-colspan="4 if report_data['show_products'] else 3" t-esc="report_data['labels']['total']"/>
                                    <td class="btf-number" t-esc="report_data['debit_total']"/>
                                    <td class="btf-number" t-esc="report_data['credit_total']"/>
                                    <td class="btf-number" t-esc="report_data['closing']"/>
                                </tr>
                            </tbody>
                        </table>
                        <t t-if="report_data['exceptions']">
                            <h3 class="btf-exception" t-esc="report_data['labels']['mismatch']"/>
                            <table>
                                <thead>
                                    <tr>
                                        <th class="btf-id" t-esc="report_data['labels']['date']"/>
                                        <th class="btf-id" t-esc="report_data['labels']['order']"/>
                                        <th class="btf-number" t-esc="report_data['labels']['computed_total']"/>
                                        <th class="btf-number" t-esc="report_data['labels']['saved_total']"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="report_data['exceptions']" t-as="exception">
                                        <tr>
                                            <td class="btf-id" t-esc="exception['date']"/>
                                            <td class="btf-id" t-esc="exception['order']"/>
                                            <td class="btf-number" t-esc="exception['computed_total']"/>
                                            <td class="btf-number" t-esc="exception['saved_total']"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </main>
                </div>
                <div class="footer" style="font-family: DejaVu Sans, Arial, sans-serif; color: #66747a; font-size: 9px; text-align: center;">
                    <span t-esc="report_data['labels']['page']"/> <span class="page"/> / <span class="topage"/>
                </div>
        </t>
    </template>
    <template id="preview_pos_tobacco_fees">
        <div class="card mt-3" t-att-dir="'rtl' if report_data['is_rtl'] else 'ltr'">
            <div class="card-body">
                <div class="text-center mb-3">
                    <img t-if="report_data['company'].logo"
                         t-att-src="'/web/image/res.company/%s/logo' % report_data['company'].id"
                         alt="Company logo" style="max-height: 64px; max-width: 160px;"/>
                    <div t-else="" t-esc="report_data['company'].name"/>
                    <h2 class="h4 mt-2" t-esc="report_data['labels']['title']"/>
                    <p class="text-muted mb-0">
                        <span t-esc="report_data['labels']['from']"/>
                        <b dir="ltr" t-esc="report_data['from_text']"/>
                        <span t-esc="report_data['labels']['to']"/>
                        <b dir="ltr" t-esc="report_data['to_text']"/>
                    </p>
                </div>
                <div class="row row-cols-2 row-cols-lg-4 g-2 mb-3">
                    <div class="col"><div class="border rounded p-2 h-100">
                        <small class="text-muted d-block" t-esc="report_data['labels']['opening']"/>
                        <strong dir="ltr" t-esc="report_data['opening']"/>
                    </div></div>
                    <div class="col"><div class="border rounded p-2 h-100">
                        <small class="text-muted d-block" t-esc="report_data['labels']['debit']"/>
                        <strong dir="ltr" t-esc="report_data['debit_total']"/>
                    </div></div>
                    <div class="col"><div class="border rounded p-2 h-100">
                        <small class="text-muted d-block" t-esc="report_data['labels']['credit']"/>
                        <strong dir="ltr" t-esc="report_data['credit_total']"/>
                    </div></div>
                    <div class="col"><div class="border rounded p-2 h-100">
                        <small class="text-muted d-block" t-esc="report_data['labels']['total']"/>
                        <strong dir="ltr" t-esc="report_data['closing']"/>
                    </div></div>
                </div>
                <p class="text-muted small">
                    <span t-esc="report_data['labels']['rows']"/>
                    <b dir="ltr" t-esc="first_row"/>–<b dir="ltr" t-esc="last_row"/>
                    <span t-esc="report_data['labels']['of']"/>
                    <b dir="ltr" t-esc="report_data['order_count']"/>
                    <span t-esc="report_data['labels']['page']"/>
                    <b dir="ltr" t-esc="page"/>/<b dir="ltr" t-esc="pages"/>
                </p>
                <p t-if="not report_data['rows']" class="text-muted" t-esc="report_data['labels']['empty']"/>
                <div t-if="report_data['rows']" class="d-none d-lg-block">
                    <table class="table table-sm table-striped align-middle">
                        <thead><tr>
                            <th class="text-center" t-esc="report_data['labels']['date']"/>
                            <th class="text-center" t-esc="report_data['labels']['order']"/>
                            <th t-if="report_data['show_products']" t-esc="report_data['labels']['product']"/>
                            <th t-esc="report_data['labels']['type']"/>
                            <th class="text-end" t-esc="report_data['labels']['debit']"/>
                            <th class="text-end" t-esc="report_data['labels']['credit']"/>
                            <th class="text-end" t-esc="report_data['labels']['running']"/>
                        </tr></thead>
                        <tbody><tr t-foreach="report_data['rows']" t-as="row">
                            <td class="text-center" dir="ltr" t-esc="row['date']"/>
                            <td class="text-center" dir="ltr" t-esc="row['order']"/>
                            <td t-if="report_data['show_products']" t-esc="row['products']"/>
                            <td t-esc="row['type']"/>
                            <td class="text-end" dir="ltr" t-esc="row['debit']"/>
                            <td class="text-end" dir="ltr" t-esc="row['credit']"/>
                            <td class="text-end" dir="ltr" t-esc="row['running']"/>
                        </tr></tbody>
                    </table>
                </div>
                <div t-if="report_data['rows']" class="d-lg-none">
                    <article t-foreach="report_data['rows']" t-as="row" class="card mb-2">
                        <div class="card-body py-2">
                            <div class="d-flex justify-content-between gap-2 flex-wrap">
                                <strong dir="ltr" t-esc="row['order']"/>
                                <span dir="ltr" t-esc="row['date']"/>
                            </div>
                            <p t-if="report_data['show_products']" class="mb-1" t-esc="row['products']"/>
                            <small t-esc="row['type']"/>
                            <div class="d-flex justify-content-between gap-2 flex-wrap mt-1">
                                <span><span t-esc="report_data['labels']['debit']"/>: <b dir="ltr" t-esc="row['debit']"/></span>
                                <span><span t-esc="report_data['labels']['credit']"/>: <b dir="ltr" t-esc="row['credit']"/></span>
                                <span><span t-esc="report_data['labels']['running']"/>: <b dir="ltr" t-esc="row['running']"/></span>
                            </div>
                        </div>
                    </article>
                </div>
                <div t-if="report_data['exceptions']" class="alert alert-warning mt-3" role="note">
                    <h3 class="h6" t-esc="report_data['labels']['mismatch']"/>
                    <div t-foreach="report_data['exceptions']" t-as="exception" class="small">
                        <b dir="ltr" t-esc="exception['order']"/>
                        <span t-esc="report_data['labels']['computed_total']"/>
                        <b dir="ltr" t-esc="exception['computed_total']"/>
                        <span t-esc="report_data['labels']['saved_total']"/>
                        <b dir="ltr" t-esc="exception['saved_total']"/>
                    </div>
                    <p t-if="len(report_data['exceptions']) &lt; int(report_data['exception_count'])"
                       class="mb-0 small" t-esc="report_data['labels']['more_differences']"/>
                </div>
            </div>
        </div>
    </template>
</odoo>
