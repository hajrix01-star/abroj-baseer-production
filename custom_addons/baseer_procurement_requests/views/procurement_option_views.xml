<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_procurement_option_list" model="ir.ui.view">
        <field name="name">baseer.procurement.purchase.option.list</field>
        <field name="model">baseer.procurement.purchase.option</field>
        <field name="arch" type="xml">
            <list string="Raw material catalogue">
                <field name="sequence" widget="handle"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="uom_id"/>
                <field name="packaging_note" optional="hide"/>
                <field name="last_price"/>
                <field name="last_price_at" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_procurement_option_form" model="ir.ui.view">
        <field name="name">baseer.procurement.purchase.option.form</field>
        <field name="model">baseer.procurement.purchase.option</field>
        <field name="arch" type="xml">
            <form string="Raw material purchase option">
                <sheet><group><group>
                    <field name="company_id"/>
                    <field name="product_id"/>
                    <field name="name"/>
                    <field name="uom_id"/>
                    <field name="packaging_note"/>
                    <field name="sequence"/>
                    <field name="active"/>
                </group><group>
                    <field name="last_price" readonly="1"/>
                    <field name="last_price_at" readonly="1"/>
                </group></group></sheet>
            </form>
        </field>
    </record>
    <record id="view_procurement_option_search" model="ir.ui.view">
        <field name="name">baseer.procurement.purchase.option.search</field>
        <field name="model">baseer.procurement.purchase.option</field>
        <field name="arch" type="xml"><search string="Raw material catalogue"><field name="product_id"/><field name="name"/><filter name="active" string="Active" domain="[('active', '=', True)]"/></search></field>
    </record>
    <record id="action_procurement_option" model="ir.actions.act_window">
        <field name="name">Raw-material catalogue</field>
        <field name="res_model">baseer.procurement.purchase.option</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_procurement_option_search"/>
    </record>
    <record id="view_procurement_price_history_list" model="ir.ui.view">
        <field name="name">baseer.procurement.price.history.list</field>
        <field name="model">baseer.procurement.price.history</field>
        <field name="arch" type="xml">
            <list string="Raw-material purchases" default_order="purchase_date desc">
                <field name="purchase_date"/>
                <field name="product_id"/>
                <field name="quantity" sum="Quantity"/>
                <field name="purchase_uom_id"/>
                <field name="unit_price"/>
                <field name="inventory_uom_id"/>
                <field name="inventory_unit_cost"/>
                <field name="previous_standard_price" optional="hide"/>
                <field name="new_standard_price"/>
                <field name="stock_receipt_created"/>
                <field name="option_id" optional="hide"/>
                <field name="warehouse_id" optional="hide"/>
                <field name="purchaser_id" optional="hide"/>
                <field name="representative_partner_id" optional="hide"/>
                <field name="request_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_procurement_price_history_pivot" model="ir.ui.view"><field name="name">baseer.procurement.price.history.pivot</field><field name="model">baseer.procurement.price.history</field><field name="arch" type="xml"><pivot string="Raw-material received quantities"><field name="product_id" type="row"/><field name="option_id" type="row"/><field name="purchase_date" interval="month" type="col"/><field name="quantity" type="measure"/></pivot></field></record>
    <record id="view_procurement_price_history_graph" model="ir.ui.view"><field name="name">baseer.procurement.price.history.graph</field><field name="model">baseer.procurement.price.history</field><field name="arch" type="xml"><graph string="Raw-material purchase quantities" type="bar"><field name="product_id"/><field name="quantity" type="measure"/></graph></field></record>
    <record id="view_procurement_price_history_search" model="ir.ui.view">
        <field name="name">baseer.procurement.price.history.search</field>
        <field name="model">baseer.procurement.price.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="option_id"/>
                <field name="purchase_uom_id"/>
                <field name="inventory_uom_id"/>
                <field name="warehouse_id"/>
                <field name="purchaser_id"/>
                <filter name="stock_receipt" string="Stock receipt created" domain="[('stock_receipt_created', '=', True)]"/>
                <filter name="without_stock_receipt" string="Without stock receipt" domain="[('stock_receipt_created', '=', False)]"/>
                <filter name="month" string="Purchase date" date="purchase_date"/>
                <group>
                    <filter name="product" string="Material" context="{'group_by':'product_id'}"/>
                    <filter name="warehouse" string="Warehouse" context="{'group_by':'warehouse_id'}"/>
                    <filter name="purchaser" string="Buyer" context="{'group_by':'purchaser_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_procurement_price_history" model="ir.actions.act_window"><field name="name">Raw-material reports</field><field name="res_model">baseer.procurement.price.history</field><field name="view_mode">pivot,graph,list</field><field name="search_view_id" ref="view_procurement_price_history_search"/></record>
</odoo>
