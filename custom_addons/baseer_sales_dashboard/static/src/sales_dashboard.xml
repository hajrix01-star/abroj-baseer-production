<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="baseer_sales_dashboard.SalesDashboard">
        <section class="o_baseer_sales_dashboard" t-ref="dashboard" t-att-aria-busy="state.loading">
            <div class="o_baseer_sales_content">
            <header class="o_baseer_sales_header">
                <div class="o_baseer_sales_heading">
                    <h1 t-esc="title"/>
                    <div t-if="state.payload" class="o_baseer_sales_scope">
                        <span class="o_baseer_sales_numeric text-muted" t-esc="periodLabel"/>
                    </div>
                </div>
                <div class="o_baseer_sales_header_actions">
                <button t-if="state.payload and state.payload.source_action" type="button"
                        class="btn btn-link o_baseer_sales_sources" t-on-click="openSources">
                    <span t-esc="labels.sources"/>
                    <i class="fa fa-external-link ms-1" aria-hidden="true"/>
                </button>
                <button type="button" class="btn btn-light o_baseer_sales_refresh" t-on-click="load"
                        t-att-disabled="state.loading">
                    <i class="fa fa-refresh me-1" aria-hidden="true"/>
                    <span t-esc="labels.refresh"/>
                </button>
                </div>
            </header>

            <div t-if="state.loading" class="o_baseer_sales_state" role="status" aria-live="polite">
                <i class="fa fa-circle-o-notch fa-spin text-muted" aria-hidden="true"/>
                <p t-esc="labels.loading"/>
            </div>
            <div t-elif="state.error" class="alert alert-danger o_baseer_sales_error" role="alert">
                <p class="mb-2" t-esc="state.error"/>
                <button type="button" class="btn btn-outline-danger btn-sm" t-on-click="load" t-esc="labels.retry"/>
            </div>
            <t t-elif="state.payload">
                <div t-if="comparisonLabel" class="o_baseer_sales_comparison_period text-muted">
                    <span t-esc="labels.comparison"/>
                    <span class="o_baseer_sales_numeric" t-esc="comparisonLabel"/>
                </div>
                <p t-if="!hasRecordedData" class="o_baseer_sales_preview_label text-muted" role="status" t-esc="labels.preview"/>
                <div class="o_baseer_sales_cards">
                    <article t-foreach="cards" t-as="card" t-key="card.key" class="o_baseer_sales_card"
                             t-att-data-metric="card.key" t-att-class="{'o_baseer_sales_card_money': card.currency, 'o_baseer_sales_card_customer': !card.currency, 'o_baseer_sales_card_preview': !hasRecordedData}">
                        <div class="o_baseer_sales_card_label">
                            <h2 t-esc="card.title"/>
                        </div>
                        <div class="o_baseer_sales_card_value">
                            <span class="o_baseer_sales_numeric" t-att-class="{'text-muted': !card.available}"
                                  t-esc="card.display"/>
                            <small t-if="card.currency and card.available" t-esc="state.payload.company.currency"/>
                        </div>
                        <p class="o_baseer_sales_card_note text-muted" t-esc="card.note"/>
                        <div t-if="card.comparison and hasRecordedData" class="o_baseer_sales_delta"
                             t-attf-data-direction="{{card.comparison.direction}}">
                            <span class="o_baseer_sales_delta_value">
                                <i t-attf-class="fa {{directionIcon(card.comparison.direction)}}" aria-hidden="true"/>
                                <span class="visually-hidden" t-esc="directionLabel(card.comparison.direction)"/>
                                <span class="o_baseer_sales_numeric" t-esc="card.comparison.display"/>
                            </span>
                            <span t-if="card.comparison.available" class="o_baseer_sales_previous text-muted">
                                <span t-esc="labels.previous"/>
                                <span class="o_baseer_sales_numeric" t-esc="card.comparison.previous_display"/>
                            </span>
                        </div>
                    </article>
                </div>

                <article t-if="sourceRows.length" class="o_baseer_sales_chart_card mb-3">
                    <header><h2 t-esc="labels.sourceBreakdown"/></header>
                    <p class="small text-muted mb-2" t-esc="labels.sourceDateBasis"/>
                    <ul class="list-group list-group-flush">
                        <li t-foreach="sourceRows" t-as="source" t-key="source.key"
                            class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2 px-0">
                            <button t-if="source.source_action" type="button" class="btn btn-link p-0 text-start"
                                    t-on-click="() => this.openSalesSource(source)" t-esc="source.name"/>
                            <span t-else="" t-esc="source.name"/>
                            <span class="text-nowrap"><strong class="o_baseer_sales_numeric"
                                t-esc="source.sales.available ? source.sales.display : '—'"/>
                                <small t-if="source.sales.available" class="text-muted ms-1" t-esc="state.payload.company.currency"/>
                            </span>
                        </li>
                    </ul>
                </article>

                <p class="small text-muted mb-1" t-esc="labels.manualScope"/>
                <div class="o_baseer_sales_coverage" t-att-title="labels.manualScope">
                    <div><span class="o_baseer_sales_numeric fw-semibold" t-esc="state.payload.coverage.operating_days"/><span t-esc="labels.completedDays"/></div>
                    <div><span class="o_baseer_sales_numeric fw-semibold" t-esc="state.payload.coverage.incomplete_days"/><span t-esc="labels.partialDays"/></div>
                    <div><span class="o_baseer_sales_numeric fw-semibold" t-esc="state.payload.coverage.closed_days"/><span t-esc="labels.closedDays"/></div>
                    <div><span class="o_baseer_sales_numeric fw-semibold" t-esc="state.payload.coverage.missing_days"/><span t-esc="labels.missingDays"/></div>
                </div>
                <div t-if="state.payload.issues.missing_customers or state.payload.issues.missing_complete_customers"
                     class="alert alert-warning o_baseer_sales_notice" role="status">
                    <i class="fa fa-info-circle me-1" aria-hidden="true"/>
                    <span t-esc="labels.customerWarning"/>
                </div>
                <div t-if="state.payload.customer_coverage and state.payload.customer_coverage.missing_rows"
                     class="alert alert-warning o_baseer_sales_notice" role="status">
                    <span t-esc="labels.knownCustomers"/>
                    <span class="ms-2" t-esc="labels.missingCustomerRows"/>:
                    <strong class="o_baseer_sales_numeric" t-esc="state.payload.customer_coverage.missing_rows"/>
                </div>

                <div class="o_baseer_sales_charts">
                    <article class="o_baseer_sales_chart_card">
                        <header><h2 t-esc="labels.chartTitle"/><span class="text-muted" t-esc="granularityLabel"/></header>
                        <div t-if="hasRecordedData" class="o_baseer_sales_canvas"><canvas t-ref="salesChart" role="img" t-att-aria-label="combinedChartLabel"/></div>
                        <div t-else="" class="o_baseer_sales_preview" role="status">
                            <div class="o_baseer_sales_preview_legend text-muted">
                                <span><i class="o_baseer_sales_legend_bar" aria-hidden="true"/><span t-esc="salesAxisLabel"/></span>
                                <span><i class="o_baseer_sales_legend_line" aria-hidden="true"/><span t-esc="customersAxisLabel"/></span>
                            </div>
                            <p class="text-muted mb-0" t-esc="labels.emptyNote"/>
                        </div>
                    </article>
                </div>

                <div class="o_baseer_sales_performance_cards">
                    <article t-if="shiftRows.length" class="o_baseer_sales_performance_card">
                        <h2 t-esc="labels.shifts"/>
                        <p class="small text-muted" t-esc="labels.manualScope"/>
                        <div class="nav nav-tabs o_baseer_sales_tabs" role="tablist" t-att-aria-label="labels.shifts">
                            <button t-foreach="tabs" t-as="tab" t-key="tab.key" type="button" role="tab"
                                    class="nav-link" t-att-class="{'active': state.shiftTab === tab.key}"
                                    t-att-id="tabId('shift', tab.key)" t-att-data-view="tab.key"
                                    t-att-aria-controls="panelId('shift')" t-att-aria-selected="state.shiftTab === tab.key ? 'true' : 'false'"
                                    t-att-tabindex="state.shiftTab === tab.key ? 0 : -1"
                                    t-on-click="() => this.selectTab('shift', tab.key)"
                                    t-on-keydown="(event) => this.onTabKeydown(event, 'shift')"
                                    t-att-title="tab.label" t-att-aria-label="tab.label">
                                <i t-att-class="tab.key === 'chart' ? 'fa fa-area-chart' : 'oi oi-view-pivot'" aria-hidden="true"/>
                            </button>
                        </div>
                        <div role="tabpanel" t-att-id="panelId('shift')" t-att-aria-labelledby="tabId('shift', state.shiftTab)" class="o_baseer_sales_tabpanel">
                            <t t-if="state.shiftTab === 'chart'">
                                <div class="o_baseer_sales_shift_chart o_baseer_sales_metric_selector">
                                    <label class="form-label mb-0" t-att-for="shiftMetricId" t-esc="labels.metric"/>
                                    <select class="form-select form-select-sm" t-att-id="shiftMetricId" t-on-change="onShiftMetricChange">
                                        <option t-foreach="shiftMetrics" t-as="metric" t-key="metric.key" t-att-value="metric.key"
                                                t-att-selected="state.shiftMetric === metric.key" t-esc="metric.label"/>
                                    </select>
                                </div>
                                <div t-if="hasShiftMetric" class="o_baseer_sales_shift_canvas">
                                    <canvas t-ref="shiftChart" role="img" t-att-aria-label="labels.shifts + ' — ' + selectedShiftMetric.label"/>
                                </div>
                                <div t-else="" class="o_baseer_sales_shift_empty text-muted" role="status"><span t-esc="hasShiftData ? labels.shiftUnavailable : labels.shiftEmpty"/></div>
                            </t>
                            <t t-else="">
                        <table class="table table-sm o_baseer_sales_shift_table mb-0">
                            <caption class="visually-hidden" t-esc="labels.shifts"/>
                            <thead><tr>
                                <th scope="col" t-esc="labels.shift"/>
                                <th scope="col" t-esc="salesAxisLabel"/>
                                <th scope="col" t-esc="labels.customers"/>
                                <th scope="col" t-esc="labels.averageBill"/>
                            </tr></thead>
                            <tbody>
                                <tr t-foreach="shiftRows" t-as="row" t-key="row.key">
                                    <th scope="row">
                                        <button t-if="row.has_data and row.source_action" type="button" class="btn btn-link p-0"
                                                t-on-click="() => this.openShiftSources(row)" t-esc="row.label"/>
                                        <span t-else="" t-esc="row.label"/>
                                    </th>
                                    <td><span class="o_baseer_sales_numeric" t-esc="row.cards.sales.display"/></td>
                                    <td><span class="o_baseer_sales_numeric" t-esc="row.cards.customers.display"/></td>
                                    <td><span class="o_baseer_sales_numeric" t-esc="row.cards.average_bill.display"/></td>
                                </tr>
                            </tbody>
                        </table>
                            </t>
                        </div>
                    </article>
                    <article t-if="paymentCoverage" class="o_baseer_sales_performance_card">
                        <h2 t-esc="labels.payments"/>
                        <p class="small text-muted" t-esc="labels.paymentScope"/>
                        <div t-if="!paymentCoverage.complete" class="alert alert-warning o_baseer_sales_notice" role="status">
                            <span t-esc="labels.paymentIncomplete"/>
                        </div>
                        <div class="nav nav-tabs o_baseer_sales_tabs" role="tablist" t-att-aria-label="labels.payments">
                            <button t-foreach="tabs" t-as="tab" t-key="tab.key" type="button" role="tab"
                                    class="nav-link" t-att-class="{'active': state.paymentTab === tab.key}"
                                    t-att-id="tabId('payment', tab.key)" t-att-data-view="tab.key"
                                    t-att-aria-controls="panelId('payment')" t-att-aria-selected="state.paymentTab === tab.key ? 'true' : 'false'"
                                    t-att-tabindex="state.paymentTab === tab.key ? 0 : -1"
                                    t-on-click="() => this.selectTab('payment', tab.key)"
                                    t-on-keydown="(event) => this.onTabKeydown(event, 'payment')"
                                    t-att-title="tab.label" t-att-aria-label="tab.label">
                                <i t-att-class="tab.key === 'chart' ? 'fa fa-area-chart' : 'oi oi-view-pivot'" aria-hidden="true"/>
                            </button>
                        </div>
                        <div role="tabpanel" t-att-id="panelId('payment')" t-att-aria-labelledby="tabId('payment', state.paymentTab)" class="o_baseer_sales_tabpanel">
                            <t t-if="state.paymentTab === 'chart'">
                                <div t-if="paymentRows.length" class="o_baseer_sales_payment_canvas">
                                    <canvas t-ref="paymentChart" role="img" t-att-aria-label="labels.payments + ' — ' + salesAxisLabel"/>
                                </div>
                                <div t-else="" class="o_baseer_sales_shift_empty text-muted" role="status"><span t-esc="labels.paymentEmpty"/></div>
                            </t>
                            <t t-else="">
                            <table t-if="paymentRows.length" class="table table-sm o_baseer_sales_shift_table o_baseer_sales_payment_table mb-0">
                                <caption class="visually-hidden" t-esc="labels.payments"/>
                                <thead><tr>
                                    <th scope="col" t-esc="labels.paymentMethod"/>
                                    <th scope="col" t-esc="salesAxisLabel"/>
                                    <th scope="col" t-esc="labels.paymentShare"/>
                                </tr></thead>
                                <tbody>
                                    <tr t-foreach="paymentRows" t-as="row" t-key="row.category_id">
                                        <th scope="row">
                                            <button t-if="row.source_action" type="button" class="btn btn-link p-0"
                                                    t-on-click="() => this.openPaymentSources(row)" t-esc="row.name"/>
                                            <span t-else="" t-esc="row.name"/>
                                            <div t-if="row.source_actions" class="d-flex flex-wrap gap-2">
                                                <button t-foreach="row.source_actions" t-as="sourceAction" t-key="sourceAction.key"
                                                        type="button" class="btn btn-link btn-sm p-0"
                                                        t-on-click="() => this.openCategorySource(sourceAction)" t-esc="sourceAction.name"/>
                                            </div>
                                        </th>
                                        <td><span class="o_baseer_sales_numeric" t-esc="row.sales.display"/></td>
                                        <td><span class="o_baseer_sales_numeric" t-esc="row.share.available ? row.share.display : '—'"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            <p t-else="" class="text-muted" t-esc="labels.paymentEmpty"/>
                            <div class="o_baseer_sales_payment_coverage">
                                <div><span t-esc="labels.coveredSales"/><span class="o_baseer_sales_numeric" t-esc="paymentCoverage.covered_sales.display"/></div>
                                <div><span t-esc="labels.uncoveredSales"/><span class="o_baseer_sales_numeric" t-esc="paymentCoverage.uncovered_sales.display"/></div>
                                <div><span t-esc="labels.coveredSummaries"/><span class="o_baseer_sales_numeric"><t t-esc="paymentCoverage.covered_summary_count"/> / <t t-esc="paymentCoverage.summary_count"/></span></div>
                                <div t-if="applicationShare"><span t-esc="labels.applicationShare"/><span class="o_baseer_sales_numeric"><t t-esc="applicationShare.display"/><t t-if="applicationShare.available">%</t></span></div>
                                <div t-if="paymentCoverage.missing_summary_count"><span t-esc="labels.missingAllocations"/><span class="o_baseer_sales_numeric" t-esc="paymentCoverage.missing_summary_count"/></div>
                                <div t-if="paymentCoverage.mismatched_summary_count"><span t-esc="labels.mismatchedAllocations"/><span class="o_baseer_sales_numeric" t-esc="paymentCoverage.mismatched_summary_count"/></div>
                                <div t-if="paymentPerformance.invoice_tender_unknown"><span t-esc="labels.invoiceTenderUnknown"/><span class="o_baseer_sales_numeric" t-esc="paymentPerformance.invoice_tender_unknown.display"/></div>
                                <div t-if="paymentPerformance.settlement_difference"><span t-esc="labels.settlementDifference"/><span class="o_baseer_sales_numeric" t-esc="paymentPerformance.settlement_difference.display"/></div>
                                <div t-if="paymentPerformance.unclassified_sales"><span t-esc="labels.unclassifiedSales"/><span class="o_baseer_sales_numeric" t-esc="paymentPerformance.unclassified_sales.display"/></div>
                            </div>
                            </t>
                        </div>
                    </article>
                </div>


                <details class="o_baseer_sales_details">
                    <summary><span t-esc="labels.details"/><span class="text-muted" t-esc="granularityLabel"/></summary>
                    <div class="o_baseer_sales_detail_header text-muted" aria-hidden="true">
                        <span t-esc="labels.date"/><span t-esc="labels.sales"/><span t-esc="labels.customers"/><span t-esc="labels.status"/>
                    </div>
                    <ul class="list-unstyled mb-0">
                        <li t-foreach="points" t-as="point" t-key="point.key" class="o_baseer_sales_detail_row">
                            <time class="o_baseer_sales_numeric fw-semibold" t-esc="point.label"/>
                            <span><span class="visually-hidden" t-esc="labels.sales"/><span class="o_baseer_sales_mobile_label text-muted" aria-hidden="true" t-esc="labels.sales"/><span class="o_baseer_sales_numeric" t-esc="point.sales_display"/></span>
                            <span><span class="visually-hidden" t-esc="labels.customers"/><span class="o_baseer_sales_mobile_label text-muted" aria-hidden="true" t-esc="labels.customers"/><span class="o_baseer_sales_numeric" t-esc="point.customers_display"/>
                                <small t-if="point.customer_coverage and point.customer_coverage.missing_rows" class="badge text-bg-light ms-1"
                                       t-att-title="labels.missingCustomerRows"><span t-esc="labels.partial"/> · <span class="o_baseer_sales_numeric" t-esc="point.customer_coverage.missing_rows"/></small>
                            </span>
                            <span class="o_baseer_sales_status" t-att-data-status="point.status" t-esc="statusLabel(point.status)"/>
                        </li>
                    </ul>
                </details>
            </t>
            </div>
        </section>
    </t>
</templates>
