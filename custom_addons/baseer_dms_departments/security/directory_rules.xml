<odoo>
    <record id="managed_hr_directory_access" model="ir.rule">
        <field name="name">HR document folders: private employee access</field>
        <field name="model_id" ref="dms.model_dms_directory"/>
        <field name="domain_force">[('managed_hr_permission', '=', True)]</field>
    </record>
    <record id="managed_hr_file_directory_access" model="ir.rule">
        <field name="name">HR document files: private employee folder access</field>
        <field name="model_id" ref="dms.model_dms_file"/>
        <field name="domain_force">[('directory_id.managed_hr_permission', '=', True)]</field>
    </record>
</odoo>
