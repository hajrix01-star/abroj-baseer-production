<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="baseer_pos_print_bridge.SessionTicketOrderCustomer"
       t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('mobileOrderList')]//div[hasclass('order-name')]/div[hasclass('fw-bolder')]/t[@t-esc='order.getName()']" position="before">
            <t t-if="order.baseer_ticket_number and !order.table_id and order.partner_id?.name">
                <t t-esc="order.partner_id.name"/><span> · </span>
            </t>
        </xpath>
    </t>
    <t t-name="baseer_pos_print_bridge.SessionTicketTabs"
       t-inherit="point_of_sale.OrderTabs" t-inherit-mode="extension">
        <xpath expr="//ListContainer" position="attributes">
            <attribute name="items">this.sortedTicketTabs</attribute>
        </xpath>
        <xpath expr="//button[@t-esc='order.getName()']" position="attributes">
            <attribute name="t-esc">order.baseer_ticket_number and !order.table_id ? order.baseer_ticket_number : order.getName()</attribute>
        </xpath>
    </t>
    <t t-name="baseer_pos_print_bridge.SessionTicketReceiptHeader"
       t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <!-- Standard retail has no tracking slot. The two Baseer retail
             layouts already supply one before the date. -->
        <xpath expr="//div[@id='order-date']" position="before">
            <div t-if="order.baseer_ticket_label and !order.config.displayTrackingNumber and !order.config.displayBigTrackingNumber and (order.config.module_pos_restaurant or !['baseer_80', 'baseer_80_customer'].includes(order.config.baseer_receipt_layout_mode))">
                <span>Order number</span>
                <bdi dir="ltr" t-esc="order.baseer_ticket_label"/>
            </div>
        </xpath>
    </t>
</templates>
