<odoo>
    <record id="budget_company_rule" model="ir.rule"><field name="name">Budget lines: allowed companies</field><field name="model_id" ref="model_abroj_project_budget_line"/><field name="domain_force">[('company_id', 'in', company_ids + [False])]</field></record>
    <record id="budget_user_rule" model="ir.rule"><field name="name">Budget lines: project visibility</field><field name="model_id" ref="model_abroj_project_budget_line"/><field name="groups" eval="[(4, ref('project.group_project_user'))]"/><field name="domain_force">['|', ('project_id.privacy_visibility', 'in', ['employees', 'portal']), ('project_id.message_partner_ids', 'in', [user.partner_id.id])]</field></record>
    <record id="budget_manager_rule" model="ir.rule"><field name="name">Budget lines: manager access</field><field name="model_id" ref="model_abroj_project_budget_line"/><field name="groups" eval="[(4, ref('project.group_project_manager'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
<record id="rule_promissory_company" model="ir.rule"><field name="name">عزل شركات سند الأمر</field><field name="model_id" ref="model_abroj_promissory_note"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="promissory_user_rule" model="ir.rule"><field name="name">سندات المشاريع المتاحة</field><field name="model_id" ref="model_abroj_promissory_note"/><field name="groups" eval="[(4, ref('base.group_user'))]"/><field name="domain_force">['|', ('project_id.privacy_visibility', 'in', ['employees', 'portal']), ('project_id.message_partner_ids', 'in', [user.partner_id.id])]</field></record>
<record id="promissory_manager_rule" model="ir.rule"><field name="name">سندات مدير المشاريع</field><field name="model_id" ref="model_abroj_promissory_note"/><field name="groups" eval="[(4, ref('project.group_project_manager'))]"/><field name="domain_force">[(1, '=', 1)]</field></record></odoo>
