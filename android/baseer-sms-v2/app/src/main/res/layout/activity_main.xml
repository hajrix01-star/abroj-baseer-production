<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F7F9FC">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بصير SMS" android:textStyle="bold" android:textSize="28sp" android:textColor="#102A43"/>
        <TextView android:id="@+id/environment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="QA · تطبيق الجسر الآمن" android:textColor="#486581" android:textSize="14sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="#FFFFFF" android:orientation="vertical" android:padding="18dp">
            <TextView android:text="حالة الاتصال" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#486581" android:textSize="13sp"/>
            <TextView android:id="@+id/connection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="غير مربوط" android:textStyle="bold" android:textSize="21sp" android:textColor="#9B1C1C"/>
            <TextView android:id="@+id/heartbeat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="لا يوجد تأكيد حي من QA بعد" android:textColor="#627D98"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="#FFFFFF" android:orientation="vertical" android:padding="18dp">
            <TextView android:text="التسليم" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#486581" android:textSize="13sp"/>
            <TextView android:id="@+id/last_captured" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="لم يحفظ التطبيق أي رسالة بعد" android:textColor="#102A43" android:textSize="16sp"/>
            <TextView android:id="@+id/last_ack" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="لم تُؤكد أي رسالة بعد" android:textColor="#102A43" android:textSize="16sp"/>
            <TextView android:id="@+id/queue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="لا توجد رسائل معلقة" android:textColor="#627D98"/>
        </LinearLayout>
        <Button android:id="@+id/pair" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="مسح رمز ربط QA"/>
        <Button android:id="@+id/permission" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="تفعيل استقبال الرسائل"/>
        <Button android:id="@+id/import_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="استيراد رسائل سابقة"/>
        <TextView android:id="@+id/automatic_sync" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="المزامنة تلقائية في الخلفية عند عودة الاتصال" android:textColor="#627D98" android:textSize="13sp"/>
        <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="#9B1C1C" android:textSize="14sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="يعمل التطبيق في الخلفية بعد الربط. لا نعرض محتوى الرسائل أو نرسله قبل الربط الصريح." android:textColor="#627D98" android:textSize="13sp"/>
    </LinearLayout>
</ScrollView>
