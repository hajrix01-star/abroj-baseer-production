<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_direct_bill_custody_reversal_wizard_form" model="ir.ui.view">
        <field name="name">baseer.procurement.direct.bill.custody.reversal.wizard.form</field>
        <field name="model">baseer.procurement.direct.bill.custody.reversal.wizard</field>
        <field name="arch" type="xml">
            <form string="Reverse supplier bill custody payment">
                <p class="text-muted">The original payment remains in the history. The unpaid amount returns to the supplier bill.</p>
                <group>
                    <field name="settlement_id" readonly="1" options="{'no_open': True}" string="Supplier bill settlement"/>
                    <field name="reason" required="1" string="Reason"/>
                    <field name="reversal_date" required="1" string="Reversal date"/>
                </group>
                <footer>
                    <button name="action_reverse" type="object" string="Reverse payment" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_direct_bill_custody_wizard_form" model="ir.ui.view">
        <field name="name">baseer.procurement.direct.bill.custody.wizard.form</field>
        <field name="model">baseer.procurement.direct.bill.custody.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay supplier bill from petty cash">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="client_token" invisible="1"/>
                <p class="text-muted">This payment reduces the selected representative's petty cash balance.</p>
                <group>
                    <field name="bill_id" string="Supplier bill" required="1" options="{'no_create': True, 'no_open': True}"
                           domain="[('move_type', '=', 'in_invoice'), ('state', '=', 'posted'), ('company_id', '=', company_id), ('amount_residual', '&gt;', 0)]"/>
                    <field name="representative_id" string="Representative" required="1" options="{'no_create': True, 'no_open': True}"
                           domain="[('is_purchase_representative', '=', True), ('company_id', 'in', [False, company_id]), ('active', '=', True), ('is_company', '=', False), ('parent_id', '=', False)]"/>
                    <field name="available_amount" string="Available balance" readonly="1"/>
                    <field name="amount" string="Amount" required="1"/>
                    <field name="settlement_date" string="Settlement date" required="1"/>
                </group>
                <footer>
                    <button name="action_settle" type="object" string="Pay from petty cash" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_move_form_direct_bill_custody" model="ir.ui.view">
        <field name="name">account.move.form.direct.bill.custody</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="before">
                <field name="amount_residual" invisible="1"/>
                <button name="action_open_representative_custody_payment" type="object"
                        string="Pay from representative petty cash"
                        groups="baseer_procurement_requests.group_procurement_accountant"
                        invisible="move_type != 'in_invoice' or state != 'posted' or amount_residual &lt;= 0"/>
            </xpath>
        </field>
    </record>
</odoo>
