<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_baseer_substitution" model="ir.ui.view">
        <field name="name">pos.config.form.baseer.substitution</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="baseer_pos_print_bridge.view_pos_config_form_direct_print"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='baseer_direct_print_enabled']" position="after">
                <field name="baseer_substitution_enabled"/>
            </xpath>
        </field>
    </record>
</odoo>
