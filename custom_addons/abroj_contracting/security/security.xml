<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="group_extraction_agent" model="res.groups">
    <field name="name">وكيل الاستخراج</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="rule_party_company" model="ir.rule">
    <field name="name">عزل الشركات: party</field>
    <field name="model_id" ref="model_abroj_contracting_party"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_subcontractor_company" model="ir.rule">
    <field name="name">عزل الشركات: subcontractor</field>
    <field name="model_id" ref="model_abroj_contracting_subcontractor"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_voucher_company" model="ir.rule">
    <field name="name">عزل الشركات: voucher</field>
    <field name="model_id" ref="model_abroj_contracting_voucher"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_invoice_company" model="ir.rule">
    <field name="name">عزل الشركات: invoice</field>
    <field name="model_id" ref="model_abroj_contracting_invoice"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_cost_company" model="ir.rule">
    <field name="name">عزل الشركات: cost</field>
    <field name="model_id" ref="model_abroj_contracting_cost"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_inbox_company" model="ir.rule">
    <field name="name">عزل الشركات: inbox</field>
    <field name="model_id" ref="model_abroj_contracting_inbox"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_project_note_company" model="ir.rule">
    <field name="name">عزل الشركات: project note</field>
    <field name="model_id" ref="model_abroj_contracting_project_note"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_clause_line_company" model="ir.rule"><field name="name">عزل شركات بنود العقود</field><field name="model_id" ref="model_abroj_contract_clause_line"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_agent_draft_vendor_moves" model="ir.rule">
    <field name="name">Extraction agent: draft vendor bills</field>
    <field name="model_id" ref="account.model_account_move"/>
    <field name="groups" eval="[(4, ref('group_extraction_agent'))]"/>
    <field name="domain_force">[('move_type', 'in', ('in_invoice', 'in_refund')), ('state', '=', 'draft')]</field>
  </record>
  <record id="rule_agent_draft_vendor_move_lines" model="ir.rule">
    <field name="name">Extraction agent: draft vendor bill lines</field>
    <field name="model_id" ref="account.model_account_move_line"/>
    <field name="groups" eval="[(4, ref('group_extraction_agent'))]"/>
    <field name="domain_force">[('move_id.move_type', 'in', ('in_invoice', 'in_refund')), ('move_id.state', '=', 'draft')]</field>
  </record>
</odoo>
