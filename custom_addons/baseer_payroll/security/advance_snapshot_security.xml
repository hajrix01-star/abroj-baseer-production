<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_advance_snapshot_reader" model="res.groups">
        <field name="name">Advance Snapshot Reader</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_advance_snapshot_company_reader" model="ir.rule">
        <field name="name">Advance snapshot company mapping: allowed companies</field>
        <field name="model_id" ref="model_baseer_hr_loan_snapshot_company"/>
        <field name="groups" eval="[(4, ref('group_advance_snapshot_reader'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_advance_snapshot_employee_reader" model="ir.rule">
        <field name="name">Advance snapshot employees: allowed companies</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('group_advance_snapshot_reader'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
</odoo>
