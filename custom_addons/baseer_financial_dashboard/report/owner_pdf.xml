    <template id="dashboard_owner_pdf_portrait"><t t-call="baseer_operations_report.owner_pdf_body"/></template>
    <template id="dashboard_owner_pdf_landscape"><t t-call="baseer_operations_report.owner_pdf_body"/></template>
</odoo>
