<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_procurement_request_list" model="ir.ui.view">
        <field name="name">baseer.procurement.request.list</field>
        <field name="model">baseer.procurement.request</field>
        <field name="arch" type="xml">
            <list string="Procurement requests" default_order="request_date desc, id desc">
                <field name="name"/>
                <field name="request_date"/>
                <field name="warehouse_id"/>
                <field name="representative_partner_id"/>
                <field name="purchaser_id" optional="hide"/>
                <field name="requested_total"/>
                <field name="actual_total" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state in ('sent', 'received')" decoration-success="state == 'purchased'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_procurement_request_form" model="ir.ui.view">
        <field name="name">baseer.procurement.request.form</field>
        <field name="model">baseer.procurement.request</field>
        <field name="arch" type="xml">
            <form string="Procurement request">
                <header>
                    <button name="action_open_whatsapp" type="object" string="Open WhatsApp" class="btn-secondary" invisible="state != 'draft'" groups="baseer_procurement_requests.group_procurement_user"/>
                    <button name="action_mark_sent" type="object" string="Confirm sent" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel request" class="btn-secondary" invisible="state not in ('draft', 'sent')" groups="baseer_procurement_requests.group_procurement_user"/>
                    <button name="action_open_manager_receipt_catalog" type="object" string="Confirm manager receipt" class="oe_highlight" invisible="state != 'sent'" groups="baseer_procurement_requests.group_procurement_manager"/>
                    <button name="action_open_actual_catalog" type="object" string="Cashier purchase receipt" class="oe_highlight" invisible="state not in ('sent', 'received')" groups="baseer_procurement_requests.group_procurement_cashier"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,received,purchased"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_picking" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_id"><field name="picking_id" widget="statinfo" string="Receipt"/></button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="o_prc_draft_send_action" invisible="state != 'draft'">
                        <button name="action_mark_sent" type="object" string="تأكيد إرسال الطلب" class="btn btn-primary"/>
                    </div>
                    <group><group>
                        <field name="company_id" readonly="state != 'draft'"/>
                        <field name="warehouse_id" invisible="1"/>
                        <field name="representative_partner_id" readonly="state != 'draft'" context="{'force_company': company_id}"/>
                        <field name="purchaser_id" readonly="1" invisible="representative_partner_id"/>
                        <field name="requester_id" readonly="1"/>
                    </group><group>
                        <field name="request_date" readonly="state != 'draft'"/>
                        <field name="whatsapp_number" invisible="1"/>
                        <field name="whatsapp_sent_at" readonly="1" invisible="not whatsapp_sent_at"/>
                        <field name="manager_received_at" readonly="1" invisible="not manager_received_at"/>
                        <field name="actual_confirmed_at" readonly="1" invisible="not actual_confirmed_at"/>
                        <field name="cancellation_reason" readonly="state not in ('draft', 'sent')" invisible="state not in ('draft', 'sent', 'cancel')"/>
                    </group></group>
                    <notebook>
                        <page string="Materials">
                            <field name="line_ids" readonly="state in ('purchased', 'cancel')">
                                <list editable="bottom"><field name="option_id" readonly="parent.state != 'draft'"/><field name="requested_qty" readonly="parent.state != 'draft'"/><field name="requested_price" readonly="parent.state != 'draft'"/><field name="manager_received_qty" readonly="parent.state != 'sent'"/><field name="actual_qty" readonly="parent.state != 'received'" groups="baseer_procurement_requests.group_procurement_cashier"/><field name="actual_price" readonly="parent.state != 'received'" groups="baseer_procurement_requests.group_procurement_cashier"/></list>
                            </field>
                            <group class="oe_subtotal_footer oe_right"><field name="requested_total" readonly="1"/><field name="actual_total" readonly="1"/></group>
                        </page>
                        <page string="WhatsApp" invisible="not whatsapp_text"><field name="whatsapp_text" readonly="1" nolabel="1"/></page>
                        <page string="Audit"><group><field name="picking_id" readonly="1"/><field name="actual_confirmed_by_id" readonly="1"/></group></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_procurement_request_search" model="ir.ui.view">
        <field name="name">baseer.procurement.request.search</field><field name="model">baseer.procurement.request</field>
        <field name="arch" type="xml"><search string="Procurement requests"><field name="name"/><field name="warehouse_id"/><field name="representative_partner_id"/><field name="purchaser_id"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="waiting" string="Waiting for cashier" domain="[('state','=','received')]"/><filter name="purchased" string="Quantity receipts" domain="[('state','=','purchased')]"/><group><filter name="group_warehouse" string="Warehouse" context="{'group_by':'warehouse_id'}"/><filter name="group_representative" string="Purchase representative" context="{'group_by':'representative_partner_id'}"/><filter name="group_state" string="State" context="{'group_by':'state'}"/></group></search></field>
    </record>
    <record id="view_procurement_request_line_report_list" model="ir.ui.view">
        <field name="name">baseer.procurement.request.line.report.list</field>
        <field name="model">baseer.procurement.request.line</field>
        <field name="arch" type="xml">
            <list string="Requested versus received materials" default_order="request_id desc, id desc" create="0" edit="0" delete="0">
                <field name="request_id"/>
                <field name="option_id"/>
                <field name="requested_qty" sum="Requested"/>
                <field name="manager_received_qty" sum="Manager receipt"/>
                <field name="manager_shortage_qty" sum="Not received"/>
                <field name="actual_qty" sum="Cashier confirmed"/>
                <field name="cashier_shortage_qty" sum="Not confirmed"/>
                <field name="warehouse_id" optional="hide"/>
                <field name="representative_partner_id" optional="hide"/>
                <field name="purchaser_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_procurement_request_line_report_pivot" model="ir.ui.view">
        <field name="name">baseer.procurement.request.line.report.pivot</field>
        <field name="model">baseer.procurement.request.line</field>
        <field name="arch" type="xml">
            <pivot string="Requested versus received materials">
                <field name="option_id" type="row"/>
                <field name="requested_qty" type="measure"/>
                <field name="manager_received_qty" type="measure"/>
                <field name="manager_shortage_qty" type="measure"/>
                <field name="actual_qty" type="measure"/>
                <field name="cashier_shortage_qty" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_procurement_request_line_search" model="ir.ui.view">
        <field name="name">baseer.procurement.request.line.report.search</field>
        <field name="model">baseer.procurement.request.line</field>
        <field name="arch" type="xml">
            <search string="Requested versus received materials">
                <field name="request_id"/><field name="option_id"/><field name="warehouse_id"/><field name="representative_partner_id"/><field name="purchaser_id"/>
                <filter name="not_received" string="Not received in full" domain="[('manager_shortage_qty', '&gt;', 0)]"/>
                <filter name="not_confirmed" string="Not confirmed in full" domain="[('cashier_shortage_qty', '&gt;', 0)]"/>
                <group><filter name="group_material" string="Material / size" context="{'group_by': 'option_id'}"/><filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/><filter name="group_purchaser" string="Purchaser" context="{'group_by': 'purchaser_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_procurement_request_line_report" model="ir.actions.act_window">
        <field name="name">Requested versus received</field><field name="res_model">baseer.procurement.request.line</field><field name="view_mode">list,pivot,graph</field><field name="search_view_id" ref="view_procurement_request_line_search"/>
    </record>
    <record id="action_procurement_request" model="ir.actions.act_window">
        <field name="name">Procurement requests</field><field name="res_model">baseer.procurement.request</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_procurement_request_search"/>
    </record>

    <record id="view_partner_form_purchase_representative" model="ir.ui.view">
        <field name="name">res.partner.form.purchase.representative</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//field[@name='category_id']" position="after">
                <field name="is_purchase_representative"
                       string="مندوب مشتريات"
                       groups="baseer_procurement_requests.group_procurement_manager"
                       invisible="is_company or parent_id"
                       help="يظهر هذا الشخص في قائمة مندوبي المشتريات للشركة النشطة."/>
            </xpath>
        </field>
    </record>
</odoo>
