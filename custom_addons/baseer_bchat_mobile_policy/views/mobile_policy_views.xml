<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_mobile_policy" model="ir.ui.view">
        <field name="name">res.users.form.bchat.mobile.policy</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="baseer_bchat.view_users_form_bchat_capabilities"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='bchat_capabilities']" position="inside">
                <field name="bchat_mobile_admin" groups="base.group_system"/>
            </xpath>
        </field>
    </record>
    <record id="view_company_mobile_policy" model="ir.ui.view">
        <field name="name">res.company.form.bchat.mobile.policy</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="BChat mobile application" groups="base.group_system">
                    <field name="bchat_mobile_direct_enabled"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
