#: code:addons/baseer_dms_bill_link/models/dms_file.py:0
msgid "The original bill belongs to another company."
msgstr "الفاتورة الأصلية تابعة لشركة أخرى."

#. module: baseer_dms_bill_link
#: code:addons/baseer_dms_bill_link/models/dms_file.py:0
