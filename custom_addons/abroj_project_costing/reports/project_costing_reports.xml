<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_abroj_receipt_voucher" model="report.paperformat">
        <field name="name">أبرج - سند استلام A4</field><field name="default" eval="False"/><field name="format">A4</field><field name="orientation">Portrait</field><field name="margin_top">12</field><field name="margin_bottom">12</field><field name="margin_left">10</field><field name="margin_right">10</field><field name="header_line" eval="False"/><field name="header_spacing">8</field><field name="dpi">90</field>
    </record>

    <record id="action_report_project_costing" model="ir.actions.report">
        <field name="name">تقرير المشروع</field><field name="model">abroj.cost.project</field><field name="report_type">qweb-pdf</field><field name="report_name">abroj_project_costing.report_project_costing</field><field name="report_file">abroj_project_costing.report_project_costing</field><field name="binding_model_id" ref="model_abroj_cost_project"/><field name="binding_type">report</field>
    </record>
    <record id="action_report_receipt_voucher" model="ir.actions.report">
        <field name="name">سند استلام</field><field name="model">abroj.cost.receipt</field><field name="report_type">qweb-pdf</field><field name="report_name">abroj_project_costing.report_receipt_voucher</field><field name="report_file">abroj_project_costing.report_receipt_voucher</field><field name="binding_model_id" ref="model_abroj_cost_receipt"/><field name="binding_type">report</field><field name="print_report_name">'%s - %s' % (object.name.replace('/', '-'), object.project_id.name)</field><field name="paperformat_id" ref="paperformat_abroj_receipt_voucher"/>
    </record>

    <record id="action_report_actual_cost_voucher" model="ir.actions.report">
        <field name="name">سند صرف</field><field name="model">abroj.cost.actual.line</field><field name="report_type">qweb-pdf</field><field name="report_name">abroj_project_costing.report_actual_cost_voucher</field><field name="report_file">abroj_project_costing.report_actual_cost_voucher</field><field name="binding_model_id" ref="model_abroj_cost_actual_line"/><field name="binding_type">report</field>
    </record>

    <template id="report_project_costing"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.external_layout"><div class="page" dir="rtl"><style>.abroj-report{font-family:'DejaVu Sans',Arial,sans-serif;direction:rtl;color:#26343d;font-size:11px}.abroj-report h1{color:#80506f;margin-bottom:10px;font-size:23px;font-weight:700}.abroj-report h2{color:#80506f;font-size:15px;margin:22px 0 8px;font-weight:700}.abroj-report table{width:100%;border-collapse:collapse;margin-top:12px}.abroj-report th{background:#f6eef2;color:#58646c;font-weight:700}.abroj-report th,.abroj-report td{border:1px solid #d9dfe2;padding:7px;text-align:right}.abroj-report .summary{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.abroj-report .summary div{border:1px solid #ded7dc;border-top:3px solid #80506f;padding:9px;background:#fcfafb;line-height:1.7}.abroj-report .muted{color:#777}</style><main class="abroj-report"><h1>تقرير تكاليف المشروع</h1><p><strong>المشروع:</strong> <span t-field="doc.name"/> — <strong>الحالة:</strong> <span t-field="doc.state"/></p><p><strong>قيمة الاتفاقية:</strong> <span t-field="doc.agreement_amount"/> — <strong>مدة الاتفاقية:</strong> <span t-field="doc.agreement_start_date"/> إلى <span t-field="doc.agreement_end_date"/></p><div class="summary"><div>المتوقع<br/><strong t-field="doc.estimated_total"/></div><div>الفعلي<br/><strong t-field="doc.actual_total"/></div><div>الانحراف<br/><strong t-field="doc.variance_amount"/></div><div>المستلم<br/><strong t-field="doc.received_total"/></div><div>المتبقي<br/><strong t-field="doc.receivable_remaining"/></div><div>نسبة الإنجاز<br/><strong><span t-field="doc.progress"/>%</strong></div></div><h2>دراسة المشروع</h2><table><thead><tr><th>الفئة</th><th>البند</th><th>الكمية</th><th>طريقة التسعير</th><th>المتوقع</th><th>الفعلي</th><th>الانحراف</th></tr></thead><tbody><tr t-foreach="doc.plan_line_ids" t-as="line"><td><span t-field="line.category_id"/></td><td><span t-field="line.name"/></td><td><span t-field="line.quantity"/></td><td><span t-field="line.pricing_method"/></td><td><span t-field="line.estimated_total"/></td><td><span t-field="line.actual_total"/></td><td><span t-field="line.variance_amount"/></td></tr></tbody></table><h2>التكاليف الفعلية</h2><table><thead><tr><th>التاريخ</th><th>البند</th><th>النوع</th><th>المبلغ</th><th>المورد / المستفيد</th></tr></thead><tbody><tr t-foreach="doc.actual_line_ids" t-as="line"><td><span t-field="line.date"/></td><td><span t-field="line.name"/></td><td><span t-field="line.cost_type"/></td><td><span t-field="line.amount"/></td><td><span t-field="line.supplier_id"/><span t-if="not line.supplier_id" t-field="line.supplier_text"/></td></tr></tbody></table></main></div></t></t></t></template>
    <template id="report_receipt_voucher"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="lang" t-value="o.env.context.get('lang') or o.partner_id.lang or o.company_id.partner_id.lang"/><t t-call="account.report_payment_receipt_document" t-lang="lang"/></t></t></template>
    <template id="report_receipt_voucher_legacy" active="False"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-set="company" t-value="doc.company_id"/><t t-set="layout_document_title" t-value="False"/><t t-call="web.external_layout"><div class="page abroj-receipt-page" dir="rtl"><style>
        div[name='address'],div[name='information_block']{display:none!important}.abroj-receipt-page{font-family:'DejaVu Sans',Arial,sans-serif;direction:rtl;color:#26343d;font-size:12px;line-height:1.7}.abroj-receipt-page *{box-sizing:border-box}.abroj-receipt-header{border:1px solid #ded7dc;border-top:6px solid #80506f;padding:16px 18px 14px;margin-bottom:18px;background:#fcfafb}.abroj-receipt-header table{width:100%;border-collapse:collapse}.abroj-receipt-logo{width:68px;max-height:54px;object-fit:contain}.abroj-receipt-company{font-size:11px;line-height:1.9;color:#5d6870}.abroj-receipt-company strong{color:#273944;font-size:15px;font-weight:700}.abroj-receipt-title{text-align:left}.abroj-receipt-title h1{margin:0 0 5px;color:#80506f;font-size:25px;font-weight:700}.abroj-receipt-title p{margin:0;color:#69757d}.abroj-receipt-number{display:inline-block;background:#80506f;color:#fff;padding:5px 10px;border-radius:2px;margin-top:8px;direction:ltr;font-family:'DejaVu Sans',Arial,sans-serif;font-weight:700;letter-spacing:.3px}.abroj-receipt-intro{border-right:4px solid #80506f;background:#f8f5f7;padding:13px 15px;margin:0 0 18px;line-height:2}.abroj-receipt-section{margin:18px 0 10px;color:#80506f;font-size:15px;font-weight:700}.abroj-receipt-table{width:100%;border-collapse:collapse;margin-bottom:16px}.abroj-receipt-table th,.abroj-receipt-table td{border:1px solid #d9dfe2;padding:10px;text-align:right;vertical-align:middle}.abroj-receipt-table th{width:22%;background:#f2eef1;color:#58646c;font-weight:700}.abroj-receipt-table td{width:28%;font-weight:600}.abroj-receipt-amount{background:#f8f5f7!important;color:#80506f!important;font-size:16px;font-weight:700}.abroj-receipt-note{border:1px solid #d9dfe2;min-height:54px;padding:10px;line-height:1.9}.abroj-receipt-signatures{width:100%;border-collapse:separate;border-spacing:12px 0;margin-top:42px}.abroj-receipt-signatures td{width:50%;border-top:1px solid #8c979d;text-align:center;padding-top:9px;color:#5d6870;font-weight:600}.abroj-receipt-footer{border-top:1px solid #d9dfe2;margin-top:25px;padding-top:9px;color:#7b858b;text-align:center;font-size:10px}</style>
        <style>
            .abroj-receipt-page{padding-top:94px!important}
            .abroj-receipt-table th,.abroj-receipt-table td,.abroj-receipt-table .abroj-receipt-amount{background:#fff!important}
        </style>
        <main>
            <!-- The company document layout is the single source of logo and company details. -->
            <style>
                .header .o_company_logo_small {max-height:64px!important;max-width:250px!important;width:auto!important}
                .abroj-receipt-header,.abroj-receipt-footer {display:none}
                .abroj-receipt-document-bar{display:table;width:100%;border:1px solid #ded7dc;border-right:5px solid #80506f;background:#fcfafb;padding:13px 16px;margin:0 0 18px}
                .abroj-receipt-document-bar .title{display:table-cell;text-align:right;color:#26343d;font-size:17px;font-weight:700;vertical-align:middle}
                .abroj-receipt-document-bar .number{display:table-cell;text-align:left;vertical-align:middle;color:#80506f;font-weight:700;font-size:14px;direction:ltr}
            </style>
            <section class="abroj-receipt-document-bar"><span class="title">دفعة مستلمة من العميل</span><span class="number" t-field="doc.name"/></section>
            <section class="abroj-receipt-header"><table><tr><td style="width:56%;text-align:right"><div class="abroj-receipt-company"><img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" class="abroj-receipt-logo"/><br/><strong t-field="doc.company_id.name"/><br/><span t-if="doc.company_id.street" t-field="doc.company_id.street"/><span t-if="doc.company_id.city">، <span t-field="doc.company_id.city"/></span><br/><span t-if="doc.company_id.vat">الرقم الضريبي: <span t-field="doc.company_id.vat"/></span></div></td><td class="abroj-receipt-title"><h1>سند استلام</h1><p>دفعة مستلمة من العميل</p><span class="abroj-receipt-number" t-field="doc.name"/></td></tr></table></section>
            <p class="abroj-receipt-intro">تم استلام الدفعة الموضحة أدناه لصالح المشروع. هذا السند للتوثيق الإداري ولا ينشئ أي قيد محاسبي تلقائي.</p>
            <p style="margin:-8px 0 16px;color:#80506f;font-weight:700">رقم السند: <span dir="ltr" t-esc="doc.name"/></p>
            <h2 class="abroj-receipt-section">بيانات الدفعة</h2>
            <table class="abroj-receipt-table"><tr><th>رقم السند</th><td><span t-field="doc.name"/></td><th>تاريخ الاستلام</th><td><span t-field="doc.date"/></td></tr><tr><th>اسم المشروع</th><td><span t-field="doc.project_id"/></td><th>العميل</th><td><span t-esc="doc.project_id.customer_name or doc.project_id.partner_id.name or '—'"/></td></tr><tr><th>قيمة هذه الدفعة</th><td colspan="3" class="abroj-receipt-amount"><span t-field="doc.amount"/></td></tr></table>
            <h2 class="abroj-receipt-section">ملخص الاتفاقية والدفعات</h2>
            <table class="abroj-receipt-table"><tr><th>قيمة الاتفاقية</th><td><span t-field="doc.project_id.agreement_amount"/></td><th>إجمالي الدفعات قبل هذا السند</th><td><span t-esc="doc.project_id.received_total - doc.amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr><tr><th>إجمالي دفعات العميل بعد السند</th><td><span t-field="doc.project_id.received_total"/></td><th>المتبقي من الاتفاقية</th><td><span t-field="doc.project_id.receivable_remaining"/></td></tr></table>
            <h2 class="abroj-receipt-section">ملاحظات</h2><div class="abroj-receipt-note"><span t-if="doc.note" t-field="doc.note"/><span t-if="not doc.note">لا توجد ملاحظات.</span></div>
            <table class="abroj-receipt-signatures"><tr><td>توقيع المستلم</td><td>اعتماد مسؤول المشروع</td></tr></table>
            <footer class="abroj-receipt-footer">تم إنشاء السند من أبرج | تكاليف المشاريع — يحتفظ المشروع بسجل الدفعات للمتابعة والمراجعة.</footer>
        </main></div></t></t></t></template>
    <template id="report_receipt_voucher_native_project_appendix" inherit_id="account.report_payment_receipt_document">
        <xpath expr="//table[@name='invoices']" position="after">
            <t t-if="o._name == 'abroj.cost.receipt'">
                <t t-set="project_summary" t-value="o._get_project_receipt_summary()"/>
                <div class="mt-4" dir="rtl">
                    <h4>ملخص المشروع والدفعات</h4>
                    <table class="table table-sm table-borderless">
                        <tbody>
                            <tr><th>المبلغ الإجمالي للاتفاقية</th><td><span t-field="o.project_id.agreement_amount"/></td><th>الدفعة المستلمة</th><td><span t-field="o.amount"/></td></tr>
                            <tr><th>إجمالي المبالغ المستلمة قبل</th><td><span t-out="project_summary['prior_amount']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td><th>المتبقي بعد هذه الدفعة</th><td><span t-out="project_summary['remaining_after']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                        </tbody>
                    </table>
                    <h4>الإيصالات السابقة</h4>
                    <table class="table table-sm" t-if="project_summary['prior_receipts']">
                        <thead><tr><th>رقم السند</th><th>التاريخ</th><th class="text-end">المبلغ</th></tr></thead>
                        <tbody><tr t-foreach="project_summary['prior_receipts']" t-as="previous"><td dir="ltr"><span t-field="previous.name"/></td><td><span t-field="previous.date"/></td><td class="text-end"><span t-field="previous.amount"/></td></tr></tbody>
                    </table>
                    <p class="text-muted" t-else="">لا توجد إيصالات سابقة لهذا المشروع.</p>
                </div>
            </t>
        </xpath>
    </template>
    <template id="report_actual_cost_voucher"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.external_layout"><div class="page abroj-payment-page" dir="rtl"><style>.abroj-payment-page{font-family:'DejaVu Sans',Arial,sans-serif;direction:rtl;color:#26343d;font-size:12px;line-height:1.7}.abroj-payment-page *{box-sizing:border-box}.abroj-payment-header{border:1px solid #ded7dc;border-top:6px solid #80506f;padding:16px 18px;margin-bottom:18px;background:#fcfafb}.abroj-payment-header table,.abroj-payment-table,.abroj-payment-signatures{width:100%;border-collapse:collapse}.abroj-payment-company{font-size:11px;line-height:1.9;color:#5d6870}.abroj-payment-company strong{font-size:15px;color:#273944}.abroj-payment-logo{width:68px;max-height:54px;object-fit:contain}.abroj-payment-title{text-align:left}.abroj-payment-title h1{margin:0;color:#80506f;font-size:25px;font-weight:700}.abroj-payment-title p{margin:4px 0 0;color:#69757d}.abroj-payment-section{margin:18px 0 10px;color:#80506f;font-size:15px;font-weight:700}.abroj-payment-table th,.abroj-payment-table td{border:1px solid #d9dfe2;padding:11px;text-align:right;vertical-align:middle}.abroj-payment-table th{width:25%;background:#f2eef1;color:#58646c;font-weight:700}.abroj-payment-amount{font-size:16px!important;color:#80506f!important;background:#f8f5f7!important;font-weight:700}.abroj-payment-note{border:1px solid #d9dfe2;padding:10px;min-height:54px}.abroj-payment-signatures{margin-top:42px}.abroj-payment-signatures td{width:50%;border-top:1px solid #8c979d;text-align:center;padding-top:9px;color:#5d6870;font-weight:600}</style><main><section class="abroj-payment-header"><table><tr><td style="width:56%;text-align:right"><div class="abroj-payment-company"><img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" class="abroj-payment-logo"/><br/><strong t-field="doc.company_id.name"/><br/><span t-if="doc.company_id.street" t-field="doc.company_id.street"/><span t-if="doc.company_id.city">، <span t-field="doc.company_id.city"/></span><br/><span t-if="doc.company_id.vat">الرقم الضريبي: <span t-field="doc.company_id.vat"/></span></div></td><td class="abroj-payment-title"><h1>سند صرف داخلي</h1><p>توثيق مبلغ مصروف على المشروع</p></td></tr></table></section><h2 class="abroj-payment-section">بيانات الصرف</h2><table class="abroj-payment-table"><tr><th>المشروع</th><td><span t-field="doc.project_id"/></td><th>تاريخ الصرف</th><td><span t-field="doc.date"/></td></tr><tr><th>البند</th><td><span t-field="doc.name"/></td><th>نوع التكلفة</th><td><span t-field="doc.cost_type"/></td></tr><tr><th>المستفيد</th><td colspan="3"><span t-field="doc.supplier_id"/><span t-if="not doc.supplier_id" t-field="doc.supplier_text"/></td></tr><tr><th>المبلغ المصروف</th><td colspan="3" class="abroj-payment-amount"><span t-field="doc.amount"/></td></tr></table><h2 class="abroj-payment-section">ملاحظات</h2><div class="abroj-payment-note"><span t-if="doc.notes" t-field="doc.notes"/><span t-if="not doc.notes">لا توجد ملاحظات.</span></div><table class="abroj-payment-signatures"><tr><td>توقيع المستلم</td><td>اعتماد مسؤول المشروع</td></tr></table></main></div></t></t></t></template>
    <!-- Use the same company-controlled Odoo document layout for the internal payment voucher. -->
    <template id="report_actual_cost_voucher_native_company_layout" inherit_id="abroj_project_costing.report_actual_cost_voucher">
        <xpath expr="//main/section[@class='abroj-payment-header']" position="before">
            <style>
                .header .o_company_logo_small {max-height:64px!important;max-width:250px!important;width:auto!important}
                .abroj-payment-header {display:none}
                .abroj-payment-document-bar{display:table;width:100%;border:1px solid #ded7dc;border-right:5px solid #80506f;background:#fcfafb;padding:13px 16px;margin:0 0 18px}
                .abroj-payment-document-bar .title{display:table-cell;text-align:right;color:#26343d;font-size:17px;font-weight:700}
                .abroj-payment-document-bar .subtitle{display:table-cell;text-align:left;color:#69757d;font-weight:600}
            </style>
            <section class="abroj-payment-document-bar"><span class="title">سند صرف داخلي</span><span class="subtitle">توثيق مبلغ مصروف على المشروع</span></section>
        </xpath>
    </template>
</odoo>
