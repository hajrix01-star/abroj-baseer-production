msgstr "يدير النظام مراجع السلف ونتائجها المالية."

#. module: baseer_access_roles
#. odoo-python
#: code:addons/baseer_access_roles/models/advance_entry.py:0
msgid "Switch to the company that owns this record."
msgstr "انتقل إلى الشركة المالكة لهذا السجل."

#. module: baseer_access_roles
#. odoo-python
#: code:addons/baseer_access_roles/models/advance_entry.py:0
