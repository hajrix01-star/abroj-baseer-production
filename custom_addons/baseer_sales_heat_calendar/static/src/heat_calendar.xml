<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="baseer_sales_heat_calendar.DashboardIntegration" t-inherit="spreadsheet_dashboard.DashboardAction" t-inherit-mode="extension" priority="30">
        <xpath expr="//DashboardSearchBar" position="attributes">
            <attribute name="t-if">!isBaseerSalesDashboard and !isBaseerHeatCalendar and status === Status.Loaded and loader.getActiveDashboard().model.getters.getGlobalFilters().length</attribute>
        </xpath>
        <xpath expr="//SpreadsheetShareButton" position="attributes">
            <attribute name="t-if">!isBaseerSalesDashboard and !isBaseerHeatCalendar</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_search_toggler')]" position="attributes">
            <attribute name="t-if">env.isSmall and !isBaseerSalesDashboard and !isBaseerHeatCalendar</attribute>
        </xpath>
        <xpath expr="//MobileFigureContainer" position="before">
            <BaseerHeatCalendar t-if="isBaseerHeatCalendar" dashboardId="dashboard.data.id" t-key="dashboard.data.id"/>
        </xpath>
        <xpath expr="//MobileFigureContainer" position="attributes">
            <attribute name="t-if">env.isSmall and !isBaseerSalesDashboard and !isBaseerHeatCalendar</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_renderer')]" position="attributes">
            <attribute name="t-else"/>
            <attribute name="t-if">!env.isSmall and !isBaseerSalesDashboard and !isBaseerHeatCalendar</attribute>
        </xpath>
    </t>

    <t t-name="baseer_sales_heat_calendar.HeatCalendar">
        <section class="o_baseer_heat_calendar" t-att-aria-busy="state.loading ? 'true' : 'false'">
            <header class="o_baseer_heat_header">
                <div>
                    <h1 t-esc="labels.title"/>
                    <p class="text-muted mb-0" t-esc="labels.subtitle"/>
                    <p t-if="state.payload" class="o_baseer_heat_scope text-muted mb-0">
                        <span t-esc="state.payload.company.name"/>
                        <span class="o_baseer_heat_numeric" t-esc="state.payload.month_label"/>
                    </p>
                </div>
                <div class="o_baseer_heat_actions">
                    <button t-if="state.payload and state.payload.can_manage_occasions" type="button" class="btn btn-secondary" t-on-click="manageOccasions">
                        <i class="fa fa-calendar me-1" aria-hidden="true"/><span t-esc="labels.manage"/>
                    </button>
                    <button t-if="state.payload and state.payload.can_manage_occasions" type="button" class="btn btn-secondary" t-on-click="manageTargets">
                        <i class="fa fa-bullseye me-1" aria-hidden="true"/><span t-esc="labels.targets"/>
                    </button>
                    <button t-if="state.payload and state.payload.can_manage_occasions" type="button" class="btn btn-outline-secondary" t-on-click="feedFixedHolidays" t-att-title="labels.feedHelp">
                        <i class="fa fa-download me-1" aria-hidden="true"/><span t-esc="labels.feed"/>
                    </button>
                    <button type="button" class="btn btn-light" t-on-click="() => this.load()" t-att-disabled="state.loading">
                        <i class="fa fa-refresh me-1" aria-hidden="true"/><span t-esc="labels.refresh"/>
                    </button>
                </div>
            </header>

            <div class="o_baseer_heat_month_switcher" role="group" t-att-aria-label="labels.title">
                <button type="button" class="btn btn-light" t-on-click="() => this.changeMonth(-1)" t-att-disabled="state.loading" t-att-title="labels.previous" t-att-aria-label="labels.previous"><i class="fa fa-chevron-left" aria-hidden="true"/></button>
                <strong class="o_baseer_heat_numeric" t-esc="state.payload ? state.payload.month_label : state.month"/>
                <button type="button" class="btn btn-light" t-on-click="() => this.changeMonth(1)" t-att-disabled="state.loading" t-att-title="labels.next" t-att-aria-label="labels.next"><i class="fa fa-chevron-right" aria-hidden="true"/></button>
            </div>

            <div t-if="state.loading and !state.payload" class="o_baseer_heat_state" role="status" aria-live="polite">
                <i class="fa fa-circle-o-notch fa-spin text-muted" aria-hidden="true"/><span t-esc="labels.loading"/>
            </div>
            <div t-elif="state.error" class="alert alert-danger" role="alert">
                <span t-esc="state.error"/>
                <button type="button" class="btn btn-outline-danger btn-sm ms-2" t-on-click="() => this.load()" t-esc="labels.retry"/>
            </div>
            <t t-elif="state.payload">
                <div class="o_baseer_heat_scroll" tabindex="0">
                    <div class="o_baseer_heat_grid" t-att-aria-label="labels.title">
                        <div class="o_baseer_heat_weekday" t-foreach="state.payload.weekdays" t-as="weekday" t-key="weekday.name">
                            <span class="o_baseer_heat_weekday_name" t-esc="weekday.name"/>
                            <span class="o_baseer_heat_weekday_average">
                                <span t-esc="state.payload.labels.weekday_average"/>
                                <strong t-if="weekday.has_average" class="o_baseer_heat_numeric" t-esc="weekday.average_display"/>
                                <span t-if="weekday.has_average" class="o_baseer_heat_weekday_currency" t-esc="state.payload.company.currency"/>
                                <strong t-else="" class="o_baseer_heat_numeric" t-esc="weekday.average_display"/>
                            </span>
                        </div>
                        <t t-foreach="state.payload.weeks" t-as="week" t-key="week_index">
                            <t t-foreach="week" t-as="day" t-key="day_index">
                                <div t-if="!day" class="o_baseer_heat_blank" aria-hidden="true"/>
                                <button t-else="" type="button" class="o_baseer_heat_day" t-attf-class="o_heat_{{day.heat_level}} o_status_{{day.status}}" t-on-click="(event) => this.openDay(day, event)" t-att-aria-label="day.aria_label">
                                    <span t-if="day.occasions.length" class="o_baseer_heat_day_occasion_badge" t-att-title="day.occasion_label">
                                        <i t-attf-class="fa {{day.occasions[0].occasion_type === 'official_holiday' ? 'fa-flag' : 'fa-calendar'}}" aria-hidden="true"/>
                                        <span class="o_baseer_heat_occasion_kind" t-esc="day.occasions[0].kind_label"/>
                                        <span t-esc="day.occasions[0].name"/>
                                        <span t-if="day.occasions.length &gt; 1" class="o_baseer_heat_occasion_count" t-esc="'+' + (day.occasions.length - 1)"/>
                                    </span>
                                    <span class="o_baseer_heat_day_number o_baseer_heat_numeric" t-esc="day.day"/>
                                    <span class="o_baseer_heat_sales"><span class="visually-hidden" t-esc="state.payload.labels.sales"/><span class="o_baseer_heat_numeric" t-esc="day.sales_display"/></span>
                                    <span class="o_baseer_heat_customers text-muted"><span class="visually-hidden" t-esc="state.payload.labels.customers"/><i class="fa fa-users me-1" aria-hidden="true"/><span class="o_baseer_heat_numeric" t-esc="day.customers_display"/></span>
                                    <span class="o_baseer_heat_status" t-esc="day.heat_label"/>
                                    <span t-if="day.partial_closure" class="badge text-bg-secondary" t-esc="day.partial_closure_label"/>
                                </button>
                            </t>
                        </t>
                    </div>
                </div>

                <HeatDayDetails t-if="state.selectedDay"
                    day="state.selectedDay"
                    currency="state.payload.company.currency"
                    labels="detailLabels"
                    openSources="(action) => this.openSources(action)"
                    close="() => this.closeDay()"
                    restoreFocus="() => this.restoreDayFocus()"/>

                <details class="o_baseer_heat_audit_table">
                    <summary t-esc="labels.details"/>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th scope="col">#</th><th scope="col" t-esc="state.payload.labels.sales"/><th scope="col" t-esc="state.payload.labels.customers"/><th scope="col" t-esc="labels.status"/><th scope="col" t-esc="labels.performance"/><th scope="col" t-esc="state.payload.labels.occasion"/></tr></thead>
                            <tbody>
                                <t t-foreach="state.payload.weeks" t-as="week" t-key="'audit_' + week_index">
                                    <tr t-foreach="week" t-as="day" t-key="day ? day.date : day_index" t-if="day">
                                        <th scope="row" class="o_baseer_heat_numeric" t-esc="day.date_display"/>
                                        <td class="o_baseer_heat_numeric" t-esc="day.sales_display"/>
                                        <td class="o_baseer_heat_numeric" t-esc="day.customers_display"/>
                                        <td t-esc="day.status_label"/>
                                        <td><span t-esc="day.heat_label"/> <span class="o_baseer_heat_numeric" t-esc="day.ratio_display"/></td>
                                        <td t-esc="day.occasion_label || labels.noOccasion"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </details>
            </t>
        </section>
    </t>

    <t t-name="baseer_sales_heat_calendar.HeatDayDetails">
        <div class="o_baseer_heat_modal_backdrop">
            <section t-ref="detailsPanel" class="o_baseer_heat_details_panel" role="dialog" aria-modal="true" aria-labelledby="o_baseer_heat_details_title">
                <header class="o_baseer_heat_details_header">
                    <h2 id="o_baseer_heat_details_title" t-esc="props.day.date_display"/>
                    <button t-ref="closeButton" class="btn btn-secondary" type="button" t-on-click="props.close" t-esc="props.labels.close"/>
                </header>
                <div class="o_baseer_heat_dialog">
                <dl>
                    <div><dt t-esc="props.labels.sales"/><dd class="o_baseer_heat_numeric"><span t-esc="props.day.sales_display"/> <span t-esc="props.currency"/></dd></div>
                    <div><dt t-esc="props.labels.customers"/><dd class="o_baseer_heat_numeric" t-esc="props.day.customers_display"/></div>
                    <div><dt t-esc="props.labels.status"/><dd><span t-esc="props.day.status_label"/><span t-if="props.day.partial_closure" class="badge text-bg-secondary ms-2" t-esc="props.day.partial_closure_label"/></dd></div>
                    <div><dt t-esc="props.labels.performance"/><dd><span t-esc="props.day.heat_label"/> <span class="o_baseer_heat_numeric" t-esc="props.day.ratio_display"/></dd></div>
                    <div><dt t-esc="basisLabel"/><dd class="o_baseer_heat_numeric" t-esc="props.day.basis_display"/></div>
                    <div><dt t-esc="props.labels.baseline_sample"/><dd class="o_baseer_heat_numeric" t-esc="props.day.baseline_sample_count"/></div>
                </dl>
                <p t-if="props.day.status !== 'complete'" class="alert alert-secondary mb-0" role="status" t-esc="props.labels.partial"/>
                <div t-if="props.day.occasions.length" class="mt-3">
                    <h3 t-esc="props.labels.occasion"/>
                    <ul class="list-unstyled mb-0">
                        <li t-foreach="props.day.occasions" t-as="occasion" t-key="occasion.code">
                            <strong t-esc="occasion.name"/><span class="badge text-bg-secondary ms-2" t-esc="occasion.kind_label"/><span class="badge text-bg-light ms-2" t-esc="occasion.status === 'estimated' ? props.labels.estimated : props.labels.confirmed"/>
                            <span class="text-muted ms-2" t-esc="occasion.source_label"/>
                            <a t-if="occasion.source_url" class="ms-2" t-att-href="occasion.source_url" target="_blank" rel="noopener noreferrer" t-esc="props.labels.source_link"/>
                        </li>
                    </ul>
                </div>
                <div t-if="props.day.shift_breakdown.length" class="mt-3">
                    <h3 t-esc="props.labels.approved_shifts"/>
                    <table class="table table-sm mb-0">
                        <thead><tr><th scope="col" t-esc="props.labels.shift"/><th scope="col" t-esc="props.labels.configuration"/><th scope="col" t-esc="props.labels.sales"/><th scope="col" t-esc="props.labels.customers"/></tr></thead>
                        <tbody><tr t-foreach="props.day.shift_breakdown" t-as="shift" t-key="shift.period + shift.configuration"><th scope="row" t-esc="shift.period"/><td t-esc="shift.configuration"/><td class="o_baseer_heat_numeric" t-esc="shift.sales_display"/><td class="o_baseer_heat_numeric" t-esc="shift.customers_display"/></tr></tbody>
                    </table>
                </div>
                </div>
                <footer class="o_baseer_heat_details_footer">
                    <button t-if="props.day.source_action" class="btn btn-primary" type="button" t-on-click="() => props.openSources(props.day.source_action)" t-esc="props.labels.source"/>
                    <button class="btn btn-secondary" type="button" t-on-click="props.close" t-esc="props.labels.close"/>
                </footer>
            </section>
        </div>
    </t>

    <t t-name="baseer_sales_heat_calendar.HeatTargetBatchDialog">
        <Dialog title="labels.title" size="'xl'" bodyClass="'p-0'">
            <form class="o_baseer_heat_target_batch" t-on-submit.prevent="save" t-att-aria-busy="state.loading or state.saving ? 'true' : 'false'">
                <header class="o_baseer_heat_target_batch_intro">
                    <p class="mb-0" t-esc="labels.scopeHelp"/>
                </header>

                <div class="o_baseer_heat_target_batch_content">
                    <div class="o_baseer_heat_target_batch_context">
                        <div class="o_baseer_heat_target_readonly">
                            <span t-esc="labels.company"/>
                            <strong t-esc="companyName"/>
                        </div>
                        <label class="o_baseer_heat_target_year">
                            <span t-esc="labels.year"/>
                            <select class="form-select form-select-sm o_baseer_heat_numeric" t-att-value="state.year" t-on-change="onYearChange" t-att-disabled="state.loading or state.saving">
                                <option t-foreach="yearOptions" t-as="year" t-key="year" t-att-value="year" t-att-selected="year === state.year ? true : undefined" t-esc="year"/>
                            </select>
                        </label>
                    </div>

                    <section class="o_baseer_heat_target_scope" t-att-aria-label="labels.months">
                        <div class="o_baseer_heat_target_scope_heading">
                            <strong t-esc="labels.months"/>
                            <div class="o_baseer_heat_target_scope_actions">
                                <button type="button" class="btn btn-link btn-sm" t-on-click="selectAllMonths" t-att-disabled="state.loading or state.saving" t-esc="labels.selectAll"/>
                                <button type="button" class="btn btn-link btn-sm" t-on-click="clearMonths" t-att-disabled="state.loading or state.saving" t-esc="labels.clear"/>
                            </div>
                        </div>
                        <div class="o_baseer_heat_target_chips" role="group" t-att-aria-label="labels.months">
                            <button t-foreach="state.months" t-as="month" t-key="month.value" type="button" class="btn btn-sm o_baseer_heat_target_chip" t-att-class="isMonthSelected(month.value) ? 'is-selected' : ''" t-att-aria-pressed="isMonthSelected(month.value) ? 'true' : 'false'" t-att-disabled="state.loading or state.saving" t-on-click="() => this.toggleMonth(month.value)" t-esc="month.label"/>
                        </div>
                    </section>

                    <section class="o_baseer_heat_target_scope" t-att-aria-label="labels.weekdays">
                        <div class="o_baseer_heat_target_scope_heading">
                            <strong t-esc="labels.weekdays"/>
                            <div class="o_baseer_heat_target_scope_actions">
                                <button type="button" class="btn btn-link btn-sm" t-on-click="selectAllWeekdays" t-att-disabled="state.loading or state.saving" t-esc="labels.selectAll"/>
                                <button type="button" class="btn btn-link btn-sm" t-on-click="clearWeekdays" t-att-disabled="state.loading or state.saving" t-esc="labels.clear"/>
                            </div>
                        </div>
                        <div class="o_baseer_heat_target_chips" role="group" t-att-aria-label="labels.weekdays">
                            <button t-foreach="state.weekdays" t-as="weekday" t-key="weekday.value" type="button" class="btn btn-sm o_baseer_heat_target_chip" t-att-class="isWeekdaySelected(weekday.value) ? 'is-selected' : ''" t-att-aria-pressed="isWeekdaySelected(weekday.value) ? 'true' : 'false'" t-att-disabled="state.loading or state.saving" t-on-click="() => this.toggleWeekday(weekday.value)" t-esc="weekday.label"/>
                        </div>
                    </section>

                    <div t-if="state.error" class="alert alert-danger o_baseer_heat_target_error" role="alert" t-esc="state.error"/>

                    <div t-if="state.loading" class="o_baseer_heat_target_loading" role="status" aria-live="polite">
                        <i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/><span t-esc="labels.loading"/>
                    </div>
                    <t t-else="">
                        <div class="o_baseer_heat_target_apply_bar">
                            <label class="o_baseer_heat_target_common">
                                <span t-esc="labels.commonAmount"/>
                                <input type="number" min="0" step="any" inputmode="decimal" dir="ltr" class="form-control form-control-sm o_baseer_heat_numeric" t-att-value="state.commonAmount" t-on-input="setCommonAmount" t-att-disabled="state.saving"/>
                            </label>
                            <button type="button" class="btn btn-outline-primary btn-sm" t-on-click="applyCommonAmount" t-att-disabled="state.saving or !selectedCellCount" t-esc="labels.applyCommon"/>
                            <div class="o_baseer_heat_target_selection_note" aria-live="polite">
                                <strong class="o_baseer_heat_numeric" t-esc="selectedCellCount"/>
                                <span t-esc="labels.selectedCells"/>
                                <span class="text-muted" t-esc="labels.untouched"/>
                                <span t-if="!hasActionableSelection" class="text-warning" t-esc="labels.noChanges"/>
                            </div>
                        </div>

                        <div t-if="visibleMonths.length and visibleWeekdays.length" class="o_baseer_heat_target_matrix_wrap d-none d-sm-block">
                            <table class="table table-sm o_baseer_heat_target_matrix mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col" t-esc="labels.months"/>
                                        <th t-foreach="visibleWeekdays" t-as="weekday" t-key="weekday.value" scope="col" t-esc="weekday.label"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="visibleMonths" t-as="month" t-key="month.value">
                                        <th scope="row" t-esc="month.label"/>
                                        <td t-foreach="visibleWeekdays" t-as="weekday" t-key="weekday.value">
                                            <t t-set="cell" t-value="cellFor(month.value, weekday.value)"/>
                                            <div class="o_baseer_heat_target_cell">
                                                <input type="number" min="0" step="any" inputmode="decimal" dir="ltr" class="form-control form-control-sm o_baseer_heat_numeric" t-att-value="cell.amount" t-on-input="(event) => this.setCellAmount(month.value, weekday.value, event)" t-att-disabled="state.saving" t-att-aria-label="month.label + ' ' + weekday.label + ' ' + labels.target"/>
                                                <label class="form-check form-switch o_baseer_heat_target_active">
                                                    <input type="checkbox" class="form-check-input" t-att-checked="cell.active" t-on-change="(event) => this.setCellActive(month.value, weekday.value, event)" t-att-disabled="state.saving"/>
                                                    <span class="form-check-label" t-esc="labels.active"/>
                                                </label>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div t-if="visibleMonths.length and visibleWeekdays.length" class="o_baseer_heat_target_mobile_cards d-sm-none">
                            <article t-foreach="visibleMonths" t-as="month" t-key="month.value" class="o_baseer_heat_target_month_card">
                                <h3 t-esc="month.label"/>
                                <div t-foreach="visibleWeekdays" t-as="weekday" t-key="weekday.value" class="o_baseer_heat_target_mobile_cell">
                                    <t t-set="cell" t-value="cellFor(month.value, weekday.value)"/>
                                    <strong t-esc="weekday.label"/>
                                    <label>
                                        <span class="visually-hidden" t-esc="labels.target"/>
                                        <input type="number" min="0" step="any" inputmode="decimal" dir="ltr" class="form-control form-control-sm o_baseer_heat_numeric" t-att-value="cell.amount" t-on-input="(event) => this.setCellAmount(month.value, weekday.value, event)" t-att-disabled="state.saving" t-att-aria-label="month.label + ' ' + weekday.label + ' ' + labels.target"/>
                                    </label>
                                    <label class="form-check form-switch o_baseer_heat_target_active">
                                        <input type="checkbox" class="form-check-input" t-att-checked="cell.active" t-on-change="(event) => this.setCellActive(month.value, weekday.value, event)" t-att-disabled="state.saving"/>
                                        <span class="form-check-label" t-esc="labels.active"/>
                                    </label>
                                </div>
                            </article>
                        </div>

                        <div t-if="!visibleMonths.length or !visibleWeekdays.length" class="o_baseer_heat_target_empty text-muted" role="status" t-esc="labels.noSelection"/>
                    </t>
                </div>
            </form>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary" t-on-click="save" t-att-disabled="state.loading or state.saving or !selectedCellCount or !hasActionableSelection">
                    <i t-if="state.saving" class="fa fa-circle-o-notch fa-spin me-1" aria-hidden="true"/>
                    <span t-esc="state.saving ? labels.saving : labels.save"/>
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="props.close" t-att-disabled="state.saving" t-esc="labels.cancel"/>
            </t>
        </Dialog>
    </t>
</templates>
