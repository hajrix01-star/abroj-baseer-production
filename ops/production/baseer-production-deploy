SELECT jsonb_build_object(
 'attachments', (SELECT jsonb_build_object('n', count(*), 'hash', md5(coalesce(string_agg(jsonb_build_object(
                     'id', a.id, 'name', a.name, 'res_model', a.res_model, 'res_id', a.res_id,
                     'res_field', a.res_field, 'company_id', a.company_id, 'checksum', a.checksum,
