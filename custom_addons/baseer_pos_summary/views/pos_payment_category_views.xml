<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_search_category" model="ir.ui.view">
        <field name="name">pos.payment.search.category</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_by_payment_method']" position="after">
                <filter name="baseer_payment_category" string="Payment Category" context="{'group_by': 'baseer_payment_category_id'}"/>
            </xpath>
            <xpath expr="//search/field[last()]" position="after">
                <field name="payment_date"/>
                <filter name="baseer_payment_date" string="Payment Date" date="payment_date"/>
            </xpath>
        </field>
    </record>
    <record id="view_pos_payment_category_pivot" model="ir.ui.view">
        <field name="name">pos.payment.category.pivot</field>
        <field name="model">pos.payment</field>
        <field name="arch" type="xml">
            <pivot string="Settlement by Category">
                <field name="baseer_payment_category_id" type="row"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_pos_payment_category_graph" model="ir.ui.view">
        <field name="name">pos.payment.category.graph</field>
        <field name="model">pos.payment</field>
        <field name="arch" type="xml">
            <graph string="Settlement by Category" type="bar">
                <field name="baseer_payment_category_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_pos_payment_category" model="ir.actions.act_window">
        <field name="name">Settlement by Category</field>
        <field name="res_model">pos.payment</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="point_of_sale.view_pos_payment_search"/>
        <field name="domain">[('pos_order_id.state', 'in', ['paid', 'done'])]</field>
        <field name="context">{'baseer_payment_category_report': True, 'search_default_baseer_payment_category': 1, 'create': False, 'edit': False, 'delete': False}</field>
    </record>
    <record id="action_pos_payment_category_pivot" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_pos_payment_category_pivot"/>
        <field name="act_window_id" ref="action_pos_payment_category"/>
    </record>
    <record id="action_pos_payment_category_graph" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_pos_payment_category_graph"/>
        <field name="act_window_id" ref="action_pos_payment_category"/>
    </record>
    <record id="action_pos_payment_category_list" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="act_window_id" ref="action_pos_payment_category"/>
    </record>
    <record id="action_pos_payment_category_form" model="ir.actions.act_window.view">
        <field name="sequence">4</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="act_window_id" ref="action_pos_payment_category"/>
    </record>
    <menuitem id="menu_pos_payment_category" name="Settlement by Category" parent="point_of_sale.menu_point_rep" action="action_pos_payment_category" sequence="5" groups="point_of_sale.group_pos_user"/>
</odoo>
