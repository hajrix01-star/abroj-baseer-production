<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="baseer_report_engine_tobacco.Report" t-inherit="baseer_report_engine.Report" t-inherit-mode="extension">
    <xpath expr="//Dropdown[@t-if='!isLedger &amp;&amp; !isCashFlow']" position="attributes"><attribute name="t-if">!isLedger &amp;&amp; !isCashFlow &amp;&amp; !isTobacco</attribute></xpath>
    <xpath expr="//Dropdown[@t-if='!isPartnerLedger'][1]" position="attributes"><attribute name="t-if">!isPartnerLedger &amp;&amp; !isTobacco</attribute></xpath>
    <xpath expr="//Dropdown[@t-if='state.analyticEnabled &amp;&amp; !isPartnerLedger &amp;&amp; !isCashFlow']" position="attributes"><attribute name="t-if">state.analyticEnabled &amp;&amp; !isPartnerLedger &amp;&amp; !isCashFlow &amp;&amp; !isTobacco</attribute></xpath>
    <xpath expr="//label[input[@disabled='disabled']]" position="before"><label t-if="isTobacco"><input type="checkbox" t-att-checked="state.options.show_products" t-on-change="(event) => state.options.show_products = event.target.checked"/> <t t-esc="tobaccoLabels.show"/></label></xpath>
    <xpath expr="//t[@t-if='isLedger || isCashFlow']" position="attributes"><attribute name="t-if">isLedger || isCashFlow || isTobacco</attribute></xpath>
    <xpath expr="//table[@t-if='isAged']" position="before">
        <t t-if="isTobacco" t-foreach="state.payload.tobacco_sections || []" t-as="section" t-key="section.company_id + '-' + section.account_id">
            <h4 class="mt-3"><t t-esc="section.company"/> — <t t-esc="section.account"/></h4>
            <div class="o_bre_tobacco_summary"><div><span t-esc="tobaccoLabels.opening"/><strong class="is-number" t-esc="tobaccoMoney(section.opening)"/></div><div><span t-esc="tobaccoLabels.debit"/><strong class="is-number" t-esc="tobaccoMoney(section.debit)"/></div><div><span t-esc="tobaccoLabels.credit"/><strong class="is-number" t-esc="tobaccoMoney(section.credit)"/></div><div><span t-esc="tobaccoLabels.netPeriod"/><strong class="is-number" t-esc="tobaccoMoney(section.net)"/></div></div>
            <table class="o_bre_table o_bre_grid_table o_bre_ledger_table o_bre_tobacco_table">
                <colgroup><col class="tob-date"/><col class="tob-document"/><col t-if="state.options.show_products" class="tob-product"/><col class="tob-type"/><col span="4" class="tob-amount"/></colgroup>
                <thead><tr class="o_bre_balance_header"><th t-esc="tobaccoLabels.date"/><th t-esc="tobaccoLabels.document"/><th t-if="state.options.show_products" t-esc="tobaccoLabels.product"/><th t-esc="tobaccoLabels.type"/><th t-esc="tobaccoLabels.debit"/><th t-esc="tobaccoLabels.credit"/><th t-esc="tobaccoLabels.net"/><th t-esc="tobaccoLabels.cumulative"/></tr></thead>
                <tbody>
                    <tr class="o_bre_section"><th t-esc="tobaccoLabels.opening"/><td t-att-colspan="state.options.show_products ? 6 : 5"/><td class="is-number" t-esc="tobaccoMoney(section.opening)"/></tr>
                    <t t-foreach="section.days" t-as="day" t-key="day.date">
                        <t t-set="key" t-value="tobaccoKey(section, day)"/>
                        <tr class="o_bre_foldable"><th><button class="o_bre_fold" t-on-click="() => this.tobaccoToggle(section, day)"><span t-esc="state.folded[key] ? '▾' : (rtl ? '◂' : '▸')"/> <bdi t-esc="day.date"/></button></th><td t-att-colspan="state.options.show_products ? 3 : 2"/><td class="is-number" t-esc="tobaccoMoney(day.debit)"/><td class="is-number" t-esc="tobaccoMoney(day.credit)"/><td class="is-number" t-esc="tobaccoMoney(day.net)"/><td class="is-number" t-esc="tobaccoMoney(day.cumulative)"/></tr>
                        <t t-if="state.folded[key]"><tr t-foreach="state.accounts[key]?.rows || []" t-as="item" t-key="item_index" class="o_bre_ledger_item"><td><bdi t-esc="item.date"/></td><td><button class="o_bre_amount" t-on-click="() => this.tobaccoOpen(item.model, item.id)" t-esc="item.name"/></td><td t-if="state.options.show_products" class="tob-product-cell"><t t-esc="item.product"/><t t-if="item.product" t-esc="' × ' + tobaccoQuantity(item.quantity)"/></td><td t-esc="item.type"/><td class="is-number" t-esc="tobaccoMoney(item.debit)"/><td class="is-number" t-esc="tobaccoMoney(item.credit)"/><td class="is-number" t-esc="tobaccoMoney(item.net)"/><td class="is-number" t-esc="tobaccoMoney(item.cumulative)"/></tr><tr t-if="state.accounts[key]?.has_more" class="o_bre_ledger_more"><td t-att-colspan="state.options.show_products ? 8 : 7"><button class="btn btn-link" t-on-click="() => this.tobaccoPage(section, day, state.accounts[key].next_offset)" t-esc="state.labels.load_more"/></td></tr></t>
                    </t>
                    <tr class="o_bre_band"><th t-esc="tobaccoLabels.total"/><td t-att-colspan="state.options.show_products ? 3 : 2"/><td class="is-number" t-esc="tobaccoMoney(section.debit)"/><td class="is-number" t-esc="tobaccoMoney(section.credit)"/><td class="is-number" t-esc="tobaccoMoney(section.net)"/><td/></tr>
                    <tr class="o_bre_total"><th t-esc="tobaccoLabels.closing"/><td t-att-colspan="state.options.show_products ? 6 : 5"/><td class="is-number" t-esc="tobaccoMoney(section.closing)"/></tr>
                </tbody>
            </table>
            <div class="alert alert-info mt-3"><strong t-esc="tobaccoLabels.reconciliation"/><div><t t-esc="tobaccoLabels.register"/>: <span class="is-number o_bre_tobacco_amount" t-esc="tobaccoMoney(section.net)"/></div><div><t t-esc="tobaccoLabels.movement"/>: <button class="o_bre_amount o_bre_tobacco_amount" dir="ltr" t-on-click="() => this.tobaccoLedger(section)" t-esc="tobaccoMoney(section.movement)"/></div><div><t t-esc="tobaccoLabels.difference"/>: <span class="is-number o_bre_tobacco_amount" t-esc="tobaccoMoney(section.difference)"/></div><div t-if="section.open_sessions.length"><t t-esc="tobaccoLabels.sessions"/>: <t t-foreach="section.open_sessions" t-as="id" t-key="id"><button class="o_bre_amount mx-1" t-on-click="() => this.tobaccoOpen('pos.session', id)" t-esc="id"/></t></div><div t-if="section.manual_move_ids.length"><t t-esc="tobaccoLabels.manual"/>: <t t-foreach="section.manual_move_ids" t-as="id" t-key="id"><button class="o_bre_amount mx-1" t-on-click="() => this.tobaccoOpen('account.move', id)" t-esc="id"/></t></div><div><t t-esc="tobaccoLabels.exceptions"/>: <t t-esc="section.exceptions.length"/></div></div>
            <table t-if="section.exceptions.length" class="o_bre_table o_bre_grid_table"><thead><tr><th t-esc="tobaccoLabels.exceptions"/><th t-esc="tobaccoLabels.computed"/><th t-esc="tobaccoLabels.saved"/></tr></thead><tbody><tr t-foreach="section.exceptions" t-as="exception" t-key="exception.id"><td><button class="o_bre_amount" t-on-click="() => this.tobaccoOpen('pos.order', exception.id)" t-esc="exception.name"/></td><td class="is-number" t-esc="tobaccoMoney(exception.computed)"/><td class="is-number" t-esc="tobaccoMoney(exception.saved)"/></tr></tbody></table>
        </t>
    </xpath>
    <xpath expr="//table[@t-if='isAged']" position="attributes"><attribute name="t-if">!isTobacco &amp;&amp; isAged</attribute></xpath>
    <xpath expr="//table[@t-else='']" position="attributes"><attribute name="t-elif">!isTobacco</attribute><attribute name="t-else"/></xpath>
</t>
</templates>
