<odoo>
  <data noupdate="1">
    <record id="group_followup_user" model="res.groups"><field name="name">مستخدم متابعة الموظفين</field></record>
    <record id="group_followup_manager" model="res.groups"><field name="name">مدير متابعة الموظفين</field><field name="implied_ids" eval="[(4, ref('group_followup_user'))]"/></record>
    <record id="base.group_system" model="res.groups"><field name="implied_ids" eval="[(4, ref('group_followup_manager'))]"/></record>
    <record id="rule_own_shift" model="ir.rule"><field name="name">ورديات المتابعة الخاصة بي</field><field name="model_id" ref="model_baseer_followup_shift"/><field name="domain_force">[('employee_id.user_id', '=', user.id), ('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_user'))]"/></record>
    <record id="rule_manager_company_shift" model="ir.rule"><field name="name">ورديات شركة المدير</field><field name="model_id" ref="model_baseer_followup_shift"/><field name="domain_force">[('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_manager'))]"/></record>
    <record id="rule_own_shift_absence" model="ir.rule"><field name="name">غياب موظفي وردياتي</field><field name="model_id" ref="model_baseer_followup_shift_absence"/><field name="domain_force">[('shift_id.employee_id.user_id', '=', user.id), ('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_user'))]"/></record>
    <record id="rule_manager_company_shift_absence" model="ir.rule"><field name="name">غياب موظفي شركة المدير</field><field name="model_id" ref="model_baseer_followup_shift_absence"/><field name="domain_force">[('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_manager'))]"/></record>
    <record id="rule_own_opening_line" model="ir.rule"><field name="name">مهام المتابعة الخاصة بي</field><field name="model_id" ref="model_baseer_followup_opening_line"/><field name="domain_force">[('shift_id.employee_id.user_id', '=', user.id), ('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_user'))]"/></record>
    <record id="rule_manager_company_opening_line" model="ir.rule"><field name="name">مهام شركة المدير</field><field name="model_id" ref="model_baseer_followup_opening_line"/><field name="domain_force">[('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_manager'))]"/></record>
    <record id="rule_manager_task_template" model="ir.rule"><field name="name">قوالب مهام شركة المدير</field><field name="model_id" ref="model_baseer_followup_task_template"/><field name="domain_force">[('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_manager'))]"/></record>
    <record id="rule_system_task_template" model="ir.rule"><field name="name">قوالب مهام مسؤول النظام</field><field name="model_id" ref="model_baseer_followup_task_template"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('base.group_system'))]"/></record>
    <record id="rule_own_followup_note" model="ir.rule"><field name="name">ملاحظات المتابعة الخاصة بي</field><field name="model_id" ref="model_baseer_followup_note"/><field name="domain_force">[('employee_id.user_id', '=', user.id), ('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_user'))]"/></record>
    <record id="rule_manager_company_followup_note" model="ir.rule"><field name="name">ملاحظات متابعة شركة المدير</field><field name="model_id" ref="model_baseer_followup_note"/><field name="domain_force">[('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_manager'))]"/></record>
    <record id="rule_own_followup_note_item" model="ir.rule"><field name="name">عناصر مهام المتابعة الخاصة بي</field><field name="model_id" ref="model_baseer_followup_note_item"/><field name="domain_force">[('note_id.employee_id.user_id', '=', user.id), ('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_user'))]"/></record>
    <record id="rule_manager_company_followup_note_item" model="ir.rule"><field name="name">عناصر مهام متابعة شركة المدير</field><field name="model_id" ref="model_baseer_followup_note_item"/><field name="domain_force">[('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_manager'))]"/></record>
    <record id="rule_manager_evaluation_template" model="ir.rule"><field name="name">قوالب مؤشرات تقييم شركة المدير</field><field name="model_id" ref="model_baseer_followup_evaluation_template"/><field name="domain_force">[('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_manager'))]"/></record>
    <record id="rule_system_evaluation_template" model="ir.rule"><field name="name">قوالب مؤشرات تقييم مسؤول النظام</field><field name="model_id" ref="model_baseer_followup_evaluation_template"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('base.group_system'))]"/></record>
    <record id="rule_own_employee_evaluation" model="ir.rule"><field name="name">تقييمات الموظفين المسجلة بواسطتي</field><field name="model_id" ref="model_baseer_followup_employee_evaluation"/><field name="domain_force">[('evaluator_id.user_id', '=', user.id), ('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_user'))]"/></record>
    <record id="rule_manager_company_employee_evaluation" model="ir.rule"><field name="name">تقييمات موظفي شركة المدير</field><field name="model_id" ref="model_baseer_followup_employee_evaluation"/><field name="domain_force">[('company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_manager'))]"/></record>
    <record id="rule_own_employee_evaluation_line" model="ir.rule"><field name="name">بنود تقييماتي المسجلة</field><field name="model_id" ref="model_baseer_followup_employee_evaluation_line"/><field name="domain_force">[('evaluation_id.evaluator_id.user_id', '=', user.id), ('evaluation_id.company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_user'))]"/></record>
    <record id="rule_manager_company_employee_evaluation_line" model="ir.rule"><field name="name">بنود تقييمات شركة المدير</field><field name="model_id" ref="model_baseer_followup_employee_evaluation_line"/><field name="domain_force">[('evaluation_id.company_id', '=', company_id)]</field><field name="groups" eval="[(4, ref('group_followup_manager'))]"/></record>
  </data>
</odoo>
