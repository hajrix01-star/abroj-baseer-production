<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_report_wizard_form" model="ir.ui.view">
        <field name="name">baseer.tax.report.wizard.form</field>
        <field name="model">baseer.tax.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Saudi VAT Report">
                <header>
                    <button name="action_print" type="object" string="Download PDF" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="period_type"/>
                            <field name="display_mode" widget="radio" options="{'horizontal': true}"/>
                            <field name="year"/>
                            <field name="journal_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="month" invisible="period_type != 'month'"/>
                            <field name="quarter" invisible="period_type != 'quarter'"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                    </group>
                    <div class="w-100">
                        <field name="preview_html" widget="baseer_tax_preview" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <button name="action_view_untagged" type="object" string="Review untagged VAT" class="btn-secondary"/>
                        <button name="action_view_other_untagged" type="object" string="Review other untagged taxes" class="btn-secondary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tax_report_wizard" model="ir.actions.act_window">
        <field name="name">Saudi VAT Report</field>
        <field name="res_model">baseer.tax.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_tax_report_wizard_form"/>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_tax_report" name="Saudi VAT Report"
              parent="account.menu_finance_reports" action="action_tax_report_wizard"
              sequence="-20"
              groups="account.group_account_readonly,account.group_account_user,account.group_account_manager"/>
</odoo>
