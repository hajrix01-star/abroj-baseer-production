<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="abroj_project_costing.StudyTree">
        <section class="o_abroj_study_tree" dir="rtl">
            <header class="o_abroj_study_tree_header">
                <div>
                    <p>نطاق العمل والتكلفة</p>
                    <h2>دراسة المشروع</h2>
                </div>
                <button type="button" class="btn btn-primary" t-on-click="() =&gt; this.addMainSection()">
                    <i class="fa fa-plus"/> إضافة بند رئيسي
                </button>
            </header>
            <div t-if="!state.loading &amp;&amp; !state.error" class="o_abroj_study_tree_summary" aria-label="إجمالي دراسة المشروع">
                <div class="o_abroj_study_tree_metric"><span>مجموع الكميات حسب الوحدة</span><strong t-esc="formatQuantities(totalQuantities)"/></div>
                <div class="o_abroj_study_tree_metric"><span>إجمالي المتوقع</span><strong t-esc="formatAmount(state.summary.estimated_total, state.summary.currency_id)"/></div>
                <div class="o_abroj_study_tree_metric"><span>إجمالي الفعلي</span><strong t-esc="formatAmount(state.summary.actual_total, state.summary.currency_id)"/></div>
                <div class="o_abroj_study_tree_metric"><span>إجمالي الانحراف</span><strong t-att-class="state.summary.variance_amount &gt; 0 ? 'is-over' : ''" t-esc="formatAmount(state.summary.variance_amount, state.summary.currency_id)"/></div>
                <small>الفعلي يشمل التكاليف المرتبطة بالدراسة والتكاليف خارج الدراسة.</small>
            </div>
            <div t-if="state.loading" class="o_abroj_study_tree_status">جارٍ تحميل دراسة المشروع…</div>
            <div t-elif="state.error" class="o_abroj_study_tree_status is-error">تعذر تحميل الدراسة. حدّث الصفحة وحاول مرة أخرى.</div>
            <div t-elif="!state.nodes.length" class="o_abroj_study_tree_empty">
                <strong>ابدأ بنطاق العمل</strong>
                <span>أضف بندًا رئيسيًا مثل «المطبخ»، ثم أضف تحته الأقسام والبنود المسعّرة.</span>
                <button type="button" class="btn btn-secondary" t-on-click="() =&gt; this.addMainSection()">إضافة بند رئيسي</button>
            </div>
            <div t-else="" class="o_abroj_study_tree_rows" t-att-class="state.dropAtRoot ? 'is-root-drop-target' : ''" t-on-dragover="allowRootDrop" t-on-drop="dropAtRoot">
                <t t-call="abroj_project_costing.StudyTreeRows">
                    <t t-set="nodes" t-value="state.nodes"/>
                    <t t-set="level" t-value="0"/>
                </t>
            </div>
        </section>
    </t>

    <t t-name="abroj_project_costing.StudyTreeRows">
        <t t-foreach="nodes" t-as="node" t-key="node.id">
            <article class="o_abroj_study_tree_row" t-att-class="(node.node_kind === 'section' ? 'is-section' : 'is-item') + (state.draggedId === node.id ? ' is-dragging' : '') + (state.dropTargetId === node.id ? ' is-drop-target' : '')" t-att-style="'--abroj-tree-level:' + level" t-att-draggable="node.node_kind === 'section' ? 'true' : 'false'" t-on-dragstart="(event) =&gt; this.dragStart(node, event)" t-on-dragend="dragEnd" t-on-dragover="(event) =&gt; this.allowDrop(node, event)" t-on-drop="(event) =&gt; this.dropOn(node, event)">
                <div class="o_abroj_study_tree_name">
                    <span t-if="node.node_kind === 'section'" class="o_abroj_tree_drag_handle" title="اسحب لتحريك القسم" aria-hidden="true"><i class="fa fa-bars"/></span>
                    <button t-if="node.children.length" type="button" class="o_abroj_tree_toggle" t-on-click="() =&gt; this.toggle(node)" t-att-aria-expanded="isExpanded(node) ? 'true' : 'false'">
                        <i t-att-class="isExpanded(node) ? 'fa fa-chevron-down' : 'fa fa-chevron-left'"/>
                    </button>
                    <span t-else="" class="o_abroj_tree_leaf_marker"/>
                    <button type="button" class="o_abroj_tree_name_button" t-on-click="() =&gt; this.editNode(node)">
                        <span class="o_abroj_tree_number" t-esc="node.tree_number"/>
                        <span class="o_abroj_tree_kind" t-esc="node.node_kind === 'section' ? 'قسم' : (node.category_id ? node.category_id[1] : 'بند')"/>
                        <strong t-esc="node.name"/>
                    </button>
                </div>
                <div class="o_abroj_study_tree_description">
                    <span class="o_abroj_tree_description_label">الوصف</span>
                    <span class="o_abroj_tree_description_text" t-esc="node.description || '—'"/>
                </div>
                <div class="o_abroj_study_tree_metric"><span t-esc="node.node_kind === 'section' ? 'مجموع الكميات' : 'الكمية'"/><strong t-esc="node.node_kind === 'section' ? formatQuantities(node.quantity_totals) : (node.quantity || 0)"/></div>
                <div class="o_abroj_study_tree_metric"><span>المتوقع</span><strong t-esc="formatAmount(node.estimated_total, node.currency_id)"/></div>
                <div class="o_abroj_study_tree_metric"><span>الفعلي</span><strong t-esc="formatAmount(node.actual_total, node.currency_id)"/></div>
                <div class="o_abroj_study_tree_metric"><span>الانحراف</span><strong t-att-class="node.variance_amount &gt; 0 ? 'is-over' : ''" t-esc="formatAmount(node.variance_amount, node.currency_id)"/></div>
                <div class="o_abroj_tree_actions">
                    <button t-if="node.node_kind === 'section'" type="button" class="btn btn-secondary o_abroj_tree_move" title="رفع القسم" aria-label="رفع القسم" t-on-click="() =&gt; this.moveUp(node)"><i class="fa fa-arrow-up"/></button>
                    <button t-if="node.node_kind === 'section'" type="button" class="btn btn-secondary o_abroj_tree_move" title="خفض القسم" aria-label="خفض القسم" t-on-click="() =&gt; this.moveDown(node)"><i class="fa fa-arrow-down"/></button>
                    <button t-if="node.node_kind === 'section'" type="button" class="btn btn-secondary o_abroj_tree_add_child" t-on-click="() =&gt; this.addChildSection(node)"><i class="fa fa-sitemap"/> قسم فرعي</button>
                    <button t-if="node.node_kind === 'section'" type="button" class="btn btn-secondary o_abroj_tree_add_child" t-on-click="() =&gt; this.addChild(node)"><i class="fa fa-plus"/> بند</button>
                    <button type="button" class="btn btn-outline-danger o_abroj_tree_delete" title="حذف" t-att-aria-label="node.node_kind === 'section' ? 'حذف القسم' : 'حذف البند'" t-on-click="() =&gt; this.confirmDelete(node)"><i class="fa fa-trash"/></button>
                </div>
            </article>
            <t t-if="node.children.length and isExpanded(node)">
                <t t-call="abroj_project_costing.StudyTreeRows">
                    <t t-set="nodes" t-value="node.children"/>
                    <t t-set="level" t-value="level + 1"/>
                </t>
            </t>
        </t>
    </t>
</templates>
