<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_owner_pdf_portrait" model="ir.actions.report">
        <field name="name">Sales and Payments / ملخص المبيعات والمدفوعات</field>
        <field name="model">baseer.operations.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baseer_operations_report.owner_pdf_portrait</field>
        <field name="report_file">baseer_operations_report.owner_pdf_portrait</field>
        <field name="paperformat_id" ref="paperformat_operations_portrait"/>
    </record>
    <record id="action_owner_pdf_landscape" model="ir.actions.report">
        <field name="name">Sales and Payments / ملخص المبيعات والمدفوعات</field>
        <field name="model">baseer.operations.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baseer_operations_report.owner_pdf_landscape</field>
        <field name="report_file">baseer_operations_report.owner_pdf_landscape</field>
        <field name="paperformat_id" ref="paperformat_operations_landscape"/>
    </record>

    <!-- Use P&L's actual print styles; keep the owner's Arabic-safe footer fix. -->
    <template id="owner_pdf_body" inherit_id="baseer_profit_loss_report.profit_loss_pdf_body" primary="True">
        <xpath expr="//h1" position="replace"><h1 t-esc="snapshot['title']"/></xpath>
        <xpath expr="//div[@class='meta']" position="replace">
            <div class="meta">
                <div><span t-esc="company_record.name"/> · <span t-esc="snapshot['currency_code']"/></div>
                <div><span t-esc="'أُنشئ في' if arabic else 'Generated at'"/>: <span dir="ltr" t-esc="generated_at.strftime('%Y-%m-%d %H:%M')"/></div>
                <div><span t-if="is_partial_journals" t-esc="'الدفاتر المختارة، تقرير جزئي' if arabic else 'Selected journals, partial report'"/><span t-else="" t-esc="'جميع الدفاتر' if arabic else 'All journals'"/><span t-if="is_partial_journals">: <span t-esc="journal_names"/></span></div>
            </div>
        </xpath>
        <xpath expr="//div[@class='notice']" position="replace"><div class="notice" t-esc="snapshot['basis']"/></xpath>
        <xpath expr="//div[@class='footer']" position="replace"/>
        <xpath expr="//div[@class='page bpl-pdf']" position="after">
            <div class="footer" style="font-family: DejaVu Sans, Arial, sans-serif; font-size: 8px; color: #657487; border-top: 1px solid #d9dfe4; padding-top: 4px;" t-att-dir="'rtl' if arabic else 'ltr'">
                <span t-esc="company_record.name"/> · <span t-esc="snapshot['currency_code']"/>
                <span t-att-style="'float: left;' if arabic else 'float: right;'" dir="ltr"><span class="page"/> / <span class="topage"/></span>
            </div>
        </xpath>
        <xpath expr="//table" position="replace">
            <table class="owner-matrix">
                <thead><tr>
                    <th t-att-style="'width: 42%;' if len(periods) == 1 else 'width: 30%;'" scope="col" t-esc="'البند' if arabic else 'Item'"/>
                    <th t-foreach="periods" t-as="period" class="numeric" scope="col">
                        <div dir="auto" t-esc="period['display_label']"/>
                        <div class="period" dir="ltr"><span t-esc="period['date_from']"/> - <span t-esc="period['date_to']"/></div>
                        <div class="period" dir="auto" t-esc="'المبلغ' if arabic else 'Amount'"/>
                    </th>
                </tr></thead>
                <tbody>
                    <tr t-foreach="rows" t-as="row" t-att-class="row['kind']" t-att-data-owner-row="row['key']">
                        <th scope="row" t-esc="row['label']"/>
                        <td t-foreach="periods" t-as="period" class="numeric">
                            <t t-set="value" t-value="row['amounts'].get(period['key'])"/>
                            <t t-if="value">
                                <span t-att-class="'negative' if value['negative'] else ''" t-esc="value['amount']"/>
                                <div t-if="value['percentage'] is not None" class="period" dir="ltr" t-esc="value['percentage']"/>
                            </t>
                            <span t-else="">-</span>
                        </td>
                    </tr>
                </tbody>
            </table>
            <p class="period" t-esc="'النسب المعروضة لطرق الدفع من إجمالي المبيعات.' if arabic else 'Payment-channel percentages are shares of total sales.'"/>
            <p t-if="any(period['has_unclassified_outflows'] for period in periods)" class="notice" t-esc="'يشمل الإجمالي مدفوعات لم يكتمل تصنيفها، وهي ظاهرة أعلاه.' if arabic else 'Totals include payments with incomplete classification, shown above.'"/>
        </xpath>
    </template>
    <template id="owner_pdf_portrait"><t t-call="baseer_operations_report.owner_pdf_body"/></template>
    <template id="owner_pdf_landscape"><t t-call="baseer_operations_report.owner_pdf_body"/></template>
</odoo>
