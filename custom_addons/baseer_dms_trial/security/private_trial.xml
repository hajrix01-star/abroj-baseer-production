<odoo>
    <!-- QA-private waiver: the owner only. This is NOT an OCA isolation fix.
         Global rules intersect native rules and apply to DMS managers too. -->
    <record id="private_storage" model="ir.rule">
        <field name="name">QA DMS private owner: storage</field>
        <field name="model_id" ref="dms.model_dms_storage"/>
        <field name="domain_force" eval="'[] if user.id == %s else [(\'id\', \'=\', 0)]' % ref('base.user_admin')"/>
        <field name="perm_read" eval="True"/><field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/><field name="perm_unlink" eval="True"/>
    </record>
    <record id="private_directory" model="ir.rule">
        <field name="name">QA DMS private owner: directory</field>
        <field name="model_id" ref="dms.model_dms_directory"/>
        <field name="domain_force" eval="'[] if user.id == %s else [(\'id\', \'=\', 0)]' % ref('base.user_admin')"/>
        <field name="perm_read" eval="True"/><field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/><field name="perm_unlink" eval="True"/>
    </record>
