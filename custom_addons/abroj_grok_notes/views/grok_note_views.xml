<odoo>
  <record id="view_grok_note_kanban" model="ir.ui.view"><field name="name">grok.note.kanban</field><field name="model">grok.note</field><field name="arch" type="xml">
    <kanban default_order="pinned desc, write_date desc, id desc"><field name="color"/><field name="pinned"/><field name="item_count"/><field name="done_count"/><field name="label_ids"/><templates><t t-name="card"><div t-attf-class="grok-note-color-{{ record.color.raw_value || 'default' }}"><strong><field name="title"/></strong><span t-if="record.pinned.raw_value" class="fa fa-thumb-tack float-end"/><div class="text-truncate"><field name="body"/></div><div t-if="record.item_count.raw_value"><field name="done_count"/> / <field name="item_count"/> completed</div><field name="label_ids" widget="many2many_tags"/><div><field name="res_name"/></div></div></t></templates></kanban>
  </field></record>
  <record id="view_grok_note_list" model="ir.ui.view"><field name="name">grok.note.list</field><field name="model">grok.note</field><field name="arch" type="xml"><list><field name="pinned"/><field name="title"/><field name="color"/><field name="label_ids" widget="many2many_tags"/><field name="res_name"/><field name="user_id"/><field name="write_date"/></list></field></record>
  <record id="view_grok_note_form" model="ir.ui.view"><field name="name">grok.note.form</field><field name="model">grok.note</field><field name="arch" type="xml"><form><sheet><group><field name="title"/><field name="body"/><field name="is_list"/><field name="item_ids" invisible="not is_list"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="done"/></list></field><field name="color"/><field name="pinned"/><field name="active"/><field name="label_ids" widget="many2many_tags"/><field name="res_model"/><field name="res_id"/><field name="res_name"/><field name="user_id"/><field name="company_id" groups="base.group_multi_company"/></group></sheet></form></field></record>
  <record id="view_grok_note_search" model="ir.ui.view"><field name="name">grok.note.search</field><field name="model">grok.note</field><field name="arch" type="xml"><search><field name="title"/><field name="body"/><field name="label_ids"/><filter name="pinned" string="Pinned" domain="[('pinned','=',True)]"/><filter name="archived" string="Archived" domain="[('active','=',False)]"/><filter name="mine" string="Mine" domain="[('user_id','=',uid)]"/><group><filter name="group_color" string="Color" context="{'group_by':'color'}"/><filter name="group_model" string="Linked model" context="{'group_by':'res_model'}"/></group></search></field></record>
  <record id="action_grok_notes" model="ir.actions.act_window"><field name="name">Grok Notes</field><field name="res_model">grok.note</field><field name="view_mode">kanban,list,form</field></record>
  <menuitem id="menu_grok_root" name="ملاحظات" groups="group_grok_user" sequence="50"/><menuitem id="menu_grok_notes" name="Grok Notes" parent="menu_grok_root" action="action_grok_notes"/>
</odoo>
