msgstr "لا يمكن نسخ مراجع مستندات الفواتير الأصلية."

#. module: baseer_dms_bill_link
#: code:addons/baseer_dms_bill_link/models/dms_file.py:0
msgid "Original bill documents are read only in Documents."
msgstr "مستندات الفواتير الأصلية متاحة للقراءة فقط في المستندات."

#. module: baseer_dms_bill_link
#: code:addons/baseer_dms_bill_link/models/dms_file.py:0
