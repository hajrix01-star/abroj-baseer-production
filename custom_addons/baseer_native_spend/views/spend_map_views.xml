<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="baseer_spend_map_rule_view_list" model="ir.ui.view">
        <field name="name">baseer.spend.map.rule.list</field>
        <field name="model">baseer.spend.map.rule</field>
        <field name="arch" type="xml">
            <list string="قواعد تصنيف الإنفاق" create="1" edit="1">
                <field name="name"/>
                <field name="company_id"/>
                <field name="selector_kind"/>
                <field name="analytic_account_id"/>
                <field name="catalog_version"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="baseer_spend_map_rule_view_form" model="ir.ui.view">
        <field name="name">baseer.spend.map.rule.form</field>
        <field name="model">baseer.spend.map.rule</field>
        <field name="arch" type="xml">
            <form string="قاعدة تصنيف الإنفاق">
                <header>
                    <button name="action_approve" type="object" string="اعتماد القاعدة" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_retire" type="object" string="إيقاف القاعدة" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,retired"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                        <field name="catalog_version" readonly="state != 'draft'"/>
                        <field name="selector_kind" readonly="state != 'draft'"/>
                        <field name="partner_id" invisible="selector_kind != 'partner'" readonly="state != 'draft'"/>
                        <field name="partner_tag_id" invisible="selector_kind != 'partner_tag'" readonly="state != 'draft'"/>
                        <field name="product_id" invisible="selector_kind != 'product'" readonly="state != 'draft'"/>
                        <field name="product_category_id" invisible="selector_kind != 'product_category'" readonly="state != 'draft'"/>
                        <field name="analytic_account_id" readonly="state != 'draft'"/>
                        <field name="natural_key"/>
                        <field name="approved_by_id"/>
                        <field name="approved_at"/>
                    </group>
                    <group><field name="note" readonly="state != 'draft'"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="baseer_spend_map_run_view_list" model="ir.ui.view">
        <field name="name">baseer.spend.map.run.list</field>
        <field name="model">baseer.spend.map.run</field>
        <field name="arch" type="xml">
            <list string="تشغيلات جاهزية التصنيف" create="1">
                <field name="name"/>
                <field name="company_id"/>
                <field name="catalog_version"/>
                <field name="state" widget="badge"/>
                <field name="total_count"/>
                <field name="resolved_count"/>
                <field name="blocked_count"/>
                <field name="generated_at"/>
            </list>
        </field>
    </record>

    <record id="baseer_spend_map_run_view_form" model="ir.ui.view">
        <field name="name">baseer.spend.map.run.form</field>
        <field name="model">baseer.spend.map.run</field>
        <field name="arch" type="xml">
            <form string="معاينة جاهزية تصنيف الإنفاق">
                <header>
                    <button name="action_generate_preview" type="object" string="إنشاء المعاينة" class="btn-primary" invisible="state == 'approved'"/>
                    <button name="action_check_stale" type="object" string="فحص حداثة المعاينة" invisible="not snapshot_hash or state == 'approved'"/>
                    <button name="action_approve" type="object" string="اعتماد الجاهزية" class="btn-primary" invisible="state != 'ready'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,ready,blocked,stale,approved"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="state != 'draft'"/>
                        <field name="company_id" readonly="state != 'draft'"/>
                        <field name="catalog_version" readonly="state != 'draft'"/>
                        <field name="snapshot_hash"/>
                        <field name="catalog_hash"/>
                        <field name="is_stale"/>
                        <field name="stale_at"/>
                        <field name="generated_by_id"/>
                        <field name="generated_at"/>
                        <field name="approved_by_id"/>
                        <field name="approved_at"/>
                    </group>
                    <group>
                        <field name="total_count"/>
                        <field name="resolved_count"/>
                        <field name="blocked_count"/>
                        <field name="note" readonly="state != 'draft'"/>
                    </group>
                    <notebook>
                        <page string="نتائج المعاينة">
                            <field name="line_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="context_kind"/>
                                    <field name="partner_id"/>
                                    <field name="partner_tag_id"/>
                                    <field name="product_id"/>
                                    <field name="product_category_id"/>
                                    <field name="selected_analytic_account_id"/>
                                    <field name="outcome" widget="badge"/>
                                    <field name="message"/>
                                    <field name="evidence_hash" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="فحوص الحداثة">
                            <field name="freshness_check_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="checked_at"/>
                                    <field name="checked_by_id"/>
                                    <field name="is_stale"/>
                                    <field name="snapshot_hash" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="baseer_spend_map_rule_action" model="ir.actions.act_window">
        <field name="name">قواعد تصنيف الإنفاق</field>
        <field name="res_model">baseer.spend.map.rule</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="baseer_spend_map_run_action" model="ir.actions.act_window">
        <field name="name">جاهزية تصنيف الإنفاق</field>
        <field name="res_model">baseer.spend.map.run</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="baseer_spend_map_menu_root" name="تصنيف الإنفاق" parent="account.menu_finance_configuration" sequence="85" groups="account.group_account_manager"/>
    <menuitem id="baseer_spend_map_menu_rules" name="القواعد" parent="baseer_spend_map_menu_root" action="baseer_spend_map_rule_action" sequence="10" groups="account.group_account_manager"/>
    <menuitem id="baseer_spend_map_menu_runs" name="المعاينة والجاهزية" parent="baseer_spend_map_menu_root" action="baseer_spend_map_run_action" sequence="20" groups="account.group_account_manager"/>
</odoo>
