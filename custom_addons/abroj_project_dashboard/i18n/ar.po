#. module: abroj_project_dashboard
#. odoo-python
#: code:addons/abroj_project_dashboard/models/voucher_workflow.py:0
msgid "The payment and invoice must have open lines on the same receivable or payable account."
msgstr "يجب أن تتضمن الدفعة والفاتورة بنودًا مفتوحة في حساب الذمم المدينة أو الدائنة نفسه."

#. module: abroj_project_dashboard
#. odoo-python
#: code:addons/abroj_project_dashboard/models/voucher_workflow.py:0
msgid "Every settlement line must have the reviewed original accounting partner."
msgstr "يجب أن يتطابق طرف كل بند تسوية مع الطرف المحاسبي الأصلي الذي راجعته."

#. module: abroj_project_dashboard
#. odoo-python
#: code:addons/abroj_project_dashboard/models/voucher_workflow.py:0
msgid "The payment residual exceeds the invoice residual. Keep the excess as an explicit advance."
msgstr "المتبقي من الدفعة أكبر من المتبقي على الفاتورة. أبق المبلغ الزائد دفعة مقدمة موضحة."

#. module: abroj_project_dashboard
#. odoo-python
#: code:addons/abroj_project_dashboard/models/voucher_workflow.py:0
msgid "The payment and invoice settlement directions must be opposite."
msgstr "يجب أن يكون اتجاه بند تسوية الدفعة مقابلًا لاتجاه بند الفاتورة."

#. module: abroj_project_dashboard
#. odoo-python
#: code:addons/abroj_project_dashboard/models/voucher_workflow.py:0
msgid "The original payment was not fully matched; review its open balance."
msgstr "لم تُسوَّ الدفعة الأصلية بالكامل؛ راجع رصيدها المفتوح."

#. module: abroj_project_dashboard
#. odoo-python
#: code:addons/abroj_project_dashboard/models/voucher_workflow.py:0
