bwork_recovery_capture_after() {
    [ "$bwork_recovery_enabled" -eq 1 ] || return 0
    local schema before archive_schema
    bwork_recovery_quiescent || return 1
    schema="$(bwork_recovery_schema_hash)" || return 1
    [ "$schema" = "$(cat "$backup/bwork-schema-before.sha256")" ] || return 1
    archive_schema="$(bwork_recovery_archive_schema_hash)" || return 1
    [ "$archive_schema" = "$schema" ] || return 1
    bwork_recovery_pg_toolchain | cmp "$backup/bwork-pg-toolchain.txt" - || return 1
    (set -o noclobber; bwork_recovery_sql capture "$schema" > "$backup/bwork-recovery-after.json") || return 1
    cmp "$backup/bwork-recovery-before.json" "$backup/bwork-recovery-after.json" || return 1
    before="$(bwork_recovery_filestore_hash)" || return 1
    [ "$before" = "$(cat "$backup/bwork-filestore-before.sha256")" ] || return 1
    # Bind every captured artifact to this exact protected source/policy/run.
    (set -o noclobber; printf 'RELEASE_ID=%s\nRUN_ID=%s\nOLD_COMMIT=%s\nCOMMIT=%s\nPOLICY_REVISION=%s\nHELPER_SHA256=%s\n' \
        "$release_id" "$run_id" "$live_commit" "$commit" "$policy_revision" "$BWORK_RECOVERY_HELPER_SHA256" \
        > "$backup/bwork-recovery-context.env") || return 1
    bwork_recovery_sync "$backup/bwork-recovery-after.json" "$backup/bwork-filestore-before.sha256" "$backup/bwork-recovery-context.env" || return 1
    (set -o noclobber; sha256sum "$backup/baseer_prod.dump" "$backup/filestore-baseer_prod.tar" \
        "$backup/bwork-recovery-before.json" "$backup/bwork-recovery-after.json" \
        "$backup/bwork-schema-before.sha256" "$backup/bwork-filestore-before.sha256" \
        "$backup/bwork-recovery-context.env" "$backup/bwork-pg-toolchain.txt" > "$backup/bwork-recovery.sha256") || return 1
    bwork_recovery_sync "$backup/bwork-recovery.sha256"
}

bwork_recovery_prepare_restore() {
    [ "$bwork_recovery_enabled" -eq 1 ] || return 0
    local proof_sha
    # A prepared intent is intentionally non-retryable. If commit/receipt is
    # ambiguous (including partial DB/filestore restore), block future runs.
    sha256sum -c "$backup/bwork-recovery.sha256" || return 1
    bwork_recovery_quiescent || return 1
    bwork_recovery_pg_toolchain | cmp "$backup/bwork-pg-toolchain.txt" - || return 1
    proof_sha="$(sha256sum "$backup/bwork-recovery-before.json" | cut -d ' ' -f 1)" || return 1
    (set -o noclobber; printf 'RECOVERY=RESTORE_PREPARED\nPROOF_SHA256=%s\nOLD_COMMIT=%s\nCOMMIT=%s\nRUN_ID=%s\n' \
        "$proof_sha" "$live_commit" "$commit" "$run_id" > "$backup/bwork-recovery-intent.env") || return 1
    [ ! -e "$backup/bwork-recovery-receipt.json" ] && [ ! -L "$backup/bwork-recovery-receipt.json" ] || return 1
    bwork_recovery_sync "$backup/bwork-recovery-intent.env" || return 1
    # Retain a global hardlink to the durable intent while recovery is pending.
    # Future deployments cannot bypass an ambiguous commit with a fresh run ID.
    ln -- "$backup/bwork-recovery-intent.env" "$BASE/bwork-recovery-pending.env" || return 1
    sync -f "$BASE" || return 1
}

bwork_recovery_restore_complete() {
    [ "$bwork_recovery_enabled" -eq 1 ] || return 0
    sha256sum -c "$backup/bwork-recovery.sha256" || return 1
    [ "$(stat -c '%d:%i' "$BASE/bwork-recovery-pending.env")" = \
        "$(stat -c '%d:%i' "$backup/bwork-recovery-intent.env")" ] || return 1
    bwork_recovery_quiescent || return 1
    bwork_recovery_pg_toolchain | cmp "$backup/bwork-pg-toolchain.txt" - || return 1
    (set -o noclobber; bwork_recovery_schema_hash > "$backup/bwork-schema-restored.sha256") || return 1
    bwork_recovery_witness create || return 1
    bwork_recovery_sync "$backup/bwork-schema-restored.sha256" "$backup/bwork-paired-restore.json"
}

bwork_recovery_restore_verify() {
    [ "$bwork_recovery_enabled" -eq 1 ] || return 0
    local schema filestore proof_sha receipt_status post_schema
    sha256sum -c "$backup/bwork-recovery.sha256" || return 1
    [ "$(stat -c '%d:%i' "$BASE/bwork-recovery-pending.env")" = \
        "$(stat -c '%d:%i' "$backup/bwork-recovery-intent.env")" ] || return 1
    bwork_recovery_quiescent || return 1
    bwork_recovery_pg_toolchain | cmp "$backup/bwork-pg-toolchain.txt" - || return 1
    bwork_recovery_witness verify || return 1
