[options]
# Create config/odoo.conf on the deployment host and replace this value with a
# long random secret. This file is deliberately ignored by Git.
admin_passwd = REPLACE_WITH_A_LONG_RANDOM_SECRET
data_dir = /var/lib/odoo
proxy_mode = True
list_db = False
limit_time_cpu = 120
limit_time_real = 240
workers = 2
max_cron_threads = 1
