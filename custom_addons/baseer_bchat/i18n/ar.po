#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/room.py:0
msgid "A room name of at most 256 UTF-8 bytes is required."
msgstr "أدخل اسمًا للغرفة لا يتجاوز 256 بايت."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/room.py:0
msgid "Only a room name and company may be supplied."
msgstr "أدخل اسم الغرفة والشركة فقط."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/room.py:0
msgid "Only a nonempty room name may be changed."
msgstr "يمكنك تغيير اسم الغرفة إلى اسم غير فارغ فقط."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/room.py:0
msgid "Select the room company as your active company."
msgstr "فعّل شركة الغرفة أولًا."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/membership.py:0
msgid "Only a room and authorized user may be selected."
msgstr "اختر غرفة ومستخدمًا مصرحًا له فقط."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/membership.py:0
msgid "The member must be an active internal account in this company."
msgstr "اختر حسابًا داخليًا نشطًا تابعًا لهذه الشركة."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/membership.py:0
msgid "This user is already an active room member."
msgstr "هذا المستخدم عضو في الغرفة بالفعل."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/room.py:0
#: code:addons/baseer_bchat/models/membership.py:0
msgid "The room company is not authorized."
msgstr "ليس لديك صلاحية لهذه الشركة."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/room.py:0
#: code:addons/baseer_bchat/models/v2_service.py:0
msgid "This room is unavailable."
msgstr "هذه الغرفة غير متاحة."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/room.py:0
msgid "BChat rooms cannot be copied."
msgstr "لا يمكن نسخ غرف بيورك."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/room.py:0
msgid "BChat rooms cannot be deleted."
msgstr "لا يمكن حذف غرف بيورك."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/membership.py:0
msgid "Membership epochs cannot be copied."
msgstr "لا يمكن نسخ فترات العضوية."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/membership.py:0
msgid "Membership epochs cannot be deleted."
msgstr "لا يمكن حذف فترات العضوية."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/membership.py:0
msgid "Membership epochs cannot be edited."
msgstr "لا يمكن تعديل فترات العضوية."

#. module: baseer_bchat
#. odoo-python
#: code:addons/baseer_bchat/models/room.py:0
#: code:addons/baseer_bchat/models/storage.py:0
msgid "An explicitly assigned BChat manager is required."
msgstr "تحتاج إلى صلاحية المدير لإدارة بيورك."

#. module: baseer_bchat
msgid "View conversations"
msgstr "عرض المحادثات"

#. module: baseer_bchat
msgid "Send messages"
msgstr "إرسال الرسائل"

#. module: baseer_bchat
msgid "Send media and files"
msgstr "إرسال الصور والتسجيلات والملفات"

#. module: baseer_bchat
msgid "Create groups"
msgstr "إنشاء مجموعات"

#. module: baseer_bchat
msgid "Manage assigned groups"
msgstr "إدارة المجموعات المصرّح بها"

#. module: baseer_bchat
msgid "View tasks"
msgstr "عرض المهام"

#. module: baseer_bchat
msgid "Create and update tasks"
msgstr "إنشاء المهام وتحديثها"

#. module: baseer_bchat
msgid "Manage rooms and members"
msgstr "إدارة الغرف والأعضاء"

#. module: baseer_bchat
msgid "This BChat action is not enabled for your user."
msgstr "هذا الإجراء في بيورك غير مفعّل لحسابك."

#. module: baseer_bchat
msgid "Only an administrator can change BChat permissions."
msgstr "يمكن للمسؤول فقط تغيير صلاحيات بيورك."

#. module: baseer_bchat
msgid "Only the admin account may manage BChat rooms."
msgstr "يمكن لحساب المدير العام فقط إدارة غرف بيورك."

#. module: baseer_bchat
msgid "BChat permission revisions are maintained by the service."
msgstr "يتولى النظام تحديث إصدار صلاحيات بيورك."
