#. odoo-python
#: code:addons/baseer_pos_zatca_b2c/models/pos_config.py:0
msgid "The internal anonymous consumer must be an individual without a VAT number."
msgstr "يجب أن يكون المستهلك الداخلي فردًا بلا رقم ضريبي."

#. odoo-python
#: code:addons/baseer_pos_zatca_b2c/models/pos_config.py:0
