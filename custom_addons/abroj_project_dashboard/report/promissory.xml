<odoo>
  <template id="promissory_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="abroj_contracting.contract_layout"><div class="page" dir="rtl"><h2>سند أمر</h2><p>رقم: <span t-field="o.name"/></p><p>المشروع: <span t-field="o.project_id"/></p><p>الطرف: <span t-out="(o.party_id or o.partner_id).name"/></p><p>المبلغ: <span t-field="o.amount"/></p><p>تاريخ الإصدار: <span t-field="o.issue_date"/> — تاريخ الاستحقاق: <span t-field="o.due_date"/></p><p>مكان الإصدار: <span t-field="o.place"/></p><p t-field="o.notes"/></div></t></t></t></template>
  <record id="report_promissory" model="ir.actions.report"><field name="name">سند أمر</field><field name="model">abroj.promissory.note</field><field name="report_type">qweb-pdf</field><field name="report_name">abroj_project_dashboard.promissory_document</field><field name="report_file">abroj_project_dashboard.promissory_document</field></record>
</odoo>
