wait_for_login() {
    local attempt
    for attempt in $(seq 1 90); do
        curl -fsS --max-time 10 http://127.0.0.1:18069/web/login >/dev/null && return 0
        sleep 1
    done
    return 1
}

wait_for_data_init() {
    local attempt status exit_code
    for attempt in $(seq 1 30); do
        status="$("${compose[@]}" ps -a --format json odoo_data_init 2>/dev/null | jq -r '.State // empty' || true)"
        [ "$status" = exited ] && break
        sleep 1
    done
    exit_code="$("${compose[@]}" ps -a --format json odoo_data_init | jq -r '.ExitCode // empty')"
    [ "$exit_code" = 0 ]
}

restore_pair() (
    # Rollback calls this while its own error trap is intentionally disabled.
    # Run the recovery pair in a strict subshell so an early database or
    # filestore failure cannot be hidden by a later successful command.
    set -Eeuo pipefail
    sha256sum -c "$backup/recovery.sha256"
    bwork_recovery_prepare_restore
    docker exec "$DB_CONTAINER" sh -lc 'dropdb -U "$POSTGRES_USER" --if-exists baseer_prod'
    docker exec "$DB_CONTAINER" sh -lc 'createdb -U "$POSTGRES_USER" baseer_prod'
    docker exec -i "$DB_CONTAINER" sh -lc 'pg_restore -U "$POSTGRES_USER" --exit-on-error --no-owner --no-privileges -d baseer_prod' < "$backup/baseer_prod.dump"
    docker run --rm --network none -v "$ODOO_VOLUME":/target -v "$backup":/backup:ro alpine:3.20 sh -lc '
        set -eu
        rm -rf -- /target/filestore/baseer_prod
        mkdir -p /target/filestore
        tar -xf /backup/filestore-baseer_prod.tar -C /target
        test -d /target/filestore/baseer_prod
    '
    bwork_recovery_restore_complete
    bwork_recovery_restore_verify
)

rollback() {
    local status=${1:-$?}
    local rollback_failed=0 restore_status
    trap - ERR
    set +e

    if [ -n "${backup:-}" ] && [ -d "$backup" ]; then
        printf 'LIVE=ROLLING_BACK\n' > "$backup/result.env"
    fi

    if [ "${release_switched:-0}" -eq 1 ] && [ "${#compose[@]}" -gt 0 ]; then
        "${compose[@]}" stop odoo >/dev/null 2>&1 || rollback_failed=1
    fi
    if [ "${database_mutated:-0}" -eq 1 ]; then
        # Do not place this strict subshell in an OR/if list: Bash would disable
        # errexit inside restore_pair and could conceal an earlier restore error.
        restore_pair > "$backup/restore-pair.log" 2>&1
        restore_status=$?
        [ "$restore_status" -eq 0 ] || rollback_failed=1
    fi
    if [ "${release_switched:-0}" -eq 1 ]; then
        ln -sfn "$old_release" "$BASE/current" || rollback_failed=1
    fi
    if [ "${service_quiesced:-0}" -eq 1 ] && [ "$rollback_failed" -eq 0 ]; then
        "${compose_old[@]}" up -d odoo_data_init >/dev/null 2>&1 || rollback_failed=1
        "${compose_old[@]}" up -d odoo >/dev/null 2>&1 || rollback_failed=1
        wait_for_login >/dev/null 2>&1 || rollback_failed=1
    fi

    if [ -n "${backup:-}" ] && [ -d "$backup" ]; then
        if [ "$rollback_failed" -eq 0 ]; then
            printf 'LIVE=ROLLED_BACK\nPREVIOUS_RELEASE=%s\n' "$old_release" >> "$backup/result.env"
        else
            printf 'LIVE=ROLLBACK_FAILED\nPREVIOUS_RELEASE=%s\n' "$old_release" >> "$backup/result.env"
        fi
    fi
    if [ "$rollback_failed" -ne 0 ]; then
        printf 'LIVE=ROLLBACK_FAILED\nPREVIOUS_RELEASE=%s\n' "$old_release" >&2
        exit 70
    fi
    exit "$status"
}

# Fixed source-only BWork transition boundary. The installed root-owned wrapper
# must itself be reviewed/rolled out separately; archived guard success is not
# proof that an installed host wrapper was changed.
declare -A BWORK_MODULE_MODE=()
bwork_native_upgrade=0
bwork_guard_root=''
bwork_requested=''
bwork_recovery_enabled=0
bwork_recovery_helper=''
bwork_recovery_schema_key=BWorkRecoverySchemaV1HashOnly20261021

bwork_recovery_source_guard() {
    local repository=$1 expected_root="$bwork_guard_root/recovery-old-source"
    bwork_recovery_helper="$bwork_guard_root/ops/lib/bwork_recovery.py"
    [ -f "$bwork_recovery_helper" ] || return 0
    [ ! -L "$bwork_recovery_helper" ] || die 'recovery helper is linked'
    [ "$(sha256sum "$bwork_recovery_helper" | cut -d ' ' -f 1)" = "$BWORK_RECOVERY_HELPER_SHA256" ] \
        || die 'recovery helper is not the exact reviewed implementation'
    chmod a+r "$bwork_recovery_helper"
    # Fresh/old-name transitions have no completed canonical source to bind.
    # They retain their existing migration/full-closure path, never a rebind.
    [ -d "$old_release/custom_addons/baseer_bwork" ] || return 0
    mkdir -m 0700 "$expected_root"
    git -C "$repository" archive --format=tar "$live_commit" custom_addons/baseer_bwork |
        tar -x -C "$expected_root" --no-same-owner --no-same-permissions
    python3 - "$old_release/custom_addons/baseer_bwork" "$expected_root/custom_addons/baseer_bwork" <<'PY'
import hashlib, pathlib, sys
def digest(path):
    root = pathlib.Path(path)
    assert root.is_dir() and not root.is_symlink()
    rows = []
    for item in sorted(root.rglob('*')):
        assert not item.is_symlink()
        if item.is_file():
            rows.append((item.relative_to(root).as_posix(), item.stat().st_size,
                         hashlib.sha256(item.read_bytes()).hexdigest()))
        else:
            assert item.is_dir()
    assert rows and len(rows) <= 4096
    return rows
assert digest(sys.argv[1]) == digest(sys.argv[2]), 'Old canonical source is not the protected frozen Git tree'
PY
}

bwork_recovery_schema_hash() {
    # Plain schema output is HASHED ONLY, never run through psql. A supported
    # fixed restrict key makes this comparison repeatable without editing SQL.
    local help hash
    local flags=(--schema-only --no-owner --no-privileges)
    help="$(docker exec "$DB_CONTAINER" pg_dump --help)" || return 1
    if [[ "$help" == *--restrict-key* ]]; then flags+=("--restrict-key=$bwork_recovery_schema_key"); fi
    hash="$(docker exec "$DB_CONTAINER" sh -eu -c \
        'exec timeout 120 pg_dump -U "$POSTGRES_USER" -d baseer_prod "$@"' sh "${flags[@]}" |
        sha256sum | cut -d ' ' -f 1)" || return 1
    [[ "$hash" =~ ^[a-f0-9]{64}$ ]] || return 1
    printf '%s\n' "$hash"
}

bwork_recovery_filestore_hash() {
    local hash image
    image="$(docker inspect --format '{{.Image}}' "$ODOO_CONTAINER")" || return 1
    [[ "$image" =~ ^sha256:[a-f0-9]{64}$ ]] || return 1
    # Reuse the exact installed image/Python stdlib, not a new package or an
    # assumed BusyBox checksum flag. Index bytes and filenames without output.
    hash="$(docker run --rm -i --pull=never --network none --read-only --memory 128m --cpus 1 \
        -v "$ODOO_VOLUME":/source:ro --entrypoint timeout "$image" 180 python3 - <<'PY'
import hashlib, pathlib, stat, struct, time
root=pathlib.Path('/source/filestore/baseer_prod')
assert root.is_dir() and not root.is_symlink()
result=hashlib.sha256(); count=total=0; deadline=time.monotonic()+170
for path in sorted(root.rglob('*')):
    assert time.monotonic()<deadline and not path.is_symlink()
    mode=path.stat().st_mode
    if stat.S_ISDIR(mode): continue
    assert stat.S_ISREG(mode)
    count+=1; size=path.stat().st_size; total+=size
    assert count<=100000 and size<=536870912 and total<=4294967296
    name=path.relative_to(root).as_posix().encode('utf-8')
    content=hashlib.sha256()
    with path.open('rb') as source:
        for chunk in iter(lambda:source.read(1048576),b''):
            assert time.monotonic()<deadline
            content.update(chunk)
    result.update(struct.pack('!Q',len(name))); result.update(name)
    result.update(struct.pack('!Q',size)); result.update(content.digest())
print(result.hexdigest())
PY
    )" || return 1
    [[ "$hash" =~ ^[a-f0-9]{64}$ ]] || return 1
    printf '%s\n' "$hash"
}

bwork_recovery_quiescent() {
    # Never stop unrelated services. Reject a running writer that still mounts
    # this exact filestore, including a bind alias of its actual volume path.
    local volume_root id mounts ids
    volume_root="$(docker volume inspect --format '{{.Mountpoint}}' "$ODOO_VOLUME")" || return 1
    [[ "$volume_root" == /var/lib/docker/volumes/*/_data ]] || return 1
    ids="$(docker ps -q --no-trunc)" || return 1
    for id in $ids; do
        [[ "$id" =~ ^[a-f0-9]{64}$ ]] || return 1
        mounts="$(docker inspect --format '{{json .Mounts}}' "$id")" || return 1
        printf '%s' "$mounts" | python3 -c '
import json,sys
root=sys.argv[1].rstrip("/")
for mount in json.load(sys.stdin):
    source=mount.get("Source", "").rstrip("/")
    aliases = (mount.get("Name") == sys.argv[2] or source == root or source.startswith(root + "/")
               or (mount.get("Type") == "bind" and root.startswith(source + "/")))
    assert not (mount.get("RW") and aliases), "An unquiesced filestore writer remains"
' "$volume_root" "$ODOO_VOLUME" || return 1
    done
}

bwork_recovery_pg_toolchain() {
    local image
    image="$(docker inspect --format '{{.Image}}' "$DB_CONTAINER")" || return 1
    [[ "$image" =~ ^sha256:[a-f0-9]{64}$ ]] || return 1
    printf 'IMAGE=%s\n' "$image"
    docker exec "$DB_CONTAINER" timeout 15 sh -ec 'postgres --version; pg_dump --version; pg_restore --version'
}

bwork_recovery_archive_schema_hash() {
    local help
    local flags=(--schema-only --no-owner --no-privileges)
    help="$(docker exec "$DB_CONTAINER" pg_restore --help)" || return 1
    if [[ "$help" == *--restrict-key* ]]; then flags+=("--restrict-key=$bwork_recovery_schema_key"); fi
    # Render the authenticated archive to stdout for hashing only. No --dbname,
    # psql or schema execution: PostgreSQL remains the trusted restore primitive.
    docker exec -i "$DB_CONTAINER" timeout 120 pg_restore "${flags[@]}" \
        < "$backup/baseer_prod.dump" | sha256sum | cut -d ' ' -f 1
}

bwork_recovery_witness() {
    local mode=$1
    python3 - "$mode" "$backup" "$release_id" "$run_id" "$live_commit" "$commit" <<'PY'
import hashlib,json,os,pathlib,re,stat,sys
mode,folder,release,run,old,candidate=sys.argv[1:]
assert mode in ('create','verify')
root=pathlib.Path(folder)
def raw(name,bound):
    path=root/name
    info=path.lstat()
    assert stat.S_ISREG(info.st_mode) and info.st_size<=bound
    with path.open('rb') as stream:
        opened=os.fstat(stream.fileno())
        assert (info.st_dev,info.st_ino)==(opened.st_dev,opened.st_ino)
        value=stream.read(bound+1)
    assert len(value)==info.st_size and len(value)<=bound
    return value
def sha(name):
    path=root/name
    assert stat.S_ISREG(path.lstat().st_mode)
    value=hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda:stream.read(1048576),b''): value.update(block)
    return value.hexdigest()
def digest_file(name):
    value=raw(name,128).decode().strip()
    assert re.fullmatch('[a-f0-9]{64}',value)
    return value
proof_raw=raw('bwork-recovery-before.json',8388608)
proof=json.loads(proof_raw)
intent=dict(line.split('=',1) for line in raw('bwork-recovery-intent.env',4096).decode().splitlines())
assert intent=={'RECOVERY':'RESTORE_PREPARED','PROOF_SHA256':hashlib.sha256(proof_raw).hexdigest(),
               'OLD_COMMIT':old,'COMMIT':candidate,'RUN_ID':run}
assert proof['database']=='baseer_prod' and proof['source']['commit']==old
original=digest_file('bwork-schema-before.sha256')
assert proof['schema_sha256']==original
witness={'protocol':'bwork-paired-restore-v1','status':'RESTORED',
 'method':'pg_restore-exit-on-error+paired-filestore','database':'baseer_prod',
 'old_commit':old,'candidate_commit':candidate,'release_id':release,'run_id':run,
 'source':proof['source'],'dump_sha256':sha('baseer_prod.dump'),
 'filestore_sha256':sha('filestore-baseer_prod.tar'),
 'proof_sha256':hashlib.sha256(proof_raw).hexdigest(),
 'intent_sha256':sha('bwork-recovery-intent.env'),
 'toolchain_sha256':sha('bwork-pg-toolchain.txt'),
 'original_schema_sha256':original,
 'restored_schema_sha256':digest_file('bwork-schema-restored.sha256')}
encoded=json.dumps(witness,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()
assert len(encoded)<=16384
if mode=='create':
    descriptor=os.open(root/'bwork-paired-restore.json',os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
    with os.fdopen(descriptor,'wb') as stream:
        stream.write(encoded);stream.flush();os.fsync(stream.fileno())
else:
    assert raw('bwork-paired-restore.json',16384)==encoded
PY
}

bwork_recovery_sql() {
    local mode=$1 schema=$2 proof_sha=${3:-}
    local flags=("$mode" --database baseer_prod --source-root /mnt/bwork-recovery-old \
        --source-commit "$live_commit" --schema-sha256 "$schema")
    [ -z "$proof_sha" ] || flags+=(--proof-sha256 "$proof_sha")
    if [ "$mode" = recover ]; then
        bwork_recovery_witness verify || return 1
        flags+=(--paired-restore-json "$(cat "$backup/bwork-paired-restore.json")" \
            --paired-restore-sha256 "$(sha256sum "$backup/bwork-paired-restore.json" | cut -d ' ' -f 1)")
    fi
    [ "$(sha256sum "$bwork_recovery_helper" | cut -d ' ' -f 1)" = "$BWORK_RECOVERY_HELPER_SHA256" ] || return 1
