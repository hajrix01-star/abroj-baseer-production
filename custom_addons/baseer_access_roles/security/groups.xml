<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_baseer_role" model="res.groups.privilege">
        <field name="name">Baseer Role</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>
    <record id="group_owner" model="res.groups">
        <field name="name">Owner / General Manager</field>
        <field name="privilege_id" eval="False"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="group_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="privilege_id" eval="False"/>
        <field name="implied_ids" eval="[(6, 0, [ref('account.group_account_invoice'), ref('purchase.group_purchase_manager'), ref('sales_team.group_sale_salesman_all_leads'), ref('point_of_sale.group_pos_user'), ref('baseer_procurement_requests.group_procurement_accountant')])]"/>
    </record>
    <record id="group_cashier" model="res.groups">
        <!-- Keep this stable XML ID and its implied rights: this is only the
             business-facing name of the existing branch-operations role. -->
        <field name="name">Branch Manager</field>
        <field name="privilege_id" eval="False"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user'), ref('point_of_sale.group_pos_user'), ref('baseer_procurement_requests.group_procurement_cashier')])]"/>
    </record>
    <record id="group_pos_cashier" model="res.groups">
        <!-- This is deliberately distinct from ``group_cashier`` above, whose
             durable technical key now represents the branch-manager role. -->
        <field name="name">Cashier</field>
        <field name="privilege_id" eval="False"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user'), ref('point_of_sale.group_pos_user')])]"/>
    </record>
</odoo>
