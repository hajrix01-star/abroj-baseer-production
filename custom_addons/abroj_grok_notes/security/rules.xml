<odoo>
  <record id="rule_note_own" model="ir.rule"><field name="name">Own notes</field><field name="model_id" ref="model_grok_note"/><field name="groups" eval="[(4, ref('group_grok_user'))]"/><field name="domain_force">[('user_id', '=', user.id)]</field></record>
  <record id="rule_note_manager" model="ir.rule"><field name="name">Manager notes</field><field name="model_id" ref="model_grok_note"/><field name="groups" eval="[(4, ref('group_grok_manager'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
  <record id="rule_note_company" model="ir.rule"><field name="name">Note companies</field><field name="model_id" ref="model_grok_note"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_item_own" model="ir.rule"><field name="name">Own note items</field><field name="model_id" ref="model_grok_note_item"/><field name="groups" eval="[(4, ref('group_grok_user'))]"/><field name="domain_force">[('note_id.user_id', '=', user.id)]</field></record>
  <record id="rule_item_manager" model="ir.rule"><field name="name">Manager note items</field><field name="model_id" ref="model_grok_note_item"/><field name="groups" eval="[(4, ref('group_grok_manager'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
  <record id="rule_item_company" model="ir.rule"><field name="name">Note item companies</field><field name="model_id" ref="model_grok_note_item"/><field name="domain_force">[('note_id.company_id', 'in', company_ids)]</field></record>
</odoo>
