<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="baseer_reports_menu.Hub">
        <div class="o_baseer_reports_hub" t-att-dir="lang === 'ar' ? 'rtl' : 'ltr'" t-att-lang="lang">
            <header t-if="!selectedReport" class="o_baseer_report_toolbar">
                <div class="o_baseer_report_toolbar_identity">
                    <ReportSelector options="options" selectedKey="state.selectedKey"
                        label="labels.choose" lang="lang" onSelect="(key) => this.selectReport(key)"/>
                </div>
                <span class="o_baseer_reports_hub_brand" t-esc="labels.title"/>
            </header>
            <div t-if="!state.ready" class="o_baseer_reports_hub_status" role="status">
                <i class="fa fa-spinner fa-spin" aria-hidden="true"/> <span t-esc="labels.loading"/>
            </div>
            <div t-if="state.ready &amp;&amp; !options.length &amp;&amp; !state.error"
                class="o_baseer_reports_hub_status" t-esc="labels.empty"/>
            <div t-if="state.error" class="alert alert-danger o_baseer_reports_hub_alert" role="alert" t-esc="state.error"/>
            <div t-if="state.ready &amp;&amp; !state.error &amp;&amp; selectedReport"
                class="o_baseer_reports_hub_body">
                <t t-component="selectedComponent" t-key="state.selectedKey" embedded="true"
                    reportOptions="options" selectedReportKey="state.selectedKey"
                    reportSelectorLabel="labels.choose" onReportSelect="(key) => this.selectReport(key)"/>
            </div>
        </div>
    </t>
</templates>
