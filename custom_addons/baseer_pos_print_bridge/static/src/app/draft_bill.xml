<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="baseer_pos_print_bridge.DraftBillLabel"
       t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//ReceiptHeader" position="before">
            <div t-if="this.isBaseerDraftBill" class="baseer-unpaid-bill-label text-center fw-bold mb-2"
                 style="border: 2px solid #000; font-size: 18px; line-height: 1.4; padding: 3px 0;">
                Unpaid
            </div>
        </xpath>
    </t>
</templates>
