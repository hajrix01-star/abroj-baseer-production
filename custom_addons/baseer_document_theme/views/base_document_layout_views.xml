<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_base_document_layout_inherit_company_seal" model="ir.ui.view">
        <field name="name">base.document.layout.company.seal</field>
        <field name="model">base.document.layout</field>
        <field name="inherit_id" ref="web.view_base_document_layout"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='report_layout_id']" position="after">
                <field name="baseer_document_seal_enabled"
                       string="Company Seal"
                       help="Adds a dynamic company seal to every standard document using the selected layout."/>
            </xpath>
        </field>
    </record>
</odoo>
