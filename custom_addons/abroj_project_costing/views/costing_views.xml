<odoo>
    <record id="view_abroj_project_list" model="ir.ui.view">
        <field name="name">abroj.cost.project.list</field><field name="model">abroj.cost.project</field>
        <field name="arch" type="xml"><list string="المشاريع" decoration-success="state == 'completed'" decoration-muted="state in ('closed', 'cancelled')" decoration-warning="state == 'pricing'">
            <field name="name"/><field name="customer_name" optional="hide"/><field name="agreement_amount" sum="إجمالي الاتفاق"/><field name="estimated_total" sum="إجمالي الدراسة"/><field name="actual_total" sum="إجمالي الفعلي"/><field name="actual_profit" string="النتيجة" sum="إجمالي النتيجة"/><field name="progress" widget="progressbar"/><field name="state" widget="badge"/><field name="write_date" string="آخر تحديث" optional="hide"/>
        </list></field>
    </record>
    <record id="view_abroj_project_search" model="ir.ui.view">
        <field name="name">abroj.cost.project.search</field><field name="model">abroj.cost.project</field>
        <field name="arch" type="xml"><search string="البحث في المشاريع"><field name="name"/><field name="customer_name"/><field name="owner_id"/><filter string="نشطة" name="active_projects" domain="[('state', 'not in', ('closed', 'cancelled'))]"/><filter string="مغلقة" name="closed" domain="[('state','=','closed')]"/><filter string="ملغية" name="cancelled" domain="[('state','=','cancelled')]"/><separator/><filter string="الحالة" name="group_state" context="{'group_by':'state'}"/><filter string="المالك" name="group_owner" context="{'group_by':'owner_id'}"/></search></field>
    </record>
    <record id="view_abroj_project_form" model="ir.ui.view">
        <field name="name">abroj.cost.project.form</field><field name="model">abroj.cost.project</field>
        <field name="arch" type="xml"><form string="مشروع أبرج"><header>
            <button name="action_close" type="object" string="إغلاق المشروع" class="btn-primary" invisible="state == 'closed'"/>
            <button name="action_reopen" type="object" string="إعادة فتح" class="btn-secondary" invisible="state != 'closed'" groups="abroj_project_costing.group_abroj_cost_manager"/>
            <button name="%(action_report_project_costing)d" type="action" string="طباعة تقرير المشروع" class="btn-secondary"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,pricing,approved,in_progress,completed,closed,cancelled"/>
        </header><sheet>
            <div class="oe_button_box" name="button_box"><button name="action_open_attachments" type="object" class="oe_stat_button" icon="fa-paperclip"><field name="attachment_count" widget="statinfo" string="الوثائق"/></button><button name="action_open_receipts" type="object" class="oe_stat_button" icon="fa-money"><field name="receipt_count" widget="statinfo" string="دفعات العميل"/></button></div>
            <div class="oe_title"><h1><field name="name" placeholder="اسم المشروع"/></h1></div>
            <group><group><field name="owner_id"/><field name="customer_name"/><field name="partner_id"/><field name="location"/></group><group><field name="agreement_amount"/><field name="agreement_start_date"/><field name="agreement_end_date"/><field name="close_date" readonly="1"/><field name="image_1920" widget="image" class="oe_avatar"/></group></group>
            <group string="الملخص المالي" col="4"><field name="estimated_total"/><field name="actual_total"/><field name="variance_amount"/><field name="variance_percent" widget="percentage"/><field name="expected_profit"/><field name="actual_profit"/><field name="received_total"/><field name="receivable_remaining"/></group>
            <notebook>
                <page string="نظرة عامة" name="overview"><group><field name="description"/><field name="note" widget="html"/></group></page>
                <page string="دراسة المشروع" name="plan"><field name="plan_line_ids" mode="list,form"><list><field name="sequence" widget="handle"/><field name="category_id" required="1"/><field name="material_id" optional="hide"/><field name="name"/><field name="pricing_method" optional="hide"/><field name="uom_type" optional="hide"/><field name="quantity"/><field name="material_unit_cost" optional="hide"/><field name="auxiliary_unit_cost" optional="hide"/><field name="labor_unit_cost" optional="hide"/><field name="inclusive_unit_cost" optional="hide"/><field name="lump_sum_cost" optional="hide"/><field name="estimated_unit_cost" readonly="1" optional="hide"/><field name="estimated_total" readonly="1"/><field name="actual_total" readonly="1" optional="hide"/><field name="variance_amount" readonly="1" optional="hide"/><field name="status" optional="hide"/><control><create string="إضافة بند دراسة"/></control></list><form string="بند دراسة المشروع"><sheet><group><group><field name="category_id"/><field name="material_id"/><field name="name"/><field name="description"/><field name="pricing_method"/><field name="uom_type"/><field name="quantity"/></group><group><field name="material_unit_cost" invisible="pricing_method not in ('detailed', 'supply_only')"/><field name="auxiliary_unit_cost" invisible="pricing_method != 'detailed'"/><field name="labor_unit_cost" invisible="pricing_method not in ('detailed', 'labor_only')"/><field name="inclusive_unit_cost" invisible="pricing_method != 'supply_install'"/><field name="lump_sum_cost" invisible="pricing_method != 'lump_sum'"/><field name="supplier_id"/><field name="supplier_text"/></group></group><group string="النتيجة"><field name="estimated_unit_cost" readonly="1"/><field name="estimated_total" readonly="1"/><field name="notes"/></group></sheet></form></field></page>
                <page string="التكاليف الفعلية" name="actual"><field name="actual_line_ids" mode="list,form"><list><field name="date"/><field name="category_id"/><field name="name"/><field name="cost_type"/><field name="quantity"/><field name="amount"/><field name="plan_line_id" optional="hide"/><field name="material_id" optional="hide"/><field name="supplier_id" optional="hide"/><control><create string="إضافة تكلفة فعلية"/></control></list><form string="تكلفة فعلية"><header><button name="%(action_report_actual_cost_voucher)d" type="action" string="طباعة سند صرف" class="btn-secondary" invisible="not id"/></header><sheet><group><group><field name="date"/><field name="plan_line_id"/><field name="is_unplanned"/><field name="category_id"/><field name="material_id"/><field name="name"/><field name="description"/></group><group><field name="cost_type"/><field name="uom_type"/><field name="quantity"/><field name="amount"/><field name="supplier_id"/><field name="supplier_text"/></group></group><group><field name="attachment_ids" widget="many2many_binary"/><field name="notes"/></group></sheet></form></field></page>
                <page string="الإنجاز" name="progress"><group><field name="progress" widget="percentage" readonly="1"/></group><field name="progress_stage_ids" mode="list,form"><list><field name="sequence" widget="handle"/><field name="name"/><field name="planned_start_date"/><field name="planned_duration_days"/><field name="planned_end_date" readonly="1"/><field name="state"/><field name="actual_completion_date" readonly="1" optional="hide"/><field name="delay_days" readonly="1" optional="hide"/><button name="action_mark_done" type="object" string="تم الإنجاز" invisible="state == 'done'"/><control><create string="إضافة مرحلة إنجاز"/></control></list><form string="مرحلة إنجاز"><sheet><group><group><field name="stage_template_key"/><field name="name"/><field name="planned_start_date"/><field name="planned_duration_days"/></group><group><field name="state"/><field name="planned_end_date" readonly="1"/><field name="actual_completion_date" readonly="1"/><field name="delay_days" readonly="1"/></group></group><group><field name="notes"/></group></sheet></form></field></page>
                <page string="دفعات العميل" name="receipts"><group string="ملخص دفعات العميل" col="3"><field name="received_total" readonly="1"/><field name="receivable_remaining" readonly="1"/><button name="action_open_receipts" type="object" string="عرض كل الدفعات" class="btn-secondary"/></group><field name="receipt_ids" mode="list,form"><list><field name="name" string="رقم السند"/><field name="date" string="التاريخ"/><field name="amount" string="المبلغ"/><control><create string="إضافة دفعة عميل"/></control></list><form string="دفعة مستلمة من العميل"><header><button name="%(action_report_receipt_voucher)d" type="action" string="طباعة سند استلام" class="btn-secondary" invisible="not id"/><button name="action_open_edit_form" type="object" string="تعديل السند" class="btn-secondary" invisible="not id"/></header><sheet><group><field name="name" readonly="1"/><field name="date" readonly="id"/><field name="amount" readonly="id"/><field name="note" readonly="id"/></group></sheet></form></field></page>
                <page string="تعديل الاتفاقية" name="amendments"><field name="amendment_ids" mode="list,form"><list><field name="date"/><field name="previous_amount" readonly="1"/><field name="new_amount"/><field name="reason"/><field name="state"/><button name="action_apply" type="object" string="تطبيق" invisible="state == 'applied'"/><control><create string="إضافة تعديل اتفاقية"/></control></list><form string="تعديل الاتفاقية"><sheet><group><field name="date"/><field name="previous_amount" readonly="1"/><field name="new_amount"/><field name="reason"/><field name="state"/></group></sheet></form></field></page>
                <page string="الأعضاء" name="members"><field name="member_ids" mode="list,form"><list><field name="user_id"/><field name="access_level"/><control><create string="إضافة عضو"/></control></list><form string="عضو المشروع"><sheet><group><field name="user_id"/><field name="access_level"/></group></sheet></form></field></page>
            </notebook>
        </sheet></form></field>
    </record>
      <record id="action_abroj_project" model="ir.actions.act_window"><field name="name">المشاريع</field><field name="res_model">abroj.cost.project</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_abroj_project_search"/></record>
      <record id="view_abroj_receipt_form_edit" model="ir.ui.view"><field name="name">abroj.cost.receipt.form.edit</field><field name="model">abroj.cost.receipt</field><field name="arch" type="xml"><form string="تعديل سند الاستلام"><header><button name="%(action_report_receipt_voucher)d" type="action" string="طباعة سند استلام" class="btn-secondary"/></header><sheet><group><field name="name" readonly="1"/><field name="project_id" readonly="1"/><field name="date"/><field name="amount"/><field name="note"/></group></sheet></form></field></record>

    <record id="view_abroj_material_list" model="ir.ui.view"><field name="name">abroj.cost.material.list</field><field name="model">abroj.cost.material</field><field name="arch" type="xml"><list string="مكتبة المواد"><field name="image_1920" widget="image"/><field name="code"/><field name="name"/><field name="category_id"/><field name="uom_type"/><field name="material_unit_cost"/><field name="auxiliary_unit_cost"/><field name="labor_unit_cost"/><field name="inclusive_unit_cost"/><field name="supplier_id"/><field name="active"/></list></field></record>
    <record id="view_abroj_material_form" model="ir.ui.view"><field name="name">abroj.cost.material.form</field><field name="model">abroj.cost.material</field><field name="arch" type="xml"><form string="مادة"><sheet><group><group><field name="image_1920" widget="image" class="oe_avatar"/><field name="code"/><field name="name"/><field name="name_en"/><field name="category_id"/><field name="uom_type"/><field name="default_pricing_method"/></group><group><field name="material_unit_cost"/><field name="auxiliary_unit_cost"/><field name="labor_unit_cost"/><field name="inclusive_unit_cost"/><field name="supplier_id"/><field name="supplier_text"/><field name="last_price_update"/><field name="active"/></group></group><notebook><page string="الوصف"><field name="description"/></page><page string="ملاحظات"><field name="notes"/></page><page string="مرجع أودو"><field name="original_product_id" readonly="1"/></page></notebook></sheet></form></field></record>
    <record id="view_abroj_material_search" model="ir.ui.view"><field name="name">abroj.cost.material.search</field><field name="model">abroj.cost.material</field><field name="arch" type="xml"><search><field name="name"/><field name="code"/><field name="category_id"/><field name="uom_type"/><field name="supplier_id"/><filter string="الفئة" name="group_category" context="{'group_by':'category_id'}"/></search></field></record>
    <record id="action_abroj_material" model="ir.actions.act_window"><field name="name">مكتبة المواد</field><field name="res_model">abroj.cost.material</field><field name="view_mode">list,form</field></record>
    <record id="view_abroj_category_list" model="ir.ui.view"><field name="name">abroj.cost.category.list</field><field name="model">abroj.cost.category</field><field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="active"/></list></field></record>
    <record id="action_abroj_category" model="ir.actions.act_window"><field name="name">الأقسام</field><field name="res_model">abroj.cost.category</field><field name="view_mode">list,form</field></record>
</odoo>
