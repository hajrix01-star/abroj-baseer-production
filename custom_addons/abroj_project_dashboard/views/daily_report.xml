<odoo>
 <record id="daily_report_list" model="ir.ui.view"><field name="name">abroj.daily.report.list</field><field name="model">abroj.daily.report</field><field name="arch" type="xml"><list><field name="date"/><field name="engineer_id"/><field name="state"/><field name="sent_at"/></list></field></record>
 <record id="daily_report_form" model="ir.ui.view"><field name="name">abroj.daily.report.form</field><field name="model">abroj.daily.report</field><field name="arch" type="xml"><form><sheet><group><field name="engineer_id"/><field name="date"/><field name="state"/><field name="approved_at"/><field name="sent_at"/></group><field name="line_ids"><list><field name="project_id"/><field name="task_id"/><field name="progress_from"/><field name="progress_to"/><field name="status"/><field name="notes"/><field name="photo_count"/><field name="tomorrow_plan"/></list></field></sheet></form></field></record>
 <record id="daily_report_action" model="ir.actions.act_window"><field name="name">التقارير اليومية</field><field name="res_model">abroj.daily.report</field><field name="view_mode">list,form</field></record>
 <menuitem id="daily_report_menu" name="التقارير اليومية" parent="project.menu_main_pm" action="daily_report_action" sequence="90"/>
 <record id="project_form_daily_reports" model="ir.ui.view"><field name="name">project.form.daily.reports</field><field name="model">project.project</field><field name="inherit_id" ref="project.edit_project"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="التقارير اليومية"><field name="abroj_daily_line_ids" readonly="1"><list><field name="report_id"/><field name="task_id"/><field name="status"/><field name="notes"/><field name="tomorrow_plan"/></list></field></page></xpath></field></record>
</odoo>
