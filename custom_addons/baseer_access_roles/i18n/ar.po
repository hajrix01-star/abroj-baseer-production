msgstr "سجل اعتماد دفعات مشتريات الكاشير"

#. module: baseer_access_roles
#: model:ir.actions.act_window,name:baseer_access_roles.action_cashier_purchase_batch_approval_audit
msgid "Cashier purchase-batch approvals"
msgstr "اعتمادات دفعات مشتريات الكاشير"

#. module: baseer_access_roles
#: model_terms:ir.ui.view,arch_db:baseer_access_roles.view_cashier_purchase_batch_approval_audit_list
msgid "Cashier Purchase-Batch Approvals"
msgstr "اعتمادات دفعات مشتريات الكاشير"

#. module: baseer_access_roles
