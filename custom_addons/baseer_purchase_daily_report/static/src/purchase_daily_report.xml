<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="baseer_purchase_daily_report.Report">
        <main class="bpr-shell">
            <div class="bpr-container">
                <t t-if="state.invoice or state.invoiceLoading or state.invoiceError">
                    <button type="button" class="bpr-back" t-on-click="backToReport"><i class="fa fa-angle-right" aria-hidden="true"/> <span t-esc="labels.back"/></button>
                    <div t-if="state.invoiceLoading" class="bpr-feedback" role="status" aria-live="polite"><span class="bpr-spinner"/> <span t-esc="labels.loading"/></div>
                    <div t-elif="state.invoiceError" class="bpr-feedback bpr-feedback--error" role="alert"><span t-esc="state.invoiceError"/></div>
                    <t t-else="">
                        <header class="bpr-detail-header">
                            <div><span class="bpr-eyebrow" t-esc="kindLabel(state.invoice.kind)"/><h1 t-esc="state.invoice.vendor"/><p class="bpr-invoice-number" dir="ltr" t-esc="state.invoice.number"/></div>
                            <span t-attf-class="bpr-status bpr-status--{{state.invoice.status}}" t-esc="statusLabel(state.invoice.status)"/>
                        </header>
                        <section class="bpr-detail-overview">
                            <div class="bpr-detail-amount"><span t-esc="labels.total"/><strong><bdi t-esc="state.invoice.total"/> <small t-esc="state.invoice.currency"/></strong><small t-esc="labels.amountCurrency"/></div>
                            <div class="bpr-detail-amount"><span t-esc="labels.paidAmount"/><strong><bdi t-esc="state.invoice.paid_unavailable ? labels.paidUnavailable : state.invoice.paid"/> <small t-if="!state.invoice.paid_unavailable" t-esc="state.invoice.currency"/></strong><small t-if="state.invoice.paid_pending" t-esc="labels.paidPending"/></div>
                            <div class="bpr-detail-amount"><span t-esc="labels.residual"/><strong><bdi t-esc="state.invoice.residual"/> <small t-esc="state.invoice.currency"/></strong></div>
                        </section>
                        <section class="bpr-panel">
                            <h2 t-esc="labels.details"/>
                            <dl class="bpr-meta">
                                <div><dt t-esc="labels.vendor"/><dd t-esc="state.invoice.vendor"/></div>
                                <div><dt t-esc="labels.enteredBy"/><dd><span t-esc="state.invoice.entered_by || labels.paidUnavailable"/><small t-if="state.invoice.entered_by"> · <span t-esc="state.invoice.entry_source === 'batch' ? labels.batchEntry : labels.invoiceEntry"/></small></dd></div>
                                <div><dt t-esc="labels.reference"/><dd t-esc="state.invoice.reference || '—'"/></div>
                                <div><dt t-esc="labels.date"/><dd><bdi t-esc="state.invoice.date || '—'"/></dd></div>
                                <div><dt t-esc="labels.due"/><dd><bdi t-esc="state.invoice.due_date || '—'"/></dd></div>
                                <div><dt t-esc="labels.beforeTax"/><dd><bdi t-esc="state.invoice.untaxed"/> <span t-esc="state.invoice.currency"/></dd></div>
                                <div><dt t-esc="labels.tax"/><dd><bdi t-esc="state.invoice.tax"/> <span t-esc="state.invoice.currency"/></dd></div>
                                <div><dt><span t-esc="labels.total"/> · <span t-esc="labels.companyCurrency"/></dt><dd><bdi t-esc="state.invoice.company_total"/> <span t-esc="state.payload.company.currency"/></dd></div>
                                <div><dt><span t-esc="labels.residual"/> · <span t-esc="labels.companyCurrency"/></dt><dd><bdi t-esc="state.invoice.company_residual"/> <span t-esc="state.payload.company.currency"/></dd></div>
                            </dl>
                        </section>
                        <section class="bpr-panel bpr-items"><div class="bpr-panel-heading"><h2 t-esc="labels.items"/><span class="bpr-count" t-esc="state.invoice.lines.length"/></div>
                            <div t-if="!state.invoice.lines.length" class="bpr-empty-small" t-esc="labels.noItems"/>
                            <article class="bpr-line" t-foreach="state.invoice.lines" t-as="line" t-key="line_index">
                                <strong class="bpr-line-name" t-esc="line.description"/>
                                <dl t-if="line.kind === 'product'" class="bpr-line-values">
                                    <div><dt t-esc="labels.quantity"/><dd><bdi t-esc="line.quantity"/></dd></div>
                                    <div><dt t-esc="labels.unitPrice"/><dd><bdi t-esc="line.unit_price"/> <span t-esc="state.invoice.currency"/></dd></div>
                                    <div><dt t-esc="labels.discount"/><dd><bdi t-esc="line.discount"/>%</dd></div>
                                    <div><dt t-esc="labels.subtotal"/><dd><bdi t-esc="line.subtotal"/> <span t-esc="state.invoice.currency"/></dd></div>
                                    <div><dt t-esc="labels.itemTotal"/><dd><bdi t-esc="line.total"/> <span t-esc="state.invoice.currency"/></dd></div>
                                </dl>
                            </article>
                        </section>
                        <section t-if="state.invoice.adjustments and state.invoice.adjustments.length" class="bpr-panel bpr-items">
                            <h2 t-esc="labels.adjustments"/>
                            <article t-foreach="state.invoice.adjustments" t-as="adjustment" t-key="adjustment_index" class="bpr-line">
                                <strong class="bpr-line-name" t-esc="adjustment.description"/>
                                <strong><bdi t-esc="adjustment.amount"/> <small t-esc="state.payload.company.currency"/></strong>
                            </article>
                        </section>
                        <p class="bpr-footnote" t-esc="labels.paidNote"/>
                        <p t-if="state.invoice.paid_unavailable" class="bpr-footnote" t-esc="labels.paidUnavailableNote"/>
                    </t>
                </t>
                <t t-else="">
                    <header class="bpr-header"><div class="bpr-heading"><span class="bpr-eyebrow"><span class="bpr-eyebrow-dot"/> <span t-esc="labels.eyebrow"/></span><h1 t-esc="labels.title"/><p t-esc="labels.subtitle"/></div><div t-if="state.payload" class="bpr-company"><span class="bpr-company-icon"><i class="fa fa-building-o" aria-hidden="true"/></span><div><small t-esc="labels.activeCompany"/><strong t-esc="state.payload.company.name"/></div></div></header>
                    <nav class="bpr-presets" t-att-aria-label="labels.datePresets">
                        <button type="button" t-foreach="presets" t-as="preset" t-key="preset" t-attf-class="bpr-preset {{isPresetActive(preset) ? 'bpr-preset--active' : ''}}" t-on-click="() => this.applyPreset(preset)" t-esc="presetLabels[preset]"/>
                    </nav>
                    <form class="bpr-filter" t-on-submit.prevent="applyFilters">
                        <label><span t-esc="labels.from"/><input type="date" t-model="state.from" t-on-change="onFromToChanged" required="required"/></label>
                        <label><span t-esc="labels.to"/><input type="date" t-model="state.to" t-on-change="onFromToChanged" required="required"/></label>
                        <label><span t-esc="labels.payment"/><select t-model="state.payment" t-on-change="onPaymentChanged"><option value="all" t-esc="labels.all"/><option value="not_paid" t-esc="labels.not_paid"/><option value="partial" t-esc="labels.partial"/><option value="in_payment" t-esc="labels.in_payment"/><option value="paid" t-esc="labels.paid"/><option value="reversed" t-esc="labels.reversed"/><option value="blocked" t-esc="labels.blocked"/><option value="draft" t-esc="labels.drafts"/></select></label>
                        <button type="submit" class="bpr-apply" t-att-disabled="state.loading"><i class="fa fa-search" aria-hidden="true"/> <span t-esc="labels.apply"/></button>
                    </form>
                    <section t-if="state.payload" class="bpr-cards" t-att-aria-label="labels.paymentMethods">
                        <button type="button" t-foreach="state.payload.methods" t-as="card" t-key="card.key" t-attf-class="bpr-card {{isMethodActive(card.key) ? 'bpr-card--active' : ''}}" t-on-click="() => this.toggleMethod(card.key)">
                            <small t-esc="card.label"/>
                            <strong><bdi t-esc="card.total"/> <em t-esc="state.payload.company.currency"/></strong>
                            <span><bdi t-esc="card.count"/> <t t-esc="labels.documents"/></span>
                        </button>
                    </section>
                    <section t-if="state.payload" class="bpr-cards bpr-cards--status" t-att-aria-label="labels.statusFilters">
                        <button type="button" t-foreach="state.payload.statuses" t-as="card" t-key="card.key" t-attf-class="bpr-card bpr-card--status bpr-card--{{card.key}} {{isStatusActive(card.key) ? 'bpr-card--active' : ''}}" t-on-click="() => this.toggleStatus(card.key)">
                            <small t-esc="statusCardLabel(card)"/>
                            <strong><bdi t-esc="card.total"/> <em t-esc="state.payload.company.currency"/></strong>
                            <span><bdi t-esc="card.count"/> <t t-esc="labels.documents"/></span>
                        </button>
                    </section>
                    <section t-if="state.payload and state.payload.custody and state.payload.custody.active" class="bpr-cards bpr-cards--custody" t-att-aria-label="labels.custody">
                        <div class="bpr-card bpr-card--custody bpr-card--custody-in">
                            <small t-esc="labels.custodyIn"/>
                            <strong><bdi t-esc="state.payload.custody.funded"/> <em t-esc="state.payload.company.currency"/></strong>
                            <span><t t-esc="labels.custodySince"/> <bdi t-esc="state.payload.custody.start"/></span>
                        </div>
                        <div class="bpr-card bpr-card--custody bpr-card--custody-out">
                            <small t-esc="labels.custodyOut"/>
                            <strong><bdi t-esc="state.payload.custody.spent"/> <em t-esc="state.payload.company.currency"/></strong>
                            <span><t t-esc="labels.custodySince"/> <bdi t-esc="state.payload.custody.start"/></span>
                        </div>
                        <button t-if="state.payload.custody.can_open" type="button" class="bpr-card bpr-card--custody bpr-card--custody-left" t-on-click="openCustody" t-att-title="labels.custodyOpen">
                            <small t-esc="labels.custodyRemaining"/>
                            <strong><bdi t-esc="state.payload.custody.remaining"/> <em t-esc="state.payload.company.currency"/></strong>
                            <span><t t-esc="labels.custodyBalanceNow"/> · <t t-esc="labels.custodyOpen"/> <i class="fa fa-angle-left" aria-hidden="true"/></span>
                        </button>
                        <div t-else="" class="bpr-card bpr-card--custody bpr-card--custody-left">
                            <small t-esc="labels.custodyRemaining"/>
                            <strong><bdi t-esc="state.payload.custody.remaining"/> <em t-esc="state.payload.company.currency"/></strong>
                            <span t-esc="labels.custodyBalanceNow"/>
                        </div>
                    </section>
                    <div class="bpr-context"><span><i class="fa fa-calendar-o" aria-hidden="true"/> <span t-esc="labels.dateNote"/></span><span t-esc="labels.liveNote"/></div>
                    <div t-if="state.loading" class="bpr-feedback" role="status" aria-live="polite"><span class="bpr-spinner"/> <span t-esc="labels.loading"/></div>
                    <div t-elif="state.error" class="bpr-feedback bpr-feedback--error" role="alert"><span t-esc="state.error"/><button type="button" t-on-click="applyFilters" t-esc="labels.retry"/></div>
                    <div t-elif="!state.payload.table.rows.length" class="bpr-empty"><span class="bpr-empty-icon"><i class="fa fa-folder-open-o" aria-hidden="true"/></span><h2 t-esc="labels.empty"/><p t-esc="labels.emptyHint"/></div>
                    <section t-else="" class="bpr-panel bpr-main-table">
                        <div class="bpr-table-scroll">
                            <table class="bpr-table">
                                <thead>
                                    <tr>
                                        <th t-esc="labels.tableDate"/>
                                        <th class="bpr-num bpr-col--total" t-esc="labels.purchaseTotal"/>
                                        <th t-foreach="state.payload.table.columns" t-as="column" t-key="column.key" t-attf-class="bpr-num bpr-col--{{column.key.split(':')[0]}}" t-esc="column.label"/>
                                        <th t-if="state.payload.table.has_transfers" class="bpr-num bpr-col--transfer" t-esc="labels.custodyTransfer"/>
                                        <th class="bpr-col--toggle"><span class="bpr-sr-only" t-esc="labels.show"/></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.payload.table.rows" t-as="row" t-key="row.key">
                                        <tr t-if="row.kind === 'day'" t-attf-class="bpr-row--day {{state.expanded === row.date ? 'bpr-row--open' : ''}}" t-on-click="() => this.toggleDay(row.date)">
                                            <td class="bpr-cell-date"><strong><bdi t-esc="row.date"/></strong><small><bdi t-esc="row.count"/> <t t-esc="labels.documents"/></small></td>
                                            <td class="bpr-num bpr-col--total"><bdi t-esc="row.total"/></td>
                                            <td t-foreach="state.payload.table.columns" t-as="column" t-key="column.key" t-attf-class="bpr-num bpr-col--{{column.key.split(':')[0]}}"><bdi t-esc="tableAmount(row, column.key)"/></td>
                                            <td t-if="state.payload.table.has_transfers" class="bpr-num bpr-col--transfer"/>
                                            <td class="bpr-col--toggle"><button type="button" class="bpr-chevron" t-on-click.stop="() => this.toggleDay(row.date)" t-att-aria-expanded="state.expanded === row.date ? 'true' : 'false'" t-att-aria-controls="'bpr-day-' + row.date"><span class="bpr-sr-only" t-esc="state.expanded === row.date ? labels.hide : labels.show"/><i t-att-class="state.expanded === row.date ? 'fa fa-angle-up' : 'fa fa-angle-down'" aria-hidden="true"/></button></td>
                                        </tr>
                                        <tr t-if="row.kind === 'day' and state.expanded === row.date" class="bpr-row--detail">
                                            <td t-att-colspan="tableColspan">
                                                <section class="bpr-day-content" t-att-id="'bpr-day-' + row.date">
                                <div t-if="state.dayLoading" class="bpr-feedback bpr-feedback--compact" role="status" aria-live="polite"><span class="bpr-spinner"/> <span t-esc="labels.loading"/></div>
                                <div t-elif="state.dayError" class="bpr-feedback bpr-feedback--error bpr-feedback--compact" role="alert"><span t-esc="state.dayError"/><button type="button" t-on-click="() => this.loadDay(0)" t-esc="labels.retry"/></div>
                                <t t-elif="state.dayData">
                                    <button type="button" class="bpr-transaction" t-foreach="state.dayData.rows" t-as="row" t-key="row.id" t-on-click="() => this.openInvoice(row.id)">
                                        <span class="bpr-transaction-icon"><i t-att-class="row.kind === 'in_refund' ? 'fa fa-reply' : 'fa fa-file-text-o'" aria-hidden="true"/></span>
                                        <span class="bpr-transaction-main"><strong t-esc="row.vendor"/><small><span t-esc="kindLabel(row.kind)"/> <span aria-hidden="true"> · </span><bdi t-esc="row.number"/></small><small t-if="row.reference" t-esc="row.reference"/><small><span t-esc="labels.enteredBy"/>: <span t-esc="row.entered_by || labels.paidUnavailable"/><t t-if="row.entered_by"> · <span t-esc="row.entry_source === 'batch' ? labels.batchEntry : labels.invoiceEntry"/></t></small></span>
                                        <span class="bpr-transaction-amount"><strong><bdi t-esc="row.total"/> <small t-esc="row.currency"/></strong><small><span t-esc="labels.paidAmount"/>: <bdi t-esc="row.paid_unavailable ? labels.paidUnavailable : row.paid"/> <span t-if="!row.paid_unavailable" t-esc="row.currency"/></small><small t-if="row.paid_pending" t-esc="labels.paidPending"/><small><span t-esc="labels.residual"/>: <bdi t-esc="row.residual"/> <span t-esc="row.currency"/></small><small t-foreach="row.method_amounts or []" t-as="part" t-key="part.key" class="bpr-method-part"><span t-esc="part.label"/>: <bdi t-esc="part.amount"/></small></span>
                                        <span t-attf-class="bpr-status bpr-status--{{row.status}}" t-esc="statusLabel(row.status)"/>
                                        <span class="bpr-open"><span class="bpr-sr-only" t-esc="labels.open"/><i class="fa fa-angle-left" aria-hidden="true"/></span>
                                    </button>
                                    <nav t-if="state.dayData.offset or state.dayData.has_more" class="bpr-pagination" t-att-aria-label="labels.page"><button type="button" t-on-click="previousPage" t-att-disabled="!state.dayData.offset" t-esc="labels.previous"/><span><span t-esc="labels.page"/> <bdi t-esc="pageNumber"/></span><button type="button" t-on-click="nextPage" t-att-disabled="!state.dayData.has_more" t-esc="labels.next"/></nav>
                                </t>
                            </section>
                                            </td>
                                        </tr>
                                        <tr t-if="row.kind === 'transfer'" class="bpr-row--transfer">
                                            <td class="bpr-cell-date"><strong><bdi t-esc="row.date"/></strong><small><t t-esc="row.label"/><t t-if="row.representative"> · <t t-esc="row.representative"/></t></small></td>
                                            <td class="bpr-num bpr-col--total"/>
                                            <td t-foreach="state.payload.table.columns" t-as="column" t-key="column.key" class="bpr-num"/>
                                            <td class="bpr-num bpr-col--transfer"><bdi t-esc="row.transfer"/></td>
                                            <td class="bpr-col--toggle"/>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th t-esc="labels.tableTotals"/>
                                        <th class="bpr-num bpr-col--total"><bdi t-esc="state.payload.table.total"/></th>
                                        <th t-foreach="state.payload.table.columns" t-as="column" t-key="column.key" class="bpr-num"><bdi t-esc="state.payload.table.totals[column.key]"/></th>
                                        <th t-if="state.payload.table.has_transfers" class="bpr-num bpr-col--transfer"><bdi t-esc="state.payload.table.transfer_total"/></th>
                                        <th class="bpr-col--toggle"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <p class="bpr-table-note"><t t-esc="labels.currencyNote"/> <bdi t-esc="state.payload.company.currency"/><t t-if="state.payload.table.has_transfers"> · <t t-esc="labels.transferNote"/></t></p>
                    </section>
                    <p class="bpr-footnote" t-esc="labels.paidNote"/>
                    <p class="bpr-footnote" t-esc="labels.paidUnavailableNote"/>
                </t>
            </div>
        </main>
    </t>
</templates>
