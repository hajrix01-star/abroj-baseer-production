<templates xml:space="preserve">
    <t t-name="baseer_dashboard2.Money">
        <span class="bd2-money">
            <span t-esc="format(props.value)"/>
            <small> ر.س</small>
        </span>
    </t>
    <t t-name="baseer_dashboard2.Badge">
        <span t-if="props.value !== null and props.value !== undefined" t-att-class="'bd2-badge '+(good?'good':'bad')">
            <t t-esc="props.value &gt;= 0 ? '▲' : '▼'"/>
            <t t-esc="Math.abs(props.value).toFixed(1)"/>%</span>
        <span t-else="" class="muted">—</span>
    </t>
    <t t-name="baseer_dashboard2.Sparkline">
        <svg class="bd2-spark" viewBox="0 0 100 32" aria-hidden="true">
            <path t-att-d="path" fill="none" t-att-stroke="props.gold ? 'var(--bd2-gold)' : 'var(--bd2-c5)'" stroke-width="2"/>
        </svg>
    </t>
    <t t-name="baseer_dashboard2.LineChart">
        <svg class="bd2-chart" viewBox="0 0 700 240" role="img">
            <defs>
                <linearGradient id="gold-area" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0" stop-color="var(--bd2-gold)" stop-opacity="0.24"/>
                    <stop offset="1" stop-color="var(--bd2-gold)" stop-opacity="0"/>
                </linearGradient>
            </defs>
            <t t-foreach="[0,1,2,3,4]" t-as="i" t-key="i">
                <line x1="20" x2="652" t-att-y1="205-i*41.25" t-att-y2="205-i*41.25" stroke="var(--bd2-grid)"/>
                <text x="660" t-att-y="209-i*41.25" fill="var(--bd2-muted)" font-size="10" t-esc="Math.round(max*i/4).toLocaleString('en-US')"/>
            </t>
            <t t-foreach="props.series" t-as="s" t-key="s_index">
                <path t-if="s.area" t-att-d="area(s.values)" fill="url(#gold-area)"/>
                <path t-att-d="path(s.values)" fill="none" t-att-stroke="s.dashed ? 'var(--bd2-faint)' : s.gold ? 'var(--bd2-gold)' : 'var(--bd2-c1)'" stroke-width="2.3" t-att-stroke-dasharray="s.dashed ? '5 5' : ''"/>
                <path t-if="s.partial" t-att-d="partialPath(s.values, s.partial)" fill="none" stroke="var(--bd2-card)" stroke-width="3.5"/>
                <path t-if="s.partial" t-att-d="partialPath(s.values, s.partial)" fill="none" stroke="var(--bd2-gold)" stroke-width="2.3" stroke-dasharray="5 4"/>
                <t t-if="!s.dashed" t-foreach="s.values" t-as="v" t-key="v_index">
                    <circle t-if="v !== null and v !== undefined" t-att-cx="chartX(v_index,s.values.length)" t-att-cy="y(v)" r="3" fill="var(--bd2-card)" t-att-stroke="s.gold ? 'var(--bd2-gold)' : 'var(--bd2-c1)'" stroke-width="2"/>
                    <text t-if="s.area and v !== null and v !== undefined" t-att-x="chartX(v_index,s.values.length)" t-att-y="y(v)-8" text-anchor="middle" fill="var(--bd2-ink)" font-size="9" font-weight="700" t-esc="compact(v)"/>
                </t>
            </t>
            <t t-foreach="props.labels || []" t-as="label" t-key="label_index">
                <text t-att-x="chartX(label_index,props.labels.length)" y="229" text-anchor="middle" fill="var(--bd2-muted)" font-size="10" t-esc="label"/>
            </t>
        </svg>
    </t>
    <t t-name="baseer_dashboard2.Track">
        <div class="bd2-track">
            <i t-att-class="props.gold ? 'gold' : ''" t-att-style="'width:'+width+'%'"/>
        </div>
    </t>
    <t t-name="baseer_dashboard2.Ring">
        <div class="bd2-ring">
            <svg viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="42" fill="none" stroke="var(--bd2-grid)" stroke-width="10"/>
                <circle cx="50" cy="50" r="42" fill="none" stroke="var(--bd2-gold)" stroke-width="10" stroke-linecap="round" stroke-dasharray="264" t-att-stroke-dashoffset="offset" transform="rotate(-90 50 50)"/>
            </svg>
            <b t-esc="props.value == null ? '—' : props.value.toFixed(1)+'%'"/>
        </div>
    </t>
    <t t-name="baseer_dashboard2.Gauge">
        <div class="bd2-gauge">
            <i t-att-style="'width:'+pos(props.value)+'%'"/>
            <b t-if="props.target != null" t-att-style="'right:'+pos(props.target)+'%'"/>
            <em t-if="props.previous != null" t-att-style="'right:'+pos(props.previous)+'%'"/>
        </div>
    </t>
    <t t-name="baseer_dashboard2.KpiCard">
        <div t-att-class="'card kpi '+(props.hero?'hero':'')">
            <Sparkline values="props.trend" gold="props.hero"/>
            <div class="muted" t-esc="props.title"/>
            <div class="kpi-value">
                <Money value="props.value"/>
            </div>
            <div>
                <Badge value="props.change" goodWhen="props.goodWhen"/>
                <span class="muted">عن الشهر السابق</span>
            </div>
        </div>
    </t>
    <t t-name="baseer_dashboard2.Timeline">
        <section class="card timeline">
            <div class="card-head">
                <div>
                    <h3>المسار الزمني للمبيعات</h3>
                    <div class="muted">شهرياً — مقارنة بالعام السابق</div>
                </div>
                <div class="seg">
                    <button t-att-class="state.timeline==='monthly'?'on':''" t-on-click="()=&gt;this.choose('timeline','monthly')">شهري</button>
                    <button t-att-class="state.timeline==='yearly'?'on':''" t-on-click="()=&gt;this.choose('timeline','yearly')">سنوي</button>
                </div>
            </div>
            <div class="stats">
                <div>
                    <small>مبيعات العام حتى تاريخه</small>
                    <b>
                        <Money value="state.data.timeline?.stats.ytd"/>
                    </b>
                </div>
                <div>
                    <small>نفس الفترة من العام السابق</small>
                    <b>
                        <t t-if="state.data.timeline?.stats.previous_ytd == null">غير متوفر</t>
                        <Money t-else="" value="state.data.timeline?.stats.previous_ytd"/>
                    </b>
                </div>
                <div>
                    <small>النمو عن العام السابق</small>
                    <b class="positive" t-esc="state.data.timeline?.stats.previous_ytd == null ? 'غير متوفر' : pct(state.data.timeline?.stats.growth_pct)"/>
                </div>
                <div>
                    <small>أفضل شهر</small>
                    <b t-esc="state.data.timeline?.stats.best_month ? months[state.data.timeline.stats.best_month.month-1]+' · '+fmt(state.data.timeline.stats.best_month.value) : '—'"/>
                </div>
            </div>
            <LineChart series="timelineSeries" labels="timelineLabels"/>
        </section>
    </t>
    <t t-name="baseer_dashboard2.Overview">
        <div class="grid three">
            <div class="card mini" t-foreach="[['المشتريات ونسبتها',state.data.purchases?.value,state.data.purchases?.pct,state.data.purchases?.trend?.map(x=&gt;x.has_data ? x.pct : null),state.data.purchases?.trend?.map(x=&gt;x.has_data ? x.value : null)],['تطبيقات التوصيل ونسبتها',state.data.sales?.apps,state.data.sales?.apps_pct,state.data.sales?.trend?.map(x=&gt;x.has_data ? x.apps_pct : null),state.data.sales?.trend?.map(x=&gt;x.has_data ? x.apps : null)],['عدد العملاء ومتوسط الفاتورة',state.data.sales?.customers?.value,state.data.sales?.customers?.avg_ticket,state.data.sales?.trend?.map(x=&gt;x.has_data ? x.customers.avg_ticket : null),state.data.sales?.trend?.map(x=&gt;x.has_data ? x.customers.value : null)]]" t-as="item" t-key="item[0]">
                <h3 t-esc="item[0]"/>
                <strong t-esc="fmt(item[1])"/>
                <div class="muted" t-esc="item[2] == null ? 'غير متوفر' : (item_index &lt; 2 ? pct(item[2])+' من المبيعات' : fmt(item[2]))"/>
                <Sparkline values="item[3]" gold="true"/><Sparkline values="item[4]"/><div class="mini-labels"><span t-foreach="trendLabels" t-as="label" t-key="label_index" t-esc="label"/></div>
            </div>
        </div>
        <div class="grid five">
            <KpiCard t-foreach="Object.entries(state.data.kpis || {})" t-as="entry" t-key="entry[0]" title="name(entry[0])" value="entry[1].value" change="entry[1].change_pct" trend="entry[1].trend" hero="entry[0]==='net_profit'" goodWhen="entry[1].good_when"/>
        </div>
        <div t-if="state.data.salaries_warning" class="chip">الرواتب أقل بوضوح من متوسط آخر 3 أشهر — قد تكون غير مكتملة</div>
        <div class="grid two-wide">
            <div class="card">
                <h3>المبيعات وصافي الربح مقابل نقطة التعادل</h3>
                <div class="muted">المسافة بين خط المبيعات والخط المتقطع = هامش الأمان</div>
                <LineChart series="[{values:state.data.breakeven_series.map(x=&gt;x.sales_net)}, {values:state.data.breakeven_series.map(x=&gt;x.net_profit),gold:true},{values:state.data.breakeven_series.map(x=&gt;x.breakeven),dashed:true}]" labels="trendLabels"/>
            </div>
            <t t-call="baseer_dashboard2.BreakEven"/>
        </div>
        <div class="card">
            <h3>من المبيعات إلى صافي الربح</h3>
            <div class="muted">كل سطر يبيّن المبلغ ونسبته من المبيعات</div>
            <div t-att-class="'bridge-row '+(row.key==='net_profit'?'net-profit':(['sales_net','gross_profit','operating_profit'].includes(row.key)?'subtotal':''))" t-foreach="state.data.bridge" t-as="row" t-key="row.key">
                <b t-esc="name(row.key)"/>
                <Track value="row.amount" max="current.sales_net" gold="row.key==='net_profit'"/>
                <strong dir="ltr" t-esc="tableFmt(row.amount || 0, true)"/>
                <span class="muted" dir="ltr" t-esc="tablePct(row.pct)"/>
            </div>
        </div>
        <div t-foreach="state.data.sales.warnings" t-as="warning" t-key="warning.company_id+warning.date" class="chip"><t t-esc="warning.date"/> · <t t-esc="warning.label"/></div>
        <t t-call="baseer_dashboard2.Compare"/>
    </t>
    <t t-name="baseer_dashboard2.BreakEven">
        <div class="card">
            <h3>نقطة التعادل</h3>
            <div class="muted">المبيعات اللازمة لتغطية كل التكاليف</div>
            <div t-if="current.breakeven !== null and current.breakeven !== undefined" class="break">
                <div>
                    <small>نقطة التعادل</small>
                    <strong>
                        <Money value="current.breakeven"/>
                    </strong>
                </div>
                <div>
                    <small>المبيعات الفعلية</small>
                    <strong class="positive" t-esc="fmt(current.sales_net)"/>
                </div>
            </div>
            <div class="break-progress"><i t-att-style="'width:'+Math.min(100, Math.max(0, 100 * (current.breakeven || 0) / (current.sales_net || 1)))+'%'"/></div>
            <div t-if="current.breakeven == null" class="muted">غير متوفر — هامش المساهمة غير صالح</div>
            <div t-else="" class="muted">هامش الأمان: <t t-esc="fmt(current.safety_margin)"/> ر.س</div><div class="break-details"><div><small>نسبة التغطية</small><strong t-esc="current.breakeven ? pct(current.sales_net / current.breakeven * 100) : 'غير متوفر'"/></div><div><small>يوم الوصول للتعادل</small><strong t-esc="state.data.breakeven?.day ? state.data.breakeven.day + ' يوم' : 'غير متوفر'"/></div></div>
        </div>
    </t>
    <t t-name="baseer_dashboard2.Compare">
        <div class="card" t-if="state.data.companies_compare?.length &gt; 1">
            <h3>مقارنة الشركات</h3>
            <div class="muted">الشركات جنب بعض</div>
            <table>
                <thead>
                    <tr>
                        <th>الشركة</th>
                        <th>المبيعات</th>
                        <th>تكلفة الأكل</th>
                        <th>الرواتب</th>
                        <th>صافي الهامش</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="state.data.companies_compare" t-as="co" t-key="co.key" t-att-class="co.key===state.company?'highlight':''">
                        <th t-esc="co.label"/>
                        <td t-esc="tableFmt(co.sales_net)"/>
                        <td t-esc="tablePct(co.food_pct)"/>
                        <td t-esc="tablePct(co.salaries_pct)"/>
                        <td t-esc="tablePct(co.net_margin_pct)"/>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>
    <t t-name="baseer_dashboard2.Revenue">
        <div class="grid four">
            <KpiCard title="'إجمالي المبيعات'" value="current.gross" hero="true"/>
            <KpiCard title="'مبيعات التطبيقات'" value="current.apps"/>
            <KpiCard title="'عدد العملاء (الطلبات)'" value="current.customers?.value"/>
            <KpiCard title="'متوسط الفاتورة'" value="current.customers?.avg_ticket"/>
        </div>
        <t t-call="baseer_dashboard2.Timeline"/>
        <div class="grid two-wide">
            <div class="card">
                <h3>المبيعات حسب طريقة الدفع</h3>
                <div class="muted">مرتبة من الأعلى · المبلغ وحصته من المبيعات والتغير</div>
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>الطريقة</th>
                            <th>الحصة</th>
                            <th>المبلغ</th>
                            <th>٪</th>
                            <th>التغير</th>
                            <th>الاتجاه</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.data.ranked" t-as="row" t-key="row.key">
                            <td t-esc="row_index+1"/>
                            <th>
                                <t t-esc="row.name"/>
                                <small class="block muted" t-esc="row.kind==='app'?'تطبيق':'الصالة'"/>
                            </th>
                            <td>
                                <Track value="row.amount" max="state.data.ranked[0]?.amount" gold="row_index===0"/>
                            </td>
                            <td t-esc="tableFmt(row.amount)"/>
                            <td t-esc="tablePct(row.share_pct)"/>
                            <td>
                                <Badge value="row.change_pct"/>
                            </td>
                            <td>
                                <Sparkline values="row.trend"/>
                            </td>
                        </tr>
                        <tr class="highlight">
                            <th colspan="3">المجموع</th>
                            <th t-esc="tableFmt(current.gross)"/>
                            <td t-esc="current.gross == null ? '—' : '100%'"/>
                            <td colspan="2">الصالة <t t-esc="fmt(state.data.split.hall)"/> · التطبيقات <t t-esc="fmt(state.data.split.apps)"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="card">
                <h3>التطبيقات ونسبتها من المبيعات</h3>
                <LineChart series="[{values:trend.map(x=&gt;x.has_data === false ? null : x.data.apps),gold:true},{values:trend.map(x=&gt;x.has_data === false ? null : x.data.gross)}]" labels="trendLabels"/>
            </div>
        </div>
        <div class="grid two">
            <div class="card">
                <h3>عمولات تطبيقات التوصيل</h3>
                <div t-if="!state.data.commissions.available" class="muted">غير متوفر — حدّد نسب العمولة من الإعدادات</div>
                <table t-else="">
                    <thead>
                        <tr>
                            <th>التطبيق</th>
                            <th>المبيعات</th>
                            <th>العمولة</th>
                            <th>الصافي</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.data.commissions.rows" t-as="r" t-key="r.key">
                            <th t-esc="r.name"/>
                            <td t-esc="tableFmt(r.gross)"/>
                            <td t-esc="tableFmt(r.commission)"/>
                            <td t-esc="tableFmt(r.net)"/>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="card">
                <h3>عدد العملاء ومتوسط الفاتورة</h3>
                <div t-if="!current.customers?.available" class="muted">غير متوفر — يتوفر من بيانات نقاط البيع فقط</div>
                <LineChart t-else="" series="[{values:trend.map(x=&gt;x.has_data ? x.data.customers?.value : null)}]" labels="trendLabels"/>
            </div>
        </div>
    </t>
    <t t-name="baseer_dashboard2.Expenses">
        <div t-if="state.data.salaries_warning" class="chip">الرواتب أقل بوضوح من متوسط آخر 3 أشهر — قد تكون غير مكتملة</div>
        <div class="grid four">
            <KpiCard title="'إجمالي المصاريف'" value="state.data.has_data ? totalExpense(current) : null" hero="true"/>
            <KpiCard title="'تكلفة الأكل'" value="state.data.has_data ? current.categories?.food_cost : null"/>
            <KpiCard title="'الرواتب'" value="state.data.has_data ? current.categories?.salaries : null"/>
            <KpiCard title="'الإيجار والكهرباء'" value="state.data.has_data ? (current.categories?.rent || 0)+(current.categories?.utilities || 0) : null"/>
        </div>
        <div class="grid two-wide">
            <div class="card">
                <h3>المصاريف مقابل المبيعات</h3>
                <div class="muted">آخر 6 أشهر</div>
                <LineChart series="[{values:series('sales_net')},{values:trend.map(x=&gt;x.has_data === false ? null : totalExpense(x.data)),gold:true}]" labels="trendLabels"/>
            </div>
            <div class="card">
                <h3>توزيع المصاريف</h3>
                <div class="ring-row">
                    <Ring value="state.data.ring.value"/>
                    <div>
                        <div class="muted">إجمالي المصاريف</div>
                        <b t-esc="fmt(state.data.has_data ? totalExpense(current) : null)"/>
                    </div>
                </div>
                <div t-if="!state.data.ring.available" class="muted">غير متوفر — لا توجد مبيعات</div>
                <div class="rank-row" t-foreach="expenses" t-as="row" t-key="row.key">
                    <b t-esc="name(row.key)"/>
                    <Track value="row.amount" max="expenses[0]?.amount" gold="row_index===0"/>
                    <strong t-esc="fmt(row.amount)"/>
                    <small t-esc="pct(row.pct)"/>
                </div>
            </div>
        </div>
        <div class="card">
            <h3>المصاريف حسب البند — مقارنة شهرية</h3>
            <table>
                <thead>
                    <tr>
                        <th>البند</th>
                        <th>الاتجاه</th>
                        <th t-foreach="trend" t-as="m" t-key="m.month" t-esc="monthName(m.month)"/>
                        <th>التغير</th>
                        <th>٪ من المبيعات</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="expenses" t-as="row" t-key="row.key">
                        <th t-esc="name(row.key)"/>
                        <td>
                            <Sparkline values="row.trend"/>
                        </td>
                        <td t-foreach="row.trend" t-as="v" t-key="v_index" t-esc="tableFmt(v)"/>
                        <td>
                            <Badge value="row.previous ? (row.amount-row.previous)/Math.abs(row.previous)*100 : null" goodWhen="'down'"/>
                        </td>
                        <td t-esc="tablePct(row.pct)"/>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>
    <t t-name="baseer_dashboard2.Ratios">
        <div class="grid four">
            <div class="card ratio" t-foreach="['food_pct','salaries_pct','prime_pct','net_margin_pct']" t-as="key" t-key="key">
                <h3 t-esc="name(key)"/>
                <div class="muted">من المبيعات</div>
                <strong t-esc="pct(current.ratios?.[key])"/>
                <span t-if="current.ratios?.[key] != null and state.data.targets[key]" t-att-class="'bd2-badge '+(state.data.targets[key].status === 'ok' ? 'good' : 'bad')" t-esc="state.data.targets[key].status === 'ok' ? 'ضمن المستهدف' : 'خارج المستهدف'"/>
                <div class="muted">المستهدف <t t-esc="pct(state.data.targets[key]?.value)"/>
                    <input t-if="state.meta.can_edit and state.data.targets[key]" class="target-input" type="number" min="0" max="100" t-att-value="state.data.targets[key].value" t-on-change="(e)=&gt;this.saveTarget(key,e)"/>
                </div>
                <Gauge value="current.ratios?.[key]" previous="state.data.previous.ratios?.[key]" target="state.data.targets[key]?.value" max="100"/>
                <Sparkline values="trend.map(x=&gt;x.has_data ? x.data.ratios[key] : null)"/>
            </div>
        </div>
        <div class="grid two">
            <div class="card">
                <h3>اتجاه نسب التكلفة</h3>
                <LineChart series="[{values:trend.map(x=&gt;x.has_data ? x.data.ratios.food_pct : null)},{values:trend.map(x=&gt;x.has_data ? x.data.ratios.salaries_pct : null),gold:true}]" labels="trendLabels"/>
            </div>
            <div class="card">
                <h3>مجمل الهامش وصافي الهامش</h3>
                <LineChart series="[{values:trend.map(x=&gt;x.data.sales_net ? x.data.gross_profit/x.data.sales_net*100 : null)},{values:trend.map(x=&gt;x.has_data ? x.data.ratios.net_margin_pct : null),gold:true}]" labels="trendLabels"/>
            </div>
        </div>
        <div class="grid two-wide">
            <t t-call="baseer_dashboard2.Compare"/>
            <t t-call="baseer_dashboard2.BreakEven"/>
        </div>
    </t>
    <t t-name="baseer_dashboard2.Pnl">
        <div class="view-controls">
            <div class="seg">
                <button t-att-class="state.view==='pnl'?'on':''" t-on-click="()=&gt;this.choose('view','pnl')">الربح والخسارة</button>
                <button t-att-class="state.view==='inout'?'on':''" t-on-click="()=&gt;this.choose('view','inout')">الداخل والخارج</button>
            </div>
            <span class="chip" t-esc="state.view==='pnl'?'قبل الضريبة':'شامل الضريبة'"/>
        </div>
        <div t-if="state.view==='inout'" class="stats card">
            <div>
                <small>الداخل</small>
                <b t-esc="fmt(state.data.months.at(-1)?.incoming.available ? state.data.months.at(-1).incoming.gross : null)"/>
            </div>
            <div>
                <small>الخارج الفعلي</small>
                <b t-esc="fmt(state.data.months.at(-1)?.outgoing.available ? state.data.months.at(-1).outgoing.total : null)"/>
            </div>
            <div>
                <small>الصافي</small>
                <b t-esc="fmt(state.data.months.at(-1)?.incoming.available and state.data.months.at(-1)?.outgoing.available ? state.data.months.at(-1).net : null)"/>
            </div>
            <div>
                <small>تطبيقات لم تُستلم بعد</small>
                <b t-esc="state.data.months.at(-1)?.incoming.apps_unreceived.available ? fmt(state.data.months.at(-1).incoming.apps_unreceived.value) : state.data.months.at(-1)?.incoming.apps_unreceived.label"/>
            </div>
        </div>
        <div t-if="state.data.salaries_warning" class="chip">الرواتب أقل بوضوح من متوسط آخر 3 أشهر — قد تكون غير مكتملة</div>
        <div class="card table-wrap">
            <div class="card-head">
                <div>
                    <h3 t-esc="state.view==='pnl'?'قائمة الدخل (الربح والخسارة)':'الداخل والخارج'"/>
                    <div class="muted" t-esc="state.view==='inout' ? 'الداخل = المبيعات شاملة الضريبة · الخارج = المدفوع فعلياً من البنك والنقد والعهدة وحسابات التطبيقات' : 'المبالغ بالريال، الأقواس = خصم'"/>
                </div>
                <button class="icon-button" t-on-click="exportCsv" title="تنزيل CSV">↓</button>
            </div>
            <table t-if="state.view==='pnl'" class="export-table">
                <thead>
                    <tr>
                        <th>البند</th>
                        <th>الاتجاه</th>
                        <th t-foreach="trend" t-as="m" t-key="m.month" t-esc="monthName(m.month)"/>
                        <th class="highlight">المجموع</th>
                        <th>٪ من المبيعات</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="state.data.rows" t-as="row" t-key="row.key">
                        <tr t-att-class="row.key==='net_profit'?'net': ['gross_profit','operating_profit'].includes(row.key)?'highlight':'group'" t-on-click="()=&gt;this.toggleRow(row.key)">
                            <th>
                                <span t-if="row.children.length">▾</span>
                                <t t-esc="row.name || name(row.key)"/>
                            </th>
                            <td>
                                <Sparkline values="row.months"/>
                            </td>
                            <td t-foreach="row.months" t-as="v" t-key="v_index" t-esc="tableFmt(v)"/>
                            <td t-esc="tableFmt(row.total)"/>
                            <td t-esc="tablePct(row.pct)"/>
                        </tr>
                        <tr t-if="!state.closed[row.key]" t-foreach="row.children" t-as="child" t-key="child_index" class="account">
                            <td>
                                <span class="muted account-code" dir="ltr" t-esc="child.code"/>
                                <t t-esc="child.code ? ' '+child.name : child.name"/>
                            </td>
                            <td>
                                <Sparkline values="child.months"/>
                            </td>
                            <td t-foreach="child.months" t-as="v" t-key="v_index" t-esc="tableFmt(v)"/>
                            <td t-esc="tableFmt(child.total)"/>
                            <td t-esc="tablePct(child.pct)"/>
                        </tr>
                    </t>
                </tbody>
            </table>
            <table t-else="" class="export-table">
                <thead>
                    <tr>
                        <th>البند</th>
                        <th>الاتجاه</th>
                        <th t-foreach="state.data.months" t-as="m" t-key="m.month" t-esc="monthName(m.month)"/>
                        <th class="highlight">المجموع</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-if="state.data.months.some(m=&gt;!m.outgoing.available)"><td colspan="9">الخارج غير مُعد للشركات: <t t-esc="state.data.months[0].outgoing.unconfigured_company_ids.join(', ')"/></td></tr>
                    <t t-foreach="[['incoming','الداخل — المبيعات حسب القناة','channels'],['outgoing','الخارج الفعلي — حسب البند','items'],['outgoing','الخارج الفعلي — حسب المصدر','sources']]" t-as="group" t-key="group[2]">
                        <tr class="group">
                            <th>
                                <t t-esc="group[1]"/> ▾</th>
                            <td>
                                <Sparkline values="state.data.months.map(m=&gt;group[0]==='incoming'?(m.incoming.available ? m.incoming.gross : null):(m.outgoing.available ? m.outgoing.total : null))"/>
                            </td>
                            <td t-foreach="state.data.months" t-as="m" t-key="m.month" t-esc="group[0]==='incoming'?tableFmt(m.incoming.available ? m.incoming.gross : null)+(m.incoming.accounting_fallback?' · من الإيراد المحاسبي':''):(!m.outgoing.available?'غير مُعد':tableFmt(-m.outgoing.total))"/>
                            <td t-esc="group[0]==='incoming'?tableFmt(state.data.total[group[0]]):(state.data.months.some(m=&gt;!m.outgoing.available)?'غير مُعد':tableFmt(-state.data.total[group[0]]))"/>
                        </tr>
                        <tr t-foreach="Object.keys(state.data.total[group[2]])" t-as="key" t-key="key" t-if="key !== 'vat_paid' || state.data.months.some(m=&gt;m.outgoing.show_vat_paid_line)">
                            <td t-esc="name(key)"/>
                            <td>
                                <Sparkline values="state.data.months.map(m=&gt;m[group[0]][group[2]][key] ?? null)"/>
                            </td>
                            <td t-foreach="state.data.months" t-as="m" t-key="m.month" t-esc="tableFmt(m[group[0]][group[2]][key] == null ? null : group[0]==='incoming' ? m[group[0]][group[2]][key] : -m[group[0]][group[2]][key])"/>
                            <td t-esc="tableFmt(group[0]==='incoming'?state.data.total[group[2]][key]:-state.data.total[group[2]][key])"/>
                        </tr>
                        <tr class="account" t-if="group[2]==='channels'">
                            <td>منها تطبيقات لم تُستلم بعد</td>
                            <td/>
                            <td t-foreach="state.data.months" t-as="m" t-key="m.month" t-esc="m.incoming.apps_unreceived.available ? tableFmt(m.incoming.apps_unreceived.value) : m.incoming.apps_unreceived.label"/>
                            <td t-esc="state.data.total.apps_unreceived.available ? tableFmt(state.data.total.apps_unreceived.value) : state.data.total.apps_unreceived.label"/>
                        </tr>
                        <tr class="account" t-if="group[2]==='channels'">
                            <td>منها ضريبة القيمة المضافة</td>
                            <td/>
                            <td t-foreach="state.data.months" t-as="m" t-key="m.month" t-esc="tableFmt(m.sales_vat.value)"/>
                            <td t-esc="tableFmt(state.data.total.sales_vat)"/>
                        </tr>
                        <tr class="account" t-if="group[2]==='items'">
                            <td>فواتير غير مسددة — نهاية الفترة</td>
                            <td/>
                            <td t-foreach="state.data.months" t-as="m" t-key="m.month" t-esc="tableFmt(m.unpaid_bills.value)"/>
                            <td t-esc="tableFmt(state.data.total.unpaid_bills.value)"/>
                        </tr>
                    </t>
                    <tr class="net">
                        <th>الصافي = الداخل − الخارج</th>
                        <td>
                            <Sparkline values="state.data.months.map(m=&gt;m.net)" gold="true"/>
                        </td>
                        <td t-foreach="state.data.months" t-as="m" t-key="m.month" t-esc="tableFmt(m.net)"/>
                        <td t-esc="tableFmt(state.data.total.net)"/>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>
    <t t-name="baseer_dashboard2.Heatmap">
        <div class="stats card">
            <div>
                <small>معدل المبيعات اليومي</small>
                <b t-esc="fmt(state.data.daily_average.current)"/>
            </div>
            <div>
                <small>معدل العملاء اليومي</small>
                <b t-esc="hasCustomers ? fmt(state.data.days.reduce((a,d)=&gt;a+(d.customers||0),0) / state.data.days.filter(d=&gt;d.customers!==null).length) : 'غير متوفر'"/>
            </div>
            <div>
                <small>إجمالي العملاء</small>
                <b t-esc="state.data.days.some(d=&gt;d.customers!==null) ? fmt(state.data.days.reduce((a,d)=&gt;a+(d.customers||0),0)) : 'غير متوفر'"/>
            </div>
            <div>
                <small>إجمالي المبيعات</small>
                <b t-esc="fmt(state.data.days.some(d=&gt;d.gross!==null) ? state.data.days.reduce((a,d)=&gt;a+(d.gross||0),0) : null)"/>
            </div>
            <div>
                <small>أفضل يوم</small>
                <b t-esc="dateName(state.data.best_day?.date)"/>
            </div>
        </div>
        <div class="card">
            <div class="card-head">
                <div>
                    <h3>التقويم الحراري — <t t-esc="monthName(state.period.month)"/>
                    </h3>
                    <div class="muted">الرقم الكبير = المبيعات (ر.س) · السطر الصغير = عدد العملاء</div>
                </div>
                <div class="seg">
                    <button t-att-class="state.metric==='gross'?'on':''" t-on-click="()=&gt;state.metric='gross'">المبيعات</button>
                    <button t-att-class="state.metric==='customers'?'on':''" t-att-disabled="!hasCustomers" title="غير متوفر قبل تشغيل نقاط البيع" t-on-click="()=&gt;state.metric='customers'">عدد الطلبات</button>
                    <button disabled="disabled" title="غير متوفر">التطبيقات</button>
                    <button t-att-class="state.metric==='ticket'?'on':''" t-att-disabled="!hasCustomers" title="غير متوفر قبل تشغيل نقاط البيع" t-on-click="()=&gt;state.metric='ticket'">متوسط الفاتورة</button>
                </div>
            </div>
            <div class="month-chips">
                <button t-foreach="months" t-as="month" t-key="month_index" t-att-class="Number(state.period.month.slice(5))===month_index+1?'on':''" t-on-click="()=&gt;this.periodChange('month',state.period.month.slice(0,4)+'-'+String(month_index+1).padStart(2,'0'))" t-esc="month"/>
            </div>
            <div class="calendar">
                <div class="weekday" t-foreach="weekdays" t-as="wd" t-key="wd_index">
                    <b t-esc="wd"/>
                    <small>معدل <t t-esc="fmt(state.data.weekday_month[(wd_index+5)%7]?.gross)"/>
                    </small>
                </div>
                <t t-foreach="calendarCells" t-as="day" t-key="day_index">
                    <div t-if="!day"/>
                    <div t-else="" t-att-class="'day level-'+level(day)+(day.events.length ? ' occasion' : '')" t-att-title="day.events.map(e=&gt;e.name).join('، ')">
                        <small t-esc="Number(day.date.slice(-2))"/>
                        <strong t-esc="fmt(dayValue(day))"/>
                        <span>
                            <t t-esc="fmt(day.customers)"/> عميل</span>
                        <em t-foreach="day.events" t-as="event" t-key="event.id" t-esc="event.name"/>
                    </div>
                </t>
            </div>
        </div>
        <div class="card">
            <h3>معدل المبيعات والعملاء حسب يوم الأسبوع</h3>
            <table>
                <thead>
                    <tr>
                        <th>الفترة</th>
                        <th t-foreach="weekdays" t-as="wd" t-key="wd" t-esc="wd"/>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>الشهر</th>
                        <td t-foreach="weekdays" t-as="wd" t-key="wd_index">
                            <b t-esc="fmt(state.data.weekday_month[(wd_index+5)%7]?.gross)"/>
                            <small class="block">
                                <t t-esc="fmt(state.data.weekday_month[(wd_index+5)%7]?.customers)"/> عميل</small>
                        </td>
                    </tr>
                    <tr>
                        <th>السنة</th>
                        <td t-foreach="weekdays" t-as="wd" t-key="wd_index" t-esc="fmt(state.data.weekday_ytd[(wd_index+5)%7]?.gross)"/>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card">
            <h3>نظرة على السنة</h3>
            <div class="year-grid">
                <div t-foreach="state.data.year_calendar" t-as="m" t-key="m.month">
                    <b t-esc="monthName(m.month)"/>
                    <div class="year-days">
                        <i t-foreach="m.days" t-as="d" t-key="d.date" t-att-class="'level-'+level(d)+(d.events.length ? ' occasion' : '')" t-att-title="dateName(d.date)+' · '+fmt(d.gross)+' · '+d.events.map(e=&gt;e.name).join('، ')">
                            <span t-esc="Number(d.date.slice(-2))"/>
                            <b t-esc="fmt(d.gross)"/>
                        </i>
                    </div>
                </div>
            </div>
        </div>
        <div class="grid two">
            <div class="card">
                <div class="card-head">
                    <h3>المناسبات والعروض</h3>
                    <button t-if="state.meta.can_edit" class="chip" t-on-click="addEvent">+ إضافة مناسبة</button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>المناسبة</th>
                            <th>من</th>
                            <th>إلى</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.data.events" t-as="e" t-key="e.id">
                            <td t-esc="e.name"/>
                            <td t-esc="dateName(e.date_from)"/>
                            <td t-esc="dateName(e.date_to)"/>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="card">
                <h3>أوقات الذروة — اليوم × الساعة</h3>
                <div t-if="!state.data.hours.available" class="muted">غير متوفر — يتوفر من بيانات نقاط البيع فقط</div>
                <div t-else="" class="hours">
                    <span t-foreach="state.data.hours.matrix" t-as="h" t-key="h_index" t-att-title="h.weekday+' / '+h.hour" t-esc="fmt(h.orders)"/>
                </div>
            </div>
        </div>
    </t>
    <t t-name="baseer_dashboard2.Glossary">
        <div class="grid two">
            <div class="card glossary" t-foreach="Object.entries(state.data.sources)" t-as="entry" t-key="entry[0]">
                <h3 t-esc="name(entry[0])"/>
                <p class="muted" t-esc="entry[1]"/>
            </div>
        </div>
        <div class="card">
            <h3>مصادر البيانات</h3>
            <table>
                <tbody>
                    <tr t-foreach="Object.entries(state.data.sources)" t-as="entry" t-key="entry[0]">
                        <th t-esc="name(entry[0])"/>
                        <td t-esc="entry[1]"/>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>
    <t t-name="baseer_dashboard2.Main">
        <div class="o_bd2" dir="rtl" data-bd2-theme="navy-gold" t-att-data-bd2-mode="state.mode">
            <aside class="bd2-sidebar">
                <div class="brand">
                    <div class="brand-icon">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 20h17M7 17V9M12 17V4M17 17v-6"/>
                        </svg>
                    </div>
                    <div>
                        <strong>جروك داشبورد</strong>
                        <small>التحليل المالي</small>
                    </div>
                </div>
                <nav>
                    <button t-foreach="pages" t-as="p" t-key="p[0]" t-att-class="state.page===p[0]?'active':''" t-on-click="()=&gt;this.choose('page',p[0])">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                            <path t-att-d="icons[p[0]]"/>
                        </svg>
                        <t t-esc="p[1]"/>
                    </button>
                </nav>
                <footer>
                    <div>● آخر بيانات مرحّلة: <t t-esc="state.meta?.last_data_date || '—'"/>
                    </div>
                    <div>المصدر: أودو — المحاسبة</div>
                </footer>
            </aside>
            <main class="bd2-main">
                <header class="bd2-header">
                    <div>
                        <h1 t-esc="page[1]"/>
                        <div class="muted" t-esc="page[2]"/>
                    </div>
                    <span class="chip">بيانات أودو المرحّلة</span>
                    <div class="header-controls">
                        <div class="seg">
                            <button t-foreach="state.meta?.companies || []" t-as="co" t-key="co.key" t-att-class="state.company===co.key?'on':''" t-on-click="()=&gt;this.choose('company',co.key)" t-esc="co.label"/>
                        </div>
                        <div class="seg">
                            <button t-att-class="state.period?.mode==='month'?'on':''" t-on-click="()=&gt;this.periodChange('mode','month')">شهر</button>
                            <button t-att-class="state.period?.mode==='range'?'on':''" t-on-click="()=&gt;this.periodChange('mode','range')">من – إلى</button>
                            <select t-if="state.period?.mode==='month'" t-att-value="state.period.month" t-on-change="(e)=&gt;this.periodChange('month',e.target.value)">
                                <option t-foreach="state.meta?.months_available || []" t-as="m" t-key="m" t-att-value="m" t-att-selected="m===state.period.month" t-esc="monthName(m)"/>
                                <option t-if="state.meta?.today and !state.meta.months_available.includes(state.meta.today.slice(0,7))" t-att-value="state.meta.today.slice(0,7)" t-esc="monthName(state.meta.today.slice(0,7))"/>
                                <option t-if="!state.meta?.months_available.length" t-att-value="state.period.month" t-esc="monthName(state.period.month)"/>
                            </select>
                            <t t-else="">
                                <input type="date" t-att-value="state.period?.date_from" t-on-change="(e)=&gt;this.periodChange('date_from',e.target.value)"/>
                                <input type="date" t-att-value="state.period?.date_to" t-on-change="(e)=&gt;this.periodChange('date_to',e.target.value)"/>
                            </t>
                        </div>
                        <button class="icon-button" title="الوضع الليلي" t-on-click="()=&gt;this.choose('mode',state.mode==='light'?'dark':'light')">☾</button>
                    </div>
                </header>
                <div class="context">
                    <span>عرض:</span>
                    <span class="chip" t-esc="companyName"/>
                    <span class="chip" t-esc="state.period?.mode==='month' ? monthName(state.period.month) : dateName(state.period?.date_from)+' – '+dateName(state.period?.date_to)"/>
                    <span t-if="state.period?.mode==='month' and state.period.month===state.meta?.today.slice(0,7)" class="chip">جزئي</span>
                    <span class="chip">الاتجاه: آخر 6 أشهر</span>
                    <span t-if="state.data?.sales?.source_counts" class="chip" t-esc="state.data.sales.source_counts.summary ? 'المصدر: ملخصات يومية' : 'المصدر: نقاط البيع'"/>
                </div>
                <div t-if="state.loading" class="card loading">جارٍ تحميل البيانات…</div>
                <div t-elif="state.error" class="card error" t-esc="state.error"/>
                <div t-elif="state.data?.available === false" class="card">غير متوفر <div class="muted" t-esc="state.data.reason"/>
                </div>
                <t t-else="">
                    <t t-if="state.page==='overview'" t-call="baseer_dashboard2.Timeline"/>
                    <t t-if="state.page==='overview'" t-call="baseer_dashboard2.Overview"/>
                    <t t-if="state.page==='revenue'" t-call="baseer_dashboard2.Revenue"/>
                    <t t-if="state.page==='expenses'" t-call="baseer_dashboard2.Expenses"/>
                    <t t-if="state.page==='ratios'" t-call="baseer_dashboard2.Ratios"/>
                    <t t-if="state.page==='pnl'" t-call="baseer_dashboard2.Pnl"/>
                    <t t-if="state.page==='heatmap'" t-call="baseer_dashboard2.Heatmap"/>
                    <t t-if="state.page==='glossary'" t-call="baseer_dashboard2.Glossary"/>
                </t>
            </main>
        </div>
    </t>
</templates>
