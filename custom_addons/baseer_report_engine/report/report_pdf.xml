<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_report_engine" model="report.paperformat">
        <field name="name">Baseer Report Engine A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
    </record>
    <record id="action_report_pdf" model="ir.actions.report">
        <field name="name">Baseer Report</field>
        <field name="model">baseer.report.definition</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baseer_report_engine.report_pdf</field>
        <field name="report_file">baseer_report_engine.report_pdf</field>
        <field name="paperformat_id" ref="paperformat_report_engine"/>
    </record>
    <template id="report_pdf">
        <t t-set="o" t-value="company"/>
        <t t-call="web.basic_layout">
            <div class="page bre-pdf" t-att-dir="'rtl' if arabic else 'ltr'">
                <style>
                    .bre-pdf { font-family: DejaVu Sans, Arial, sans-serif; color: #243246; font-size: 10px; }
                    .bre-pdf h1 { font-size: 16px; margin: 0 0 4px; }
                    .bre-pdf .meta { color: #5d6b7a; margin-bottom: 8px; }
                    .bre-pdf .note { background: #e7f2f4; padding: 4px 6px; margin: 0 0 8px; }
                    .bre-pdf table { width: 100%; border-collapse: collapse; }
                    .bre-pdf th, .bre-pdf td { padding: 3px 5px; border-bottom: 1px solid #e1e6ea; vertical-align: top; }
                    .bre-pdf thead { display: table-header-group; }
                    .bre-pdf tr { page-break-inside: avoid; }
                    .bre-pdf .num { direction: ltr; unicode-bidi: isolate; text-align: right; white-space: nowrap; }
                    .bre-pdf .negative { color: #c72634; }
                    .bre-pdf .section th, .bre-pdf .section td { font-weight: 700; }
                    .bre-pdf .band th, .bre-pdf .band td { background: #d8dadd; font-weight: 700; }
                    .bre-pdf .total th, .bre-pdf .total td { border-top: 1px solid #b7c0c8; font-weight: 700; }
                    .bre-pdf .grid .shaded { background: #f9fafb; }
                    .bre-pdf .grid .groups th:not(:first-child) { border: 1px solid #d8dadd; text-align: center; }
                    .bre-pdf .grid .total th, .bre-pdf .grid .total td { border-top: 0; }
                    .bre-pdf .account td { color: #3c4c5e; }
                </style>
                <h1 t-esc="payload['report']['name']"/>
                <div class="meta">
                    <div t-esc="' · '.join(company['name'] for company in payload['companies'])"/>
                    <div>
                        <span t-esc="payload['currency']['code']"/>
                        <t t-if="payload['columns']"> · <bdi t-esc="payload['column_groups'][0]['label'] if payload['report'].get('report_kind') in ('partner_ledger', 'aged') else payload['columns'][0]['label']"/></t>
                    </div>
                </div>
                <div t-if="payload.get('filter_line')" class="meta" t-esc="payload['filter_line']"/>
                <div class="note">
                    <div t-foreach="payload['notes']" t-as="note" t-esc="note"/>
                </div>
                <table t-att-class="'grid' if payload.get('column_groups') else ''">
                    <thead>
                        <tr t-if="payload.get('column_groups')" class="groups">
                            <th/>
                            <th t-foreach="payload['column_groups']" t-as="group" t-att-colspan="group['colspan']" class="num" t-esc="group['label']"/>
                        </tr>
                        <tr>
                            <th t-esc="'' if payload.get('column_groups') else payload['report']['name']"/>
                            <th t-foreach="payload['columns']" t-as="column" t-att-class="'num shaded' if payload.get('column_groups') and (column['figure'] == 'debit' or column['kind'] == 'end') else 'num'"><bdi t-esc="column['label']"/></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="payload['lines']" t-as="line">
                            <tr t-att-class="line['display'] + (' band' if (line['level'] == 0 and line['display'] == 'section') or (not payload.get('column_groups') and payload['report']['date_mode'] == 'range' and line['display'] == 'total') else '')">
                                <th>
                                    <span t-attf-style="#{'padding-right' if arabic else 'padding-left'}: #{8 + line['level'] * 14}px">
                                        <t t-if="payload.get('column_groups') and line['display'] != 'total' and payload['report'].get('report_kind') not in ('partner_ledger', 'aged')"><bdi t-if="line['account_code']" t-esc="line['account_code']"/> <bdi t-esc="line['account_name']"/></t>
                                        <t t-else="" t-esc="line['name']"/>
                                    </span>
                                </th>
                                <t t-if="payload['report'].get('report_kind') == 'ledger'"><td/><td/><td/></t>
                                <t t-if="payload['report'].get('report_kind') == 'partner_ledger'"><td/><td/><td/><td/><td/><td class="num" t-esc="line['amounts'][0]['display']"/><td class="num" t-esc="line['amounts'][1]['display']"/><td/><td class="num" t-esc="line['amounts'][2]['display']"/></t>
                                <td t-if="payload['report'].get('report_kind') == 'aged'"/>
                                <td t-if="payload['report'].get('report_kind') != 'partner_ledger'" t-foreach="line['amounts']" t-as="amount" t-att-class="'num' + (' negative' if amount['negative'] else '') + (' shaded' if payload.get('column_groups') and (payload['columns'][amount_index + (3 if payload['report'].get('report_kind') == 'ledger' else 0)]['figure'] == 'debit' or payload['columns'][amount_index + (3 if payload['report'].get('report_kind') == 'ledger' else 0)]['kind'] == 'end') else '')" t-esc="amount['display'] if not line.get('hide_amounts') and not (payload['report'].get('report_kind') == 'aged' and line['display'] == 'section') else ''"/>
                            </tr>
                            <tr t-if="payload['report'].get('report_kind') not in ('partner_ledger', 'aged')" t-foreach="line.get('ledger', {}).get('rows', [])" t-as="item" t-att-class="'total' if item['type'] == 'total' else 'account'">
                                <td t-esc="item['name']"/><td t-esc="item.get('date', '')"/><td t-esc="item.get('partner', '')"/><td t-esc="item.get('currency', '')"/>
                                <td t-foreach="item['amounts']" t-as="amount" class="num" t-esc="amount['display']"/>
                            </tr>
                            <tr t-if="payload['report'].get('report_kind') == 'aged'" t-foreach="line.get('ledger', {}).get('rows', [])" t-as="item" class="account">
                                <td t-esc="item['name']"/><td t-esc="item.get('invoice_date', '')"/><td t-foreach="item['amounts']" t-as="amount" class="num" t-esc="amount['display']"/>
                            </tr>
                            <tr t-if="payload['report'].get('report_kind') == 'partner_ledger'" t-foreach="line.get('ledger', {}).get('rows', [])" t-as="item" t-att-class="'total' if item['type'] == 'total' else 'account'">
                                <td t-esc="item['name']"/><td t-esc="item.get('journal', '')"/><td t-esc="item.get('account', '')"/><td t-esc="item.get('invoice_date', '')"/><td t-att-style="'color: #d23f3a' if item.get('overdue') else ''" t-esc="item.get('due_date', '')"/><td t-esc="item.get('matching', '')"/><td class="num" t-esc="item['amounts'][0]['display']"/><td class="num" t-esc="item['amounts'][1]['display']"/><td class="num" t-esc="item.get('amount_currency', '')"/><td class="num" t-esc="item['amounts'][2]['display']"/>
                            </tr>
                            <tr t-foreach="line.get('accounts', [])" t-as="account" class="account">
                                <td>
                                    <span t-if="arabic" t-attf-style="padding-right: #{22 + line['level'] * 14}px">
                                        <bdi t-esc="account['code']"/> <bdi t-esc="account['name']"/>
                                    </span>
                                    <span t-else="" t-attf-style="padding-left: #{22 + line['level'] * 14}px">
                                        <bdi t-esc="account['code']"/> <bdi t-esc="account['name']"/>
                                    </span>
                                </td>
                                <td t-foreach="account['amounts']" t-as="amount" t-att-class="'num negative' if amount['negative'] else 'num'" t-esc="amount['display']"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <div class="footer" style="font-family: DejaVu Sans, Arial, sans-serif; font-size: 8px; color: #657487; border-top: 1px solid #d9dfe4; padding-top: 4px;">
                <span t-esc="company.name"/>
                <span style="float: right;"><span class="page"/> / <span class="topage"/></span>
            </div>
        </t>
    </template>
</odoo>
