<odoo>
  <record id="account_move_form_voucher" model="ir.ui.view">
    <field name="name">account.move.form.abroj.voucher</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <field name="abroj_voucher_id" invisible="1"/>
        <button name="action_open_abroj_voucher" type="object" class="oe_stat_button" icon="fa-file-text-o" string="السند" invisible="not abroj_voucher_id"/>
      </xpath>
      <xpath expr="//group[@id='header_right_group']" position="inside">
        <field name="abroj_project_id" readonly="state != 'draft'" options="{'no_create': True}"/>
      </xpath>
    </field>
  </record>
  <record id="account_payment_form_voucher" model="ir.ui.view">
    <field name="name">account.payment.form.abroj.voucher</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <field name="abroj_voucher_id" invisible="1"/>
        <button name="action_open_abroj_voucher" type="object" class="oe_stat_button" icon="fa-file-text-o" string="السند" invisible="not abroj_voucher_id"/>
      </xpath>
    </field>
  </record>
  <record id="account_move_search_voucher" model="ir.ui.view">
    <field name="name">account.move.search.abroj.voucher</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_account_move_filter"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside"><field name="abroj_voucher_id"/></xpath>
    </field>
  </record>
  <record id="account_move_line_search_voucher" model="ir.ui.view">
    <field name="name">account.move.line.search.abroj.voucher</field>
    <field name="model">account.move.line</field>
    <field name="inherit_id" ref="account.view_account_move_line_filter"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside"><field name="ref" string="السند" filter_domain="[('move_id.abroj_voucher_id.name', 'ilike', self)]"/></xpath>
    </field>
  </record>
</odoo>
