<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="baseer_purchase_daily_report.Report">
        <main class="bpr-shell">
            <div class="bpr-container">
                <t t-if="state.invoice or state.invoiceLoading or state.invoiceError">
                    <button type="button" class="bpr-back" t-on-click="backToReport"><i class="fa fa-angle-right" aria-hidden="true"/> <span t-esc="labels.back"/></button>
                    <div t-if="state.invoiceLoading" class="bpr-feedback" role="status" aria-live="polite"><span class="bpr-spinner"/> <span t-esc="labels.loading"/></div>
                    <div t-elif="state.invoiceError" class="bpr-feedback bpr-feedback--error" role="alert"><span t-esc="state.invoiceError"/></div>
                    <t t-else="">
                        <header class="bpr-detail-header">
                            <div><span class="bpr-eyebrow" t-esc="kindLabel(state.invoice.kind)"/><h1 t-esc="state.invoice.vendor"/><p class="bpr-invoice-number" dir="ltr" t-esc="state.invoice.number"/></div>
                            <span t-attf-class="bpr-status bpr-status--{{state.invoice.status}}" t-esc="statusLabel(state.invoice.status)"/>
                        </header>
                        <section class="bpr-detail-overview">
                            <div class="bpr-detail-amount"><span t-esc="labels.total"/><strong><bdi t-esc="state.invoice.total"/> <small t-esc="state.invoice.currency"/></strong><small t-esc="labels.amountCurrency"/></div>
                            <div class="bpr-detail-amount"><span t-esc="labels.paidAmount"/><strong><bdi t-esc="state.invoice.paid_unavailable ? labels.paidUnavailable : state.invoice.paid"/> <small t-if="!state.invoice.paid_unavailable" t-esc="state.invoice.currency"/></strong><small t-if="state.invoice.paid_pending" t-esc="labels.paidPending"/></div>
                            <div class="bpr-detail-amount"><span t-esc="labels.residual"/><strong><bdi t-esc="state.invoice.residual"/> <small t-esc="state.invoice.currency"/></strong></div>
                        </section>
                        <section class="bpr-panel">
                            <h2 t-esc="labels.details"/>
                            <dl class="bpr-meta">
                                <div><dt t-esc="labels.vendor"/><dd t-esc="state.invoice.vendor"/></div>
                                <div><dt t-esc="labels.enteredBy"/><dd><span t-esc="state.invoice.entered_by || labels.paidUnavailable"/><small t-if="state.invoice.entered_by"> · <span t-esc="state.invoice.entry_source === 'batch' ? labels.batchEntry : labels.invoiceEntry"/></small></dd></div>
                                <div><dt t-esc="labels.reference"/><dd t-esc="state.invoice.reference || '—'"/></div>
                                <div><dt t-esc="labels.date"/><dd><bdi t-esc="state.invoice.date || '—'"/></dd></div>
                                <div><dt t-esc="labels.due"/><dd><bdi t-esc="state.invoice.due_date || '—'"/></dd></div>
                                <div><dt t-esc="labels.beforeTax"/><dd><bdi t-esc="state.invoice.untaxed"/> <span t-esc="state.invoice.currency"/></dd></div>
                                <div><dt t-esc="labels.tax"/><dd><bdi t-esc="state.invoice.tax"/> <span t-esc="state.invoice.currency"/></dd></div>
                                <div><dt><span t-esc="labels.total"/> · <span t-esc="labels.companyCurrency"/></dt><dd><bdi t-esc="state.invoice.company_total"/> <span t-esc="state.payload.company.currency"/></dd></div>
                                <div><dt><span t-esc="labels.residual"/> · <span t-esc="labels.companyCurrency"/></dt><dd><bdi t-esc="state.invoice.company_residual"/> <span t-esc="state.payload.company.currency"/></dd></div>
                            </dl>
                        </section>
                        <section class="bpr-panel bpr-items"><div class="bpr-panel-heading"><h2 t-esc="labels.items"/><span class="bpr-count" t-esc="state.invoice.lines.length"/></div>
                            <div t-if="!state.invoice.lines.length" class="bpr-empty-small" t-esc="labels.noItems"/>
                            <article class="bpr-line" t-foreach="state.invoice.lines" t-as="line" t-key="line_index">
                                <strong class="bpr-line-name" t-esc="line.description"/>
                                <dl t-if="line.kind === 'product'" class="bpr-line-values">
                                    <div><dt t-esc="labels.quantity"/><dd><bdi t-esc="line.quantity"/></dd></div>
                                    <div><dt t-esc="labels.unitPrice"/><dd><bdi t-esc="line.unit_price"/> <span t-esc="state.invoice.currency"/></dd></div>
                                    <div><dt t-esc="labels.discount"/><dd><bdi t-esc="line.discount"/>%</dd></div>
                                    <div><dt t-esc="labels.subtotal"/><dd><bdi t-esc="line.subtotal"/> <span t-esc="state.invoice.currency"/></dd></div>
                                    <div><dt t-esc="labels.itemTotal"/><dd><bdi t-esc="line.total"/> <span t-esc="state.invoice.currency"/></dd></div>
                                </dl>
                            </article>
                        </section>
                        <section t-if="state.invoice.adjustments and state.invoice.adjustments.length" class="bpr-panel bpr-items">
                            <h2 t-esc="labels.adjustments"/>
                            <article t-foreach="state.invoice.adjustments" t-as="adjustment" t-key="adjustment_index" class="bpr-line">
                                <strong class="bpr-line-name" t-esc="adjustment.description"/>
                                <strong><bdi t-esc="adjustment.amount"/> <small t-esc="state.payload.company.currency"/></strong>
                            </article>
                        </section>
                        <p class="bpr-footnote" t-esc="labels.paidNote"/>
                        <p t-if="state.invoice.paid_unavailable" class="bpr-footnote" t-esc="labels.paidUnavailableNote"/>
                    </t>
                </t>
                <t t-else="">
                    <header class="bpr-header">
                        <div class="bpr-heading"><h1 t-esc="labels.title"/><p t-esc="labels.subtitle"/></div>
                        <div class="bpr-header-side">
                            <div t-if="state.payload" class="bpr-company"><span class="bpr-company-icon"><i class="fa fa-building-o" aria-hidden="true"/></span><strong t-esc="state.payload.company.name"/></div>
                            <div t-if="state.applied" class="bpr-export">
                                <button type="button" class="bpr-export-btn" t-on-click="exportPdf" t-att-disabled="state.loading or state.exporting">
                                    <i class="fa fa-file-pdf-o" aria-hidden="true"/> <span t-esc="labels.exportPdf"/>
                                </button>
                                <button type="button" class="bpr-export-btn" t-on-click="exportXlsx" t-att-disabled="state.loading or state.exporting">
                                    <i class="fa fa-file-excel-o" aria-hidden="true"/> <span t-esc="labels.exportExcel"/>
                                </button>
                            </div>
                        </div>
                    </header>
                    <div t-if="state.exporting" class="bpr-feedback bpr-feedback--compact" role="status" aria-live="polite"><span class="bpr-spinner"/> <span t-esc="labels.exporting"/></div>
                    <div t-if="state.exportError" class="bpr-feedback bpr-feedback--error bpr-feedback--compact" role="alert"><span t-esc="state.exportError"/></div>
                    <form class="bpr-filter" t-on-submit.prevent="applyFilters">
                        <nav class="bpr-presets" t-att-aria-label="labels.datePresets">
                            <button type="button" t-foreach="presets" t-as="preset" t-key="preset" t-attf-class="bpr-preset {{isPresetActive(preset) ? 'bpr-preset--active' : ''}}" t-on-click="() => this.applyPreset(preset)" t-esc="presetLabels[preset]"/>
                        </nav>
                        <label class="bpr-field"><span t-esc="labels.from"/><input type="date" t-model="state.from" t-on-change="onFromToChanged" required="required"/></label>
                        <label class="bpr-field"><span t-esc="labels.to"/><input type="date" t-model="state.to" t-on-change="onFromToChanged" required="required"/></label>
                        <label class="bpr-field bpr-field--status"><span class="bpr-sr-only" t-esc="labels.payment"/><select t-model="state.payment" t-on-change="onPaymentChanged" t-att-aria-label="labels.payment"><option value="all" t-esc="labels.all"/><option value="not_paid" t-esc="labels.not_paid"/><option value="partial" t-esc="labels.partial"/><option value="in_payment" t-esc="labels.in_payment"/><option value="paid" t-esc="labels.paid"/><option value="reversed" t-esc="labels.reversed"/><option value="blocked" t-esc="labels.blocked"/><option value="draft" t-esc="labels.drafts"/></select></label>
                        <button type="submit" class="bpr-apply" t-att-disabled="state.loading" t-esc="labels.apply"/>
                    </form>
                    <section t-if="state.payload" t-attf-class="bpr-kpis {{state.payload.custody and state.payload.custody.active ? '' : 'bpr-kpis--two'}}">
                        <article class="bpr-kpi bpr-kpi--total">
                            <h2 t-esc="labels.totalPurchases"/>
                            <div class="bpr-kpi-big"><strong><bdi t-esc="state.payload.table.total"/></strong> <small><t t-esc="state.payload.company.currency"/> · <bdi t-esc="state.payload.table.count"/> <t t-esc="labels.invoices"/></small></div>
                            <div class="bpr-split" aria-hidden="true">
                                <span t-foreach="splitParts" t-as="part" t-key="part.key" t-attf-class="bpr-split-part bpr-split-part--{{part.key}}" t-attf-style="width: {{part.width}}%"/>
                            </div>
                            <ul class="bpr-legend">
                                <li t-foreach="splitParts" t-as="part" t-key="part.key"><span t-attf-class="bpr-dot bpr-split-part--{{part.key}}"/><t t-esc="part.label"/> <strong><bdi t-esc="part.amount"/></strong></li>
                            </ul>
                        </article>
                        <article t-if="state.payload.custody and state.payload.custody.active" class="bpr-kpi bpr-kpi--custody">
                            <h2><t t-esc="labels.custodyBalance"/><t t-if="state.payload.custody.representatives"> · <t t-esc="state.payload.custody.representatives"/></t></h2>
                            <div class="bpr-custody-figures">
                                <div><small t-esc="labels.custodyIn"/><strong><bdi t-esc="state.payload.custody.funded"/></strong></div>
                                <div><small t-esc="labels.custodyOut"/><strong><bdi t-esc="state.payload.custody.spent"/></strong></div>
                                <div class="bpr-custody-left"><small t-esc="labels.custodyRemaining"/><strong><bdi t-esc="state.payload.custody.remaining"/></strong></div>
                            </div>
                            <div class="bpr-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" t-att-aria-valuenow="state.payload.custody.spent_percent"><span t-attf-style="width: {{state.payload.custody.spent_percent}}%"/></div>
                            <div class="bpr-kpi-foot">
                                <span t-esc="spentPercentLabel"/>
                                <button t-if="state.payload.custody.can_open" type="button" class="bpr-link" t-on-click="openCustody"><t t-esc="labels.custodyOpen"/> <i class="fa fa-angle-left" aria-hidden="true"/></button>
                            </div>
                        </article>
                        <article class="bpr-kpi bpr-kpi--status">
                            <h2 t-esc="labels.paymentStatus"/>
                            <t t-if="allSettled">
                                <span class="bpr-badge"><i class="fa fa-check-circle" aria-hidden="true"/> <t t-esc="labels.allPaid"/></span>
                                <p class="bpr-kpi-note" t-esc="labels.noOpenBills"/>
                            </t>
                            <t t-else="">
                                <button type="button" t-foreach="state.payload.statuses" t-as="card" t-key="card.key" t-attf-class="bpr-status-line {{isStatusActive(card.key) ? 'bpr-status-line--active' : ''}}" t-on-click="() => this.toggleStatus(card.key)">
                                    <span t-esc="statusCardLabel(card)"/>
                                    <span><bdi t-esc="card.count"/> · <strong><bdi t-esc="card.total"/></strong></span>
                                </button>
                            </t>
                        </article>
                    </section>
                    <div t-if="state.loading" class="bpr-feedback" role="status" aria-live="polite"><span class="bpr-spinner"/> <span t-esc="labels.loading"/></div>
                    <div t-elif="state.error" class="bpr-feedback bpr-feedback--error" role="alert"><span t-esc="state.error"/><button type="button" t-on-click="applyFilters" t-esc="labels.retry"/></div>
                    <div t-elif="!state.payload.table.rows.length" class="bpr-empty"><span class="bpr-empty-icon"><i class="fa fa-folder-open-o" aria-hidden="true"/></span><h2 t-esc="labels.empty"/><p t-esc="labels.emptyHint"/></div>
                    <section t-else="" class="bpr-panel bpr-main-table">
                        <div class="bpr-panel-head">
                            <h2 t-esc="labels.byDay"/>
                            <span t-if="state.payload.table.show_custody and state.payload.custody"><t t-esc="labels.dateBasis"/> <bdi t-esc="state.payload.custody.start"/></span>
                            <span t-else="" t-esc="labels.dateNote"/>
                        </div>
                        <div class="bpr-table-scroll">
                            <table class="bpr-grid">
                                <thead>
                                    <tr t-if="state.payload.table.show_custody" class="bpr-grid-groups">
                                        <th t-att-colspan="purchaseColspan" t-esc="labels.purchases"/>
                                        <th colspan="2" class="bpr-g2" t-esc="labels.custodyGroup"/>
                                    </tr>
                                    <tr>
                                        <th t-esc="labels.tableDate"/>
                                        <th><span class="bpr-full" t-esc="labels.invoiceCount"/><span class="bpr-short" t-esc="labels.invoiceCountShort"/></th>
                                        <th t-foreach="state.payload.table.columns" t-as="column" t-key="column.key" t-esc="column.label"/>
                                        <th t-esc="labels.purchaseTotal"/>
                                        <t t-if="state.payload.table.show_custody">
                                            <th class="bpr-g2" t-esc="labels.custodyTransfer"/>
                                            <th t-esc="labels.custodyBalanceCol"/>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.payload.table.rows" t-as="row" t-key="row.key">
                                        <tr t-if="row.kind === 'day'" t-attf-class="bpr-row--day {{state.expanded === row.date ? 'bpr-row--open' : ''}}" t-on-click="() => this.toggleDay(row.date)">
                                            <td class="bpr-cell-date"><button type="button" class="bpr-chevron" t-on-click.stop="() => this.toggleDay(row.date)" t-att-aria-expanded="state.expanded === row.date ? 'true' : 'false'"><span class="bpr-sr-only" t-esc="state.expanded === row.date ? labels.hide : labels.show"/><i t-att-class="state.expanded === row.date ? 'fa fa-angle-down' : 'fa fa-angle-right'" aria-hidden="true"/></button><bdi class="bpr-full" t-esc="row.date"/><bdi class="bpr-short" t-esc="shortDate(row.date)"/></td>
                                            <td><bdi t-esc="row.count"/></td>
                                            <t t-foreach="state.payload.table.columns" t-as="column" t-key="column.key">
                                                <td t-if="tableAmount(row, column.key)"><bdi t-esc="tableAmount(row, column.key)"/></td>
                                                <td t-else="" class="bpr-empty-cell">—</td>
                                            </t>
                                            <td class="bpr-strong"><bdi t-esc="row.total"/></td>
                                            <t t-if="state.payload.table.show_custody">
                                                <td t-if="row.transfer" class="bpr-g2"><bdi t-esc="row.transfer"/></td>
                                                <td t-else="" class="bpr-g2 bpr-empty-cell">—</td>
                                                <td><bdi t-esc="row.balance"/></td>
                                            </t>
                                        </tr>
                                        <tr t-if="row.kind === 'transfer'" class="bpr-row--transfer">
                                            <td class="bpr-cell-date"><span class="bpr-chevron-space"/><bdi class="bpr-full" t-esc="row.date"/><bdi class="bpr-short" t-esc="shortDate(row.date)"/></td>
                                            <td/>
                                            <td t-foreach="state.payload.table.columns" t-as="column" t-key="column.key"/>
                                            <td/>
                                            <t t-if="state.payload.table.show_custody">
                                                <td class="bpr-g2"><bdi t-esc="row.transfer"/></td>
                                                <td><bdi t-esc="row.balance"/></td>
                                            </t>
                                        </tr>
                                        <t t-if="row.kind === 'day' and state.expanded === row.date">
                                            <tr t-if="state.dayLoading or state.dayError or !state.dayData" class="bpr-row--bill">
                                                <td t-att-colspan="purchaseColspan">
                                                    <div t-if="state.dayError" class="bpr-feedback bpr-feedback--error bpr-feedback--compact" role="alert"><span t-esc="state.dayError"/><button type="button" t-on-click="() => this.loadDay(0)" t-esc="labels.retry"/></div>
                                                    <div t-else="" class="bpr-feedback bpr-feedback--compact" role="status" aria-live="polite"><span class="bpr-spinner"/> <span t-esc="labels.loading"/></div>
                                                </td>
                                                <td t-if="state.payload.table.show_custody" colspan="2" class="bpr-g2 bpr-custody-gap"/>
                                            </tr>
                                            <t t-else="">
                                                <tr t-foreach="state.dayData.rows" t-as="bill" t-key="bill.id" class="bpr-row--bill" t-on-click="() => this.openInvoice(bill.id)" t-att-title="labels.open">
                                                    <td colspan="2" class="bpr-bill-name"><span class="bpr-bill-vendor" t-esc="bill.vendor"/><bdi class="bpr-bill-number bpr-full" t-esc="bill.number"/><bdi class="bpr-bill-number bpr-short" t-esc="shortNumber(bill.number)"/><span t-if="bill.status === 'draft'" class="bpr-bill-flag" t-esc="labels.draft"/></td>
                                                    <td t-foreach="state.payload.table.columns" t-as="column" t-key="column.key"><bdi t-if="bill.table_amounts[column.key]" t-esc="bill.table_amounts[column.key]"/></td>
                                                    <td><bdi t-esc="bill.company_total"/></td>
                                                    <td t-if="state.payload.table.show_custody and bill_first" colspan="2" t-att-rowspan="billRowspan" class="bpr-g2 bpr-custody-gap"/>
                                                </tr>
                                                <tr t-if="state.dayData.offset or state.dayData.has_more" class="bpr-row--bill">
                                                    <td t-att-colspan="purchaseColspan"><nav class="bpr-pagination" t-att-aria-label="labels.page"><button type="button" t-on-click.stop="previousPage" t-att-disabled="!state.dayData.offset" t-esc="labels.previous"/><span><span t-esc="labels.page"/> <bdi t-esc="pageNumber"/></span><button type="button" t-on-click.stop="nextPage" t-att-disabled="!state.dayData.has_more" t-esc="labels.next"/></nav></td>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td t-esc="labels.tableTotals"/>
                                        <td><bdi t-esc="state.payload.table.count"/></td>
                                        <td t-foreach="state.payload.table.columns" t-as="column" t-key="column.key"><bdi t-esc="state.payload.table.totals[column.key]"/></td>
                                        <td><bdi t-esc="state.payload.table.total"/></td>
                                        <t t-if="state.payload.table.show_custody">
                                            <td class="bpr-g2"><bdi t-esc="state.payload.table.transfer_total"/></td>
                                            <td><bdi t-esc="state.payload.table.balance"/></td>
                                        </t>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <p class="bpr-table-note"><t t-esc="labels.currencyNote"/> <bdi t-esc="state.payload.company.currency"/><t t-if="state.payload.table.show_custody"> · <t t-esc="labels.transferNote"/></t></p>
                    </section>
                </t>
            </div>
        </main>
    </t>
</templates>
