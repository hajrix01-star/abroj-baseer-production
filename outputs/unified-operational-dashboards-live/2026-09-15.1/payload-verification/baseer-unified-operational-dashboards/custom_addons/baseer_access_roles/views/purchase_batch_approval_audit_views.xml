                <field name="execution_user_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_cashier_purchase_batch_approval_audit" model="ir.actions.act_window">
        <field name="name">Cashier purchase-batch approvals</field>
        <field name="res_model">baseer.purchase.batch.cashier.approval.audit</field>
        <field name="view_mode">list</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>
