<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_baseer_hr_service_analytic_readiness_form" model="ir.ui.view">
        <field name="name">baseer.hr.service.analytic.readiness.form</field>
        <field name="model">baseer.hr.service.analytic.readiness</field>
        <field name="arch" type="xml">
            <form string="جاهزية خدمات الموظفين">
                <header>
                    <button name="action_refresh" type="object" string="فحص الجاهزية" class="btn-secondary"/>
                    <button name="action_add_missing" type="object" string="إضافة الناقص" class="btn-primary" invisible="state == 'ready'"/>
                    <field name="state" widget="statusbar" statusbar_visible="ready,blocked"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="summary" nolabel="1" readonly="1"/>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list create="0" edit="0" delete="0" decoration-success="state == 'ready'" decoration-warning="state == 'missing'" decoration-danger="state == 'blocked'">
                            <field name="service_type"/>
                            <field name="product_id"/>
                            <field name="analytic_account_id" string="التصنيف المتوقع"/>
                            <field name="state" widget="badge"/>
                            <field name="message"/>
                        </list>
                    </field>
                </sheet>
                <footer><button string="إغلاق" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
    <record id="view_company_form_hr_service_analytic_readiness" model="ir.ui.view">
        <field name="name">res.company.form.hr.service.analytic.readiness</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_baseer_open_hr_service_analytic_readiness" type="object"
                        class="oe_stat_button" icon="fa-check-square-o"
                        string="Employee Service Readiness"
                        groups="account.group_account_manager" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
