#!/usr/bin/env bash
# Root-owned production deploy wrapper.  GitHub may select a reviewed release
# identifier only; this wrapper owns the corresponding commit and module list.
set -Eeuo pipefail
umask 027

readonly BASE=/srv/abroj-baseer-production
readonly RELEASES="$BASE/releases"
readonly BACKUPS="$BASE/backups"
readonly STAGING="$BASE/deploy-staging"
readonly POLICY_DIR=/etc/baseer-production/release-policies
readonly SOURCE_REMOTE=ssh://git@ssh.github.com:443/hajrix01-star/abroj-baseer-production.git
readonly SOURCE_SSH_KEY=/etc/baseer-production/source-readonly.key
readonly SOURCE_KNOWN_HOSTS=/etc/baseer-production/github-known_hosts
readonly DB_CONTAINER=baseer-odoo-prod-db-1
readonly ODOO_CONTAINER=baseer-odoo-prod-odoo-1
readonly ODOO_VOLUME=baseer-odoo-prod-odoo-data
readonly LOCK_FILE=/var/lock/baseer-production-deploy.lock
die() {
    printf 'DEPLOY=FAILED\nREASON=%s\n' "$*" >&2
    exit 1
}

require_root() {
    [ "$(id -u)" -eq 0 ] || die 'root is required'
}

validate_arguments() {
    [ "$#" -eq 2 ] || die 'expected: release_id run_id'
    release_id=$1
    run_id=$2

    [[ "$release_id" =~ ^[a-z0-9][a-z0-9-]{2,63}$ ]] || die 'invalid release id'
    [[ "$run_id" =~ ^[0-9]+$ ]] || die 'invalid run id'
}

load_policy() {
    local policy key value seen_release=0 seen_commit=0 seen_modules_field=0
    policy="$POLICY_DIR/$release_id.env"
    [ -f "$policy" ] && [ ! -L "$policy" ] || die 'release policy is missing or unsafe'
    [ "$(stat -c '%U:%G:%a' -- "$policy")" = 'root:root:600' ] || die 'release policy ownership or mode is unsafe'

    while IFS='=' read -r key value || [ -n "$key" ]; do
        case "$key" in
            RELEASE_ID) [ "$seen_release" -eq 0 ] || die 'duplicate policy release id'; policy_release_id=$value; seen_release=1 ;;
            COMMIT) [ "$seen_commit" -eq 0 ] || die 'duplicate policy commit'; commit=$value; seen_commit=1 ;;
            MODULES) [ "$seen_modules_field" -eq 0 ] || die 'duplicate policy modules'; policy_modules=$value; seen_modules_field=1 ;;
            ''|'#'*) ;;
            *) die 'policy has an unknown key' ;;
        esac
    done < "$policy"

    [ "$seen_release" -eq 1 ] && [ "$seen_commit" -eq 1 ] && [ "$seen_modules_field" -eq 1 ] || die 'policy is incomplete'
    [ "$policy_release_id" = "$release_id" ] || die 'policy release id mismatch'
    [[ "$commit" =~ ^[a-f0-9]{40}$ ]] || die 'policy commit is invalid'
    IFS=',' read -r -a APPROVED_MODULES <<< "$policy_modules"
    [ "${#APPROVED_MODULES[@]}" -gt 0 ] || die 'policy has no modules'
    declare -A seen_module_names=()
    for approved_module in "${APPROVED_MODULES[@]}"; do
        [[ "$approved_module" =~ ^baseer_[a-z0-9_]+$ ]] || die 'policy module is invalid'
        [ -z "${seen_module_names[$approved_module]+x}" ] || die 'policy repeats a module'
        seen_module_names[$approved_module]=1
    done
}

fetch_reviewed_source() {
    local fetch_repo fetched_commit
    fetch_repo="$stage/fetch.git"
    install -d -o root -g root -m 0700 "$stage"
    git init --bare --quiet "$fetch_repo"
    git -C "$fetch_repo" remote add origin "$SOURCE_REMOTE"
    GIT_SSH_COMMAND="ssh -i $SOURCE_SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$SOURCE_KNOWN_HOSTS" \
        git -C "$fetch_repo" fetch --no-tags --quiet origin "$commit"
    fetched_commit="$(git -C "$fetch_repo" rev-parse FETCH_HEAD^{commit})"
    [ "$fetched_commit" = "$commit" ] || die 'fetched source does not match the approved commit'
    mkdir -m 0700 "$stage/source"
    git -C "$fetch_repo" archive --format=tar "$commit" | tar -x -C "$stage/source" --no-same-owner --no-same-permissions
    rm -rf -- "$fetch_repo"
}

snapshot_sql=$(cat <<'SQL'
SELECT jsonb_build_object(
  'account.move', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM account_move),
  'account.move.line', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM account_move_line),
  'account.payment', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM account_payment),
  'purchase.order', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM purchase_order),
  'purchase.order.line', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM purchase_order_line),
  'sale.order', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM sale_order),
  'sale.order.line', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM sale_order_line),
  'stock.picking', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM stock_picking),
  'stock.move', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM stock_move),
  'hr.employee', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM hr_employee),
  'hr.payslip', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM hr_payslip),
  'res.partner.non_user', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(p.id), 0), 'w', coalesce(max(p.write_date)::text, '')) FROM res_partner p WHERE NOT EXISTS (SELECT 1 FROM res_users u WHERE u.partner_id = p.id)),
  'baseer.pos.summary', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM baseer_pos_summary),
  'baseer.pos.summary.allocation', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM baseer_pos_summary_allocation),
  'baseer.heat.target', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM baseer_heat_calendar_target),
  'baseer.occasion', (SELECT jsonb_build_object('n', count(*), 'ids', coalesce(sum(id), 0), 'w', coalesce(max(write_date)::text, '')) FROM baseer_official_occasion)
);
SQL
)

snapshot() {
    printf '%s\n' "$snapshot_sql" | docker exec -i "$DB_CONTAINER" sh -lc 'psql -U "$POSTGRES_USER" -d baseer_prod -Atq'
}

wait_for_login() {
    local attempt
    for attempt in $(seq 1 90); do
        curl -fsS --max-time 10 http://127.0.0.1:18069/web/login >/dev/null && return 0
        sleep 1
    done
    return 1
}

wait_for_data_init() {
    local attempt status exit_code
    for attempt in $(seq 1 30); do
        status="$("${compose[@]}" ps -a --format json odoo_data_init 2>/dev/null | jq -r '.State // empty' || true)"
        [ "$status" = exited ] && break
        sleep 1
    done
    exit_code="$("${compose[@]}" ps -a --format json odoo_data_init | jq -r '.ExitCode // empty')"
    [ "$exit_code" = 0 ]
}

restore_pair() (
    # Rollback calls this while its own error trap is intentionally disabled.
    # Run the recovery pair in a strict subshell so an early database or
    # filestore failure cannot be hidden by a later successful command.
    set -Eeuo pipefail
    sha256sum -c "$backup/recovery.sha256"
    docker exec "$DB_CONTAINER" sh -lc 'dropdb -U "$POSTGRES_USER" --if-exists baseer_prod'
    docker exec "$DB_CONTAINER" sh -lc 'createdb -U "$POSTGRES_USER" baseer_prod'
    docker exec -i "$DB_CONTAINER" sh -lc 'pg_restore -U "$POSTGRES_USER" --no-owner --no-privileges -d baseer_prod' < "$backup/baseer_prod.dump"
    docker run --rm --network none -v "$ODOO_VOLUME":/target -v "$backup":/backup:ro alpine:3.20 sh -lc '
        set -eu
        rm -rf -- /target/filestore/baseer_prod
        mkdir -p /target/filestore
        tar -xf /backup/filestore-baseer_prod.tar -C /target
        test -d /target/filestore/baseer_prod
    '
)

rollback() {
    local status=$?
    local rollback_failed=0
    trap - ERR
    set +e

    if [ -n "${backup:-}" ] && [ -d "$backup" ]; then
        printf 'LIVE=ROLLING_BACK\n' > "$backup/result.env"
    fi

    if [ "${release_switched:-0}" -eq 1 ] && [ "${#compose[@]}" -gt 0 ]; then
        "${compose[@]}" stop odoo >/dev/null 2>&1 || rollback_failed=1
    fi
    if [ "${database_mutated:-0}" -eq 1 ]; then
        restore_pair >/dev/null 2>&1 || rollback_failed=1
    fi
    if [ "${release_switched:-0}" -eq 1 ]; then
        ln -sfn "$old_release" "$BASE/current" || rollback_failed=1
    fi
    if [ "${service_quiesced:-0}" -eq 1 ]; then
        "${compose_old[@]}" up -d odoo_data_init >/dev/null 2>&1 || rollback_failed=1
        "${compose_old[@]}" up -d odoo >/dev/null 2>&1 || rollback_failed=1
        wait_for_login >/dev/null 2>&1 || rollback_failed=1
    fi

    if [ -n "${backup:-}" ] && [ -d "$backup" ]; then
        if [ "$rollback_failed" -eq 0 ]; then
            printf 'LIVE=ROLLED_BACK\nPREVIOUS_RELEASE=%s\n' "$old_release" >> "$backup/result.env"
        else
            printf 'LIVE=ROLLBACK_FAILED\nPREVIOUS_RELEASE=%s\n' "$old_release" >> "$backup/result.env"
        fi
    fi
    if [ "$rollback_failed" -ne 0 ]; then
        printf 'LIVE=ROLLBACK_FAILED\nPREVIOUS_RELEASE=%s\n' "$old_release" >&2
        exit 70
    fi
    exit "$status"
}

require_root
validate_arguments "$@"
exec 9>"$LOCK_FILE"
flock -n 9 || die 'another production deployment is already running'
load_policy

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
stage="$RELEASES/.stage-${commit:0:12}-${run_id}-$stamp"
mkdir -p "$RELEASES"
[ ! -e "$stage" ] || die 'private source staging path already exists'
fetch_reviewed_source
source_dir="$stage/source"
[ -d "$source_dir" ] || die 'fetched source is missing'
[ ! -e "$source_dir/.env" ] || die 'fetched source must not contain .env'
[ -f "$source_dir/compose.production.yaml" ] || die 'release compose file is missing'
if find "$source_dir" -type l -print -quit | grep -q .; then
    die 'fetched source contains a link'
fi
for approved_module in "${APPROVED_MODULES[@]}"; do
    [ -f "$source_dir/custom_addons/$approved_module/__manifest__.py" ] || die "approved module is missing from release: $approved_module"
done

old_release="$(readlink -f "$BASE/current")"
[ -d "$old_release" ] || die 'current release cannot be resolved'
[ -f "$old_release/.env" ] || die 'current .env is missing'
[ -f "$old_release/config/odoo.conf" ] || die 'current odoo.conf is missing'
compose_old=(docker compose --project-name baseer-odoo-prod --env-file "$old_release/.env" -f "$old_release/compose.production.yaml" --project-directory "$old_release")
odoo_config_gid="$(docker exec "$ODOO_CONTAINER" id -g odoo)"
[[ "$odoo_config_gid" =~ ^[0-9]+$ ]] || die 'could not resolve the Odoo configuration group'

source_kb="$(du -sk "$source_dir" | awk '{print $1}')"
db_bytes="$(docker exec "$DB_CONTAINER" sh -lc 'psql -U "$POSTGRES_USER" -d baseer_prod -Atqc "SELECT pg_database_size(current_database())"')"
db_kb=$(( (db_bytes + 1023) / 1024 ))
filestore_kb="$(docker run --rm --network none -v "$ODOO_VOLUME":/source:ro alpine:3.20 sh -lc 'du -sk /source/filestore/baseer_prod | awk "{print \$1}"')"
available_kb="$(df --output=avail -k "$BASE" | tail -n 1 | tr -d ' ')"
required_kb=$(( 2 * (source_kb + db_kb + filestore_kb) + 1024 * 1024 ))
[ "$available_kb" -gt "$required_kb" ] || die 'insufficient disk space for a recoverable deployment'

backup="$BACKUPS/pre-${commit:0:12}-${run_id}-$stamp"
release="$RELEASES/${commit:0:12}-run-${run_id}-$stamp"
release_switched=0
database_mutated=0
service_quiesced=0
compose=()
trap rollback ERR

mkdir -p "$BACKUPS" "$backup"
[ ! -e "$release" ] || die 'release path already exists'
mv "$source_dir" "$release"
rmdir "$stage"
# The release source is mounted into the unprivileged Odoo container.  It must
# be traversable and readable there; the sensitive files copied below retain
# their restrictive modes and are deliberately excluded from the archive.
chmod -R a+rX -- "$release"
install -D -m 0600 "$old_release/.env" "$release/.env"
# Odoo runs without root.  Let its *current numeric group* read the config
# without exposing `admin_passwd` to the constrained deploy account; `.env`
# above remains root-only.
install -D -o root -g "$odoo_config_gid" -m 0640 "$old_release/config/odoo.conf" "$release/config/odoo.conf"
docker compose --project-name baseer-odoo-prod --env-file "$release/.env" -f "$release/compose.production.yaml" --project-directory "$release" config --quiet

# Quiesce first: DB, filestore and the protected snapshot must describe the
# same instant.  The trap restarts this exact release if capture fails.
# Mark it before issuing stop: a transport/compose error can occur after Docker
# has already stopped the container, and the ERR trap must still revive it.
service_quiesced=1
"${compose_old[@]}" stop odoo
snapshot > "$backup/protected-before.json"
docker exec "$DB_CONTAINER" sh -lc 'pg_dump -Fc -U "$POSTGRES_USER" -d baseer_prod' > "$backup/baseer_prod.dump"
docker run --rm --network none -v "$ODOO_VOLUME":/source:ro -v "$backup":/target alpine:3.20 sh -lc 'tar -C /source -cf /target/filestore-baseer_prod.tar filestore/baseer_prod'
sha256sum "$backup/baseer_prod.dump" "$backup/filestore-baseer_prod.tar" > "$backup/recovery.sha256"

ln -sfn "$release" "$BASE/current"
release_switched=1
compose=(docker compose --project-name baseer-odoo-prod --env-file "$release/.env" -f "$release/compose.production.yaml" --project-directory "$release")

upgrade_modules=()
install_modules=()
for approved_module in "${APPROVED_MODULES[@]}"; do
    module_state="$(docker exec "$DB_CONTAINER" sh -lc "psql -U \"\$POSTGRES_USER\" -d baseer_prod -Atqc \"SELECT state FROM ir_module_module WHERE name = '$approved_module'\"")"
    case "$module_state" in
        installed) upgrade_modules+=("$approved_module") ;;
        ''|uninstalled) install_modules+=("$approved_module") ;;
        *) die "module is in an unsafe state: $approved_module=$module_state" ;;
    esac
done
odoo_command='odoo --config=/etc/odoo/odoo.conf --db_host="$HOST" --db_user="$USER" --db_password="$PASSWORD" --addons-path=/usr/lib/python3/dist-packages/odoo/addons,/mnt/baseer-addons,/mnt/third-party-addons/erp_heritage_19,/mnt/third-party-addons/odoomates_19 -d baseer_prod'
if [ "${#upgrade_modules[@]}" -gt 0 ]; then
    upgrade_csv="$(IFS=,; printf '%s' "${upgrade_modules[*]}")"
    odoo_command+=" -u $upgrade_csv"
fi
if [ "${#install_modules[@]}" -gt 0 ]; then
    install_csv="$(IFS=,; printf '%s' "${install_modules[*]}")"
    odoo_command+=" -i $install_csv"
fi
odoo_command+=' --stop-after-init --workers=0 --max-cron-threads=0'
database_mutated=1
"${compose[@]}" run --rm --no-deps --entrypoint sh odoo -lc "$odoo_command" > "$backup/module-upgrade.log" 2>&1

snapshot > "$backup/protected-after.json"
cmp "$backup/protected-before.json" "$backup/protected-after.json"
wait_for_data_init
"${compose[@]}" up -d odoo
wait_for_login

for approved_module in "${APPROVED_MODULES[@]}"; do
    module_state="$(docker exec "$DB_CONTAINER" sh -lc "psql -U \"\$POSTGRES_USER\" -d baseer_prod -Atqc \"SELECT state FROM ir_module_module WHERE name = '$approved_module'\"")"
    [ "$module_state" = installed ] || die "approved module is not installed after deployment: $approved_module"
done
"${compose[@]}" logs --no-color --tail=300 odoo > "$backup/odoo-smoke.log"
! grep -Eq 'Traceback \(most recent call last\)|CRITICAL|FATAL' "$backup/odoo-smoke.log"

printf 'LIVE=GO\nRELEASE_ID=%s\nRELEASE=%s\nBACKUP=%s\nCOMMIT=%s\nMODULES=%s\n' "$release_id" "$release" "$backup" "$commit" "${APPROVED_MODULES[*]}" > "$backup/result.env"
printf 'LIVE=GO\nRELEASE=%s\nBACKUP=%s\n' "$release" "$backup"
