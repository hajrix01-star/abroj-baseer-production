<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_bchat_capabilities" model="ir.ui.view">
        <field name="name">res.users.form.bchat.capabilities</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']//field[@name='group_ids']" position="before">
                <group name="bchat_capabilities" string="BChat" groups="base.group_system">
                    <field name="bchat_chat_view"/>
                    <field name="bchat_chat_send" readonly="not bchat_chat_view"/>
                    <field name="bchat_media" readonly="not bchat_chat_view"/>
                    <field name="bchat_media_view" readonly="not bchat_chat_view"/>
                    <field name="bchat_media_download" readonly="not bchat_chat_view or not bchat_media_view"/>
                    <field name="bchat_group_create" readonly="not bchat_chat_view"/>
                    <field name="bchat_group_manage" readonly="not bchat_chat_view"/>
                    <field name="bchat_task_view"/>
                    <field name="bchat_task_manage" readonly="not bchat_task_view"/>
                    <field name="bchat_room_admin_eligible" invisible="1"/>
                    <field name="bchat_manage_rooms" invisible="not bchat_room_admin_eligible"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
