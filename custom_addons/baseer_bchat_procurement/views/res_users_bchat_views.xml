<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_bchat_capabilities" model="ir.ui.view">
        <field name="name">res.users.form.bchat.capabilities</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="baseer_bchat.view_users_form_bchat_capabilities"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='bchat_capabilities']" position="inside">
                <separator string="Purchase requests"/>
                <field name="bchat_order_operator_eligible" invisible="1"/>
                <field name="bchat_order_view"/>
                <field name="bchat_order_create" readonly="not bchat_order_operator_eligible or not bchat_order_view"/>
                <field name="bchat_order_receive" readonly="not bchat_order_operator_eligible or not bchat_order_view"/>
            </xpath>
        </field>
    </record>
</odoo>
