<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A watchdog is an invisible background worker, not a terminal app. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.5.18</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(QaProfile)' == 'true'">
    <DefineConstants>$(DefineConstants);QA_PROFILE</DefineConstants>
    <AssemblyName>Baseer.PrintAgent.QA</AssemblyName>
  </PropertyGroup>
</Project>
