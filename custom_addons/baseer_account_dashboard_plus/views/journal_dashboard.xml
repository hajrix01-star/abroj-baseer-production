<odoo>
  <record id="journal_dashboard_plus" model="ir.ui.view">
    <field name="name">account.journal.dashboard.plus</field>
    <field name="model">account.journal</field>
    <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@id='dashboard_bank_cash_right']" position="inside">
        <div class="row" t-if="dashboard.baseer_ledger_balance">
          <div class="col text-start">
            <a type="object" name="baseer_open_ledger" title="Posted journal account balance; the card balance reflects bank statements and matched payments."><t t-if="dashboard.baseer_kind == 'delivery'">Due from delivery app</t><t t-else="">Ledger balance</t></a>
            <span t-if="dashboard.baseer_kind == 'delivery'" class="badge text-bg-light">Delivery app</span>
            <span t-if="dashboard.baseer_kind == 'custody'" class="badge text-bg-light">Custody</span>
          </div>
          <div class="col-auto text-end"><bdi dir="ltr"><t t-out="dashboard.baseer_ledger_balance"/></bdi> <small t-if="dashboard.baseer_has_ledger_diff" class="text-muted"><bdi dir="ltr">Δ <t t-out="dashboard.baseer_ledger_diff"/></bdi></small></div>
        </div>
      </xpath>
      <xpath expr="//div[@id='bank_and_cash_container']" position="inside">
        <div class="col-4" groups="account.group_account_readonly">
          <h5 class="o_kanban_card_manage_title">Reporting</h5>
          <div><a type="object" name="baseer_card_report_action" context="{'baseer_report': 'ledger'}">General Ledger</a></div>
        </div>
      </xpath>
      <xpath expr="//div[@name='kanban_manage_reports']" position="inside">
        <div t-if="journal_type == 'sale'"><a type="object" name="baseer_card_report_action" context="{'baseer_report': 'receivable'}">Aged Receivable</a></div>
        <div t-if="journal_type == 'purchase'"><a type="object" name="baseer_card_report_action" context="{'baseer_report': 'payable'}">Aged Payable</a></div>
      </xpath>
    </field>
  </record>
</odoo>
