<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cashier_batch_form" model="ir.ui.view">
        <field name="name">Purchase batch cashier access</field>
        <field name="model">baseer.purchase.batch</field>
        <field name="inherit_id" ref="baseer_purchase_batch.view_purchase_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@invisible=&quot;state != 'draft'&quot;]" position="attributes"><attribute name="groups">!baseer_access_roles.group_cashier</attribute></xpath>
            <xpath expr="//button[@name='action_approve']" position="replace">
                <button name="action_approve" type="object" string="Save and approve" class="oe_highlight"
                        invisible="state != 'draft' or not is_current_company or (is_cashier and not cashier_batch_approval_allowed)"/>
            </xpath>
            <xpath expr="//button[@name='action_view_bills']" position="attributes"><attribute name="groups">!baseer_access_roles.group_cashier</attribute></xpath>
            <xpath expr="//field[@name='is_current_company']" position="after">
                <field name="is_cashier" invisible="True"/>
                <field name="cashier_batch_approval_allowed" invisible="True"/>
            </xpath>
            <xpath expr="//div[hasclass('text-muted', 'mb-3')]" position="after">
                <div class="text-info mt-2" role="note" groups="baseer_access_roles.group_cashier"
                     invisible="state != 'draft' or cashier_batch_approval_allowed">
                    Your draft remains pending accountant approval for this company.
                </div>
            </xpath>
            <xpath expr="//field[@name='move_id']" position="attributes"><attribute name="groups">!baseer_access_roles.group_cashier</attribute></xpath>
            <xpath expr="//field[@name='bill_payment_state']" position="attributes"><attribute name="groups">!baseer_access_roles.group_cashier</attribute></xpath>
            <xpath expr="//field[@name='move_id']" position="after"><field name="baseer_bill_reference" optional="hide" readonly="True" groups="baseer_access_roles.group_cashier"/></xpath>
        </field>
    </record>
    <record id="view_cashier_batch_line_form" model="ir.ui.view">
        <field name="name">Purchase batch line cashier access</field>
        <field name="model">baseer.purchase.batch.line</field>
        <field name="inherit_id" ref="baseer_purchase_batch.view_purchase_batch_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[field[@name='move_id']]" position="replace">
                <group string="Original Documents" groups="!baseer_access_roles.group_cashier">
                    <field name="move_id" string="Vendor Bill" readonly="True"/>
                    <field name="payment_id" string="Payment" readonly="True"/>
                    <field name="bill_payment_state" string="Payment Status" readonly="True"/>
                </group>
                <group groups="baseer_access_roles.group_cashier"><field name="baseer_bill_reference" readonly="True"/></group>
            </xpath>
        </field>
    </record>
    <menuitem id="menu_cashier_purchase_batches" name="My Purchase Batches"
              parent="point_of_sale.menu_point_root" action="baseer_purchase_batch.action_purchase_batches"
              sequence="35" groups="baseer_access_roles.group_cashier"/>
</odoo>
