<odoo>
    <record id="action_dashboard" model="ir.actions.client"><field name="name">Dashboard 2</field><field name="tag">baseer_dashboard2.main</field><field name="target">current</field></record>
    <record id="event_view_list" model="ir.ui.view"><field name="name">baseer.dashboard2.event.list</field><field name="model">baseer.dashboard2.event</field><field name="arch" type="xml"><list><field name="name"/><field name="date_from"/><field name="date_to"/><field name="kind"/><field name="company_ids" widget="many2many_tags"/></list></field></record>
    <record id="event_view_form" model="ir.ui.view"><field name="name">baseer.dashboard2.event.form</field><field name="model">baseer.dashboard2.event</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="date_from"/><field name="date_to"/><field name="kind"/><field name="company_ids" widget="many2many_tags"/><field name="note"/><field name="color_token"/><field name="active"/></group></sheet></form></field></record>
    <record id="action_events" model="ir.actions.act_window"><field name="name">المناسبات</field><field name="res_model">baseer.dashboard2.event</field><field name="view_mode">list,form</field></record>
    <record id="settings_view_list" model="ir.ui.view"><field name="name">baseer.dashboard2.settings.list</field><field name="model">baseer.dashboard2.settings</field><field name="arch" type="xml"><list><field name="company_id"/></list></field></record>
    <record id="settings_view_form" model="ir.ui.view"><field name="name">baseer.dashboard2.settings.form</field><field name="model">baseer.dashboard2.settings</field><field name="arch" type="xml"><form><sheet><group><field name="company_id"/><field name="outflow_journal_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]"/><field name="custody_journal_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]"/><field name="show_vat_paid_line"/><field name="pos_cutover_note"/></group></sheet></form></field></record>
    <record id="action_settings" model="ir.actions.act_window"><field name="name">الإعدادات</field><field name="res_model">baseer.dashboard2.settings</field><field name="view_mode">list,form</field></record>
    <!-- Preserve a menu name edited in the UI or through translations on upgrades. -->
    <data noupdate="1">
        <menuitem id="menu_dashboard" name="Dashboard 2" action="action_dashboard" web_icon="baseer_dashboard2,static/description/icon.png" groups="account.group_account_readonly" sequence="20"/>
        <menuitem id="menu_events" name="المناسبات" parent="menu_dashboard" action="action_events" groups="account.group_account_readonly"/>
        <menuitem id="menu_settings" name="الإعدادات" parent="menu_dashboard" action="action_settings" groups="account.group_account_manager"/>
    </data>
</odoo>
