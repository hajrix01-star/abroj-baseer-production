<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Statement of financial position.
        Asset balances keep their natural debit-positive sign.
        Liability, equity and earnings balances are reversed so credit balances read as positive.
        Current-year and prior-year earnings split income, expense and equity_unaffected
        on the company's fiscal year. Prior-year equity_unaffected stays in the previous-year
        line so an allocation posted in an earlier year still keeps the statement in balance.
    -->
    <record id="report_balance_sheet" model="baseer.report.definition">
        <field name="name">Balance Sheet</field>
        <field name="code">balance_sheet</field>
        <field name="date_mode">as_of</field>
    </record>

    <record id="line_bs_assets" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">10</field>
        <field name="code">ASSETS</field>
        <field name="name">Assets</field>
        <field name="foldable" eval="True"/>
        <field name="hideable" eval="False"/>
        <field name="display">section</field>
    </record>
    <record id="expr_bs_assets" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_assets"/>
        <field name="engine">formula</field>
        <field name="formula">CA + FA + NCA</field>
    </record>

    <record id="line_bs_ca" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_assets"/>
        <field name="sequence">20</field>
        <field name="code">CA</field>
        <field name="name">Current Assets</field>
        <field name="foldable" eval="True"/>
        <field name="display">section</field>
    </record>
    <record id="expr_bs_ca" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_ca"/>
        <field name="engine">formula</field>
        <field name="formula">CASH + REC + CUR + PRE</field>
    </record>

    <record id="line_bs_cash" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_ca"/>
        <field name="sequence">30</field>
        <field name="code">CASH</field>
        <field name="name">Bank and Cash</field>
        <field name="foldable" eval="True"/>
    </record>
    <record id="expr_bs_cash" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_cash"/>
        <field name="engine">account_type</field>
        <field name="account_types">asset_cash</field>
        <field name="figure">balance</field>
        <field name="sign">1</field>
        <field name="date_scope">to_date</field>
    </record>

    <record id="line_bs_rec" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_ca"/>
        <field name="sequence">40</field>
        <field name="code">REC</field>
        <field name="name">Accounts Receivable</field>
        <field name="foldable" eval="True"/>
    </record>
    <record id="expr_bs_rec" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_rec"/>
        <field name="engine">account_type</field>
        <field name="account_types">asset_receivable</field>
        <field name="figure">balance</field>
        <field name="sign">1</field>
        <field name="date_scope">to_date</field>
    </record>

    <record id="line_bs_cur" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_ca"/>
        <field name="sequence">50</field>
        <field name="code">CUR</field>
        <field name="name">Other Current Assets</field>
        <field name="foldable" eval="True"/>
    </record>
    <record id="expr_bs_cur" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_cur"/>
        <field name="engine">account_type</field>
        <field name="account_types">asset_current</field>
        <field name="figure">balance</field>
        <field name="sign">1</field>
        <field name="date_scope">to_date</field>
    </record>

    <record id="line_bs_pre" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_ca"/>
        <field name="sequence">60</field>
        <field name="code">PRE</field>
        <field name="name">Prepayments</field>
        <field name="foldable" eval="True"/>
    </record>
    <record id="expr_bs_pre" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_pre"/>
        <field name="engine">account_type</field>
        <field name="account_types">asset_prepayments</field>
        <field name="figure">balance</field>
        <field name="sign">1</field>
        <field name="date_scope">to_date</field>
    </record>

    <record id="line_bs_fa" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_assets"/>
        <field name="sequence">70</field>
        <field name="code">FA</field>
        <field name="name">Fixed Assets</field>
        <field name="foldable" eval="True"/>
    </record>
    <record id="expr_bs_fa" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_fa"/>
        <field name="engine">account_type</field>
        <field name="account_types">asset_fixed</field>
        <field name="figure">balance</field>
        <field name="sign">1</field>
        <field name="date_scope">to_date</field>
    </record>

    <record id="line_bs_nca" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_assets"/>
        <field name="sequence">80</field>
        <field name="code">NCA</field>
        <field name="name">Non-current Assets</field>
        <field name="foldable" eval="True"/>
    </record>
    <record id="expr_bs_nca" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_nca"/>
        <field name="engine">account_type</field>
        <field name="account_types">asset_non_current</field>
        <field name="figure">balance</field>
        <field name="sign">1</field>
        <field name="date_scope">to_date</field>
    </record>

    <record id="line_bs_le" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">90</field>
        <field name="code">LE</field>
        <field name="name">Liabilities &amp; Equity</field>
        <field name="foldable" eval="False"/>
        <field name="hideable" eval="False"/>
        <field name="display">section</field>
    </record>

    <record id="line_bs_liab" model="baseer.report.line">
        <field name="parent_id" ref="line_bs_le"/>
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">90</field>
        <field name="code">LIAB</field>
        <field name="name">Liabilities</field>
        <field name="foldable" eval="True"/>
        <field name="hideable" eval="False"/>
        <field name="display">section</field>
    </record>
    <record id="expr_bs_liab" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_liab"/>
        <field name="engine">formula</field>
        <field name="formula">CL + NCL</field>
    </record>

    <record id="line_bs_cl" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_liab"/>
        <field name="sequence">100</field>
        <field name="code">CL</field>
        <field name="name">Current Liabilities</field>
        <field name="foldable" eval="True"/>
        <field name="display">section</field>
    </record>
    <record id="expr_bs_cl" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_cl"/>
        <field name="engine">formula</field>
        <field name="formula">OCL + PAY</field>
    </record>

    <record id="line_bs_ocl" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_cl"/>
        <field name="sequence">120</field>
        <field name="code">OCL</field>
        <field name="name">Other Current Liabilities</field>
        <field name="foldable" eval="True"/>
    </record>
    <record id="expr_bs_ocl" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_ocl"/>
        <field name="engine">account_type</field>
        <field name="account_types">liability_current,liability_credit_card</field>
        <field name="figure">balance</field>
        <field name="sign">-1</field>
        <field name="date_scope">to_date</field>
    </record>

    <record id="line_bs_pay" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_cl"/>
        <field name="sequence">110</field>
        <field name="code">PAY</field>
        <field name="name">Accounts Payable</field>
        <field name="foldable" eval="True"/>
    </record>
    <record id="expr_bs_pay" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_pay"/>
        <field name="engine">account_type</field>
        <field name="account_types">liability_payable</field>
        <field name="figure">balance</field>
        <field name="sign">-1</field>
        <field name="date_scope">to_date</field>
    </record>

    <record id="line_bs_ncl" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_liab"/>
        <field name="sequence">130</field>
        <field name="code">NCL</field>
        <field name="name">Non-current Liabilities</field>
        <field name="foldable" eval="True"/>
    </record>
    <record id="expr_bs_ncl" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_ncl"/>
        <field name="engine">account_type</field>
        <field name="account_types">liability_non_current</field>
        <field name="figure">balance</field>
        <field name="sign">-1</field>
        <field name="date_scope">to_date</field>
    </record>

    <record id="line_bs_equity" model="baseer.report.line">
        <field name="parent_id" ref="line_bs_le"/>
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">140</field>
        <field name="code">EQUITY</field>
        <field name="name">Equity</field>
        <field name="foldable" eval="True"/>
        <field name="hideable" eval="False"/>
        <field name="display">section</field>
    </record>
    <record id="expr_bs_equity" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_equity"/>
        <field name="engine">formula</field>
        <field name="formula">UNA + RE</field>
    </record>

    <record id="line_bs_una" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_equity"/>
        <field name="sequence">150</field>
        <field name="code">UNA</field>
        <field name="name">Unallocated Earnings</field>
        <field name="foldable" eval="True"/>
        <field name="display">section</field>
    </record>
    <record id="expr_bs_una" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_una"/>
        <field name="engine">formula</field>
        <field name="formula">CY_UNA + PY_UNA</field>
    </record>

    <record id="line_bs_cy_una" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_una"/>
        <field name="sequence">160</field>
        <field name="code">CY_UNA</field>
        <field name="name">Current Year Unallocated Earnings</field>
        <field name="foldable" eval="True"/>
        <field name="display">section</field>
    </record>
    <record id="expr_bs_cy_una" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_cy_una"/>
        <field name="engine">formula</field>
        <field name="formula">CY_EARN + CY_ALLOC</field>
    </record>

    <record id="line_bs_cy_earn" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_cy_una"/>
        <field name="sequence">170</field>
        <field name="code">CY_EARN</field>
        <field name="name">Current Year Earnings</field>
        <field name="foldable" eval="True"/>
    </record>
    <record id="expr_bs_cy_earn" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_cy_earn"/>
        <field name="engine">account_type</field>
        <field name="account_types">income,income_other,expense,expense_other,expense_depreciation,expense_direct_cost</field>
        <field name="figure">balance</field>
        <field name="sign">-1</field>
        <field name="date_scope">from_fiscalyear</field>
    </record>

    <record id="line_bs_cy_alloc" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_cy_una"/>
        <field name="sequence">180</field>
        <field name="code">CY_ALLOC</field>
        <field name="name">Current Year Allocated Earnings</field>
        <field name="foldable" eval="True"/>
    </record>
    <record id="expr_bs_cy_alloc" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_cy_alloc"/>
        <field name="engine">account_type</field>
        <field name="account_types">equity_unaffected</field>
        <field name="figure">balance</field>
        <field name="sign">-1</field>
        <field name="date_scope">from_fiscalyear</field>
    </record>

    <record id="line_bs_py_una" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_una"/>
        <field name="sequence">190</field>
        <field name="code">PY_UNA</field>
        <field name="name">Previous Years Unallocated Earnings</field>
        <field name="foldable" eval="True"/>
    </record>
    <record id="expr_bs_py_pl" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_py_una"/>
        <field name="sequence">10</field>
        <field name="engine">account_type</field>
        <field name="account_types">income,income_other,expense,expense_other,expense_depreciation,expense_direct_cost</field>
        <field name="figure">balance</field>
        <field name="sign">-1</field>
        <field name="date_scope">before_fiscalyear</field>
    </record>
    <record id="expr_bs_py_alloc" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_py_una"/>
        <field name="sequence">20</field>
        <field name="engine">account_type</field>
        <field name="account_types">equity_unaffected</field>
        <field name="figure">balance</field>
        <field name="sign">-1</field>
        <field name="date_scope">before_fiscalyear</field>
    </record>

    <record id="line_bs_re" model="baseer.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="parent_id" ref="line_bs_equity"/>
        <field name="sequence">145</field>
        <field name="code">RE</field>
        <field name="name">Retained Earnings</field>
        <field name="foldable" eval="True"/>
    </record>
    <record id="expr_bs_re" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_re"/>
        <field name="engine">account_type</field>
        <field name="account_types">equity</field>
        <field name="figure">balance</field>
        <field name="sign">-1</field>
        <field name="date_scope">to_date</field>
    </record>

    <record id="expr_bs_le" model="baseer.report.expression">
        <field name="line_id" ref="line_bs_le"/>
        <field name="engine">formula</field>
        <field name="formula">LIAB + EQUITY</field>
    </record>
</odoo>
