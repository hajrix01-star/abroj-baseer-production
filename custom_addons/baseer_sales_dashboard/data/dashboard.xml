<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="dashboard_executive_center" model="spreadsheet.dashboard">
            <field name="name">Command center</field>
            <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_sales"/>
            <field name="sequence">1</field>
            <field name="baseer_dashboard_kind">executive_center</field>
            <field name="is_published">True</field>
            <field name="group_ids" eval="[(6, 0, [ref('point_of_sale.group_pos_user')])]"/>
        </record>
        <record id="dashboard_sales_summary" model="spreadsheet.dashboard">
            <field name="name">Sales summaries</field>
            <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_sales"/>
            <field name="sequence">5</field>
            <field name="baseer_dashboard_kind">sales_summary</field>
            <field name="is_published">True</field>
            <field name="group_ids" eval="[(6, 0, [ref('point_of_sale.group_pos_user')])]"/>
        </record>
    </data>
    <record id="action_executive_home" model="ir.actions.client">
        <field name="name">Command center</field>
        <field name="tag">action_spreadsheet_dashboard</field>
        <field name="params" eval="{'dashboard_id': ref('dashboard_executive_center')}"/>
    </record>
</odoo>
