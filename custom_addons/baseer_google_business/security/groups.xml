<odoo>
    <record id="group_gbp_reader" model="res.groups">
        <field name="name">Google Business Reader</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_gbp_responder" model="res.groups">
        <field name="name">Google Business Responder</field>
        <field name="implied_ids" eval="[(4, ref('group_gbp_reader'))]"/>
    </record>
    <record id="group_gbp_manager" model="res.groups">
        <field name="name">Google Business Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_gbp_responder'))]"/>
    </record>
    <record id="baseer_access_roles.group_owner" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_gbp_manager'))]"/>
    </record>
</odoo>
