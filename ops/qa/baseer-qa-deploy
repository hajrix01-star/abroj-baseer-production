#!/usr/bin/env bash
# Root-owned QA deployment wrapper. The caller supplies a reviewed release ID;
# this wrapper owns the policy, source verification, recovery pair and module
# allowlist.
set -Eeuo pipefail
umask 027

declare -A APPROVED_MODULE_SET=()
phase_guard_active=0

die() {
    printf 'QA_DEPLOY=FAILED\nREASON=%s\n' "$*" >&2
    if [ "${phase_guard_active:-0}" -eq 1 ]; then
        rollback 1
    fi
    exit 1
}

require_safe_file() {
    local file=$1 mode=$2
    [ -f "$file" ] && [ ! -L "$file" ] || die "missing or unsafe file: $file"
    [ "$(stat -c '%U:%G:%a' -- "$file")" = "root:root:$mode" ] || die "unsafe ownership or mode: $file"
}

require_root_owned_path() {
    local path=$1 expected_root=$2 expected_mode=$3 actual mode part
    actual="$(realpath -e -- "$path")" || die "cannot resolve path: $path"
    case "$actual" in "$expected_root"|"$expected_root"/*) ;; *) die "path is outside required root: $path" ;; esac
    [ -f "$actual" ] && [ ! -L "$actual" ] || die "missing or unsafe file: $path"
    mode="$(stat -c '%U:%G:%a' -- "$actual")"
    [ "$mode" = "root:root:$expected_mode" ] || die "unsafe ownership or mode: $path"
    part="$actual"
    while :; do
        if [ "$part" = "$expected_root" ]; then
            [ "$(stat -c '%U:%G:%a' -- "$part")" = root:root:700 ] || die "unsafe QA config directory: $part"
        else
            [ "$(stat -c '%U:%G' -- "$part")" = root:root ] || die "unsafe parent ownership: $part"
            mode="$(stat -c '%a' -- "$part")"
            (( (8#$mode & 022) == 0 )) || die "group/other may write parent: $part"
        fi
        [ "$part" = "$expected_root" ] && break
        part="$(dirname -- "$part")"
    done
}

require_root() { [ "$(id -u)" -eq 0 ] || die 'root is required'; }

load_config() {
    local config_dir=/etc/baseer-qa current_suffix=/current
    if [ "$target" = noorix-preview ]; then
        config_dir=/etc/baseer-qa/noorix-preview
        current_suffix=/noorix-preview/current
    fi
    local config="$config_dir/deploy.env"
    require_safe_file "$config" 600
    require_root_owned_path "$config" /etc/baseer-qa 600
    # The root-owned configuration contains QA infrastructure identity only.
    # shellcheck disable=SC1090
    . "$config"
    for name in QA_ENVIRONMENT QA_BASE QA_DATABASE QA_DB_CONTAINER QA_ODOO_VOLUME QA_COMPOSE_PROJECT QA_COMPOSE_FILE QA_ENV_FILE QA_LOGIN_URL QA_SOURCE_REMOTE QA_SOURCE_SSH_KEY QA_SOURCE_KNOWN_HOSTS; do
        [ -n "${!name:-}" ] || die "missing config value: $name"
    done
    [ "$QA_ENVIRONMENT" = qa ] || die 'environment marker is not qa'
    [ "$QA_BASE" = /srv/baseer-qa ] || die 'QA_BASE must be /srv/baseer-qa'
    [[ "$QA_DATABASE" =~ ^baseer(_live)?_qa(_[a-zA-Z0-9]+)*$ ]] || die 'database is not QA-namespaced'
    [[ "$QA_DB_CONTAINER" =~ qa ]] && [[ "$QA_ODOO_VOLUME" =~ qa ]] && [[ "$QA_COMPOSE_PROJECT" =~ qa ]] || die 'runtime identity is not QA-namespaced'
    [[ "$QA_LOGIN_URL" =~ ^http://127\.0\.0\.1:[0-9]+/web/login$ ]] || die 'QA login URL must be loopback only'
    [ "$QA_COMPOSE_FILE" = "$config_dir/compose.yaml" ] || die 'QA compose path must be fixed'
    [ "$QA_ENV_FILE" = "$config_dir/runtime.env" ] || die 'QA env path must be fixed'
    require_root_owned_path "$QA_COMPOSE_FILE" /etc/baseer-qa 600
    require_root_owned_path "$QA_ENV_FILE" /etc/baseer-qa 600
    readonly CURRENT="$QA_BASE$current_suffix"
    grep -Fq "$CURRENT/custom_addons:/mnt/baseer-addons:ro" "$QA_COMPOSE_FILE" || die 'QA compose must mount the selected current custom addons read-only'
    readonly POLICY_DIR=/etc/baseer-qa/release-policies
    readonly RELEASES="$QA_BASE/releases"
    readonly BACKUPS="$QA_BASE/backups"
    readonly STAGING="$QA_BASE/deploy-staging"
    readonly ODOO_SERVICE="${QA_ODOO_SERVICE:-odoo}"
    readonly ADDONS_PATH="${QA_ADDONS_PATH:-/usr/lib/python3/dist-packages/odoo/addons,/mnt/baseer-addons,/mnt/third-party-addons/erp_heritage_19,/mnt/third-party-addons/odoomates_19}"
}

validate_arguments() {
    target=primary
    explicit_preview=0
    if [ "${1:-}" = --noorix-preview ]; then
        target=noorix-preview
        explicit_preview=1
        shift
    fi
    [ "$#" -eq 2 ] || die 'expected: release_id github_run_id'
    release_id=$1
    run_id=$2
    [[ "$release_id" =~ ^[a-z0-9][a-z0-9-]{2,63}$ ]] || die 'invalid release id'
    [[ "$run_id" =~ ^[0-9]+$ ]] || die 'invalid GitHub run id'
}

qa_serve_status() { /usr/bin/tailscale serve status --json; }

select_active_target() {
    # Called only with the shared deployment lock held. Refuse ambiguity rather
    # than guessing which database an ordinary deployment should mutate.
    [ "$explicit_preview" = 0 ] || return 0
    local route
    route="$(qa_serve_status | python3 -c '
import json, sys
def unique(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError()
        result[key] = value
    return result
try:
    obj = json.load(sys.stdin, object_pairs_hook=unique)
    if not isinstance(obj, dict) or set(obj) != {"TCP", "Web"}:
        raise ValueError()
    tcp = obj["TCP"]
    if (not isinstance(tcp, dict) or set(tcp) != {"8443"} or
            not isinstance(tcp["8443"], dict) or set(tcp["8443"]) != {"HTTPS"} or
            tcp["8443"]["HTTPS"] is not True or not isinstance(obj["Web"], dict) or len(obj["Web"]) != 1):
        raise ValueError()
    host, value = next(iter(obj["Web"].items()))
    if host != "baseer-live-qa.tail938958.ts.net:8443" or not isinstance(value, dict):
        raise ValueError()
    handlers = value.get("Handlers")
    if set(value) != {"Handlers"} or not isinstance(handlers, dict) or set(handlers) != {"/"}:
        raise ValueError()
    entry = handlers["/"]
    if not isinstance(entry, dict) or set(entry) != {"Proxy"}:
        raise ValueError()
    routes = {"http://127.0.0.1:18134": "primary", "http://127.0.0.1:18140": "noorix-preview"}
    print(routes[entry["Proxy"]])
except (ValueError, KeyError, TypeError):
    sys.exit(1)
')" || die 'cannot safely determine active QA route'
    case "$route" in primary|noorix-preview) target=$route ;; *) die 'invalid QA route' ;; esac
}

verify_preview_scope() {
    if [ "$target" = primary ]; then
        [ "$release_id" != baseer-2026-11-22-noorix-net-estimate-preview ] ||
            die 'Noorix preview release requires the isolated preview target'
        return
    fi
    if [ "$explicit_preview" = 1 ]; then
        [ "$release_id" = baseer-2026-11-22-noorix-net-estimate-preview ] &&
        [ "$commit" = 4a4f06cda34a5a6e2817e9e118f95c9945c4f2ab ] &&
        [ "$policy_modules" = baseer_profit_loss_report ] &&
        [ -z "${policy_third_party_modules:-}" ] ||
            die 'Noorix preview accepts only the approved standalone report release'
    else
        [ "$release_id" != baseer-2026-11-22-noorix-net-estimate-preview ] ||
            die 'Noorix preview release requires explicit isolated staging'
    fi
    [ "$QA_DATABASE" = baseer_qa_20261121b ] &&
    [ "$QA_DB_CONTAINER" = baseer-qa-refresh-20261121b-db-1 ] &&
    [ "$QA_ODOO_VOLUME" = baseer-qa-refresh-20261121b-odoo ] &&
    [ "$QA_COMPOSE_PROJECT" = baseer-qa-refresh-20261121b ] &&
    [ "$QA_LOGIN_URL" = http://127.0.0.1:18140/web/login ] &&
    [ "$ODOO_SERVICE" = odoo ] ||
        die 'Noorix preview target identity mismatch'
    local primary=/etc/baseer-qa/deploy.env
    require_safe_file "$primary" 600
    grep -Fxq 'QA_DATABASE=baseer_qa_20261023' "$primary" &&
    grep -Fxq 'QA_COMPOSE_PROJECT=baseer-qa-refresh-20261023' "$primary" ||
        die 'primary and preview must use distinct approved QA identities'
    systemctl is-active --quiet baseer-qa-refresh-20261121b-firewall.service ||
        die 'Noorix preview isolation service is not active'
    local helper=/usr/local/lib/baseer-qa-refresh/prepare-noorix-preview.py
    require_safe_file "$helper" 750
    local verify_flag=--verify-promoted
    [ "$explicit_preview" = 1 ] && verify_flag=--verify-installed
    python3 -I "$helper" "$verify_flag" ||
        die 'Noorix preview configuration or runtime did not pass preflight'
}

copy_qa_source() {
    cp -a -- "$old_release/." "$stage/"
    if [ "$target" = noorix-preview ]; then
        # The receipt authenticates the inherited source only. Keep it on
        # that release for rollback; the new release seals its own receipt.
        rm -f -- "$stage/QA_PROMOTED_SOURCE.json"
    fi
}

verify_source_identity() {
    require_safe_file "$QA_SOURCE_SSH_KEY" 600
    require_safe_file "$QA_SOURCE_KNOWN_HOSTS" 644
}

load_policy() {
    local key value seen_release=0 seen_commit=0 seen_modules=0 seen_third_party=0 seen_revision=0 seen_run=0
    policy="$POLICY_DIR/$release_id.env"
    require_safe_file "$policy" 600
    while IFS='=' read -r key value || [ -n "$key" ]; do
        case "$key" in
            RELEASE_ID) [ "$seen_release" -eq 0 ] || die 'duplicate RELEASE_ID'; policy_release_id=$value; seen_release=1 ;;
            COMMIT) [ "$seen_commit" -eq 0 ] || die 'duplicate COMMIT'; commit=$value; seen_commit=1 ;;
            MODULES) [ "$seen_modules" -eq 0 ] || die 'duplicate MODULES'; policy_modules=$value; seen_modules=1 ;;
            THIRD_PARTY_MODULES) [ "$seen_third_party" -eq 0 ] || die 'duplicate THIRD_PARTY_MODULES'; policy_third_party_modules=$value; seen_third_party=1 ;;
            POLICY_REVISION) [ "$seen_revision" -eq 0 ] || die 'duplicate POLICY_REVISION'; policy_revision=$value; seen_revision=1 ;;
            APPROVED_RUN_ID) [ "$seen_run" -eq 0 ] || die 'duplicate APPROVED_RUN_ID'; approved_run_id=$value; seen_run=1 ;;
            ''|'#'*) ;;
            *) die "unknown policy key: $key" ;;
        esac
    done < "$policy"
    [ "$seen_release" -eq 1 ] && [ "$seen_commit" -eq 1 ] && [ "$seen_modules" -eq 1 ] && [ "$seen_revision" -eq 1 ] && [ "$seen_run" -eq 1 ] || die 'incomplete approved policy'
    [ "$policy_release_id" = "$release_id" ] || die 'release id mismatch'
    [[ "$commit" =~ ^[a-f0-9]{40}$ ]] || die 'invalid policy commit'
    [[ "$policy_revision" =~ ^[a-f0-9]{40}$ ]] || die 'invalid policy revision'
    [[ "$approved_run_id" =~ ^[0-9]+$ ]] || die 'invalid approval run id'
    [ "$approved_run_id" = "$run_id" ] || die 'approval run does not match deployment request'
    APPROVED_MODULES=()
    if [ -n "$policy_modules" ]; then
        IFS=',' read -r -a APPROVED_MODULES <<< "$policy_modules"
    fi
    [ "${#APPROVED_MODULES[@]}" -gt 0 ] || [ -n "${policy_third_party_modules:-}" ] || die 'policy has no modules'
    APPROVED_MODULE_SET=()
    for module in "${APPROVED_MODULES[@]}"; do
        [[ "$module" =~ ^(baseer|abroj)_[a-z0-9_]+$ ]] || die 'invalid module name'
        [ -z "${APPROVED_MODULE_SET[$module]+x}" ] || die 'duplicate module name'
        APPROVED_MODULE_SET[$module]=1
    done
    if [ "$seen_third_party" -eq 1 ]; then
        third_party_path="$(third_party_module_path "$policy_third_party_modules")" || die 'invalid third-party module'
    fi
}

third_party_module_path() {
    case "$1" in
        eh_account_dynamic_reports) printf '%s\n' third_party_addons/erp_heritage_19/eh_account_dynamic_reports ;;
        dms) printf '%s\n' third_party_addons/oca_dms_19/dms ;;
        *) return 1 ;;
    esac
}

verify_third_party_runtime_path() {
    if [ "${policy_third_party_modules:-}" = dms ]; then
        case ",$ADDONS_PATH," in
            *,/mnt/third-party-addons/oca_dms_19,*) ;;
            *) die 'QA addons path must include the reviewed OCA DMS directory' ;;
        esac
    fi
}

compose=()
compose_cmd() {
    docker compose --project-name "$QA_COMPOSE_PROJECT" --env-file "$QA_ENV_FILE" -f "$QA_COMPOSE_FILE" --project-directory "$QA_BASE" "$@"
}

source_ssh() {
    GIT_SSH_COMMAND="ssh -i $QA_SOURCE_SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$QA_SOURCE_KNOWN_HOSTS" "$@"
}

module_state() {
    local module=$1
    docker exec "$QA_DB_CONTAINER" sh -lc "psql -U \"\$POSTGRES_USER\" -d '$QA_DATABASE' -Atqc \"SELECT state FROM ir_module_module WHERE name = '$module'\""
}

wait_for_login() {
    local attempt
    for attempt in $(seq 1 90); do
        curl -fsSL --max-time 10 "$QA_LOGIN_URL" >/dev/null && return 0
        sleep 1
    done
    return 1
}

start_qa_app() {
    if [ "${target:-primary}" = noorix-preview ]; then
        compose_cmd up -d --no-deps --force-recreate "$ODOO_SERVICE"
    else
        compose_cmd up -d "$ODOO_SERVICE"
    fi
}

verify_preview_app_source() {
    [ "${target:-primary}" = noorix-preview ] || return 0
    local file expected actual
    file=baseer_profit_loss_report/models/profit_loss.py
    expected=$(sha256sum -- "$CURRENT/custom_addons/$file") || return 1
    actual=$(docker exec baseer-qa-refresh-20261121b-odoo-1 sha256sum -- "/mnt/baseer-addons/$file") || return 1
    [ "${expected%% *}" = "${actual%% *}" ]
}

# The copied release, Git fetch and recovery pair all occupy QA's filesystem.
# Use apparent source/filestore sizes so sparse files cannot understate a tar
# backup.  All probes are read-only and must return bounded decimal integers.
capacity_number() {
    [[ "$1" =~ ^(0|[1-9][0-9]{0,14})$ ]] || die "invalid capacity estimate: $2"
}

release_apparent_bytes() { du -sb -- "$old_release" | awk '{print $1}'; }
release_entry_count() { find "$old_release" -xdev -printf '.' | wc -c | tr -d '[:space:]'; }
database_apparent_bytes() {
    docker exec "$QA_DB_CONTAINER" sh -lc "psql -U \"\$POSTGRES_USER\" -d '$QA_DATABASE' -Atqc 'SELECT pg_database_size(current_database())'"
}
filestore_apparent_bytes() {
    docker run --rm --network none -v "$QA_ODOO_VOLUME":/source:ro alpine:3.20 sh -lc \
        'du -sb "/source/filestore/'"$QA_DATABASE"'" | awk "{print \$1}"'
}
qa_available_bytes() { df -B1 --output=avail -- "$QA_BASE" | tail -n 1 | tr -d '[:space:]'; }
qa_available_inodes() { df --output=iavail -- "$QA_BASE" | tail -n 1 | tr -d '[:space:]'; }

capacity_guard() {
    local phase=$1 release_bytes=0 release_entries=0 db_bytes filestore_bytes available_bytes available_inodes required_bytes required_inodes
    if [ "$phase" = prefetch ]; then
        release_bytes="$(release_apparent_bytes)" || die 'cannot estimate current QA release size'
        release_entries="$(release_entry_count)" || die 'cannot estimate current QA release inodes'
        capacity_number "$release_bytes" release_bytes
        capacity_number "$release_entries" release_inodes
    elif [ "$phase" != backup ]; then
        die 'invalid capacity phase'
    fi
    db_bytes="$(database_apparent_bytes)" || die 'cannot estimate QA database size'
    filestore_bytes="$(filestore_apparent_bytes)" || die 'cannot estimate QA filestore size'
    available_bytes="$(qa_available_bytes)" || die 'cannot determine QA free bytes'
    available_inodes="$(qa_available_inodes)" || die 'cannot determine QA free inodes'
    capacity_number "$db_bytes" database_bytes
    capacity_number "$filestore_bytes" filestore_bytes
    capacity_number "$available_bytes" free_bytes
    capacity_number "$available_inodes" free_inodes
    # Prefetch needs one copied release plus room for its Git object pack.
    # The backup probe runs after staging and reserves only the recovery pair.
    required_bytes=$(( 2 * release_bytes + db_bytes + filestore_bytes + 1073741824 ))
    required_inodes=$(( release_entries + 4096 ))
    [ "$available_bytes" -ge "$required_bytes" ] || die "insufficient QA free bytes before $phase: need=$required_bytes available=$available_bytes"
    [ "$available_inodes" -ge "$required_inodes" ] || die "insufficient QA free inodes before $phase: need=$required_inodes available=$available_inodes"
    printf 'QA_CAPACITY=PASS PHASE=%s REQUIRED_BYTES=%s AVAILABLE_BYTES=%s REQUIRED_INODES=%s AVAILABLE_INODES=%s\n' \
        "$phase" "$required_bytes" "$available_bytes" "$required_inodes" "$available_inodes"
}

capture_recovery_pair() {
    docker exec "$QA_DB_CONTAINER" sh -lc "pg_dump -Fc -U \"\$POSTGRES_USER\" -d '$QA_DATABASE'" > "$backup/database.dump" \
        || die 'QA database backup failed'
    docker run --rm --network none -v "$QA_ODOO_VOLUME":/source:ro -v "$backup":/target alpine:3.20 sh -lc 'tar -C /source -cf /target/filestore.tar "filestore/'"$QA_DATABASE"'"' \
        || die 'QA filestore backup failed'
    sha256sum "$backup/database.dump" "$backup/filestore.tar" > "$backup/recovery.sha256" \
        || die 'QA recovery checksum failed'
}

qa_database_app_user() {
    local app_user
    app_user="$(awk -F= '
        /^USER=[A-Za-z_][A-Za-z0-9_]*$/ { count++; app_user=$2 }
        END { if (count != 1) exit 1; print app_user }
    ' "$QA_ENV_FILE")" || die 'cannot determine the QA Odoo database user'
    printf '%s\n' "$app_user"
}

normalize_restored_database_ownership() {
    local app_user
    app_user="$(qa_database_app_user)"
    docker exec "$QA_DB_CONTAINER" sh -lc "psql -v ON_ERROR_STOP=1 -U \"\$POSTGRES_USER\" -d postgres \\
        -c 'ALTER DATABASE \"$QA_DATABASE\" OWNER TO \"$app_user\"' \\
        && psql -v ON_ERROR_STOP=1 -U \"\$POSTGRES_USER\" -d '$QA_DATABASE' \\
        -c 'ALTER SCHEMA public OWNER TO \"$app_user\"' \\
        -c 'GRANT USAGE, CREATE ON SCHEMA public TO \"$app_user\"' \\
        -c \"DO \\\$\\\$ DECLARE record_to_fix record; BEGIN \\
            FOR record_to_fix IN SELECT schemaname, tablename FROM pg_tables WHERE schemaname = 'public' LOOP \\
                EXECUTE format('ALTER TABLE %I.%I OWNER TO %I', record_to_fix.schemaname, record_to_fix.tablename, '$app_user'); \\
            END LOOP; \\
            FOR record_to_fix IN SELECT sequence_schema, sequence_name FROM information_schema.sequences WHERE sequence_schema = 'public' LOOP \\
                EXECUTE format('ALTER SEQUENCE %I.%I OWNER TO %I', record_to_fix.sequence_schema, record_to_fix.sequence_name, '$app_user'); \\
            END LOOP; \\
        END \\\$\\\$;\"" || die 'QA database ownership normalization failed'
}

is_known_websocket_startup_traceback() {
    local log=$1 traceback_count request_error_count socket_keyerror_count websocket_runtime_count websocket_500_count
    traceback_count="$(grep -Ec 'Traceback \(most recent call last\):' "$log")" || return 1
    request_error_count="$(grep -Ec 'Exception during request handling\.' "$log")" || return 1
    socket_keyerror_count="$(grep -Ec "KeyError: 'socket'" "$log")" || return 1
    websocket_runtime_count="$(grep -Ec "RuntimeError: Couldn't bind the websocket\. Is the connection opened on the evented port \(8072\)\?" "$log")" || return 1
    websocket_500_count="$(grep -Ec 'GET /websocket\?version=.* HTTP/1\.1" 500 ' "$log")" || return 1
    [ "$traceback_count" -eq 2 ] &&
        [ "$request_error_count" -eq 1 ] &&
        [ "$socket_keyerror_count" -eq 1 ] &&
        [ "$websocket_runtime_count" -eq 1 ] &&
        [ "$websocket_500_count" -eq 1 ]
}

verify_smoke_log() {
    local result log="$backup/odoo-smoke.log"
    if grep -Eq 'CRITICAL|FATAL' "$log"; then
        die 'fatal QA smoke log entry'
    else
        result=$?
        [ "$result" -eq 1 ] || die 'cannot scan QA smoke log'
    fi
    if grep -Eq 'Traceback \(most recent call last\):' "$log"; then
        is_known_websocket_startup_traceback "$log" || die 'fatal QA smoke log entry'
    else
        result=$?
        [ "$result" -eq 1 ] || die 'cannot scan QA smoke log'
    fi
}

record_promoted_release() {
    # Only an ordinary deployment to the active Noorix backend updates its
    # boot provenance. Initial isolated staging has its own immutable pin.
    if [ "$target" != noorix-preview ] || [ "$explicit_preview" = 1 ]; then
        return 0
    fi
    local helper=/usr/local/lib/baseer-qa-refresh/prepare-noorix-preview.py
    require_safe_file "$helper" 750
    python3 -I "$helper" --record-promoted || die 'cannot seal promoted QA release'
}

restore_pair() (
    set -Eeuo pipefail
    # rollback() invokes this in an OR-list, where Bash ignores errexit even
    # inside this subshell. Explicit guards are required before each DB write.
    sha256sum -c "$backup/recovery.sha256" || return 1
    compose_cmd stop "$ODOO_SERVICE" >/dev/null 2>&1 || return 1
    docker exec "$QA_DB_CONTAINER" sh -lc "dropdb -U \"\$POSTGRES_USER\" --if-exists '$QA_DATABASE'" || return 1
    docker exec "$QA_DB_CONTAINER" sh -lc "createdb -U \"\$POSTGRES_USER\" '$QA_DATABASE'" || return 1
    docker exec -i "$QA_DB_CONTAINER" sh -lc "pg_restore -U \"\$POSTGRES_USER\" --no-owner --no-privileges -d '$QA_DATABASE'" < "$backup/database.dump" || return 1
    normalize_restored_database_ownership || return 1
    docker run --rm --network none -v "$QA_ODOO_VOLUME":/target -v "$backup":/backup:ro alpine:3.20 sh -lc '
        set -eu
        rm -rf -- "/target/filestore/'"$QA_DATABASE"'"
        mkdir -p /target/filestore
        tar -xf /backup/filestore.tar -C /target
        test -d "/target/filestore/'"$QA_DATABASE"'"
    ' || return 1
)

rollback() {
    local status=${1:-$?} rollback_failed=0 stop_failed=0
    [ "$status" -ne 0 ] || status=1
    trap - ERR HUP INT TERM
    set +e
    if [ "${release_switched:-0}" -eq 1 ]; then
        compose_cmd stop "$ODOO_SERVICE" >/dev/null 2>&1 || { rollback_failed=1; stop_failed=1; }
    fi
    if [ "${database_mutated:-0}" -eq 1 ] && [ "$rollback_failed" -eq 0 ]; then
        restore_pair >/dev/null 2>&1 || rollback_failed=1
    fi
    if [ "${release_switched:-0}" -eq 1 ] && [ "$stop_failed" -eq 0 ]; then
        ln -sfn "$old_release" "$CURRENT" || rollback_failed=1
    fi
    # A failed restore must never restart Odoo against an incomplete database.
    if [ "${service_quiesced:-0}" -eq 1 ] && [ "$rollback_failed" -eq 0 ]; then
        if ! start_qa_app >/dev/null 2>&1 || ! wait_for_login >/dev/null 2>&1 ||
            ! verify_preview_app_source >/dev/null 2>&1; then
            rollback_failed=1
            if [ "${target:-primary}" = noorix-preview ]; then
                compose_cmd stop "$ODOO_SERVICE" >/dev/null 2>&1 || true
            fi
        fi
    fi
    if [ -n "${backup:-}" ] && [ -d "$backup" ]; then
        if [ "$rollback_failed" -eq 0 ]; then
            printf 'QA_DEPLOY=ROLLED_BACK\nPREVIOUS_RELEASE=%s\n' "$old_release" > "$backup/result.env"
        else
            printf 'QA_DEPLOY=ROLLBACK_FAILED\nPREVIOUS_RELEASE=%s\n' "$old_release" > "$backup/result.env"
        fi
    fi
    [ "$rollback_failed" -eq 0 ] || printf 'QA_DEPLOY=ROLLBACK_FAILED\n' >&2
    [ "$rollback_failed" -eq 0 ] || exit 70
    exit "$status"
}

# Fixed source-only BWork transition boundary. The installed root-owned wrapper
# must itself be reviewed/rolled out separately; archived guard success is not
# proof that an installed host wrapper was changed.
declare -A BWORK_MODULE_MODE=()
bwork_native_upgrade=0
bwork_guard_root=''
bwork_requested=''
bwork_source_guard() {
    local candidate=$1 repository=$2 module core='' legacy=0 canonical=0
    for module in "${APPROVED_MODULES[@]}"; do
        case "$module" in baseer_bchat) legacy=1 ;; baseer_bwork) canonical=1 ;; esac
    done
    [ "$legacy" -eq 0 ] || [ "$canonical" -eq 0 ] || die 'mixed BChat/BWork core policy'
    if [ "$canonical" -eq 1 ]; then core=baseer_bwork
    elif [ "$legacy" -eq 1 ]; then core=baseer_bchat
    else return 0
    fi
    bwork_guard_root="$stage.guard"
    [ ! -e "$bwork_guard_root" ] && [ ! -L "$bwork_guard_root" ] || die 'guard staging path already exists'
    mkdir -m 0700 "$bwork_guard_root"
    # Exact approved commit; never main/working tree. Retain every default
    # backend/Android/guard-integrity check without leaking unrelated source
    # into the module-scoped host release.
    git -C "$repository" archive --format=tar "$commit" .github android "custom_addons/$core" ops |
        tar -x -C "$bwork_guard_root" --no-same-owner --no-same-permissions
    PYTHONDONTWRITEBYTECODE=1 python3 "$bwork_guard_root/custom_addons/$core/tools/release_guard.py" ||
        die 'frozen cumulative BWork source guard rejected candidate'
    if [ "$canonical" -eq 1 ]; then
        # Canonical fixed entry: custom_addons/baseer_bwork/tools/release_guard.py
        python3 "$bwork_guard_root/ops/lib/bwork_release_source.py" prepare \
            --candidate-root "$candidate" --guard-root "$bwork_guard_root" --modules "$policy_modules" >/dev/null ||
            die 'actual staged BWork core differs from frozen guard source'
        bwork_requested="$(python3 "$bwork_guard_root/ops/lib/bwork_release_source.py" requested \
            --candidate-root "$candidate" --modules "$policy_modules")" || die 'invalid BWork requested closure'
    fi
}

bwork_classify() {
    local candidate=$1 result=$2 lines operation module
    shift 2
    [ -n "$bwork_requested" ] || return 0
    "$@" run --rm --no-deps -T -v "$candidate:/mnt/bwork-candidate:ro" --entrypoint python3 "$bwork_service" \
        /mnt/bwork-candidate/custom_addons/baseer_bwork/tools/canonical_pre_upgrade.py \
        --classify --modules "$bwork_requested" --database "$bwork_database" > "$result" ||
        die 'BWork read-only database classification failed'
    lines="$(python3 "$bwork_guard_root/ops/lib/bwork_release_source.py" plan \
        --candidate-root "$candidate" --modules "$policy_modules" --plan "$result")" ||
        die 'BWork installed closure is not fully approved'
    BWORK_MODULE_MODE=()
    while read -r operation module; do
        case "$operation" in
            NATIVE) case "$module" in yes) bwork_native_upgrade=1 ;; no) bwork_native_upgrade=0 ;; *) die 'invalid native mode' ;; esac ;;
            UPGRADE|INSTALL) BWORK_MODULE_MODE[$module]=$operation ;;
            *) die 'invalid classification operation' ;;
        esac
    done <<< "$lines"
}

bwork_verify() {
    local candidate=$1 result=$2 mode=--verify verification=verified
    shift 2
    [ -n "$bwork_requested" ] || return 0
    if [ "$bwork_native_upgrade" -eq 1 ]; then mode=--verify-transition; verification=verified-transition; fi
    "$@" run --rm --no-deps -T -v "$candidate:/mnt/bwork-candidate:ro" --entrypoint python3 "$bwork_service" \
        /mnt/bwork-candidate/custom_addons/baseer_bwork/tools/canonical_pre_upgrade.py \
        "$mode" --modules "$bwork_requested" --database "$bwork_database" > "$result" ||
        die 'BWork canonical postconditions failed'
    python3 "$bwork_guard_root/ops/lib/bwork_release_source.py" "$verification" \
        --candidate-root "$candidate" --modules "$policy_modules" --plan "$result" >/dev/null ||
        die 'BWork post-upgrade closure failed'
}


# The refresh artifact has an exact detached runtime tree. Only its first
# reviewed scoped transition back to main may use this explicit lineage.
verify_refresh_source_advance() {
    local repo=$1 inherited=$2 current=$3 next=$4 pin pin_candidate pin_baseline pin_previous pin_ref
    [ "$QA_DATABASE" = baseer_qa_20261121b ] && [ "$QA_COMPOSE_PROJECT" = baseer-qa-refresh-20261121b ] ||
        die 'candidate does not advance current QA source'
    [[ "$inherited" =~ ^/srv/baseer-qa/releases/qa-refresh-20261121b-[1-9][0-9]*$ ]] ||
        die 'current QA is not the approved refresh artifact'
    git -C "$repo" merge-base --is-ancestor "$policy_revision" refs/heads/source-main ||
        die 'refresh transition policy is outside reviewed main'
    git -C "$repo" merge-base --is-ancestor "$next" refs/heads/source-main ||
        die 'refresh transition source is outside reviewed main'
    pin=$(git -C "$repo" show "$policy_revision:ops/qa/runtime-pins/20261121b.env") ||
        die 'refresh transition has no approved source pin'
    pin_candidate=$(awk -F= '$1 == "RUNTIME_CANDIDATE" {print $2}' <<< "$pin")
    pin_baseline=$(awk -F= '$1 == "RUNTIME_BASELINE" {print $2}' <<< "$pin")
    pin_previous=$(awk -F= '$1 == "RUNTIME_PREVIOUS_QA" {print $2}' <<< "$pin")
    pin_ref=$(awk -F= '$1 == "RUNTIME_REF" {print $2}' <<< "$pin")
    [[ "$pin_candidate" = "$current" && "$pin_baseline" =~ ^[a-f0-9]{40}$ &&
        "$pin_previous" =~ ^[a-f0-9]{40}$ && "$pin_ref" = refs/heads/codex/qa-runtime-20261121b-90c662 ]] ||
        die 'refresh transition does not match the approved artifact'
    git -C "$repo" merge-base --is-ancestor "$pin_previous" "$next" ||
        die 'refresh transition would rewind the reviewed QA source'
    source_ssh git -C "$repo" fetch --no-tags --quiet origin "$pin_ref:refs/heads/reviewed-qa-runtime"
    [ "$(git -C "$repo" rev-parse refs/heads/reviewed-qa-runtime)" = "$current" ] &&
        [ "$(git -C "$repo" rev-parse "$current^")" = "$pin_baseline" ] ||
        die 'approved refresh artifact moved'
    python3 - "$repo" "$inherited" "$current" <<'PY_VERIFY_REFRESH' || die 'current QA runtime differs from the reviewed refresh'
import hashlib
import stat
import subprocess
import sys
from pathlib import Path

repo, root, commit = sys.argv[1:]
roots = ('custom_addons', 'third_party_addons')
expected = {}
git_tree = subprocess.check_output(['git', '-C', repo, 'ls-tree', '-rz', commit, '--', *roots])
for entry in git_tree.split(b'\0'):
    if not entry:
        continue
    identity, name = entry.split(b'\t', 1)
    mode, kind, blob = identity.decode('ascii').split()
    if kind != 'blob' or mode not in ('100644', '100755'):
        sys.exit('Unsupported QA runtime object')
    expected[name.decode('utf-8')] = mode, blob

actual = {}
for name in roots:
    directory = Path(root) / name
    if not directory.is_dir() or directory.is_symlink():
        sys.exit('Missing QA runtime root')
    for path in directory.rglob('*'):
        info = path.lstat()
        rel = path.relative_to(root)
        if not stat.S_ISDIR(info.st_mode) and not stat.S_ISREG(info.st_mode):
            sys.exit('Unexpected QA runtime path type')
        if stat.S_ISDIR(info.st_mode) or '__pycache__' in rel.parts or path.suffix in ('.pyc', '.pyo'):
            continue
        data = path.read_bytes()
        blob = hashlib.sha1(f'blob {len(data)}\0'.encode() + data).hexdigest()
        actual[rel.as_posix()] = ('100755' if info.st_mode & 0o111 else '100644', blob)
if actual != expected:
    sys.exit('QA runtime content is not the approved tree')
PY_VERIFY_REFRESH
}

require_root
validate_arguments "$@"
readonly LOCK_FILE=/var/lock/baseer-qa-deploy.lock
exec 9>"$LOCK_FILE"
flock -n 9 || die 'another QA deployment is running'
select_active_target
load_config
verify_source_identity
load_policy
verify_third_party_runtime_path
install -d -o root -g root -m 0700 "$RELEASES" "$BACKUPS" "$STAGING"
verify_preview_scope

old_release="$(readlink -f "$CURRENT")"
[ -d "$old_release" ] || die 'current QA release cannot be resolved'
[ -f "$old_release/RELEASE_COMMIT" ] || die 'current QA release has no source marker'
live_commit="$(tr -d '\r\n' < "$old_release/RELEASE_COMMIT")"
[[ "$live_commit" =~ ^[a-f0-9]{40}$ ]] || die 'current QA source marker is invalid'

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
stage="$STAGING/.stage-${commit:0:12}-${run_id}-$stamp"
backup="$BACKUPS/pre-${commit:0:12}-${run_id}-$stamp"
release="$RELEASES/${commit:0:12}-run-${run_id}-$stamp"
release_switched=0
database_mutated=0
service_quiesced=0
capacity_guard prefetch
phase_guard_active=1
trap rollback ERR HUP INT TERM
[ ! -e "$stage" ] && [ ! -e "$backup" ] && [ ! -e "$release" ] || die 'deployment path already exists'

git init --bare --quiet "$stage.git"
git -C "$stage.git" remote add origin "$QA_SOURCE_REMOTE"
source_ssh git -C "$stage.git" fetch --no-tags --quiet origin main:refs/heads/source-main "$commit"
git -C "$stage.git" cat-file -e "$commit^{commit}" || die 'candidate commit is missing'
if [ "$explicit_preview" = 1 ] || ! git -C "$stage.git" merge-base --is-ancestor "$live_commit" "$commit"; then
    verify_refresh_source_advance "$stage.git" "$old_release" "$live_commit" "$commit"
fi
for module in "${APPROVED_MODULES[@]}"; do
    git -C "$stage.git" cat-file -e "$commit:custom_addons/$module/__manifest__.py" || die "approved module absent from candidate: $module"
done
if [ -n "${policy_third_party_modules:-}" ]; then
    grep -Fq "$CURRENT/third_party_addons:/mnt/third-party-addons:ro" "$QA_COMPOSE_FILE" || die 'QA compose must mount selected current third-party addons read-only'
    git -C "$stage.git" cat-file -e "$commit:$third_party_path/__manifest__.py" || die 'approved third-party module absent from candidate'
    if git -C "$stage.git" ls-tree -r "$commit" -- "$third_party_path" | awk '$1 == "120000" { found = 1 } END { exit !found }'; then
        die 'approved third-party module contains a symlink'
    fi
fi

# Release policies are module-scoped.  Retain the exact current QA tree and
# overlay only the reviewed modules so unrelated commits in the candidate
# cannot leak into QA merely because they share Git history.
mkdir -m 0700 "$stage"
copy_qa_source
for module in "${APPROVED_MODULES[@]}"; do
    rm -rf -- "$stage/custom_addons/$module"
    mkdir -p "$stage/custom_addons"
    git -C "$stage.git" archive --format=tar "$commit" "custom_addons/$module" | \
        tar -x -C "$stage" --no-same-owner --no-same-permissions
done
if [ -n "${policy_third_party_modules:-}" ]; then
    rm -rf -- "$stage/$third_party_path"
    git -C "$stage.git" archive --format=tar "$commit" "$third_party_path" | \
        tar -x -C "$stage" --no-same-owner --no-same-permissions
fi
bwork_source_guard "$stage" "$stage.git"
rm -rf -- "$stage.git"
chmod -R a+rX -- "$stage"
bwork_database=$QA_DATABASE
bwork_service=$ODOO_SERVICE
bwork_classify "$stage" "$stage/bwork-classification.json" compose_cmd
mv "$stage" "$release"
printf '%s\n' "$commit" > "$release/RELEASE_COMMIT"
chmod -R a+rX -- "$release"

upgrade_modules=()
install_modules=()
for module in "${APPROVED_MODULES[@]}" ${policy_third_party_modules:+"$policy_third_party_modules"}; do
    state="$(module_state "$module")"
    case "${BWORK_MODULE_MODE[$module]:-}" in
        UPGRADE) upgrade_modules+=("$module"); continue ;;
        INSTALL) install_modules+=("$module"); continue ;;
    esac
    case "$state" in
        installed) upgrade_modules+=("$module") ;;
        ''|uninstalled) install_modules+=("$module") ;;
        *) die "module is in an unsafe state: $module=$state" ;;
    esac
done
capacity_guard backup
mkdir -m 0700 "$backup"
service_quiesced=1
compose_cmd stop "$ODOO_SERVICE"
capture_recovery_pair

# Recheck after quiescence; classification is read-only, no writes before the
# checked DB+filestore recovery pair. A changed closure is a stop, not expansion.
if [ -n "$bwork_requested" ]; then
    bwork_classify "$release" "$backup/bwork-classification.json" compose_cmd
    cmp "$release/bwork-classification.json" "$backup/bwork-classification.json" || die 'BWork classification changed during quiescence'
fi

ln -sfn "$release" "$CURRENT"
release_switched=1
odoo_command="odoo --config=/etc/odoo/odoo.conf --db_host=\"\$HOST\" --db_user=\"\$USER\" --db_password=\"\$PASSWORD\" --addons-path=$ADDONS_PATH -d $QA_DATABASE"
if [ "${#upgrade_modules[@]}" -gt 0 ]; then
    odoo_command+=" -u $(IFS=,; printf '%s' "${upgrade_modules[*]}")"
fi
if [ "${#install_modules[@]}" -gt 0 ]; then
    odoo_command+=" -i $(IFS=,; printf '%s' "${install_modules[*]}")"
fi
odoo_command+=' --stop-after-init --workers=0 --max-cron-threads=0'
if [ "$bwork_native_upgrade" -eq 1 ]; then
    [ "${#upgrade_modules[@]}" -gt 0 ] || die 'native migration requires canonical upgrade list'
    odoo_command+=' --pre-upgrade-scripts=/mnt/baseer-addons/baseer_bwork/tools/canonical_pre_upgrade.py'
fi
database_mutated=1
compose_cmd run --rm --no-deps --entrypoint sh "$ODOO_SERVICE" -lc "$odoo_command" > "$backup/module-upgrade.log" 2>&1
bwork_verify "$release" "$backup/bwork-verified.json" compose_cmd
smoke_since="$(date -u +%Y-%m-%dT%H:%M:%SZ)" || die 'cannot timestamp QA smoke attempt'
start_qa_app
wait_for_login
verify_preview_app_source || die 'running Noorix preview did not mount the approved report source'
for module in "${APPROVED_MODULES[@]}" ${policy_third_party_modules:+"$policy_third_party_modules"}; do
    [ "$(module_state "$module")" = installed ] || die "module not installed after QA deployment: $module"
done
compose_cmd logs --since "$smoke_since" --no-color --tail=300 "$ODOO_SERVICE" > "$backup/odoo-smoke.log"
verify_smoke_log
record_promoted_release
printf 'QA_DEPLOY=GO\nRELEASE_ID=%s\nRELEASE=%s\nBACKUP=%s\nCOMMIT=%s\nMODULES=%s\nTHIRD_PARTY_MODULES=%s\n' \
    "$release_id" "$release" "$backup" "$commit" "$policy_modules" "${policy_third_party_modules:-}" > "$backup/result.env"
printf 'QA_DEPLOY=GO\nRELEASE=%s\nBACKUP=%s\n' "$release" "$backup"
