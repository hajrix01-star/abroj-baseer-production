<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="baseer_report_engine_tobacco.Report" t-inherit="baseer_report_engine.Report" t-inherit-mode="extension">
    <xpath expr="//Dropdown[@menuClass=&quot;'o_bre_dropdown o_bre_date_menu'&quot;]" position="attributes"><attribute name="t-if">!isTobacco</attribute></xpath>
    <xpath expr="//Dropdown[@menuClass=&quot;'o_bre_dropdown o_bre_date_menu'&quot;]" position="before"><input t-if="isTobacco" type="month" class="form-control o_bre_tobacco_month" t-att-aria-label="tobaccoLabels.month" t-att-value="(state.options.date_from || '').slice(0, 7)" t-on-change="tobaccoChooseMonth"/></xpath>
    <xpath expr="//Dropdown[@t-if='!isLedger &amp;&amp; !isCashFlow']" position="attributes"><attribute name="t-if">!isLedger &amp;&amp; !isCashFlow &amp;&amp; !isTobacco</attribute></xpath>
    <xpath expr="//Dropdown[@t-if='!isPartnerLedger'][1]" position="attributes"><attribute name="t-if">!isPartnerLedger &amp;&amp; !isTobacco</attribute></xpath>
    <xpath expr="//Dropdown[@t-if='state.analyticEnabled &amp;&amp; !isPartnerLedger &amp;&amp; !isCashFlow']" position="attributes"><attribute name="t-if">state.analyticEnabled &amp;&amp; !isPartnerLedger &amp;&amp; !isCashFlow &amp;&amp; !isTobacco</attribute></xpath>
    <xpath expr="//label[input[@disabled='disabled']]" position="before"><label t-if="isTobacco"><input type="checkbox" t-att-checked="state.options.show_products" t-on-change="(event) => state.options.show_products = event.target.checked"/> <t t-esc="tobaccoLabels.show"/></label><label t-if="isTobacco"><input type="checkbox" t-att-checked="state.options.show_cumulative" t-on-change="(event) => state.options.show_cumulative = event.target.checked"/> <t t-esc="tobaccoLabels.showCumulative"/></label></xpath>
    <xpath expr="//t[@t-if='isLedger || isCashFlow']" position="attributes"><attribute name="t-if">isLedger || isCashFlow || isTobacco</attribute></xpath>
    <xpath expr="//table[@t-if='isAged']" position="before">
        <t t-if="isTobacco" t-foreach="state.payload.tobacco_sections || []" t-as="section" t-key="section.company_id + '-' + section.account_id">
            <h4 class="mt-3"><t t-esc="section.company"/> — <t t-esc="section.account"/></h4>
            <div class="o_bre_tobacco_summary"><div t-if="state.options.show_cumulative"><span t-esc="tobaccoLabels.opening"/><strong class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(section.opening)"/></strong></div><div><span t-esc="tobaccoLabels.debit"/><strong class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(section.debit)"/></strong></div><div><span t-esc="tobaccoLabels.credit"/><strong class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(section.credit)"/></strong></div><div><span t-esc="tobaccoLabels.netPeriod"/><strong class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(section.net)"/></strong></div></div>
            <table class="o_bre_table o_bre_grid_table o_bre_ledger_table o_bre_tobacco_table">
                <colgroup><col class="tob-date"/><col class="tob-document"/><col t-if="state.options.show_products" class="tob-product"/><col class="tob-type"/><col t-att-span="state.options.show_cumulative ? 4 : 3" class="tob-amount"/></colgroup>
                <thead><tr class="o_bre_balance_header"><th t-esc="tobaccoLabels.date"/><th t-esc="tobaccoLabels.document"/><th t-if="state.options.show_products" t-esc="tobaccoLabels.product"/><th t-esc="tobaccoLabels.type"/><th t-esc="tobaccoLabels.debit"/><th t-esc="tobaccoLabels.credit"/><th t-esc="tobaccoLabels.net"/><th t-if="state.options.show_cumulative" t-esc="tobaccoLabels.cumulative"/></tr></thead>
                <tbody>
                    <tr t-if="state.options.show_cumulative" class="o_bre_section"><th><t t-esc="tobaccoLabels.opening"/><bdi dir="ltr" class="tob-mobile-balance" t-esc="tobaccoMoney(section.opening)"/></th><td t-att-colspan="state.options.show_products ? 6 : 5"/><td class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(section.opening)"/></td></tr>
                    <t t-foreach="section.days" t-as="day" t-key="day.date">
                        <t t-set="key" t-value="tobaccoKey(section, day)"/>
                        <tr class="o_bre_foldable"><th><button class="o_bre_fold" t-on-click="() => this.tobaccoToggle(section, day)"><span t-esc="state.folded[key] ? '▾' : (rtl ? '◂' : '▸')"/> <bdi t-esc="day.date"/></button></th><td t-att-colspan="state.options.show_products ? 3 : 2"/><td class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(day.debit)"/></td><td class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(day.credit)"/></td><td class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(day.net)"/></td><td t-if="state.options.show_cumulative" class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(day.cumulative)"/></td></tr>
                        <t t-if="state.folded[key]"><tr t-foreach="state.accounts[key]?.rows || []" t-as="item" t-key="item_index" class="o_bre_ledger_item"><td><bdi t-esc="item.date"/></td><td><button class="o_bre_amount" t-on-click="() => this.tobaccoOpen(item.model, item.id)" t-esc="item.name"/></td><td t-if="state.options.show_products" class="tob-product-cell"><t t-esc="item.product"/><t t-if="item.product" t-esc="' × ' + tobaccoQuantity(item.quantity)"/></td><td t-esc="item.type"/><td class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(item.debit)"/></td><td class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(item.credit)"/></td><td class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(item.net)"/></td><td t-if="state.options.show_cumulative" class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(item.cumulative)"/></td></tr><tr t-if="state.accounts[key]?.has_more" class="o_bre_ledger_more"><td t-att-colspan="(state.options.show_products ? 7 : 6) + (state.options.show_cumulative ? 1 : 0)"><button class="btn btn-link" t-on-click="() => this.tobaccoPage(section, day, state.accounts[key].next_offset)" t-esc="state.labels.load_more"/></td></tr></t>
                    </t>
                    <tr class="o_bre_band"><th t-esc="tobaccoLabels.total"/><td t-att-colspan="state.options.show_products ? 3 : 2"/><td class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(section.debit)"/></td><td class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(section.credit)"/></td><td class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(section.net)"/></td><td t-if="state.options.show_cumulative"/></tr>
                    <tr t-if="state.options.show_cumulative" class="o_bre_total"><th><t t-esc="tobaccoLabels.closing"/><bdi dir="ltr" class="tob-mobile-balance" t-esc="tobaccoMoney(section.closing)"/></th><td t-att-colspan="state.options.show_products ? 6 : 5"/><td class="is-number"><bdi dir="ltr" t-esc="tobaccoMoney(section.closing)"/></td></tr>
                </tbody>
            </table>
        </t>
    </xpath>
    <xpath expr="//table[@t-if='isAged']" position="attributes"><attribute name="t-if">!isTobacco &amp;&amp; isAged</attribute></xpath>
    <xpath expr="//table[@t-else='']" position="attributes"><attribute name="t-elif">!isTobacco</attribute><attribute name="t-else"/></xpath>
</t>
</templates>
