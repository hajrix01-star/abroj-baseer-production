<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bchat_room_list" model="ir.ui.view">
        <field name="name">baseer.bchat.room.list</field>
        <field name="model">baseer.bchat.room</field>
        <field name="arch" type="xml">
            <list string="BChat Rooms" create="1" delete="0">
                <field name="name"/>
                <field name="company_id"/>
                <field name="invoice_policy"/>
            </list>
        </field>
    </record>
    <record id="view_bchat_room_form" model="ir.ui.view">
        <field name="name">baseer.bchat.room.form</field>
        <field name="model">baseer.bchat.room</field>
        <field name="arch" type="xml">
            <form string="BChat Room" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" readonly="id"/>
                        <field name="invoice_policy"/>
                        <field name="invoice_policy_version" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Members">
                            <field name="membership_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="user_id"/>
                                    <field name="active"/>
                                    <field name="joined_after_message_id"/>
                                    <field name="left_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_bchat_membership_list" model="ir.ui.view">
        <field name="name">baseer.bchat.membership.list</field>
        <field name="model">baseer.bchat.membership</field>
        <field name="arch" type="xml">
            <list string="BChat Memberships" create="1" delete="0">
                <field name="room_id"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="active"/>
                <field name="joined_after_message_id"/>
                <field name="left_at"/>
            </list>
        </field>
    </record>
    <record id="view_bchat_membership_form" model="ir.ui.view">
        <field name="name">baseer.bchat.membership.form</field>
        <field name="model">baseer.bchat.membership</field>
        <field name="arch" type="xml">
            <form string="BChat Membership" create="1" edit="1" delete="0" duplicate="0">
                <header>
                    <button name="action_revoke" type="object" string="Remove Member"
                            class="btn-danger" invisible="not id or not active"/>
                </header>
                <sheet>
                    <group>
                        <field name="room_id" readonly="id"/>
                        <field name="user_id" readonly="id"/>
                        <field name="company_id" readonly="1" required="0" invisible="not id"/>
                        <field name="active" readonly="1"/>
                        <field name="joined_after_message_id" readonly="1"/>
                        <field name="left_at" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bchat_rooms" model="ir.actions.act_window">
        <field name="name">BChat Rooms</field>
        <field name="res_model">baseer.bchat.room</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bchat_memberships" model="ir.actions.act_window">
        <field name="name">BChat Members</field>
        <field name="res_model">baseer.bchat.membership</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <menuitem id="menu_bchat_root" name="BChat" sequence="25"
              groups="baseer_bchat.group_bchat_manager"/>
    <menuitem id="menu_bchat_rooms" name="Rooms" parent="menu_bchat_root"
              action="action_bchat_rooms" sequence="10"
              groups="baseer_bchat.group_bchat_manager"/>
    <menuitem id="menu_bchat_members" name="Members" parent="menu_bchat_root"
              action="action_bchat_memberships" sequence="20"
              groups="baseer_bchat.group_bchat_manager"/>
</odoo>
