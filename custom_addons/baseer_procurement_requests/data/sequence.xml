<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_procurement_request" model="ir.sequence">
        <field name="name">Procurement request</field>
        <field name="code">baseer.procurement.request</field>
        <field name="prefix">PRC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_procurement_custody" model="ir.sequence">
        <field name="name">Petty Cash</field>
        <field name="code">baseer.procurement.custody</field>
        <field name="prefix">PCUST/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_procurement_representative_petty_cash" model="ir.sequence">
        <field name="name">Representative Petty Cash</field>
        <field name="code">baseer.procurement.representative.petty.cash</field>
        <field name="prefix">RPC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
