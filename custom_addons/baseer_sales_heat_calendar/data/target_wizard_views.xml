<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_baseer_heat_calendar_target_wizard_form" model="ir.ui.view">
        <field name="name">baseer.heat.calendar.target.wizard.form</field>
        <field name="model">baseer.heat.calendar.target.wizard</field>
        <field name="arch" type="xml">
            <form string="Set heat calendar target" create="0" edit="0" delete="0">
                <sheet>
                    <div class="alert alert-info" role="status">
                        Each target applies to one company, one calendar month, and one named weekday. Saving the same scope updates it instead of creating a duplicate.
                    </div>
                    <group>
                        <field name="company_id"/>
                        <field name="year"/>
                        <field name="month"/>
                        <field name="weekday"/>
                        <field name="target_amount"/>
                        <field name="active"/>
                    </group>
                    <div class="text-muted" role="status">
                        <field name="scope_message" nolabel="1" readonly="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Save target" class="btn-primary"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
