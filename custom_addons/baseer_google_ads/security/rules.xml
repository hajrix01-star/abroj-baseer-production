<odoo>
  <data noupdate="1">
    <record id="rule_gads_connection_company" model="ir.rule">
      <field name="name">Google Ads connection: allowed companies</field>
      <field name="model_id" ref="model_baseer_gads_connection"/>
      <field name="domain_force">[('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[(4, ref('baseer_google_ads.group_gads_reader'))]"/>
    </record>
