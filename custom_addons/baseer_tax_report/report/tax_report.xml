<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_tax" model="report.paperformat">
        <field name="name">Saudi VAT Report A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">14</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
    </record>
    <record id="action_report_tax" model="ir.actions.report">
        <field name="name">Saudi VAT Report</field>
        <field name="model">baseer.tax.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baseer_tax_report.report_tax</field>
        <field name="report_file">baseer_tax_report.report_tax</field>
        <field name="paperformat_id" ref="paperformat_tax"/>
        <field name="print_report_name">'تقرير الضريبة %s-%s' % ((object.month if object.period_type == 'month' else 'Q' + object.quarter), object.year)</field>
    </record>
    <template id="tax_table">
        <table class="btr-table table table-sm table-striped align-middle">
            <thead><tr>
                <th style="width: 65%">البند / VAT return box</th>
                <th style="width: 17.5%" class="btr-money text-end">الأساس / Amount</th>
                <th style="width: 17.5%" class="btr-money text-end">الضريبة / VAT</th>
            </tr></thead>
            <tbody>
                <t t-foreach="report_data['visible_rows']" t-as="row">
                <tr t-att-class="('btr-total fw-bold ' if row['number'] in ('6', '12', '13', '16') else '') + ('btr-row' if report_data['interactive'] else '')"
                    t-att-data-id="row['number'] if report_data['interactive'] else None">
                    <td>
                        <a t-if="report_data['interactive']" href="#" class="btr-row-link text-decoration-underline"
                            t-att-data-id="row['number']" title="عرض تفاصيل البند">
                            <span class="btr-number" t-esc="row['number']"/>. <span t-esc="row['name'].split('. ', 1)[-1]"/>
                        </a>
                        <t t-else=""><span class="btr-number" t-esc="row['number']"/>. <span t-esc="row['name'].split('. ', 1)[-1]"/></t>
                    </td>
                    <td dir="ltr"
                        t-att-class="'btr-money text-end' + (' is-zero' if row['base'] is not None and row['base'] == 0 else (' is-negative' if row['base'] is not None and row['base'] &lt; 0 else ''))">
                        <a t-if="report_data['interactive'] and row['direct'].get('base')"
                                href="#" class="btr-open text-decoration-underline"
                                t-att-data-id="row['number'] + ':base'" title="عرض القيود الداعمة"
                                t-esc="row['base_text']"/>
                        <a t-elif="report_data['interactive'] and row['components'].get('base')"
                                href="#" class="btr-expand text-decoration-underline"
                                t-att-data-id="row['number'] + ':base'" title="عرض البنود المكوّنة"
                                t-esc="row['base_text']"/>
                        <span t-else="" t-esc="row['base_text']"/>
                    </td>
                    <td dir="ltr"
                        t-att-class="'btr-money text-end' + (' is-zero' if row['tax'] is not None and row['tax'] == 0 else (' is-negative' if row['tax'] is not None and row['tax'] &lt; 0 else ''))">
                        <a t-if="report_data['interactive'] and row['direct'].get('tax')"
                                href="#" class="btr-open text-decoration-underline"
                                t-att-data-id="row['number'] + ':tax'" title="عرض القيود الداعمة"
                                t-esc="row['tax_text']"/>
                        <a t-elif="report_data['interactive'] and row['components'].get('tax')"
                                href="#" class="btr-expand text-decoration-underline"
                                t-att-data-id="row['number'] + ':tax'" title="عرض البنود المكوّنة"
                                t-esc="row['tax_text']"/>
                        <span t-else="" t-esc="row['tax_text']"/>
                    </td>
                </tr>
                <tr t-if="report_data['interactive']" class="btr-row-actions d-none" t-att-data-id="row['number']">
                    <td colspan="3">
                        <t t-foreach="('base', 'tax')" t-as="column">
                            <a t-if="row['direct'].get(column)" href="#" class="btr-open d-inline-block me-3 text-decoration-underline"
                                t-att-data-id="row['number'] + ':' + column">
                                <t t-esc="'قيود الأساس / Base entries' if column == 'base' else 'قيود الضريبة / VAT entries'"/>
                            </a>
                            <a t-elif="row['components'].get(column)" href="#" class="btr-expand d-inline-block me-3 text-decoration-underline"
                                t-att-data-id="row['number'] + ':' + column">
                                <t t-esc="'تفصيل الأساس / Base details' if column == 'base' else 'تفصيل الضريبة / VAT details'"/>
                            </a>
                        </t>
                    </td>
                </tr>
                <t t-if="report_data['interactive']" t-foreach="('base', 'tax')" t-as="column">
                    <tr t-if="row['components'].get(column)" class="btr-components d-none"
                        t-att-data-id="row['number'] + ':' + column">
                        <td colspan="3">
                            <span>البنود المكوّنة / Component boxes:</span>
                            <a t-foreach="row['components'][column]" t-as="component"
                                    href="#" class="btr-open d-inline-block me-3 text-decoration-underline"
                                    t-att-data-id="component['number'] + ':' + component['column']"
                                    title="عرض القيود الداعمة">
                                <span t-esc="component['number']"/>. <span t-esc="component['name'].split('. ', 1)[-1]"/>
                                <span dir="ltr" t-esc="component['amount_text']"/>
                            </a>
                        </td>
                    </tr>
                </t>
                </t>
                <tr t-if="not report_data['visible_rows']"><td colspan="3">لا توجد مبالغ في الفترة المحددة / No non-zero boxes for this period.</td></tr>
            </tbody>
        </table>
        <div t-if="report_data['exception']['count']" class="btr-warning">
            <t t-if="report_data['is_rtl']">
                <strong>قيود ضريبة القيمة المضافة غير المصنفة:</strong>
                عدد القيود: <span t-esc="report_data['exception']['count']"/>؛ الرصيد:
                <span class="btr-money" dir="ltr" t-esc="report_data['exception_amount_text']"/>.
                <a t-if="report_data['interactive']" href="#" class="btr-help ms-1"
                    title="هذه القيود لا تدخل ضمن خانات التقرير الضريبي الست عشرة. راجع وسومها الضريبية قبل اعتماد التقرير."
                    aria-label="معلومات عن قيود القيمة المضافة غير المصنفة">؟</a>
                <span t-else="">هذه القيود لا تدخل ضمن خانات التقرير الضريبي الست عشرة. راجع وسومها الضريبية قبل اعتماد التقرير.</span>
            </t>
            <t t-else="">
                <strong>Unclassified VAT entries:</strong>
                Entries: <span t-esc="report_data['exception']['count']"/>; signed balance:
                <span class="btr-money" dir="ltr" t-esc="report_data['exception_amount_text']"/>.
                <a t-if="report_data['interactive']" href="#" class="btr-help ms-1"
                    title="These entries are excluded from the 16 VAT return boxes. Review their tax-grid tags before approving the report."
                    aria-label="About unclassified VAT entries">?</a>
                <span t-else="">These entries are excluded from the 16 VAT return boxes. Review their tax-grid tags before approving the report.</span>
            </t>
        </div>
        <div t-if="report_data['exception']['other_count']" class="btr-warning">
            <t t-if="report_data['is_rtl']">
                <strong>قيود ضرائب أخرى غير مصنفة:</strong>
                عدد القيود: <span t-esc="report_data['exception']['other_count']"/>؛ الرصيد:
                <span class="btr-money" dir="ltr" t-esc="report_data['other_tax_amount_text']"/>.
                <a t-if="report_data['interactive']" href="#" class="btr-help ms-1"
                    title="راجع مجموعات هذه الضرائب قبل تصنيفها ضمن ضريبة القيمة المضافة. لا تُدرج هذه القيود في خانات الإقرار."
                    aria-label="معلومات عن قيود الضرائب الأخرى غير المصنفة">؟</a>
                <span t-else="">راجع مجموعات هذه الضرائب قبل تصنيفها ضمن ضريبة القيمة المضافة. لا تُدرج هذه القيود في خانات الإقرار.</span>
            </t>
            <t t-else="">
                <strong>Other unclassified tax entries:</strong>
                Entries: <span t-esc="report_data['exception']['other_count']"/>; signed balance:
                <span class="btr-money" dir="ltr" t-esc="report_data['other_tax_amount_text']"/>.
                <a t-if="report_data['interactive']" href="#" class="btr-help ms-1"
                    title="Review these tax groups before classifying them as VAT. These entries are excluded from the VAT return boxes."
                    aria-label="About other unclassified tax entries">?</a>
                <span t-else="">Review these tax groups before classifying them as VAT. These entries are excluded from the VAT return boxes.</span>
            </t>
        </div>
    </template>
    <template id="preview_tax_report">
        <div class="btr-report-card o_baseer_report" t-att-dir="'rtl' if report_data['is_rtl'] else 'ltr'">
            <header class="o_baseer_report_head">
                <div class="o_baseer_report_identity">
                    <div>
                        <h2 class="o_baseer_report_title">
                            <t t-if="report_data['is_rtl']">تقرير ضريبة القيمة المضافة</t>
                            <t t-else="">Saudi VAT Report</t>
                        </h2>
                        <p class="o_baseer_report_period">
                            <span t-esc="report_data['company'].name"/> ·
                            <span dir="ltr" t-esc="report_data['date_from']"/> —
                            <span dir="ltr" t-esc="report_data['date_to']"/>
                        </p>
                    </div>
                </div>
                <span class="o_baseer_report_meta" t-esc="report_data['currency'].name"/>
            </header>
            <div t-if="report_data['journal_names']" class="o_baseer_report_warning" role="status">
                <t t-if="report_data['is_rtl']">تحليل حسب الدفاتر المختارة؛ ليس إجمالي الإقرار لجميع الدفاتر:</t>
                <t t-else="">Selected journals — analytical view, not the full VAT return:</t>
                <span t-esc="report_data['journal_names']"/>
            </div>
            <div class="btr-table-scroll"><t t-call="baseer_tax_report.tax_table"/></div>
        </div>
    </template>
    <template id="report_tax">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="report_data['company']"/>
            <div class="page" t-att-dir="'rtl' if report_data['is_rtl'] else 'ltr'">
                <style>
                    @page {size: A4 portrait; margin: 14mm 10mm 16mm 10mm;}
                    .page {width: 190mm; max-width: 190mm; margin: 0 auto;}
                    .btr {font-family: DejaVu Sans, Arial, sans-serif; color: #26343d; font-size: 10px;}
                    .btr-header {text-align: center; margin-bottom: 12px;}
                    .btr-header img {display: block; max-height: 60px; max-width: 160px; margin: 0 auto 4px;}
                    .btr h2 {font-size: 17px; margin: 5px 0;}
                    .btr-table {width: 100%; border-collapse: collapse; table-layout: fixed;}
                    .btr-table thead {display: table-header-group;}
                    .btr-table tr {page-break-inside: avoid;}
                    .btr-table th, .btr-table td {border: 1px solid #d9dfe2; padding: 5px; vertical-align: middle;}
                    .btr-table th {background: #edf3f2;}
                    .btr-total {font-weight: bold; background: #f2f5f4;}
                    .btr-money {direction: ltr; unicode-bidi: isolate; text-align: right; white-space: nowrap;}
                    .btr-number {direction: ltr; unicode-bidi: isolate;}
                    .btr-warning {margin-top: 12px; padding: 7px; border: 1px solid #d99053; color: #8b4a22;}
                </style>
                <main class="btr">
                    <div class="btr-header">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Company logo"/>
                        <strong t-esc="company.name"/><br/>
                        <span t-if="company.vat">الرقم الضريبي: <span dir="ltr" t-esc="company.vat"/></span>
                        <h2>تقرير ضريبة القيمة المضافة / Saudi VAT Report</h2>
                        <span dir="ltr" t-esc="report_data['date_from']"/> —
                        <span dir="ltr" t-esc="report_data['date_to']"/>
                        <span t-esc="report_data['currency'].name"/>
                    </div>
                    <div t-if="report_data['journal_names']" class="btr-warning">
                        تحليل حسب الدفاتر المختارة؛ ليس إجمالي الإقرار لجميع الدفاتر / Selected journals — analytical view, not the full VAT return:
                        <span t-esc="report_data['journal_names']"/>
                    </div>
                    <t t-call="baseer_tax_report.tax_table"/>
                </main>
            </div>
        </t>
    </template>
</odoo>
