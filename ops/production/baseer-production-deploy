    post_schema="$(bwork_recovery_schema_hash)" || return 1
    [ "$post_schema" = "$schema" ] || return 1
    "${compose_old[@]}" run --rm --no-deps -T --entrypoint timeout odoo 120 python3 \
        /mnt/baseer-addons/baseer_bwork/tools/canonical_pre_upgrade.py --classify \
        --modules baseer_bwork,baseer_bwork_admin,baseer_bwork_dashboard,baseer_bwork_procurement \
        --database baseer_prod > "$backup/bwork-restored-classification.json" || return 1
    python3 -c 'import json,sys; v=json.load(open(sys.argv[1])); assert v["classification"]=="canonical-ready" and not v["install"]' \
        "$backup/bwork-restored-classification.json" || return 1
    bwork_recovery_sync "$backup/bwork-restored-classification.json" || return 1
    (set -o noclobber; sha256sum "$backup/bwork-recovery-intent.env" "$backup/bwork-recovery-receipt.json" \
        "$backup/bwork-restored-classification.json" "$backup/bwork-paired-restore.json" \
        "$backup/bwork-schema-restored.sha256" > "$backup/bwork-recovery-result.sha256") || return 1
    bwork_recovery_sync "$backup/bwork-recovery-result.sha256" || return 1
    [ "$(stat -c '%d:%i' "$BASE/bwork-recovery-pending.env")" = \
        "$(stat -c '%d:%i' "$backup/bwork-recovery-intent.env")" ] || return 1
