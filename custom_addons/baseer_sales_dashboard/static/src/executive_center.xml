<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="baseer_sales_dashboard.ExecutiveCenter">
        <section class="o_baseer_executive" t-att-aria-label="labels.title" t-att-aria-busy="state.loading">
            <header class="o_bec_heading">
                <div><h1 t-esc="labels.title"/></div>
                <button type="button" class="btn btn-light" t-on-click="loadCards" t-att-disabled="state.loading"><i class="fa fa-refresh me-1" aria-hidden="true"/><t t-esc="labels.refresh"/></button>
            </header>
            <form class="o_bec_filters" t-on-submit="applyFilters">
                <label><span t-esc="labels.period"/><select class="form-select" t-model="state.preset">
                    <option value="last_complete_day" t-esc="labels.lastComplete"/><option value="current_day" t-esc="labels.currentDay"/>
                    <option value="this_month" t-esc="labels.thisMonth"/><option value="last_month" t-esc="labels.lastMonth"/>
                    <option value="last_30_days" t-esc="labels.last30"/><option value="custom" t-esc="labels.custom"/>
                </select></label>
                <label t-if="state.preset === 'custom'"><span t-esc="labels.from"/><input type="date" class="form-control" t-model="state.dateFrom" required="required"/></label>
                <label t-if="state.preset === 'custom'"><span t-esc="labels.to"/><input type="date" class="form-control" t-model="state.dateTo" required="required"/></label>
                <button type="submit" class="btn btn-primary" t-att-disabled="state.loading" t-esc="labels.apply"/>
            </form>
            <p t-if="state.period" class="o_bec_period"><bdi><t t-esc="state.period.from"/> — <t t-esc="state.period.to"/></bdi></p>
            <details class="o_bec_picker">
                <summary><i class="fa fa-building-o me-2" aria-hidden="true"/><t t-esc="labels.companies"/> <bdi t-esc="state.selected.length"/></summary>
                <div class="o_bec_picker_actions"><button type="button" class="btn btn-link" t-on-click="selectAll" t-esc="labels.all"/><button type="button" class="btn btn-link" t-on-click="clearSelection" t-esc="labels.clear"/></div>
                <div class="o_bec_company_options"><label t-foreach="state.companies" t-as="company" t-key="company.id"><input type="checkbox" t-att-checked="state.selected.includes(company.id)" t-on-change="(ev) => this.selectCompany(company.id, ev)"/><span t-esc="company.name"/></label></div>
            </details>
            <p t-if="state.loading" class="o_bec_status" role="status" aria-live="polite"><i class="fa fa-circle-o-notch fa-spin me-2" aria-hidden="true"/><t t-esc="labels.loading"/> <bdi><t t-esc="state.loaded"/> / <t t-esc="state.selected.length"/></bdi></p>
            <div t-if="state.error" class="alert alert-warning" role="alert"><p t-esc="state.error"/><button type="button" class="btn btn-outline-secondary" t-on-click="initialize" t-esc="labels.retry"/></div>
            <p t-if="!state.loading and !state.error and !state.selected.length" class="o_bec_status" t-esc="state.companies.length ? labels.empty : labels.noCompanies"/>
            <div class="o_bec_company_tabs" role="group" t-att-aria-label="labels.companies">
                <button t-foreach="state.cards" t-as="companyCard" t-key="companyCard.company.id" type="button" class="o_bec_company_tab" t-att-class="{'o_bec_active': state.activeCompany === companyCard.company.id}" t-att-aria-pressed="state.activeCompany === companyCard.company.id" t-on-click="() => this.activateCompany(companyCard.company.id)">
                    <span t-esc="companyCard.company.name"/><strong><bdi t-esc="companyCard.total.display"/> <small t-esc="companyCard.company.currency"/></strong>
                </button>
            </div>
            <div class="o_bec_grid">
                <article t-foreach="activeCards" t-as="card" t-key="card.company.id" class="o_bec_card">
                    <header class="o_bec_card_header"><div><p class="o_bec_date"><t t-esc="labels.period"/> · <bdi><t t-esc="card.period.from"/> — <t t-esc="card.period.to"/></bdi></p><h2 t-att-title="card.company.name" t-esc="card.company.name"/></div></header>
                    <p t-if="!card.available or card.reason === 'no_sales'" class="o_bec_status" t-esc="card.reason === 'unsupported_currency' ? labels.unsupportedCurrency : labels.unavailable"/>
                    <section class="o_bec_daily" t-att-aria-label="labels.total"><p t-esc="labels.total"/><div class="o_bec_daily_value"><bdi t-esc="card.total.display"/><small t-if="card.total.available" t-esc="card.company.currency"/></div></section>
                    <section class="o_bec_metrics"><div t-foreach="metrics(card)" t-as="metric" t-key="metric.key"><p t-esc="metric.label"/><strong><bdi t-esc="metric.value"/></strong></div></section>
                    <section t-if="card.timeline.length" class="o_bec_chart" t-att-aria-label="labels.chart"><p class="o_bec_chart_title" t-esc="labels.chart"/>
                        <div class="o_bec_bars" role="group" t-att-aria-label="labels.chart">
                            <button t-foreach="card.timeline" t-as="point" t-key="point.date" type="button" class="o_bec_bar" t-att-class="{'o_bec_point_open': state.point === pointKey(card, point), 'o_bec_point_missing': ['missing','no_orders'].includes(point.status), 'o_bec_point_partial': ['current','incomplete'].includes(point.status), 'o_bec_point_negative': point.value !== null and point.value.startsWith('-')}" t-att-aria-label="pointLabel(point)" t-on-click="() => this.togglePoint(card, point)" t-on-keydown="onPointKeydown">
                                <span class="o_bec_bar_fill" t-att-style="barStyle(point)"/>
                                <span class="o_bec_tooltip" aria-hidden="true"><strong t-esc="point.date"/><span><bdi t-esc="point.display"/></span><span t-esc="pointStatus(point)"/><span t-if="point.change.available"><bdi t-esc="point.change.display"/></span></span>
                            </button>
                        </div>
                        <div class="o_bec_dates"><span t-foreach="card.timeline" t-as="point" t-key="point.date"><bdi t-esc="point.label"/></span></div>
                    </section>
                    <section class="o_bec_days" t-att-aria-label="labels.days">
                        <h3 t-esc="labels.days"/>
                        <p t-if="!(card.days || []).length" class="o_bec_status" t-esc="labels.noSessions"/>
                        <details t-foreach="card.days || []" t-as="day" t-key="day.date" class="o_bec_day" t-on-toggle="(ev) => this.onDayToggle(ev, card, day)">
                            <summary>
                                <span class="o_bec_day_date"><i class="fa fa-chevron-down" aria-hidden="true"/><bdi t-esc="day.date"/><small><bdi t-esc="day.session_count"/> <t t-esc="labels.allSessions"/></small></span>
                                <span><small t-esc="labels.sales"/><strong><bdi t-esc="day.sales.display"/></strong></span>
                                <span><small t-esc="labels.customers"/><strong><bdi t-esc="day.customer_count.display"/></strong></span>
                                <span><small t-esc="labels.averageCustomer"/><strong><bdi t-esc="day.average_customer.display"/></strong></span>
                            </summary>
                            <div class="o_bec_day_body">
                                <p t-if="state.sessionLoading[dayKey(card, day)]" role="status" class="o_bec_status" t-esc="labels.loadingSessions"/>
                                <div t-if="state.sessionErrors[dayKey(card, day)]" role="alert" class="alert alert-warning"><p t-esc="state.sessionErrors[dayKey(card, day)]"/><button type="button" class="btn btn-outline-secondary" t-on-click="() => this.loadSessionPage(card, day, 1)" t-esc="labels.retry"/></div>
                                <t t-set="sessions" t-value="sessionsFor(card, day)"/>
                                <t t-if="sessions">
                                    <p t-if="!sessions.rows.length" class="o_bec_status" t-esc="labels.noSessions"/>
                                    <details t-foreach="sessions.rows" t-as="session" t-key="session.session_id" class="o_bec_session">
                                        <summary><span><strong t-esc="session.name"/><small><t t-esc="session.pos_name"/> · <t t-esc="sessionStatus(session.state)"/></small></span><strong><bdi t-esc="session.sales.display"/></strong></summary>
                                        <div class="o_bec_session_metrics">
                                            <div><small t-esc="labels.saleOrders"/><bdi t-esc="session.sale_order_count"/></div>
                                            <div><small t-esc="labels.customers"/><bdi t-esc="session.customer_count.display"/></div>
                                            <div><small t-esc="labels.averageOrder"/><bdi t-esc="session.average_order.display"/></div>
                                            <div><small t-esc="labels.averageCustomer"/><bdi t-esc="session.average_customer.display"/></div>
                                            <div><small t-esc="labels.cancelledOrders"/><bdi t-esc="session.cancelled_orders"/></div>
                                            <div><small t-esc="labels.itemCancellations"/><span t-esc="counterDisplay(session.item_cancellations)"/></div>
                                            <div><small t-esc="labels.substitutions"/><span t-esc="counterDisplay(session.substitutions)"/></div>
                                        </div>
                                    </details>
                                    <nav t-if="sessions.total > sessions.page_size" class="o_bec_session_pages" t-att-aria-label="labels.sessionDetails">
                                        <button type="button" class="btn btn-outline-secondary" t-att-disabled="state.sessionLoading[dayKey(card, day)] || sessions.page &lt;= 1" t-on-click="() => this.loadSessionPage(card, day, sessions.page - 1)" t-esc="labels.previousPage"/>
                                        <span><t t-esc="labels.page"/> <bdi t-esc="sessions.page"/></span>
                                        <button type="button" class="btn btn-outline-secondary" t-att-disabled="state.sessionLoading[dayKey(card, day)] || !sessions.has_next" t-on-click="() => this.loadSessionPage(card, day, sessions.page + 1)" t-esc="labels.next"/>
                                    </nav>
                                </t>
                            </div>
                        </details>
                    </section>
                </article>
            </div>
        </section>
    </t>
</templates>
