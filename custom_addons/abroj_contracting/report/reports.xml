<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <template id="pdf_document_layout" inherit_id="web.minimal_layout" primary="True">
    <xpath expr="//t[@t-call-assets='web.report_assets_pdf']" position="replace"/>
    <xpath expr="//t[@t-call-assets='web.report_assets_common']" position="replace"/>
    <xpath expr="//t[@t-call-assets='web.report_assets_pdf']" position="replace"/>
    <xpath expr="//head" position="inside">
      <style>html,body {margin:0;padding:0;} * {box-sizing:border-box;} .article .page {page-break-after:always;} .article .page:last-child {page-break-after:auto;} table {border-collapse:collapse;} p {margin:5px 0;} h2,h3,h4 {page-break-after:avoid;} tr {page-break-inside:avoid;}</style>
    </xpath>
  </template>
  <template id="document_container">
    <html>
      <head>
        <meta charset="utf-8"/>
      </head>
      <body dir="ltr">
        <main>
          <t t-out="0"/>
        </main>
      </body>
    </html>
  </template>
  <template id="contract_layout">
    <t t-set="company" t-value="o.company_id"/>
    <div t-attf-class="header o_company_#{company.id}_layout" style="font-size:10px;color:#0f2a4a;border-bottom:1px solid #b8975a;padding-bottom:9px;">
      <style t-out="company.contract_font_css()"/>
      <table style="width:100%" dir="ltr">
        <tr>
          <td style="width:42%"><strong t-out="company.contracting_name_en or company.name"/><br/>CR: <span t-field="company.company_registry"/> | VAT: <span t-field="company.vat"/></td>
          <td style="width:16%;text-align:center">
            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height:65px;max-width:100px"/>
          </td>
          <td dir="rtl" style="width:42%;text-align:right"><strong t-out="company.contracting_name_ar or company.name"/><br/>السجل التجاري: <span t-field="company.company_registry"/><br/>الرقم الضريبي: <span t-field="company.vat"/></td>
        </tr>
      </table>
    </div>
    <div t-attf-class="article o_company_#{company.id}_layout" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" style="font-size:14px;line-height:1.55;color:#26394b;" dir="ltr">
      <style t-out="company.contract_font_css()"/>
      <style>
.clause {width:100%;table-layout:fixed;margin:0 0 5px;border-collapse:collapse;page-break-inside:avoid;}
.clause td {width:50%;vertical-align:top;padding:5px 14px;white-space:normal;}
.clause td.en {text-align:left;padding-left:0;border-right:1px solid #dce1e6;}
.clause td.ar {text-align:right;padding-right:0;}
.clause span,.clause p {white-space:pre-line;}
.clause p {margin:3px 0 0;}
.clause strong {font-size:18px;color:#0f2a4a;}
h2 {font-size:25px;color:#0f2a4a;margin:0 0 4px;line-height:1.5;}
h4 {font-size:17px;color:#0f2a4a;margin:12px 0 6px;}
.title-band {border-bottom:1px solid #b8975a;padding:2px 0 10px;margin-bottom:12px;}
.document-meta {font-size:10px;color:#687587;text-align:center;}
.summary {background:#f1f4f7;border-top:1px solid #b8975a;border-bottom:1px solid #dce1e6;padding:7px 12px;margin:8px 0 12px;page-break-inside:avoid;}
.summary .clause {margin:0;}
.summary .clause td {padding-top:3px;padding-bottom:3px;}
.balance {width:100%;border-collapse:collapse;font-size:12px;margin-bottom:12px;}
.balance th {background:#eaf0f5;color:#0f2a4a;text-align:left;font-weight:700;padding:7px 10px;border-bottom:1px solid #b8975a;}
.balance td {padding:6px 10px;border-bottom:1px solid #e0e5e9;}
.balance tr:nth-child(odd) td {background:#f7f9fb;}
.signatures {margin-top:18px;border-top:1px solid #b8975a;padding-top:12px;page-break-inside:avoid;}
.signatures .clause td {line-height:2;}
.stamp {text-align:center;color:#7b8792;font-size:10px;letter-spacing:1px;margin-top:10px;}
.terms {page-break-before:always;}
.voucher-page .clause td {padding-top:4px;padding-bottom:4px;}
</style>
      <t t-out="0"/>
    </div>
    <div t-attf-class="footer o_company_#{company.id}_layout" style="font-size:9px;line-height:1.6;color:#667789;text-align:center;border-top:1px solid #b8975a;padding-top:7px;">
      <style t-out="company.contract_font_css()"/>
      <div t-out="company.partner_id.contact_address"/>
      <div><span t-field="company.phone"/> | <span t-field="company.email"/> | <span t-field="company.website"/></div>
      <div><span t-out="company.contracting_name_en or company.name"/> / <span dir="rtl" t-out="company.contracting_name_ar or company.name"/> — <span dir="ltr" style="display:inline-block">Page <span class="page"/> of <span class="topage"/></span></div>
    </div>
  </template>
  <record id="contract_paperformat" model="report.paperformat">
    <field name="name">Abroj bilingual A4</field>
    <field name="format">A4</field>
    <field name="margin_top">34</field>
    <field name="margin_bottom">27</field>
    <field name="margin_left">12</field>
    <field name="margin_right">12</field>
    <field name="header_spacing">7</field>
    <field name="dpi">90</field>
    <field name="orientation">Portrait</field>
  </record>
  <record id="report_agreement" model="ir.actions.report">
    <field name="name">Client contract / عقد العميل</field>
    <field name="model">project.project</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">abroj_contracting.agreement</field>
    <field name="binding_model_id" ref="project.model_project_project"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="contract_paperformat"/>
  </record>
  <template id="agreement">
    <t t-call="abroj_contracting.document_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="abroj_contracting.contract_layout">
          <div class="page">
            <div class="title-band"><h2 style="text-align:center">Client contract / عقد العميل</h2>
            <div class="document-meta">No. / الرقم: <span t-out="'PRJ-%s' % o.id" dir="ltr"/>   |   Date / التاريخ: <span t-out="o.contracting_start" dir="ltr"/></div></div><table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Project: <span t-out="o.name"/></td>
                <td class="ar" dir="rtl">المشروع: <span t-out="o.name"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Company: <span t-out="o.company_id.contracting_name_en or o.company_id.name"/><br/>VAT: <span t-out="o.company_id.vat"/></td>
                <td class="ar" dir="rtl">الشركة: <span t-out="o.company_id.contracting_name_ar or o.company_id.name"/><br/>الرقم الضريبي: <span t-out="o.company_id.vat"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Party: <span t-out="o.partner_id.name"/><br/>VAT: <span t-out="o.partner_id.vat"/></td>
                <td class="ar" dir="rtl">الطرف: <span t-out="o.partner_id.name"/><br/>الرقم الضريبي: <span t-out="o.partner_id.vat"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Project / Scope: <span t-out="o.report_text('contracting_goal', 'en')"/></td>
                <td class="ar" dir="rtl">المشروع / النطاق: <span t-out="o.report_text('contracting_goal', 'ar')"/></td>
              </tr>
            </table>
            <div class="summary"><table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Contract value: <span t-out="o.contract_value" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
                <td class="ar" dir="rtl">قيمة العقد: <span t-out="o.contract_value" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">VAT rate: <span t-out="o.contract_vat_percent"/>%<br/>VAT: <span t-out="o.contract_value * o.contract_vat_percent / 100" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/><br/>Total including VAT: <span t-out="o.contract_value * (1 + o.contract_vat_percent / 100)" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
                <td class="ar" dir="rtl">نسبة الضريبة: <span t-out="o.contract_vat_percent"/>%<br/>الضريبة: <span t-out="o.contract_value * o.contract_vat_percent / 100" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/><br/>الإجمالي شامل الضريبة: <span t-out="o.contract_value * (1 + o.contract_vat_percent / 100)" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
              </tr>
            </table>
            </div><table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Start: <span t-out="o.contracting_start" dir="ltr"/> | End: <span t-out="o.contracting_end" dir="ltr"/><br/>Days: <span t-out="o.duration_days"/></td>
                <td class="ar" dir="rtl">البدء: <span t-out="o.contracting_start" dir="ltr"/> | الانتهاء: <span t-out="o.contracting_end" dir="ltr"/><br/>الأيام: <span t-out="o.duration_days"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Payment milestones: <span t-out="o.report_text('contract_payment_schedule', 'en')"/><br/>Retention: <span t-out="o.contract_retention_percent"/>%</td>
                <td class="ar" dir="rtl">مراحل الدفع: <span t-out="o.report_text('contract_payment_schedule', 'ar')"/><br/>الضمان: <span t-out="o.contract_retention_percent"/>%</td>
              </tr>
            </table>
            <div class="terms"><h4>Terms &amp; conditions / الشروط والأحكام</h4><t t-foreach="o.contract_clauses()" t-as="clause">
              <table class="clause" dir="ltr">
                <tr>
                  <td class="en" dir="ltr">
                    <span t-out="clause_index + 1"/>. <strong t-out="clause.report_text('name', 'en')"/>
                    <p t-out="clause.text_en"/>
                  </td>
                  <td class="ar" dir="rtl">
                    <span t-out="clause_index + 1"/>. <strong t-out="clause.report_text('name', 'ar')"/>
                    <p t-out="clause.text_ar"/>
                  </td>
                </tr>
              </table>
            </t>
            </div><div class="signatures"><table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Company signature: __________________<br/>Party signature: __________________<br/>Date: __________________</td>
                <td class="ar" dir="rtl">توقيع الشركة: __________________<br/>توقيع الطرف: __________________<br/>التاريخ: __________________</td>
              </tr>
            </table>
          <div class="stamp">COMPANY STAMP / ختم الشركة</div></div></div>
        </t>
      </t>
    </t>
  </template>
  <record id="report_subcontract" model="ir.actions.report">
    <field name="name">Subcontract / عقد مقاول الباطن</field>
    <field name="model">abroj.contracting.subcontractor</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">abroj_contracting.subcontract</field>
    <field name="binding_model_id" ref="model_abroj_contracting_subcontractor"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="contract_paperformat"/>
  </record>
  <template id="subcontract">
    <t t-call="abroj_contracting.document_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="abroj_contracting.contract_layout">
          <div class="page">
            <div class="title-band"><h2 style="text-align:center">Subcontract / عقد مقاول الباطن</h2>
            <div class="document-meta">No. / الرقم: <span t-out="'SUB-%s' % o.id" dir="ltr"/>   |   Date / التاريخ: <span t-out="o.start_date" dir="ltr"/></div></div><table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Project: <span t-out="o.project_id.name"/></td>
                <td class="ar" dir="rtl">المشروع: <span t-out="o.project_id.name"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Company: <span t-out="o.company_id.contracting_name_en or o.company_id.name"/><br/>VAT: <span t-out="o.company_id.vat"/></td>
                <td class="ar" dir="rtl">الشركة: <span t-out="o.company_id.contracting_name_ar or o.company_id.name"/><br/>الرقم الضريبي: <span t-out="o.company_id.vat"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Party: <span t-out="o.partner_id.name"/><br/>VAT: <span t-out="o.partner_id.vat"/></td>
                <td class="ar" dir="rtl">الطرف: <span t-out="o.partner_id.name"/><br/>الرقم الضريبي: <span t-out="o.partner_id.vat"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Project / Scope: <span t-out="o.report_text('scope', 'en')"/></td>
                <td class="ar" dir="rtl">المشروع / النطاق: <span t-out="o.report_text('scope', 'ar')"/></td>
              </tr>
            </table>
            <div class="summary"><table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Contract value: <span t-out="o.agreed_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
                <td class="ar" dir="rtl">قيمة العقد: <span t-out="o.agreed_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
              </tr>
            </table>
            </div><table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Type: <span t-out="{'labor': 'Labor only', 'materials': 'Materials inclusive', 'lump': 'Lump sum', 'other': 'Other'}.get(o.contract_type, '')"/></td>
                <td class="ar" dir="rtl">نوع العقد: <span t-out="{'labor': 'عمالة فقط', 'materials': 'شامل المواد', 'lump': 'مقطوعية', 'other': 'أخرى'}.get(o.contract_type, '')"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Penalties: <span t-out="o.report_text('penalties', 'en')"/></td>
                <td class="ar" dir="rtl">الغرامات: <span t-out="o.report_text('penalties', 'ar')"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Start: <span t-out="o.start_date" dir="ltr"/> | End: <span t-out="o.end_date" dir="ltr"/><br/>Days: <span t-out="o.duration_days"/></td>
                <td class="ar" dir="rtl">البدء: <span t-out="o.start_date" dir="ltr"/> | الانتهاء: <span t-out="o.end_date" dir="ltr"/><br/>الأيام: <span t-out="o.duration_days"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Payment milestones: <span t-out="o.report_text('payment_terms', 'en')"/><br/>Retention: <span t-out="o.retention_percent"/>%</td>
                <td class="ar" dir="rtl">مراحل الدفع: <span t-out="o.report_text('payment_terms', 'ar')"/><br/>الضمان: <span t-out="o.retention_percent"/>%</td>
              </tr>
            </table>
            <div class="terms"><h4>Terms &amp; conditions / الشروط والأحكام</h4><t t-foreach="o.contract_clauses()" t-as="clause">
              <table class="clause" dir="ltr">
                <tr>
                  <td class="en" dir="ltr">
                    <span t-out="clause_index + 1"/>. <strong t-out="clause.report_text('name', 'en')"/>
                    <p t-out="clause.text_en"/>
                  </td>
                  <td class="ar" dir="rtl">
                    <span t-out="clause_index + 1"/>. <strong t-out="clause.report_text('name', 'ar')"/>
                    <p t-out="clause.text_ar"/>
                  </td>
                </tr>
              </table>
            </t>
            </div><div class="signatures"><table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Company signature: __________________<br/>Party signature: __________________<br/>Date: __________________</td>
                <td class="ar" dir="rtl">توقيع الشركة: __________________<br/>توقيع الطرف: __________________<br/>التاريخ: __________________</td>
              </tr>
            </table>
          <div class="stamp">COMPANY STAMP / ختم الشركة</div></div></div>
        </t>
      </t>
    </t>
  </template>
  <record id="report_voucher" model="ir.actions.report">
    <field name="name">Voucher / سند</field>
    <field name="model">abroj.contracting.voucher</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">abroj_contracting.voucher</field>
    <field name="binding_model_id" ref="model_abroj_contracting_voucher"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="contract_paperformat"/>
  </record>
  <template id="voucher">
    <t t-call="abroj_contracting.document_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="abroj_contracting.contract_layout">
          <div class="page voucher-page">
            <div class="title-band"><h2 style="text-align:center">
              <t t-if="o.kind == 'receipt'">Receipt voucher / سند قبض</t>
              <t t-else="">Payment voucher / سند صرف</t>
            </h2>
            <div class="document-meta">No. / الرقم: <span t-out="o.name" dir="ltr"/>   |   Date / التاريخ: <span t-out="o.date" dir="ltr"/></div></div><table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Company: <span t-out="o.company_id.contracting_name_en or o.company_id.name"/><br/>VAT: <span t-out="o.company_id.vat"/></td>
                <td class="ar" dir="rtl">الشركة: <span t-out="o.company_id.contracting_name_ar or o.company_id.name"/><br/>الرقم الضريبي: <span t-out="o.company_id.vat"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Party: <span t-out="o.partner_id.name"/><br/>VAT: <span t-out="o.partner_id.vat"/></td>
                <td class="ar" dir="rtl">الطرف: <span t-out="o.partner_id.name"/><br/>الرقم الضريبي: <span t-out="o.partner_id.vat"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Number: <span t-out="o.name"/> | Date: <span t-out="o.date" dir="ltr"/><br/>Project: <span t-out="o.project_id.name"/><br/>Contract: <span t-out="o.subcontractor_id.display_name or o.vendor_contract_reference or o.project_id.name"/><br/>Status: <span t-out="{'draft': 'Draft', 'issued': 'Issued', 'cancelled': 'Cancelled'}.get(o.state)"/><br/>Method: <span t-out="{'cash': 'Cash', 'bank': 'Bank transfer', 'other': 'Other'}.get(o.method)"/><br/>Memo: <span t-out="o.report_text('memo', 'en')"/></td>
                <td class="ar" dir="rtl">الرقم: <span t-out="o.name"/> | التاريخ: <span t-out="o.date" dir="ltr"/><br/>المشروع: <span t-out="o.project_id.name"/><br/>العقد: <span t-out="o.subcontractor_id.display_name or o.vendor_contract_reference or o.project_id.name"/><br/>الحالة: <span t-out="{'draft': 'مسودة', 'issued': 'صادر', 'cancelled': 'ملغى'}.get(o.state)"/><br/>طريقة الدفع: <span t-out="{'cash': 'نقداً', 'bank': 'تحويل بنكي', 'other': 'أخرى'}.get(o.method)"/><br/>البيان: <span t-out="o.report_text('memo', 'ar')"/></td>
              </tr>
            </table>
            <h4>Previous issued vouchers / السندات السابقة الصادرة</h4>
            <table class="balance" dir="ltr">
              <tr>
                <th>Date / التاريخ</th>
                <th>Number / الرقم</th>
                <th>Type / النوع</th>
                <th>Amount / المبلغ</th>
              </tr>
              <tr t-foreach="o.previous_vouchers()" t-as="v">
                <td>
                  <span t-field="v.date"/>
                </td>
                <td>
                  <span t-field="v.name"/>
                </td>
                <td>
                  <span t-out="'Payment / صرف' if v.kind == 'payment' else 'Receipt / قبض'"/>
                </td>
                <td>
                  <span t-field="v.amount"/>
                </td>
              </tr>
            </table>
            <div class="summary"><table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Contract value: <span t-out="o.balance_contract_value" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
                <td class="ar" dir="rtl">قيمة العقد: <span t-out="o.balance_contract_value" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Materials deducted: <span t-out="o.balance_materials" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
                <td class="ar" dir="rtl">المواد المخصومة: <span t-out="o.balance_materials" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Total before this voucher: <span t-out="o.balance_before" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
                <td class="ar" dir="rtl">الإجمالي قبل هذا السند: <span t-out="o.balance_before" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">This voucher: <span t-out="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
                <td class="ar" dir="rtl">هذا السند: <span t-out="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
              </tr>
            </table>
            <table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Remaining after: <span t-out="o.balance_remaining" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
                <td class="ar" dir="rtl">المتبقي بعد السند: <span t-out="o.balance_remaining" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" dir="ltr"/></td>
              </tr>
            </table>
            </div><div class="signatures"><table class="clause" dir="ltr">
              <tr>
                <td class="en" dir="ltr">Company signature: __________________<br/>Party signature: __________________<br/>Date: __________________</td>
                <td class="ar" dir="rtl">توقيع الشركة: __________________<br/>توقيع الطرف: __________________<br/>التاريخ: __________________</td>
              </tr>
            </table>
          <div class="stamp">COMPANY STAMP / ختم الشركة</div></div></div>
        </t>
      </t>
    </t>
  </template>
  <record id="report_settlement" model="ir.actions.report">
    <field name="name">تسوية نهاية المشروع</field>
    <field name="model">abroj.contracting.subcontractor</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">abroj_contracting.settlement</field>
    <field name="binding_model_id" ref="model_abroj_contracting_subcontractor"/>
    <field name="binding_type">report</field>
  </record>
  <template id="settlement">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
          <div class="page" dir="rtl">
            <h2>تسوية نهاية المشروع</h2>
            <p t-field="o.project_id.name"/>
            <p t-field="o.partner_id.name"/>
            <p>قيمة العقد: <span t-field="o.agreed_amount"/></p>
            <p>مواد أبروج — دفعة عن المقاول: <span t-field="o.materials_total"/></p>
            <p>المدفوع: <span t-field="o.paid"/></p>
            <p>المسترد: <span t-field="o.received"/></p>
            <p>المستحق المتبقي: <span t-field="o.remaining"/></p>
            <p>نسبة الضمان: <span t-field="o.retention_percent"/> % (ضمن المستحق)</p>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
