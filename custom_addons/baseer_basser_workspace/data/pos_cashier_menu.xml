<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!--
        The native POS List action opens the backend pos.config list.  This
        source-owned menu deliberately targets the native Kanban dashboard:
        it is visible only as a validated BASSER card for a POS cashier, while
        the normal top-level menu curation remains unchanged.
    -->
    <menuitem id="menu_pos_cashier_point_of_sale_dashboard"
              name="Point of Sale"
              parent="point_of_sale.menu_point_root"
              action="point_of_sale.action_pos_config_kanban"
              sequence="5"
              groups="point_of_sale.group_pos_user"/>
</odoo>
