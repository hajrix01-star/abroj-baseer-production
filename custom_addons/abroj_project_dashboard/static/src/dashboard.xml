<templates xml:space="preserve">
<t t-name="abroj_project_dashboard.Dashboard">
<div class="abroj_dashboard" dir="rtl">
 <div class="ab_hd"><div><h1 t-esc="state.detail ? state.detail.name : 'لوحة التحكم – المشاريع'"/><div class="ab_sub">مؤسسة أبرج للمقاولات · نظرة شاملة على أداء المشاريع والوضع المالي</div></div><button t-if="state.detail" class="ab_btn" t-on-click="() => state.detail = null">العودة للوحة التحكم</button></div>
 <t t-if="!state.detail">
 <div class="ab_card ab_filters"><input type="date" t-model="state.filters.from"/><input type="date" t-model="state.filters.to"/><select t-model="state.filters.status"><option value="">كل الحالات</option><option value="ongoing">جارية</option><option value="completed">مكتملة</option><option value="delayed">متأخرة</option><option value="stalled">متعثرة</option></select><select t-model="state.filters.type"><option value="">نوع المشروع</option><option t-foreach="state.data.types" t-as="item" t-key="item.id" t-att-value="item.id" t-esc="item.name"/></select><select t-model.number="state.filters.manager"><option value="">مدير المشروع</option><option t-foreach="state.data.managers" t-as="item" t-key="item.id" t-att-value="item.id" t-esc="item.name"/></select><select t-model.number="state.filters.client"><option value="">العميل</option><option t-foreach="state.data.clients" t-as="item" t-key="item.id" t-att-value="item.id" t-esc="item.name"/></select><input placeholder="بحث باسم المشروع" t-model="state.filters.search"/><button class="ab_btn" t-on-click="load">تطبيق</button></div>
 <div class="ab_tabs"><button t-foreach="[['overview','◉','النظرة العامة','ملخص المؤشرات'],['tracking','▣','المتابعة','الجارية · الأعلى · الأنواع'],['finance','﷼','المالية','الميزانية · الربح · السيولة'],['timeline','▤','الخط الزمني','مراحل ومواعيد المشاريع'],['delayed','⚠','المتأخرة والمتعثرة','المشاريع والمهام'] ]" t-as="tab" t-key="tab[0]" t-att-class="'ab_card ab_tab ' + (state.tab === tab[0] ? 'selected' : '')" t-on-click="() => state.tab = tab[0]"><span class="ab_icon" t-esc="tab[1]"/><span><b t-esc="tab[2]"/><small t-esc="tab[3]"/></span></button></div>
 <div class="ab_section"><b t-esc="{'overview':'النظرة العامة','tracking':'المتابعة','finance':'المالية','timeline':'الخط الزمني','delayed':'المتأخرة والمتعثرة'}[state.tab]"/><span>نظرة على المشاريع الحالية</span></div>
 </t>
 <t t-if="state.detail"><div class="ab_card ab_project_header"><div class="ab_ring"><span t-esc="state.detail.progress + '%'"/><small>الإنجاز</small></div><div class="ab_project_meta"><h2><t t-esc="state.detail.name"/> <span class="ab_badge" t-esc="state.detail.status_label"/></h2><div class="ab_meta"><div t-foreach="[['نوع المشروع',state.detail.type_label],['العميل',state.detail.client],['مدير المشروع',state.detail.manager],['تاريخ البدء',state.detail.start],['تاريخ التسليم',state.detail.end],['قيمة العقد',money(state.detail.contract)]]" t-as="item" t-key="item[0]"><small t-esc="item[0]"/><b t-esc="item[1] || '—'"/></div></div></div></div></t>
 <div t-if="!state.detail and ['overview','tracking'].includes(state.tab)" class="ab_grid five"><div class="ab_card ab_kpi" t-foreach="overviewCards" t-as="card" t-key="card.label"><span class="ab_icon" t-esc="card.icon"/><strong t-esc="card.value"/><span t-esc="card.label"/></div></div>
 <div t-if="state.detail or state.tab === 'finance'" class="ab_grid three"><div class="ab_card ab_kpi" t-foreach="cards" t-as="card" t-key="card.label"><span class="ab_icon" t-esc="card.icon"/><strong t-esc="money(card.value)"/><span t-esc="card.label"/><small>ر.س</small><small t-if="card.sub" t-att-class="card.subRed ? 'text-danger' : ''" t-esc="card.sub"/></div></div>
 <t t-if="state.detail"><div class="ab_grid two"><div class="ab_card"><h3>الميزانية مقابل الفعلي حسب بند التكلفة</h3><table><thead><tr><th>البند</th><th t-esc="categoryLabels.phase"/><th>الميزانية</th><th>الفعلي</th><th>مدفوع مقدماً</th><th>إجمالي المصروف</th><th t-esc="categoryLabels.remaining"/><th>المؤشر</th></tr></thead><tbody><tr t-foreach="state.detail.categories" t-as="c" t-key="c_index" t-att-class="c.over_budget ? 'text-danger' : ''"><td t-esc="c.name"/><td><span class="ab_phase_name" t-att-title="c.phase || '—'" t-esc="c.phase || '—'"/></td><td t-esc="money(c.budget)"/><td t-esc="money(c.actual)"/><td t-esc="money(c.advance_paid)"/><td t-esc="money(c.total_spent)"/><td t-att-class="c.remaining &lt; 0 ? 'text-danger' : ''" t-esc="money(c.remaining)"/><td><span class="ab_badge" t-esc="c.over > 0 ? 'تجاوز ' + money(c.over) : 'ضمن الميزانية'"/></td></tr><tr class="fw-bold"><td t-esc="categoryLabels.total"/><td/><td t-esc="money(state.detail.categories_total.budget)"/><td t-esc="money(state.detail.categories_total.actual)"/><td t-esc="money(state.detail.categories_total.advance_paid)"/><td t-esc="money(state.detail.categories_total.total_spent)"/><td t-att-class="state.detail.categories_total.remaining &lt; 0 ? 'text-danger' : ''" t-esc="money(state.detail.categories_total.remaining)"/><td/></tr></tbody></table></div><div class="ab_card"><h3>المتبقي للتحصيل</h3><strong class="ab_big" t-esc="money(state.detail.remaining)"/><p>المحصّل <t t-esc="money(state.detail.customer_received)"/> من <t t-esc="money(state.detail.contract)"/></p></div></div></t>
 <t t-if="!state.detail and ['overview','tracking','finance','delayed'].includes(state.tab)"><div class="ab_grid two"><div class="ab_card"><h3 t-esc="state.tab === 'finance' ? 'الميزانية مقابل الفعلي' : state.tab === 'delayed' ? 'المشاريع المتأخرة والمتعثرة' : 'المشاريع'"/><table><thead><tr><th>المشروع</th><th>الحالة</th><th>الإنجاز</th><th t-esc="state.tab === 'finance' ? 'الميزانية / الفعلي' : 'مدير المشروع'"/></tr></thead><tbody><t t-foreach="projects" t-as="p" t-key="p.id"><tr t-if="state.tab !== 'delayed' or p.delayed or p.stalled" t-on-click="() => detail(p.id)" class="ab_link"><td><b t-esc="p.name"/><small t-esc="p.type_label"/></td><td><span class="ab_badge" t-esc="p.delayed ? 'متأخر' : p.stalled ? 'متعثر' : p.status_label"/></td><td><div class="ab_progress"><i t-att-style="'width:'+p.progress+'%'"></i></div> <t t-esc="p.progress"/>%</td><td t-esc="state.tab === 'finance' ? money(p.budget_available ? p.budget : null) + ' / ' + money(p.actual) : p.manager"/></tr></t></tbody></table><p t-if="!projects.length">لا توجد مشاريع مطابقة.</p></div><div class="ab_card"><h3>توزيع أنواع المشاريع</h3><div class="ab_donut" t-att-style="donutStyle"><div class="ab_donut_center"><b t-esc="projects.length"/><small>المشاريع</small></div></div><div t-foreach="state.data.types" t-as="type" t-key="type.id" class="ab_type"><span t-esc="type.name"/><b t-esc="projects.filter(p => p.type === type.id).length"/></div></div></div></t>
 <div t-if="!state.detail and ['overview','tracking'].includes(state.tab)" class="ab_grid two"><div class="ab_card"><h3>أعلى المشاريع إنجازاً</h3><div class="ab_type ab_link" t-foreach="[...projects].sort((a,b) => b.progress-a.progress).slice(0,5)" t-as="p" t-key="p.id" t-on-click="() => detail(p.id)"><span t-esc="p.name"/><b t-esc="p.progress + '%'"/></div></div><div class="ab_card"><h3>المشاريع الجارية والمكتملة</h3><div class="ab_type ab_link" t-foreach="projects" t-as="p" t-key="p.id" t-on-click="() => detail(p.id)"><span t-esc="p.name"/><span class="ab_badge" t-esc="p.completed ? 'مكتمل' : 'جارٍ'"/></div></div></div>
 <t t-if="state.detail or state.tab === 'timeline'"><div class="ab_card"><h3>الجدول الزمني لمراحل المشروع</h3><t t-foreach="state.detail ? [state.detail] : projects" t-as="p" t-key="p.id"><h4 t-if="!state.detail" class="ab_link" t-on-click="() => detail(p.id)" t-esc="p.name"/><t t-set="layout" t-value="timeline(p.phases)"/><div t-if="layout" class="ab_timeline"><div class="ab_timeline_inner" t-att-style="'--timeline-width:' + layout.width + 'px'"><div class="ab_phase ab_date_row"><b/><div class="ab_date_track"><div t-foreach="layout.cells" t-as="cell" t-key="cell.index" t-att-class="'ab_day' + (cell.week ? ' ab_week' : '')" t-att-style="'left:' + cell.left + '%;width:' + cell.width + '%'"><span t-if="cell.label" t-att-style="'width:' + cell.labelWidth + '%'" t-esc="cell.label"/></div><div t-if="layout.today !== null" class="ab_today ab_today_header" t-att-style="'left:' + layout.today + '%'"><span t-esc="todayLabel"/></div></div><small/></div><div class="ab_phase" t-foreach="p.phases" t-as="phase" t-key="phase_index"><b t-att-title="phase.name" t-esc="phase.name"/><div class="ab_track"><div t-foreach="layout.cells.filter(c => c.week)" t-as="cell" t-key="cell.index" class="ab_week_line" t-att-style="'left:' + cell.left + '%'"/><div t-if="layout.today !== null" class="ab_today" t-att-style="'left:' + layout.today + '%'"></div><i t-att-class="phase.delayed ? 'late' : ''" t-att-style="bar(phase, layout)"/></div><small t-esc="phase.start + ' – ' + phase.end + ' · ' + phase.duration + ' يوم'"/></div></div></div></t></div></t>
 <t t-if="state.detail"><div class="ab_grid two"><div class="ab_card"><h3>العقود والسندات</h3><table t-if="state.detail.contracts.length"><tr><th>العقد</th><th>الطرف</th><th>القيمة</th></tr><tr t-foreach="state.detail.contracts" t-as="contract" t-key="contract_index"><td t-esc="contract.name"/><td t-esc="contract.partner"/><td t-esc="money(contract.amount)"/></tr></table><h4>السندات</h4><table><tr><th>السند</th><th>النوع</th><th>الطرف</th><th>المبلغ</th></tr><tr t-foreach="state.detail.vouchers" t-as="v" t-key="v_index"><td t-esc="v.name"/><td t-esc="v.kind === 'receipt' ? 'قبض' : 'صرف'"/><td t-esc="v.partner"/><td t-esc="money(v.amount)"/></tr></table><p t-if="!state.detail.vouchers.length">لا توجد سندات متاحة.</p></div><div class="ab_card"><h3>المهام المتأخرة</h3><table><tr><th>المهمة</th><th>المسؤول</th><th>الموعد</th></tr><t t-foreach="state.detail.phases" t-as="phase" t-key="phase_index"><tr t-if="phase.delayed"><td t-esc="phase.name"/><td t-esc="phase.assignee"/><td t-esc="phase.end"/></tr></t></table></div></div></t>
</div></t></templates>
