<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="baseer_procurement_requests.RepresentativePettyCash">
        <main class="o_rep_pc" t-att-dir="languageDirection()">
            <header class="o_rep_pc_header">
                <div><h1>Representative Petty Cash</h1><p>Record a transfer from a company payment point to a purchasing representative.</p></div>
                <div class="o_rep_pc_filters"><label>Representative
                    <Dropdown>
                        <button type="button" class="o_rep_pc_select btn btn-light" t-att-title="representativeLabel()"><span t-esc="representativeLabel()"/><i class="fa fa-chevron-down" aria-hidden="true"/></button>
                        <t t-set-slot="content">
                            <DropdownItem onSelected="() => this.selectRepresentative(false)">All representatives</DropdownItem>
                            <DropdownItem t-foreach="state.data?.representatives || []" t-as="representative" t-key="representative.id" onSelected="() => this.selectRepresentative(representative.id)"><t t-esc="representative.display_name"/></DropdownItem>
                        </t>
                    </Dropdown>
                </label><label>Month<input class="form-control" type="month" t-att-value="state.monthStart ? state.monthStart.slice(0, 7) : ''" t-on-change="onMonthChange"/></label></div>
            </header>
            <section t-if="state.loading" class="o_rep_pc_empty" aria-live="polite"><i class="fa fa-spinner fa-spin me-2" aria-hidden="true"/>Loading…</section>
            <section t-elif="state.error" class="alert alert-danger"><t t-esc="state.error"/></section>
            <t t-else="">
                <section class="o_rep_pc_cards" aria-label="Monthly summary">
                    <article><span>Transferred to representative</span><strong dir="ltr"><t t-esc="money(state.data.summary.funded)"/></strong></article>
                    <article><span>Settled against purchases</span><strong dir="ltr"><t t-esc="money(state.data.summary.settled)"/></strong><small>Completed during invoice entry</small></article>
                    <article class="is_total"><span>Remaining</span><strong dir="ltr"><t t-esc="money(state.data.summary.remaining)"/></strong></article>
                </section>
                <section t-if="state.data.can_record" class="o_rep_pc_entry" aria-label="Add petty cash">
                    <h2>Add petty cash</h2>
                    <p t-if="state.data.setup_issue" class="alert alert-warning mb-3"><t t-esc="state.data.setup_issue"/></p>
                    <p t-elif="!state.data.payment_points_configured" class="alert alert-warning mb-3">
                        No payment point is configured for Representative Petty Cash. Ask a manager to select the existing company payment points in the company settings.
                    </p>
                    <div class="o_rep_pc_grid">
                        <label>Purchase request
                            <Dropdown>
                                <button type="button" class="o_rep_pc_select btn btn-light" t-att-title="requestLabel()"><span t-esc="requestLabel()"/><i class="fa fa-chevron-down" aria-hidden="true"/></button>
                                <t t-set-slot="content">
                                    <DropdownItem t-foreach="state.data.requests" t-as="request" t-key="request.id" onSelected="() => this.selectRequest(request.id)"><t t-esc="request.name"/> — <t t-esc="request.representative_name"/></DropdownItem>
                                </t>
                            </Dropdown>
                        </label>
                        <div class="o_rep_pc_request_total" t-if="selectedRequest()">Purchase request value: <strong dir="ltr"><t t-esc="money(selectedRequest().amount)"/></strong></div>
                        <label>From
                            <Dropdown>
                                <button type="button" class="o_rep_pc_select btn btn-light" t-att-title="paymentPointLabel()"><span t-esc="paymentPointLabel()"/><i class="fa fa-chevron-down" aria-hidden="true"/></button>
                                <t t-set-slot="content">
                                    <DropdownItem t-foreach="state.data.payment_points" t-as="point" t-key="point.id" onSelected="() => this.selectPaymentPoint(point.id)"><t t-esc="point.name"/></DropdownItem>
                                </t>
                            </Dropdown>
                        </label>
                        <label>To
                            <Dropdown>
                                <button type="button" class="o_rep_pc_select btn btn-light" t-att-title="destinationLabel()"><span t-esc="destinationLabel()"/><i class="fa fa-chevron-down" aria-hidden="true"/></button>
                                <t t-set-slot="content">
                                    <DropdownItem t-foreach="state.data.representatives" t-as="representative" t-key="representative.id" onSelected="() => this.selectDestination(representative.id)"><t t-esc="representative.display_name"/></DropdownItem>
                                </t>
                            </Dropdown>
                        </label>
                        <label>Amount
                            <input class="form-control" type="number" min="0.01" step="0.01" inputmode="decimal" t-att-value="state.amount" t-on-input="onAmountInput"/>
                        </label>
                        <label>Transfer date
                            <input class="form-control" type="date" t-att-value="state.movementDate" t-on-input="onMovementDateInput"/>
                        </label>
                        <button type="button" class="btn btn-primary" t-on-click="save" t-att-disabled="state.saving or state.data.setup_issue or !state.data.payment_points_configured"><t t-if="state.saving">Saving…</t><t t-else="">Save</t></button>
                    </div>
                </section>
                <section t-if="state.data.can_record" class="o_rep_pc_entry" aria-label="Return petty cash">
                    <h2>Return remaining</h2>
                    <div class="o_rep_pc_grid">
                        <label>Original movement
                            <Dropdown>
                                <button type="button" class="o_rep_pc_select btn btn-light" t-att-title="returnOriginLabel()"><span t-esc="returnOriginLabel()"/><i class="fa fa-chevron-down" aria-hidden="true"/></button>
                                <t t-set-slot="content">
                                    <DropdownItem t-foreach="state.data.open_fundings" t-as="funding" t-key="funding.id" onSelected="() => this.selectReturnOrigin(funding.id)"><t t-esc="funding.name"/> — <t t-esc="funding.representative_name"/> (<t t-esc="money(funding.remaining)"/>)</DropdownItem>
                                </t>
                            </Dropdown>
                        </label>
                        <label>To
                            <Dropdown>
                                <button type="button" class="o_rep_pc_select btn btn-light" t-att-title="returnPaymentPointLabel()"><span t-esc="returnPaymentPointLabel()"/><i class="fa fa-chevron-down" aria-hidden="true"/></button>
                                <t t-set-slot="content">
                                    <DropdownItem t-foreach="state.data.payment_points" t-as="point" t-key="point.id" onSelected="() => this.selectReturnPaymentPoint(point.id)"><t t-esc="point.name"/></DropdownItem>
                                </t>
                            </Dropdown>
                        </label>
                        <label>Amount<input class="form-control" type="number" min="0.01" step="0.01" inputmode="decimal" t-att-value="state.returnAmount" t-on-input="(event) => state.returnAmount = event.target.value"/></label>
                        <button type="button" class="btn btn-outline-primary" t-on-click="saveReturn" t-att-disabled="state.saving or state.data.setup_issue or !state.data.payment_points_configured">Save return</button>
                    </div>
                </section>
                <section t-if="!state.data.can_record" class="o_rep_pc_empty">This is a review screen. Only the accountant can record petty cash or a return.</section>
                <section class="o_rep_pc_rows">
                    <h2>This month's movements</h2>
                    <p t-if="!state.data.movements.length" class="o_rep_pc_empty">No movements in the selected month.</p>
                    <table t-else=""><thead><tr><th>Date</th><th>Movement number</th><th>Purchase request</th><th>From</th><th>To</th><th>Amount</th></tr></thead><tbody>
                        <tr t-foreach="state.data.movements" t-as="movement" t-key="movement.id"><td t-att-data-label="movementColumnLabels.date"><t t-esc="movement.date"/></td><td t-att-data-label="movementColumnLabels.movement"><t t-esc="movement.name"/></td><td t-att-data-label="movementColumnLabels.request"><t t-esc="movement.request_name || 'Return'"/></td><td t-att-data-label="movementColumnLabels.from"><t t-esc="movement.payment_point_name"/></td><td t-att-data-label="movementColumnLabels.to"><t t-esc="movement.representative_name"/></td><td t-att-data-label="movementColumnLabels.amount" dir="ltr"><t t-esc="money(movement.amount)"/></td></tr>
                    </tbody></table>
                </section>
            </t>
        </main>
    </t>
</templates>
