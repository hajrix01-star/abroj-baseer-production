<odoo>
  <record id="accounting_issue_form" model="ir.ui.view">
    <field name="name">abroj.contracting.accounting.issue.form</field>
    <field name="model">abroj.contracting.accounting.issue</field>
    <field name="arch" type="xml">
      <form string="Accounting review" class="abroj_accounting_review">
        <field name="cost_id" invisible="1" readonly="1"/>
        <field name="voucher_id" invisible="1" readonly="1"/>
        <field name="currency_id" invisible="1" readonly="1"/>
        <field name="project_id" invisible="1" readonly="1"/>
        <field name="analytic_precision" invisible="1"/>
        <field name="payment_uses_clearing" invisible="1"/>
        <group>
          <field name="company_id" readonly="1"/>
          <field name="amount" string="Gross source amount" readonly="1"/>
          <field name="mode" invisible="not cost_id"/>
          <field name="partner_id" required="1" options="{'no_create': True}"/>
          <field name="existing_move_id" invisible="not cost_id or mode != 'existing'" required="cost_id and mode == 'existing'"
                 domain="[('company_id', '=', company_id), ('move_type', '=', 'in_invoice'), ('state', '=', 'posted'), ('partner_id', '=', partner_id)]" options="{'no_create': True}"/>
          <field name="journal_id" invisible="cost_id and mode == 'existing'" required="not cost_id or mode == 'create'"
                 domain="[('company_id', '=', company_id), ('type', 'in', ['purchase'] if cost_id else ['cash', 'bank'])]" options="{'no_create': True}"/>
          <field name="payment_account_id" invisible="not voucher_id" readonly="1"/>
          <field name="expense_account_id" invisible="not cost_id or mode != 'create'" required="cost_id and mode == 'create'"
                 domain="[('company_ids', 'in', [company_id]), ('account_type', 'in', ['expense', 'expense_direct_cost', 'expense_depreciation'])]" options="{'no_create': True}"/>
          <field name="analytic_distribution" string="Analytic distribution" widget="analytic_distribution"
                 invisible="not cost_id or mode != 'create'" options="{'account_field': 'expense_account_id', 'business_domain': 'bill', 'disable_save': True}"/>
          <field name="tax_ids" widget="many2many_tags" invisible="not cost_id or mode != 'create'"
                 domain="[('company_id', '=', company_id), ('type_tax_use', '=', 'purchase')]" options="{'no_create': True}"/>
          <field name="invoice_date" widget="abroj_accounting_date" invisible="not cost_id or mode != 'create'" required="cost_id and mode == 'create'" options="{'numeric': True}"/>
          <field name="date" widget="abroj_accounting_date" invisible="cost_id and mode == 'existing'" required="not cost_id or mode == 'create'" readonly="voucher_id" options="{'numeric': True}"/>
        </group>
        <p class="text-muted" invisible="not cost_id">The source amount is the gross payable total, including any selected tax. Leave taxes empty only when no tax applies.</p>
        <p class="text-muted" invisible="not cost_id or mode != 'create'">Keep the project allocation at 100% and complete the required analytic dimensions.</p>
        <p class="text-muted" invisible="not cost_id or mode != 'existing'">Link the existing posted bill when this expense has already been recorded. Its company, supplier, amount and project allocation must match.</p>
        <p class="text-muted" invisible="not voucher_id">Review the receiving or paying cash/bank journal before issuing the accounting entry.</p>
        <p class="text-warning" invisible="not voucher_id or not payment_uses_clearing">This journal posts through an outstanding account. Cash/bank recognition follows native reconciliation.</p>
        <footer>
          <button name="action_issue" type="object" string="Confirm accounting" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
