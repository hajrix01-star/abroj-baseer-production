        case "$module" in baseer_bchat) legacy=1 ;; baseer_bwork) canonical=1 ;; esac
    done
    [ "$legacy" -eq 0 ] || [ "$canonical" -eq 0 ] || die 'mixed BChat/BWork core policy'
    if [ "$canonical" -eq 1 ]; then core=baseer_bwork
    elif [ "$legacy" -eq 1 ]; then core=baseer_bchat
    else return 0
    fi
    bwork_guard_root="$stage.guard"
    [ ! -e "$bwork_guard_root" ] && [ ! -L "$bwork_guard_root" ] || die 'guard staging path already exists'
    mkdir -m 0700 "$bwork_guard_root"
    # Exact approved commit; never main/working tree. Retain every default
    # backend/Android/guard-integrity check without leaking unrelated source
    # into the module-scoped host release.
    git -C "$repository" archive --format=tar "$commit" .github android "custom_addons/$core" ops |
        tar -x -C "$bwork_guard_root" --no-same-owner --no-same-permissions
    PYTHONDONTWRITEBYTECODE=1 python3 "$bwork_guard_root/custom_addons/$core/tools/release_guard.py" ||
        die 'frozen cumulative BWork source guard rejected candidate'
    if [ "$canonical" -eq 1 ]; then
        # Canonical fixed entry: custom_addons/baseer_bwork/tools/release_guard.py
        python3 "$bwork_guard_root/ops/lib/bwork_release_source.py" prepare \
            --candidate-root "$candidate" --guard-root "$bwork_guard_root" --modules "$policy_modules" >/dev/null ||
            die 'actual staged BWork core differs from frozen guard source'
        bwork_requested="$(python3 "$bwork_guard_root/ops/lib/bwork_release_source.py" requested \
            --candidate-root "$candidate" --modules "$policy_modules")" || die 'invalid BWork requested closure'
    fi
}

bwork_classify() {
    local candidate=$1 result=$2 lines operation module
    shift 2
    [ -n "$bwork_requested" ] || return 0
    "$@" run --rm --no-deps -T -v "$candidate:/mnt/bwork-candidate:ro" --entrypoint python3 "$bwork_service" \
        /mnt/bwork-candidate/custom_addons/baseer_bwork/tools/canonical_pre_upgrade.py \
        --classify --modules "$bwork_requested" --database "$bwork_database" > "$result" ||
        die 'BWork read-only database classification failed'
    lines="$(python3 "$bwork_guard_root/ops/lib/bwork_release_source.py" plan \
        --candidate-root "$candidate" --modules "$policy_modules" --plan "$result")" ||
        die 'BWork installed closure is not fully approved'
    BWORK_MODULE_MODE=()
    while read -r operation module; do
        case "$operation" in
            NATIVE) case "$module" in yes) bwork_native_upgrade=1 ;; no) bwork_native_upgrade=0 ;; *) die 'invalid native mode' ;; esac ;;
            UPGRADE|INSTALL) BWORK_MODULE_MODE[$module]=$operation ;;
            *) die 'invalid classification operation' ;;
        esac
    done <<< "$lines"
}

bwork_verify() {
    local candidate=$1 result=$2 mode=--verify verification=verified
    shift 2
    [ -n "$bwork_requested" ] || return 0
    if [ "$bwork_native_upgrade" -eq 1 ]; then mode=--verify-transition; verification=verified-transition; fi
    "$@" run --rm --no-deps -T -v "$candidate:/mnt/bwork-candidate:ro" --entrypoint python3 "$bwork_service" \
        /mnt/bwork-candidate/custom_addons/baseer_bwork/tools/canonical_pre_upgrade.py \
        "$mode" --modules "$bwork_requested" --database "$bwork_database" > "$result" ||
        die 'BWork canonical postconditions failed'
    python3 "$bwork_guard_root/ops/lib/bwork_release_source.py" "$verification" \
        --candidate-root "$candidate" --modules "$policy_modules" --plan "$result" >/dev/null ||
        die 'BWork post-upgrade closure failed'
}

require_root
validate_arguments "$@"
exec 9>"$LOCK_FILE"
flock -n 9 || die 'another production deployment is already running'
[ ! -e "$BASE/bwork-recovery-pending.env" ] && [ ! -L "$BASE/bwork-recovery-pending.env" ] \
    || die 'a previous recovery has an unresolved durable intent; investigate without retry'
verify_source_identity
load_policy

old_release="$(readlink -f "$BASE/current")"
[ -d "$old_release" ] || die 'current release cannot be resolved'
[ -f "$old_release/.env" ] || die 'current .env is missing'
[ -f "$old_release/config/odoo.conf" ] || die 'current odoo.conf is missing'
prepare_google_runtime
prepare_dms_runtime
if [ -f "$old_release/RELEASE_COMMIT" ]; then
    live_commit="$(tr -d '\r\n' < "$old_release/RELEASE_COMMIT")"
    [[ "$live_commit" =~ ^[a-f0-9]{40}$ ]] || die 'current release commit marker is invalid'
else
    current_release_name="$(basename "$old_release")"
    [[ "$current_release_name" =~ ^([a-f0-9]{12})-run- ]] || die 'legacy current release name has no commit prefix'
    live_commit_prefix="${BASH_REMATCH[1]}"
fi

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
stage="$RELEASES/.stage-${commit:0:12}-${run_id}-$stamp"
mkdir -p "$RELEASES"
[ ! -e "$stage" ] || die 'private source staging path already exists'
fetch_reviewed_source
source_dir="$stage/source"
[ -d "$source_dir" ] || die 'fetched source is missing'
[ ! -e "$source_dir/.env" ] || die 'fetched source must not contain .env'
[ -f "$source_dir/compose.production.yaml" ] || die 'release compose file is missing'
if find "$source_dir" -type l -print -quit | grep -q .; then
    die 'fetched source contains a link'
fi
for approved_module in "${APPROVED_MODULES[@]}"; do
    [ -f "$source_dir/custom_addons/$approved_module/__manifest__.py" ] || die "approved module is missing from release: $approved_module"
done
for approved_module in "${APPROVED_THIRD_PARTY_MODULES[@]}"; do
    module_path="$(third_party_module_path "$approved_module")"
    [ -f "$source_dir/$module_path/__manifest__.py" ] || die "approved third-party module is missing from release: $approved_module"
done
verify_installed_baseer_module_source

compose_old=(docker compose --project-name baseer-odoo-prod --env-file "$old_release/.env" -f "$old_release/compose.production.yaml" "${dms_old_compose_files[@]}" "${google_compose_files[@]}" --project-directory "$old_release")
bwork_database=baseer_prod
bwork_service=odoo
chmod -R a+rX -- "$source_dir"
bwork_classify "$source_dir" "$stage/bwork-classification.json" "${compose_old[@]}"
run_dms_preflight
odoo_config_gid="$(docker exec "$ODOO_CONTAINER" id -g odoo)"
[[ "$odoo_config_gid" =~ ^[0-9]+$ ]] || die 'could not resolve the Odoo configuration group'

source_kb="$(du -sk "$source_dir" | awk '{print $1}')"
db_bytes="$(docker exec "$DB_CONTAINER" sh -lc 'psql -U "$POSTGRES_USER" -d baseer_prod -Atqc "SELECT pg_database_size(current_database())"')"
db_kb=$(( (db_bytes + 1023) / 1024 ))
filestore_kb="$(docker run --rm --network none -v "$ODOO_VOLUME":/source:ro alpine:3.20 sh -lc 'du -sk /source/filestore/baseer_prod | awk "{print \$1}"')"
available_kb="$(df --output=avail -k "$BASE" | tail -n 1 | tr -d ' ')"
required_kb=$(( 2 * (source_kb + db_kb + filestore_kb) + 1024 * 1024 ))
[ "$available_kb" -gt "$required_kb" ] || die 'insufficient disk space for a recoverable deployment'

backup="$BACKUPS/pre-${commit:0:12}-${run_id}-$stamp"
release="$RELEASES/${commit:0:12}-run-${run_id}-$stamp"
release_switched=0
database_mutated=0
service_quiesced=0
compose=()
trap rollback ERR

mkdir -p "$BACKUPS" "$backup"
[ ! -e "$release" ] || die 'release path already exists'
mv "$source_dir" "$release"
if [ "$dms_release_requested" -eq 1 ]; then
    mv "$stage/dms-preflight.log" "$backup/dms-preflight.log"
    mv "$stage/dms-compose-check.log" "$backup/dms-preflight-compose-check.log"
fi
if [ -f "$stage/bwork-classification.json" ]; then
    mv "$stage/bwork-classification.json" "$backup/bwork-classification-before.json"
fi
rmdir "$stage"
printf '%s\n' "$commit" > "$release/RELEASE_COMMIT"
# The release source is mounted into the unprivileged Odoo container.  It must
# be traversable and readable there; the sensitive files copied below retain
# their restrictive modes and are deliberately excluded from the archive.
chmod -R a+rX -- "$release"
install -D -m 0600 "$old_release/.env" "$release/.env"
# Odoo runs without root.  Let its *current numeric group* read the config
# without exposing `admin_passwd` to the constrained deploy account; `.env`
# above remains root-only.
install -D -o root -g "$odoo_config_gid" -m 0640 "$old_release/config/odoo.conf" "$release/config/odoo.conf"
generate_dms_runtime
compose=(docker compose --project-name baseer-odoo-prod --env-file "$release/.env" -f "$release/compose.production.yaml" "${dms_new_compose_files[@]}" "${google_compose_files[@]}" --project-directory "$release")
"${compose_old[@]}" config --quiet >/dev/null 2>&1 || die 'current compose configuration is invalid'
"${compose[@]}" config --quiet >/dev/null 2>&1 || die 'release compose configuration is invalid'

# Quiesce first: DB, filestore and the protected snapshot must describe the
# same instant.  The trap restarts this exact release if capture fails.
# Mark it before issuing stop: a transport/compose error can occur after Docker
# has already stopped the container, and the ERR trap must still revive it.
service_quiesced=1
"${compose_old[@]}" stop odoo
if [ -n "$bwork_requested" ]; then
    bwork_recovery_capture_before "$backup/bwork-classification-before.json" || die 'BWork original recovery capture failed'
fi
snapshot > "$backup/protected-before.json"
if [ "$dms_release_requested" -eq 1 ]; then
    dms_original_snapshot > "$backup/dms-originals-before.json"
fi
docker exec "$DB_CONTAINER" sh -lc 'pg_dump -Fc -U "$POSTGRES_USER" -d baseer_prod' > "$backup/baseer_prod.dump"
docker run --rm --network none -v "$ODOO_VOLUME":/source:ro -v "$backup":/target alpine:3.20 sh -lc 'tar -C /source -cf /target/filestore-baseer_prod.tar filestore/baseer_prod'
sha256sum "$backup/baseer_prod.dump" "$backup/filestore-baseer_prod.tar" > "$backup/recovery.sha256"
bwork_recovery_capture_after || die 'BWork recovery proof drifted during backup'

if [ -n "$bwork_requested" ]; then
    bwork_classify "$release" "$backup/bwork-classification.json" "${compose[@]}"
    cmp "$backup/bwork-classification-before.json" "$backup/bwork-classification.json" || die 'BWork classification changed during quiescence'
fi

ln -sfn "$release" "$BASE/current"
release_switched=1

upgrade_modules=()
install_modules=()
for approved_module in "${APPROVED_MODULES[@]}" "${APPROVED_THIRD_PARTY_MODULES[@]}"; do
    module_state="$(docker exec "$DB_CONTAINER" sh -lc "psql -U \"\$POSTGRES_USER\" -d baseer_prod -Atqc \"SELECT state FROM ir_module_module WHERE name = '$approved_module'\"")"
    case "${BWORK_MODULE_MODE[$approved_module]:-}" in
        UPGRADE) upgrade_modules+=("$approved_module"); continue ;;
        INSTALL) install_modules+=("$approved_module"); continue ;;
    esac
    case "$module_state" in
        installed) upgrade_modules+=("$approved_module") ;;
        ''|uninstalled) install_modules+=("$approved_module") ;;
        *) die "module is in an unsafe state: $approved_module=$module_state" ;;
    esac
done
odoo_command='odoo --config=/etc/odoo/odoo.conf --db_host="$HOST" --db_user="$USER" --db_password="$PASSWORD" --addons-path=/usr/lib/python3/dist-packages/odoo/addons,/mnt/baseer-addons,/mnt/third-party-addons/erp_heritage_19,/mnt/third-party-addons/odoomates_19 -d baseer_prod'
if [ "$dms_runtime_required" -eq 1 ]; then
    dms_addons_path="$(python3 -c '
import json, sys
command = json.load(open(sys.argv[1]))["services"]["odoo"]["command"]
print(next(item.split("=", 1)[1] for item in command if item.startswith("--addons-path=")))
' "$release/config/dms-runtime.compose.json")"
    [[ "$dms_addons_path" =~ ^[a-zA-Z0-9_/,.-]+$ ]] || die 'DMS addons path is unsafe'
    odoo_command='odoo --config=/etc/odoo/odoo.conf --db_host="$HOST" --db_user="$USER" --db_password="$PASSWORD" --addons-path="$DMS_ADDONS_PATH" -d baseer_prod'
fi
if [ "${#upgrade_modules[@]}" -gt 0 ]; then
    upgrade_csv="$(IFS=,; printf '%s' "${upgrade_modules[*]}")"
    odoo_command+=" -u $upgrade_csv"
fi
if [ "${#install_modules[@]}" -gt 0 ]; then
    install_csv="$(IFS=,; printf '%s' "${install_modules[*]}")"
    odoo_command+=" -i $install_csv"
fi
odoo_command+=' --stop-after-init --workers=0 --max-cron-threads=0'
if [ "$bwork_native_upgrade" -eq 1 ]; then
    [ "${#upgrade_modules[@]}" -gt 0 ] || die 'native migration requires canonical upgrade list'
    odoo_command+=' --pre-upgrade-scripts=/mnt/baseer-addons/baseer_bwork/tools/canonical_pre_upgrade.py'
fi
if [ "$dms_release_requested" -eq 1 ]; then
    odoo_command+=' --without-demo=True'
fi
database_mutated=1
"${compose[@]}" run --rm --no-deps -e "DMS_ADDONS_PATH=${dms_addons_path:-}" --entrypoint sh odoo -lc "$odoo_command" > "$backup/module-upgrade.log" 2>&1
bwork_verify "$release" "$backup/bwork-verified.json" "${compose[@]}"

if [ "$dms_release_requested" -eq 1 ]; then
    "${compose[@]}" run --rm --no-deps -T -e "DMS_ADDONS_PATH=$dms_addons_path" --entrypoint sh odoo -lc \
        'DMS_PRODUCTION_PHASE=setup odoo shell --config=/etc/odoo/odoo.conf --db_host="$HOST" --db_user="$USER" --db_password="$PASSWORD" --addons-path="$DMS_ADDONS_PATH" -d baseer_prod --no-http --workers=0 --max-cron-threads=0' \
        < "$release/ops/production/dms-private-setup.py" > "$backup/dms-private-setup.log" 2>&1
    grep -Fxq 'DMS_PRODUCTION_SETUP=GO' "$backup/dms-private-setup.log" || die 'DMS private setup did not confirm acceptance'
    dms_original_snapshot > "$backup/dms-originals-after.json"
    cmp "$backup/dms-originals-before.json" "$backup/dms-originals-after.json"
fi

snapshot > "$backup/protected-after.json"
cmp "$backup/protected-before.json" "$backup/protected-after.json"
wait_for_data_init
"${compose[@]}" up -d odoo
wait_for_login

for approved_module in "${APPROVED_MODULES[@]}" "${APPROVED_THIRD_PARTY_MODULES[@]}"; do
    module_state="$(docker exec "$DB_CONTAINER" sh -lc "psql -U \"\$POSTGRES_USER\" -d baseer_prod -Atqc \"SELECT state FROM ir_module_module WHERE name = '$approved_module'\"")"
    [ "$module_state" = installed ] || die "approved module is not installed after deployment: $approved_module"
done
"${compose[@]}" logs --no-color --tail=300 odoo > "$backup/odoo-smoke.log"
! grep -Eq 'Traceback \(most recent call last\)|CRITICAL|FATAL' "$backup/odoo-smoke.log"

printf 'LIVE=GO\nRELEASE_ID=%s\nRELEASE=%s\nBACKUP=%s\nCOMMIT=%s\nMODULES=%s\nTHIRD_PARTY_MODULES=%s\nPOLICY_REVISION=%s\nAPPROVED_RUN_ID=%s\n' "$release_id" "$release" "$backup" "$commit" "${APPROVED_MODULES[*]}" "${APPROVED_THIRD_PARTY_MODULES[*]}" "$policy_revision" "$approved_run_id" > "$backup/result.env"
printf 'LIVE=GO\nRELEASE=%s\nBACKUP=%s\n' "$release" "$backup"
