<odoo>
    <record id="cron_work_task_reminders" model="ir.cron">
        <field name="name">BWork: queue due private task reminders</field>
        <field name="model_id" ref="model_baseer_bchat_task"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model._cron_work_task_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
