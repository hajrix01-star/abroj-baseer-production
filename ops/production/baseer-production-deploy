SQL
}

run_dms_preflight() {
    [ "$dms_release_requested" -eq 1 ] || return 0
    # This registry-only check runs against the unchanged running release before
    # service quiescence. The reviewed script forces a read-only transaction.
    current_addons_path="$("${compose_old[@]}" config --format json 2> "$stage/dms-compose-check.log" | python3 -c '
import json, sys
command = json.load(sys.stdin)["services"]["odoo"]["command"]
paths = [item.split("=", 1)[1] for item in command if item.startswith("--addons-path=")]
assert len(paths) == 1
print(paths[0])
' 2>> "$stage/dms-compose-check.log")" || die 'could not validate the current DMS runtime command'
    [[ "$current_addons_path" =~ ^[a-zA-Z0-9_/,.-]+$ ]] || die 'current addons path is unsafe'
    "${compose_old[@]}" run --rm --no-deps -T -e "DMS_ADDONS_PATH=$current_addons_path" --entrypoint sh odoo -lc \
        'DMS_PRODUCTION_PHASE=preflight odoo shell --config=/etc/odoo/odoo.conf --db_host="$HOST" --db_user="$USER" --db_password="$PASSWORD" --addons-path="$DMS_ADDONS_PATH" -d baseer_prod --no-http --workers=0 --max-cron-threads=0' \
        < "$source_dir/ops/production/dms-private-setup.py" > "$stage/dms-preflight.log" 2>&1
    grep -Fxq 'DMS_PRODUCTION_PREFLIGHT=GO' "$stage/dms-preflight.log" || die 'DMS preflight did not confirm prerequisites'
}

load_policy() {
    local policy key value seen_release=0 seen_commit=0 seen_modules_field=0 seen_third_party_modules_field=0 seen_revision=0 seen_approval_run=0
    policy="$POLICY_DIR/$release_id.env"
    [ -f "$policy" ] && [ ! -L "$policy" ] || die 'release policy is missing or unsafe'
    [ "$(stat -c '%U:%G:%a' -- "$policy")" = 'root:root:600' ] || die 'release policy ownership or mode is unsafe'

    while IFS='=' read -r key value || [ -n "$key" ]; do
        case "$key" in
            RELEASE_ID) [ "$seen_release" -eq 0 ] || die 'duplicate policy release id'; policy_release_id=$value; seen_release=1 ;;
            COMMIT) [ "$seen_commit" -eq 0 ] || die 'duplicate policy commit'; commit=$value; seen_commit=1 ;;
            MODULES) [ "$seen_modules_field" -eq 0 ] || die 'duplicate policy modules'; policy_modules=$value; seen_modules_field=1 ;;
            THIRD_PARTY_MODULES) [ "$seen_third_party_modules_field" -eq 0 ] || die 'duplicate policy third-party modules'; policy_third_party_modules=$value; seen_third_party_modules_field=1 ;;
            POLICY_REVISION) [ "$seen_revision" -eq 0 ] || die 'duplicate policy revision'; policy_revision=$value; seen_revision=1 ;;
            APPROVED_RUN_ID) [ "$seen_approval_run" -eq 0 ] || die 'duplicate policy approval run'; approved_run_id=$value; seen_approval_run=1 ;;
            ''|'#'*) ;;
            *) die 'policy has an unknown key' ;;
        esac
    done < "$policy"

    [ "$seen_release" -eq 1 ] && [ "$seen_commit" -eq 1 ] && [ "$seen_modules_field" -eq 1 ] && [ "$seen_revision" -eq 1 ] && [ "$seen_approval_run" -eq 1 ] || die 'policy is incomplete'
    [ "$policy_release_id" = "$release_id" ] || die 'policy release id mismatch'
    [[ "$commit" =~ ^[a-f0-9]{40}$ ]] || die 'policy commit is invalid'
    [[ "$policy_revision" =~ ^[a-f0-9]{40}$ ]] || die 'policy revision is invalid'
    [[ "$approved_run_id" =~ ^[0-9]+$ ]] || die 'policy approval run is invalid'
    IFS=',' read -r -a APPROVED_MODULES <<< "$policy_modules"
    [ "${#APPROVED_MODULES[@]}" -gt 0 ] || die 'policy has no modules'
    declare -A seen_module_names=()
    for approved_module in "${APPROVED_MODULES[@]}"; do
        [[ "$approved_module" =~ ^(baseer_[a-z0-9_]+|abroj_website|abroj_project_costing)$ ]] || die 'policy module is invalid'
        [ -z "${seen_module_names[$approved_module]+x}" ] || die 'policy repeats a module'
        seen_module_names[$approved_module]=1
    done
    APPROVED_THIRD_PARTY_MODULES=()
    if [ -n "${policy_third_party_modules:-}" ]; then
        IFS=',' read -r -a APPROVED_THIRD_PARTY_MODULES <<< "$policy_third_party_modules"
        declare -A seen_third_party_module_names=()
        for approved_module in "${APPROVED_THIRD_PARTY_MODULES[@]}"; do
            third_party_module_path "$approved_module" >/dev/null || die 'policy third-party module is invalid'
            [ -z "${seen_third_party_module_names[$approved_module]+x}" ] || die 'policy repeats a third-party module'
            seen_third_party_module_names[$approved_module]=1
        done
    fi
    dms_release_requested=0
    for approved_module in "${APPROVED_MODULES[@]}" "${APPROVED_THIRD_PARTY_MODULES[@]}"; do
        case "$approved_module" in dms|baseer_dms_trial|baseer_dms_bill_link|baseer_dms_departments) dms_release_requested=1 ;; esac
    done
    if [ "$dms_release_requested" -eq 1 ]; then
        [ "${#APPROVED_MODULES[@]}" -eq 3 ] && [ "${#APPROVED_THIRD_PARTY_MODULES[@]}" -eq 1 ] \
            && [ "${APPROVED_THIRD_PARTY_MODULES[0]}" = dms ] || die 'DMS release requires the exact four private modules'
        for approved_module in baseer_dms_trial baseer_dms_bill_link baseer_dms_departments; do
            [ -n "${seen_module_names[$approved_module]+x}" ] || die 'DMS release requires the exact four private modules'
        done
    fi
}

fetch_reviewed_source() {
    local fetch_repo fetched_commit approved_module module_path source_path
    fetch_repo="$stage/fetch.git"
    install -d -o root -g root -m 0700 "$stage"
    git init --bare --quiet "$fetch_repo"
    git -C "$fetch_repo" remote add origin "$SOURCE_REMOTE"
    GIT_SSH_COMMAND="ssh -i $SOURCE_SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$SOURCE_KNOWN_HOSTS" \
        git -C "$fetch_repo" fetch --no-tags --quiet origin main:refs/heads/source-main "$commit"
    if [ -n "${live_commit_prefix:-}" ]; then
        live_commit="$(git -C "$fetch_repo" rev-parse "${live_commit_prefix}^{commit}")" || die 'could not resolve legacy live commit'
    else
        git -C "$fetch_repo" cat-file -e "$live_commit^{commit}" || die 'live release commit is absent from source remote'
    fi
    git -C "$fetch_repo" merge-base --is-ancestor "$live_commit" "$commit" || die 'approved commit does not advance from the live release'
    fetched_commit="$(git -C "$fetch_repo" rev-parse "${commit}^{commit}")"
    [ "$fetched_commit" = "$commit" ] || die 'fetched source does not match the approved commit'
    # A policy approves an explicit module set, not an entire Git history.  A
    # candidate can legitimately be descended from main while main also holds
    # unrelated, unreleased work.  Start with the exact running release and
    # overlay only those reviewed modules; compose/config and every other
    # add-on remain byte-for-byte on the current production release.
    mkdir -m 0700 "$stage/source"
    cp -a -- "$old_release/." "$stage/source/"
    rm -f -- "$stage/source/.env" "$stage/source/config/odoo.conf"
    for approved_module in "${APPROVED_MODULES[@]}"; do
        if git -C "$fetch_repo" ls-tree -r "$commit" -- "custom_addons/$approved_module" | awk '$1 == "120000" { found = 1 } END { exit !found }'; then
            die "approved module contains a symbolic link: $approved_module"
        fi
        rm -rf -- "$stage/source/custom_addons/$approved_module"
        git -C "$fetch_repo" archive --format=tar "$commit" "custom_addons/$approved_module" | \
            tar -x -C "$stage/source" --no-same-owner --no-same-permissions
    done
    for approved_module in "${APPROVED_THIRD_PARTY_MODULES[@]}"; do
        module_path="$(third_party_module_path "$approved_module")"
        if git -C "$fetch_repo" ls-tree -r "$commit" -- "$module_path" | awk '$1 == "120000" { found = 1 } END { exit !found }'; then
            die "approved third-party module contains a symbolic link: $approved_module"
        fi
        rm -rf -- "$stage/source/$module_path"
        git -C "$fetch_repo" archive --format=tar "$commit" "$module_path" | \
            tar -x -C "$stage/source" --no-same-owner --no-same-permissions
    done
    if [ "$dms_release_requested" -eq 1 ]; then
        for source_path in third_party_addons/oca_dms_19/PROVENANCE.md ops/production/dms-private-setup.py; do
            [ "$(git -C "$fetch_repo" ls-tree "$commit" -- "$source_path" | awk '{print $1}')" = 100644 ] \
                || die 'DMS release support source is absent or unsafe'
            git -C "$fetch_repo" archive --format=tar "$commit" "$source_path" | \
                tar -x -C "$stage/source" --no-same-owner --no-same-permissions
        done
    fi
    rm -rf -- "$fetch_repo"
}

# A database can retain an installed Baseer module even if an earlier manual
# source repair was never committed.  A Git-archived release would then start
# without that module and fail later while rendering a view.  Fail before the
# live service is stopped whenever the candidate source is not closed over the
# installed Baseer addon set.
verify_installed_baseer_module_source() {
    local installed_module
    while IFS= read -r installed_module; do
        [ -n "$installed_module" ] || continue
        [ -f "$source_dir/custom_addons/$installed_module/__manifest__.py" ] \
            || die "installed Baseer module is missing from release source: $installed_module"
    done < <(
        docker exec "$DB_CONTAINER" sh -lc \
            'psql -U "$POSTGRES_USER" -d baseer_prod -Atqc "SELECT name FROM ir_module_module WHERE state = '\''installed'\'' AND name LIKE '\''baseer_%'\'' ORDER BY name"'
    )
}

