#!/usr/bin/env bash
# Root-owned, pull-only QA request bridge.  GitHub can request a bounded tag;
# only the existing approval/deployment wrappers decide whether it may run.
set -Eeuo pipefail
umask 027

readonly CONFIG=/etc/baseer-qa/deploy.env
readonly STATE_DIR=/srv/baseer-qa/processed-requests
readonly LOCK_FILE=/var/lock/baseer-qa-release-poller.lock

die() { printf 'QA_POLLER=FAILED\nREASON=%s\n' "$*" >&2; exit 1; }
require_root() { [ "$(id -u)" -eq 0 ] || die 'root is required'; }
require_safe_file() {
    local file=$1 mode=$2
    [ -f "$file" ] && [ ! -L "$file" ] || die "missing or unsafe file: $file"
    [ "$(stat -c '%U:%G:%a' -- "$file")" = "root:root:$mode" ] || die "unsafe ownership or mode: $file"
}

require_root
require_safe_file "$CONFIG" 600
# shellcheck disable=SC1090
. "$CONFIG"
for name in QA_ENVIRONMENT QA_BASE QA_SOURCE_REMOTE QA_SOURCE_SSH_KEY QA_SOURCE_KNOWN_HOSTS QA_TAG_ALLOWED_SIGNERS; do
    [ -n "${!name:-}" ] || die "missing config value: $name"
done
[ "$QA_ENVIRONMENT" = qa ] || die 'environment marker is not qa'
[ "$QA_BASE" = /srv/baseer-qa ] || die 'QA_BASE must be /srv/baseer-qa'
require_safe_file "$QA_SOURCE_SSH_KEY" 600
require_safe_file "$QA_SOURCE_KNOWN_HOSTS" 644
require_safe_file "$QA_TAG_ALLOWED_SIGNERS" 644
install -d -o root -g root -m 0700 "$STATE_DIR"
exec 9>"$LOCK_FILE"
flock -n 9 || exit 0

fetch_dir="$(mktemp -d "$QA_BASE/deploy-staging/.poller.XXXXXX")"
trap 'rm -rf -- "$fetch_dir"' EXIT
git init --bare --quiet "$fetch_dir/repo.git"
git -C "$fetch_dir/repo.git" remote add origin "$QA_SOURCE_REMOTE"
export GIT_SSH_COMMAND="ssh -i $QA_SOURCE_SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$QA_SOURCE_KNOWN_HOSTS"
git -C "$fetch_dir/repo.git" fetch --quiet --no-tags origin main:refs/heads/source-main

process_request() {
    local tag_ref=$1 tag_name=$2 release_id=$3 run_id=$4
    git -C "$fetch_dir/repo.git" fetch --quiet origin "$tag_ref:$tag_ref" || return 1
    [ "$(git -C "$fetch_dir/repo.git" cat-file -t "$tag_ref")" = tag ] || return 1
    [ "$(git -C "$fetch_dir/repo.git" cat-file -p "$tag_ref" | sed -n '3s/^tag //p')" = "$tag_name" ] || return 1
    git -C "$fetch_dir/repo.git" -c gpg.format=ssh \
        -c "gpg.ssh.allowedSignersFile=$QA_TAG_ALLOWED_SIGNERS" verify-tag "$tag_ref" || return 1
    local tag_commit
    tag_commit="$(git -C "$fetch_dir/repo.git" rev-parse "$tag_ref^{commit}")" || return 1
    git -C "$fetch_dir/repo.git" merge-base --is-ancestor "$tag_commit" refs/heads/source-main || return 1
    /usr/local/sbin/baseer-qa-approve-release "$release_id" "$run_id" "$tag_commit" || return 1
    /usr/local/sbin/baseer-qa-deploy "$release_id" "$run_id" || return 1
}

while IFS=$'\t' read -r tag_object tag_ref; do
    tag_name="${tag_ref#refs/tags/}"
    [[ "$tag_name" =~ ^qa-release-([a-z0-9][a-z0-9-]{2,63})-([0-9]+)$ ]] || continue
    release_id="${BASH_REMATCH[1]}"
    run_id="${BASH_REMATCH[2]}"
    [ -e "$STATE_DIR/$tag_name.result" ] && continue
    if process_request "$tag_ref" "$tag_name" "$release_id" "$run_id"; then
        result=GO
    else
        result=FAILED
    fi
    install -o root -g root -m 0600 /dev/null "$STATE_DIR/$tag_name.result"
    printf 'QA_POLLER=%s\nTAG=%s\n' "$result" "$tag_name" > "$STATE_DIR/$tag_name.result"
    [ "$result" = GO ] && exit 0
    # A rejected request is a completed security decision, not a failed
    # service.  Keep the failure in the immutable result marker and let the
    # timer remain healthy for the next legitimate signed request.
    exit 0
done < <(git ls-remote --refs "$QA_SOURCE_REMOTE" 'refs/tags/qa-release-*' | sort -k2)

printf 'QA_POLLER=IDLE\n'
