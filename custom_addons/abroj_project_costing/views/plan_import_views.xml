<odoo>
    <record id="view_abroj_cost_plan_import_wizard_form" model="ir.ui.view">
        <field name="name">abroj.cost.plan.import.wizard.form</field>
        <field name="model">abroj.cost.plan.import.wizard</field>
        <field name="arch" type="xml">
            <form string="استيراد دراسة المشروع">
                <sheet>
                    <group>
                        <field name="project_id"/>
                        <field name="company_id" readonly="1"/>
                    </group>
                    <group string="الملف">
                        <div class="text-muted">نزّل النموذج أولاً، وأبقِ أسماء الأعمدة كما هي. لا ينشئ الاستيراد مواداً أو فئات.</div>
                        <button name="action_download_template" type="object" string="تنزيل نموذج Excel" class="btn-secondary" icon="fa-download"/>
                        <field name="import_file" filename="import_filename"/>
                        <field name="import_filename" invisible="1"/>
                    </group>
                    <group string="ضوابط الاستيراد">
                        <div class="text-muted">يدعم CSV وXLSX حتى 500 بند. يتحقق النظام من كامل الملف قبل الحفظ، ولا يستورد إلى دراسة تحتوي بنوداً.</div>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import_plan" type="object" string="تحقق واستيراد" class="btn-primary"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
