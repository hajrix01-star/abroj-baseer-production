#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/offline_preview.js:0
msgid "Add products before applying an invoice discount."
msgstr "أضف أصنافًا قبل تطبيق خصم الفاتورة."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/offline_preview.js:0
msgid "This basket contains protected items or unsupported taxes."
msgstr "يحتوي الطلب على أصناف محمية أو ضرائب لا يدعمها خصم الفاتورة."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/offline_preview.js:0
msgid "The discount exceeds the permitted amount or invoice total."
msgstr "الخصم يتجاوز الحد المسموح أو إجمالي الفاتورة."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/offline_preview.js:0
msgid "The discount could not be calculated for this order."
msgstr "تعذّر حساب الخصم لهذا الطلب."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/global_discount.js:0
msgid "A paid offline order needs manager review. Do not collect payment again."
msgstr "يوجد طلب دُفع أثناء انقطاع الاتصال ويحتاج مراجعة المدير. لا تحصّل المبلغ مرة أخرى."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/global_discount.js:0
msgid "Offline order needs review"
msgstr "طلب غير متزامن يحتاج مراجعة"

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/global_discount.js:0
msgid "Payment is recorded locally. Do not collect it again. Ask a manager to review the synchronization error."
msgstr "سُجّل الدفع على الجهاز. لا تحصّل المبلغ مرة أخرى، واطلب من المدير مراجعة خطأ المزامنة."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/global_discount.js:0
msgid "The local point-of-sale data cannot be verified. Ask a manager before clearing it."
msgstr "تعذّر التحقق من بيانات نقطة البيع على الجهاز. اطلب من المدير مراجعتها قبل مسحها."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/global_discount.js:0
msgid "The current point-of-sale session could not be verified. Keep the local orders for review."
msgstr "تعذّر التحقق من جلسة نقطة البيع الحالية. احتفظ بالطلبات على الجهاز للمراجعة."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/global_discount.js:0
msgid "A saved order needs review before it can synchronize. Its local data was kept."
msgstr "يوجد طلب محفوظ يحتاج مراجعة قبل المزامنة. بقيت بياناته على الجهاز."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/global_discount.js:0
msgid "The register could not be refreshed safely. Check the connection and wait for orders to finish saving."
msgstr "تعذّر تحديث نقطة البيع. تحقّق من الاتصال وانتظر اكتمال حفظ الطلبات."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/global_discount.js:0
msgid "The current session is available online. Its offline catalog could not be saved."
msgstr "الجلسة الحالية تعمل عبر الإنترنت. تعذّر حفظ الكتالوج لاستخدامه دون اتصال."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/global_discount.js:0
msgid "A paid offline order is waiting to synchronize. Reconnect or ask a manager before refreshing point-of-sale data."
msgstr "يوجد طلب مدفوع دون اتصال ينتظر المزامنة. أعد الاتصال أو اطلب من المدير المراجعة قبل تحديث بيانات نقطة البيع."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/global_discount.js:0
msgid "The paid offline order is incomplete on this device. Ask a manager to restore it before continuing."
msgstr "بيانات الطلب المدفوع دون اتصال غير مكتملة على هذا الجهاز. اطلب من المدير استعادتها قبل المتابعة."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/global_discount.js:0
msgid "The payment could not be saved on this device. Do not collect it again. Keep this screen open and ask a manager for help."
msgstr "تعذّر حفظ الدفع على هذا الجهاز. لا تحصّل المبلغ مرة أخرى، وأبقِ الشاشة مفتوحة واطلب مساعدة المدير."

#. module: baseer_pos_global_discount
#: model_terms:ir.ui.view,arch_db:baseer_pos_global_discount.Dialog
msgid "The fixed amount includes VAT. The invoice is issued after synchronization."
msgstr "المبلغ الثابت شامل الضريبة. تُصدر الفاتورة بعد المزامنة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount needs review before synchronization."
msgstr "يحتاج الخصم المسجل دون اتصال إلى مراجعة قبل المزامنة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount identifier is invalid."
msgstr "معرّف الخصم المسجل دون اتصال غير صحيح."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount does not match this order."
msgstr "الخصم المسجل دون اتصال لا يطابق هذا الطلب."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount preview is invalid."
msgstr "معاينة الخصم المسجل دون اتصال غير صحيحة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount tax evidence is missing."
msgstr "بيانات ضريبة الخصم المسجل دون اتصال غير موجودة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount tax evidence is invalid."
msgstr "بيانات ضريبة الخصم المسجل دون اتصال غير صحيحة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount amount evidence is missing."
msgstr "بيانات مبلغ الخصم المسجل دون اتصال غير موجودة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount amount evidence is invalid."
msgstr "بيانات مبلغ الخصم المسجل دون اتصال غير صحيحة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount preview is incomplete."
msgstr "معاينة الخصم المسجل دون اتصال غير مكتملة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The same offline order cannot be synchronized twice in one request."
msgstr "لا يمكن مزامنة الطلب المسجل دون اتصال مرتين في العملية نفسها."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount belongs to another company."
msgstr "الخصم المسجل دون اتصال تابع لشركة أخرى."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount retry differs from the paid order. Keep it for manager review."
msgstr "إعادة مزامنة الخصم تختلف عن الطلب المدفوع. احتفظ بالطلب لمراجعة المدير."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount session is not available in this company."
msgstr "جلسة الخصم المسجل دون اتصال غير متاحة في هذه الشركة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Remove the existing invoice discount while connected before using offline discount."
msgstr "أزل خصم الفاتورة الحالي أثناء الاتصال قبل استخدام الخصم دون اتصال."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount must be synchronized through the point of sale."
msgstr "يجب مزامنة الخصم المسجل دون اتصال من خلال نقطة البيع."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline order fingerprint is missing."
msgstr "بصمة الطلب المسجل دون اتصال غير موجودة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount cannot be synchronized in this order state."
msgstr "لا يمكن مزامنة الخصم المسجل دون اتصال في حالة الطلب الحالية."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "This offline discount command was already processed. Refresh the order."
msgstr "تمت معالجة هذا الخصم المسجل دون اتصال مسبقًا. حدّث الطلب."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The offline discount tax categories differ from the server calculation. Keep the paid order for manager review."
msgstr "فئات ضريبة الخصم تختلف عن حساب الخادم. احتفظ بالطلب المدفوع لمراجعة المدير."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The paid amount or tax differs from the server calculation. Keep the paid order for manager review."
msgstr "المبلغ المدفوع أو الضريبة يختلف عن حساب الخادم. احتفظ بالطلب المدفوع لمراجعة المدير."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/global_discount.js:0
msgid "Enter a positive number using 0-9 and at most two decimal places."
msgstr "أدخل عددًا موجبًا بالأرقام 0-9 وبحد أقصى منزلتين عشريتين."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Enter a valid discount."
msgstr "أدخل قيمة خصم صحيحة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The discount amount is too large."
msgstr "مبلغ الخصم أكبر من الحد المسموح."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Discount audit records are created by the invoice discount command only."
msgstr "يُنشئ إجراء خصم الفاتورة سجلات التدقيق فقط."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Discount audit records cannot be changed."
msgstr "لا يمكن تعديل سجلات تدقيق الخصم."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Discount audit records cannot be removed."
msgstr "لا يمكن حذف سجلات تدقيق الخصم."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "This discount belongs to another company."
msgstr "هذا الخصم يخص شركة أخرى."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "This order does not belong to an allowed company."
msgstr "هذا الطلب لا يخص شركة مسموحًا لك بالوصول إليها."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The point of sale company does not match the order."
msgstr "شركة نقطة البيع لا تطابق شركة الطلب."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "You are not a cashier for this point of sale."
msgstr "لست ضمن مستخدمي نقطة البيع هذه."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "An invoice discount requires an unpaid draft in an open, enabled point of sale."
msgstr "يتطلب الخصم طلبًا مسودة دون دفعات وجلسة مفتوحة في نقطة بيع مفعّل فيها الخصم."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Invoice discounts currently require the company currency with two decimal places."
msgstr "يتطلب خصم الفاتورة حاليًا عملة الشركة بمنزلتين عشريتين."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Invoice discounts do not support cash rounding in this candidate."
msgstr "خصم الفاتورة في هذه النسخة لا يدعم تقريب الدفع النقدي."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Remove the invoice discount before changing products, quantities, prices, customer or taxes."
msgstr "أزل خصم الفاتورة قبل تغيير الأصناف أو الكميات أو الأسعار أو العميل أو الضرائب."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The discount command identifier is invalid."
msgstr "معرّف إجراء الخصم غير صحيح."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "This discount command belongs to a different operation."
msgstr "معرّف الخصم مرتبط بإجراء آخر."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The order changed on another device. Refresh it before trying again."
msgstr "تغيّر الطلب على جهاز آخر. حدّثه قبل إعادة المحاولة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Add between 1 and 200 products before applying an invoice discount."
msgstr "أضف من 1 إلى 200 صنف قبل تطبيق خصم الفاتورة."


#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "This basket already contains special price or tax allocations."
msgstr "تحتوي السلة بالفعل توزيعات خاصة للأسعار أو الضرائب."

#. module: baseer_pos_global_discount
#. odoo-javascript
#: code:addons/baseer_pos_global_discount/static/src/app/global_discount.js:0
#: model:ir.model.fields,field_description:baseer_pos_global_discount.field_pos_config__baseer_global_discount_enabled
#: model_terms:ir.ui.view,arch_db:baseer_pos_global_discount.pos_config_global_discount
msgid "Invoice discount"
msgstr "خصم الفاتورة"

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Choose a discount type and enter a short reason."
msgstr "اختر نوع الخصم وأدخل سببًا مختصرًا."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Enter a positive discount and its reason."
msgstr "أدخل قيمة خصم موجبة وسبب الخصم."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "A new discount cannot be applied to a refund."
msgstr "لا يمكن تطبيق خصم جديد على المرتجع."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Ask a POS manager to set up the invoice discount product."
msgstr "اطلب من مدير نقطة البيع إعداد صنف خصم الفاتورة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The eligible total must be positive."
msgstr "يجب أن تكون قيمة الأصناف القابلة للخصم أكبر من 0."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The discount exceeds the permitted percentage or invoice total."
msgstr "الخصم يتجاوز النسبة المسموحة أو إجمالي الفاتورة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The discount exceeds the permitted amount."
msgstr "الخصم يتجاوز المبلغ المسموح."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The tax engine could not preserve the requested discount amount."
msgstr "تعذّرت مطابقة مبلغ الخصم المطلوب بعد احتساب الضريبة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The refund exceeds the remaining sold quantity."
msgstr "كمية المرتجع تتجاوز الكمية المتبقية من البيع الأصلي."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Select products from one discounted sale in this company."
msgstr "اختر أصنافًا من فاتورة بيع واحدة بها خصم في هذه الشركة."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The original sale has not been paid."
msgstr "فاتورة البيع الأصلية لم تُدفع بعد."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Refund products only; discount lines cannot be refunded separately."
msgstr "اختر الأصناف للمرتجع؛ لا يمكن إرجاع أسطر الخصم وحدها."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Refund each original product on one line only."
msgstr "اجمع مرتجع كل سطر أصلي في سطر واحد فقط."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The refund must preserve the original product, price and tax identity."
msgstr "يجب أن يحافظ المرتجع على الصنف والسعر والضريبة في البيع الأصلي."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Finish or cancel the other draft refund of this product first."
msgstr "أكمل أو ألغِ مسودة المرتجع الأخرى لهذا الصنف أولًا."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Original sale discount allocation"
msgstr "حصة المرتجع من خصم البيع الأصلي"

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "Prepare the original invoice discount allocation before paying this refund."
msgstr "جهّز حصة المرتجع من خصم الفاتورة الأصلية قبل دفعه."

#. module: baseer_pos_global_discount
#. odoo-python
#: code:addons/baseer_pos_global_discount/models/pos_order.py:0
msgid "The payment total does not match the server tax calculation. Refresh the order."
msgstr "إجمالي الدفع لا يطابق حساب الضريبة المعتمد. حدّث الطلب."

#. module: baseer_pos_global_discount
