<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_baseer_substitution" model="ir.ui.view">
        <field name="name">product.template.form.baseer.substitution</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']/group/group[@name='pos']" position="inside">
                <separator string="Controlled substitution"/>
                <field name="baseer_substitution_enabled"/>
                <field name="baseer_substitution_product_ids" widget="many2many_tags"
                    invisible="not baseer_substitution_enabled"
                    domain="[('id', '!=', product_variant_id)]"
                    options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
