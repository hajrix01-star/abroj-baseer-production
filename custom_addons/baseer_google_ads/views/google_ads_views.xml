<odoo>
  <record id="view_gads_connection_list" model="ir.ui.view">
    <field name="name">baseer.gads.connection.list</field><field name="model">baseer.gads.connection</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="customer_id"/><field name="state"/><field name="last_sync_at"/><field name="last_error_code"/></list></field>
  </record>
  <record id="view_gads_connection_form" model="ir.ui.view">
    <field name="name">baseer.gads.connection.form</field><field name="model">baseer.gads.connection</field>
    <field name="arch" type="xml"><form string="Google Ads connection"><header><button name="action_sync_read_only" type="object" string="Read-only refresh" class="btn-primary" groups="baseer_google_ads.group_gads_manager"/></header><sheet><div class="alert alert-info" role="alert">Credentials are imported server-side only. This module has no Google Ads write operation.</div><group><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="legacy_connection_id"/><field name="customer_id"/><field name="login_customer_id"/><field name="state"/><field name="last_sync_at" readonly="1"/><field name="last_error_at" readonly="1"/><field name="last_error_code" readonly="1"/></group></sheet></form></field>
  </record>
  <record id="view_gads_fact_list" model="ir.ui.view">
    <field name="name">baseer.gads.daily.fact.list</field><field name="model">baseer.gads.daily.fact</field>
    <field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="metric_date"/><field name="campaign_name"/><field name="campaign_status"/><field name="impressions"/><field name="clicks"/><field name="cost_micros"/><field name="conversions_scaled"/><field name="conversion_value_scaled"/></list></field>
  </record>
  <record id="view_gads_fact_search" model="ir.ui.view">
    <field name="name">baseer.gads.daily.fact.search</field><field name="model">baseer.gads.daily.fact</field>
    <field name="arch" type="xml"><search><field name="connection_id"/><field name="campaign_name"/><field name="metric_date"/><field name="campaign_status"/><filter name="enabled" string="Enabled" domain="[('campaign_status','=','ENABLED')]"/><filter name="paused" string="Paused" domain="[('campaign_status','=','PAUSED')]"/><filter name="group_campaign" string="Campaign" context="{'group_by':'campaign_name'}"/></search></field>
  </record>
  <record id="view_gads_sync_list" model="ir.ui.view">
    <field name="name">baseer.gads.sync.run.list</field><field name="model">baseer.gads.sync.run</field>
    <field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="connection_id"/><field name="kind"/><field name="state"/><field name="started_at"/><field name="finished_at"/><field name="row_count"/><field name="error_code"/></list></field>
  </record>
  <record id="view_gads_dataset_list" model="ir.ui.view">
    <field name="name">baseer.gads.dataset.list</field><field name="model">baseer.gads.dataset</field>
    <field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="connection_id"/><field name="dataset_key"/><field name="state"/><field name="row_count"/><field name="last_sync_at"/><field name="last_error_code"/></list></field>
  </record>
  <record id="action_gads_dashboard" model="ir.actions.client"><field name="name">Dashboard</field><field name="tag">baseer_google_ads.dashboard</field></record>
  <record id="action_gads_connections" model="ir.actions.act_window"><field name="name">Connections</field><field name="res_model">baseer.gads.connection</field><field name="view_mode">list,form</field></record>
  <record id="action_gads_facts" model="ir.actions.act_window"><field name="name">Daily facts</field><field name="res_model">baseer.gads.daily.fact</field><field name="view_mode">list</field><field name="search_view_id" ref="view_gads_fact_search"/></record>
  <record id="action_gads_sync_runs" model="ir.actions.act_window"><field name="name">Synchronization log</field><field name="res_model">baseer.gads.sync.run</field><field name="view_mode">list</field></record>
  <record id="action_gads_datasets" model="ir.actions.act_window"><field name="name">Dataset status</field><field name="res_model">baseer.gads.dataset</field><field name="view_mode">list</field></record>
  <menuitem id="menu_gads_root" name="Google Ads" sequence="41" groups="baseer_google_ads.group_gads_reader"/>
  <menuitem id="menu_gads_dashboard" name="Dashboard" parent="menu_gads_root" action="action_gads_dashboard" sequence="5"/>
  <menuitem id="menu_gads_facts" name="Daily facts" parent="menu_gads_root" action="action_gads_facts" sequence="20" groups="baseer_google_ads.group_gads_manager"/>
  <menuitem id="menu_gads_sync_runs" name="Synchronization log" parent="menu_gads_root" action="action_gads_sync_runs" sequence="30" groups="baseer_google_ads.group_gads_manager"/>
  <menuitem id="menu_gads_datasets" name="Dataset status" parent="menu_gads_root" action="action_gads_datasets" sequence="35" groups="baseer_google_ads.group_gads_manager"/>
  <menuitem id="menu_gads_connections" name="Connections" parent="menu_gads_root" action="action_gads_connections" sequence="90" groups="base.group_system"/>
</odoo>
