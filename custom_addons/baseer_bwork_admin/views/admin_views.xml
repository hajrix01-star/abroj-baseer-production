<odoo>
    <record id="console_form" model="ir.ui.view">
        <field name="name">baseer.bwork.admin.console.form</field>
        <field name="model">baseer.bwork.admin.console</field>
        <field name="arch" type="xml">
            <form string="BWork Administration" delete="0" duplicate="0">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-primary"/>
                    <button name="action_rooms" type="object" string="Rooms"/>
                    <button name="action_members" type="object" string="Memberships"/>
                    <button name="action_settings" type="object" string="Warning settings" groups="base.group_system"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_ids" widget="many2many_tags" domain="[('id', 'in', context.get('allowed_company_ids', []))]" options="{'no_create': True}"/>
                        <field name="status"/>
                    </group>
                    <group string="Overview" col="3">
                        <field name="rooms_count"/><field name="members_count"/><field name="logical_storage"/>
                    </group>
                    <notebook>
                        <page string="Storage and retention">
                            <p>Logical size of distinct original and thumbnail attachments per company, not physical disk usage. All linked files are retained; no deletion or backup is performed here.</p>
                            <p>Warning threshold 0 disables warnings. Existing unlinked staged uploads expire after 24 hours; this console does not change that policy.</p>
                            <field name="storage_details" nolabel="1"/>
                        </page>
                        <page string="Notifications and operations">
                            <p>Actual metadata counts only. A scheduled cron or sent provider request does not prove device delivery. Provider readiness is unverified; no configuration secrets are inspected.</p>
                            <field name="operations" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="room_list" model="ir.ui.view">
        <field name="name">baseer.bwork.admin.room.list</field>
        <field name="model">baseer.bchat.room</field>
        <field name="arch" type="xml"><list string="BWork rooms" create="0" edit="0" delete="0" open_form_view="0"><field name="name"/><field name="company_id"/><field name="is_group"/></list></field>
    </record>
    <record id="member_list" model="ir.ui.view">
        <field name="name">baseer.bwork.admin.member.list</field>
        <field name="model">baseer.bchat.membership</field>
        <field name="arch" type="xml"><list string="BWork memberships" create="0" edit="0" delete="0" open_form_view="0"><field name="room_id"/><field name="company_id"/><field name="user_id"/><field name="active"/><field name="left_at"/></list></field>
    </record>
    <record id="room_form" model="ir.ui.view">
        <field name="name">baseer.bwork.admin.room.form</field><field name="model">baseer.bchat.room</field>
        <field name="arch" type="xml"><form string="BWork room metadata" create="0" edit="0" delete="0" duplicate="0"><sheet><group><field name="name"/><field name="company_id" options="{'no_open': True}"/><field name="is_group"/></group></sheet></form></field>
    </record>
    <record id="member_form" model="ir.ui.view">
        <field name="name">baseer.bwork.admin.member.form</field><field name="model">baseer.bchat.membership</field>
        <field name="arch" type="xml"><form string="BWork membership metadata" create="0" edit="0" delete="0" duplicate="0"><sheet><group><field name="room_id" options="{'no_open': True}"/><field name="company_id" options="{'no_open': True}"/><field name="user_id" options="{'no_open': True}"/><field name="active"/><field name="left_at"/></group></sheet></form></field>
    </record>
    <record id="policy_list" model="ir.ui.view">
        <field name="name">baseer.bwork.admin.policy.list</field><field name="model">baseer.bwork.admin.policy</field>
        <field name="arch" type="xml"><list string="BWork warning settings" delete="0"><field name="company_id"/><field name="warning_mib"/><field name="write_uid"/><field name="write_date"/></list></field>
    </record>
    <record id="policy_form" model="ir.ui.view">
        <field name="name">baseer.bwork.admin.policy.form</field><field name="model">baseer.bwork.admin.policy</field>
        <field name="arch" type="xml"><form string="BWork warning settings" delete="0" duplicate="0"><sheet><group><field name="company_id" readonly="id" options="{'no_create': True}"/><field name="warning_mib"/></group><p>0 disables the warning. This never limits uploads or deletes files.</p><group><field name="write_uid" readonly="1"/><field name="write_date" readonly="1"/></group></sheet></form></field>
    </record>
    <record id="console_action" model="ir.actions.act_window">
        <field name="name">BWork Administration</field><field name="res_model">baseer.bwork.admin.console</field><field name="view_mode">form</field><field name="view_id" ref="console_form"/>
    </record>
    <menuitem id="admin_menu" name="Administration" parent="baseer_bchat.menu_bchat_root" action="console_action" groups="baseer_bchat.group_bchat_manager" sequence="5"/>
</odoo>
