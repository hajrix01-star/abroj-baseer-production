<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_tobacco_report_wizard_form" model="ir.ui.view">
        <field name="name">baseer.pos.tobacco.report.wizard.form</field>
        <field name="model">baseer.pos.tobacco.report.wizard</field>
        <field name="arch" type="xml">
            <form string="POS Tobacco Fee Register">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        Operational report, not an accounting ledger. Tobacco fees are recalculated from the current tax settings; the running total starts at zero for each period.
                    </div>
                    <div class="text-muted">
                        Requires both Accounting and POS read access.
                    </div>
                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="period"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report" type="object" string="Print PDF" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_tobacco_report_wizard" model="ir.actions.act_window">
        <field name="name">POS Tobacco Fee Register</field>
        <field name="res_model">baseer.pos.tobacco.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pos_tobacco_report_wizard_form"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_pos_tobacco_report"
              name="POS Tobacco Fee Register"
              parent="account.menu_finance_reports"
              action="action_pos_tobacco_report_wizard"
              sequence="65"
              groups="account.group_account_readonly,account.group_account_invoice,account.group_account_user,account.group_account_manager"/>
</odoo>
