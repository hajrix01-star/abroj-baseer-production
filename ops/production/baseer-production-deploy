bwork_recovery_sync() {
    local path
    for path in "$@"; do
        chmod 0600 "$path" || return 1
        sync -f "$path" || return 1
    done
    sync -f "$backup"
}

bwork_recovery_capture_before() {
    local plan=$1 mode schema
    mode="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("update_mode",""))' "$plan")" || return 1
