<templates xml:space="preserve">
  <t t-name="baseer_google_ads.Dashboard">
    <main class="o_gads_dashboard" t-att-dir="ar ? 'rtl' : 'ltr'">
      <t t-if="state.status === 'loading'"><section class="gads-state"><span class="fa fa-circle-o-notch fa-spin"/> <span><t t-esc="labels.loading"/></span></section></t>
      <t t-elif="state.status === 'error'"><section class="gads-state gads-error"><p><t t-esc="labels.error"/></p><button class="btn btn-primary" t-on-click="load"><t t-esc="labels.retry"/></button></section></t>
      <t t-else="">
        <header class="gads-header"><div><p class="gads-eyebrow"><t t-esc="labels.eyebrow"/></p><h1><t t-esc="labels.title"/></h1><p><t t-esc="labels.description"/></p></div><button class="btn btn-secondary gads-filter-toggle" t-on-click="toggleFilters"><span class="fa fa-sliders"/> <t t-esc="state.filtersOpen ? labels.hideFilters : labels.showFilters"/></button></header>
        <section class="gads-filters" t-if="state.filtersOpen">
          <label><span><t t-esc="labels.account"/></span><select t-on-change="selectConnection"><t t-foreach="state.data.connections" t-as="connection" t-key="connection.id"><option t-att-value="connection.id" t-att-selected="connection.id === state.selectedConnectionId"><t t-esc="connection.name"/></option></t></select></label>
          <label><span><t t-esc="labels.period"/></span><select t-on-change="selectPeriod"><option value="today" t-att-selected="state.period === 'today'"><t t-esc="labels.today"/></option><option value="yesterday" t-att-selected="state.period === 'yesterday'"><t t-esc="labels.yesterday"/></option><option value="7" t-att-selected="state.period === '7'"><t t-esc="labels.days7"/></option><option value="30" t-att-selected="state.period === '30'"><t t-esc="labels.days30"/></option><option value="month" t-att-selected="state.period === 'month'"><t t-esc="labels.thisMonth"/></option><option value="last_month" t-att-selected="state.period === 'last_month'"><t t-esc="labels.lastMonth"/></option><option value="quarter" t-att-selected="state.period === 'quarter'"><t t-esc="labels.thisQuarter"/></option><option value="last_quarter" t-att-selected="state.period === 'last_quarter'"><t t-esc="labels.lastQuarter"/></option><option value="year" t-att-selected="state.period === 'year'"><t t-esc="labels.thisYear"/></option><option value="last_year" t-att-selected="state.period === 'last_year'"><t t-esc="labels.lastYear"/></option><option value="custom" t-att-selected="state.period === 'custom'"><t t-esc="labels.custom"/></option></select></label>
          <label><span><t t-esc="labels.campaignStatus"/></span><select t-on-change="selectCampaignStatus"><option value="ALL" t-att-selected="state.campaignStatus === 'ALL'"><t t-esc="labels.all"/></option><t t-foreach="state.data.filters.campaign_statuses" t-as="item" t-key="item"><option t-att-value="item" t-att-selected="state.campaignStatus === item"><t t-esc="statusLabel(item)"/></option></t></select></label>
          <label><span><t t-esc="labels.campaign"/></span><select t-on-change="selectCampaign"><option value="" t-att-selected="!state.campaignId"><t t-esc="labels.all"/></option><t t-foreach="campaigns()" t-as="item" t-key="item.id"><option t-att-value="item.id" t-att-selected="state.campaignId == item.id"><t t-esc="item.name"/></option></t></select></label>
          <label><span><t t-esc="labels.adStatus"/></span><select t-on-change="selectAdStatus"><option value="ALL" t-att-selected="state.adStatus === 'ALL'"><t t-esc="labels.all"/></option><t t-foreach="state.data.filters.ad_statuses" t-as="item" t-key="item"><option t-att-value="item" t-att-selected="state.adStatus === item"><t t-esc="statusLabel(item)"/></option></t></select><small><t t-esc="labels.adFilterHint"/></small></label>
          <div class="gads-custom-dates" t-if="state.period === 'custom'"><label><span><t t-esc="labels.from"/></span><input type="date" t-model="state.dateFrom"/></label><label><span><t t-esc="labels.to"/></span><input type="date" t-model="state.dateTo"/></label><button class="btn btn-primary" t-on-click="applyCustomDates"><t t-esc="labels.apply"/></button></div>
          <button class="btn btn-secondary" t-on-click="load"><span class="fa fa-refresh"/> <t t-esc="labels.reload"/></button>
        </section>
        <section class="gads-status-line"><span><b><t t-esc="labels.connection"/>:</b> <t t-esc="connectionState()"/></span><span><b><t t-esc="labels.lastSync"/>:</b> <t t-esc="selectedConnection().last_sync || '-'"/></span><span><b><t t-esc="labels.coverage"/>:</b> <t t-esc="state.data.period.covered_days"/> / <t t-esc="state.data.period.total_days"/></span><span class="gads-readonly"><span class="fa fa-lock"/> <t t-esc="labels.readOnly"/></span><span t-if="state.refreshing" class="gads-refreshing"><span class="fa fa-circle-o-notch fa-spin"/> <t t-esc="labels.refreshing"/></span><span t-if="state.refreshError" class="gads-refresh-error"><span class="fa fa-exclamation-circle"/> <t t-esc="labels.refreshFailed"/></span></section>
        <p class="gads-scope-note"><span class="fa fa-info-circle"/> <t t-esc="labels.detailsScope"/></p>
        <nav class="gads-tabs" role="tablist" t-att-aria-label="labels.eyebrow"><t t-foreach="tabs()" t-as="tab" t-key="tab[0]"><button role="tab" t-att-aria-selected="state.tab === tab[0]" t-att-class="state.tab === tab[0] ? 'is-active' : ''" t-on-click="() => this.selectTab(tab[0])"><t t-esc="tab[1]"/></button></t></nav>
        <t t-if="state.tab === 'overview'">
          <section class="gads-operational" aria-label="Operational snapshot"><article><span class="fa fa-play-circle"/><div><small><t t-esc="labels.activeCampaigns"/></small><strong><t t-esc="state.data.operational.active_campaigns"/></strong></div></article><article><span class="fa fa-pause-circle"/><div><small><t t-esc="labels.pausedCampaigns"/></small><strong><t t-esc="state.data.operational.paused_campaigns"/></strong></div></article><article><span class="fa fa-bullhorn"/><div><small><t t-esc="labels.totalCampaigns"/></small><strong><t t-esc="state.data.operational.total_campaigns"/></strong></div></article><article class="is-alert"><span class="fa fa-exclamation-circle"/><div><small><t t-esc="labels.alerts"/></small><strong><t t-esc="state.data.operational.alerts"/></strong></div></article></section>
          <section class="gads-kpis"><t t-foreach="[[labels.cost,state.data.summary.cost],[labels.impressions,state.data.summary.impressions],[labels.clicks,state.data.summary.clicks],[labels.conversions,state.data.summary.google_conversions],[labels.ctr,state.data.summary.ctr + '%'],[labels.cpc,state.data.summary.cpc],[labels.conversionValue,state.data.summary.google_conversion_value]]" t-as="metric" t-key="metric[0]"><article class="gads-card"><span><t t-esc="metric[0]"/></span><strong><t t-esc="metric[1]"/></strong></article></t></section>
          <section class="gads-overview-grid"><article class="gads-chart-card"><header><div><h2><t t-esc="labels.trend"/></h2><div class="gads-chart-controls"><label><span><t t-esc="labels.metric"/></span><select t-on-change="selectTimelineMetric"><t t-foreach="timelineMetrics()" t-as="metric" t-key="metric[0]"><option t-att-value="metric[0]" t-att-selected="state.timelineMetric === metric[0]"><t t-esc="metric[1]"/></option></t></select></label><label class="gads-compare-toggle"><input type="checkbox" t-att-checked="state.comparePrevious" t-on-change="selectComparison"/><span><t t-esc="labels.comparePrevious"/></span></label></div></div><div class="gads-grain"><button t-att-class="state.timelineGrain === 'day' ? 'is-active' : ''" t-on-click="() => this.selectTimelineGrain('day')"><t t-esc="labels.daily"/></button><button t-att-class="state.timelineGrain === 'month' ? 'is-active' : ''" t-on-click="() => this.selectTimelineGrain('month')"><t t-esc="labels.monthly"/></button><button t-att-class="state.timelineGrain === 'year' ? 'is-active' : ''" t-on-click="() => this.selectTimelineGrain('year')"><t t-esc="labels.yearly"/></button></div></header><t t-if="timelineHasData()"><div class="gads-chart-legend"><span class="is-current"><i/> <t t-esc="labels.currentPeriod"/></span><span t-if="state.comparePrevious" class="is-previous"><i/> <t t-esc="labels.previousPeriod"/></span><small t-if="state.comparePrevious and state.data.timeline.comparison_period"><t t-esc="labels.previousCoverage"/>: <t t-esc="state.data.timeline.comparison_period.covered_days"/> / <t t-esc="state.data.timeline.comparison_period.total_days"/></small></div><div class="gads-line-chart" role="img" t-att-aria-label="labels.trend"><svg viewBox="0 0 100 100" preserveAspectRatio="none"><line x1="0" x2="100" y1="4" y2="4"/><line x1="0" x2="100" y1="50" y2="50"/><line x1="0" x2="100" y1="96" y2="96"/><t t-if="state.comparePrevious" t-foreach="lineSegments('previous')" t-as="segment" t-key="segment"><polyline class="gads-line-previous" fill="none" t-att-points="segment"/></t><t t-foreach="lineSegments('current')" t-as="segment" t-key="segment"><polyline class="gads-line-current" fill="none" t-att-points="segment"/></t><t t-foreach="timelinePoints()" t-as="point" t-key="point.key"><circle t-if="point.current !== null" class="gads-point-current" r="1.45" t-att-cx="pointX(point.position)" t-att-cy="pointY(point.current)"><title><t t-esc="point.currentDate + ': ' + formatTimelineValue(point.current)"/></title></circle><circle t-if="state.comparePrevious and point.previous !== null" class="gads-point-previous" r="1.15" t-att-cx="pointX(point.position)" t-att-cy="pointY(point.previous)"><title><t t-esc="point.previousDate + ': ' + formatTimelineValue(point.previous)"/></title></circle></t></svg><div class="gads-chart-labels"><t t-foreach="timelinePoints()" t-as="point" t-key="point.key"><span><t t-esc="point.currentDate"/></span></t></div></div></t><t t-else=""><p class="gads-section-empty"><t t-esc="labels.noDataState"/></p></t></article>
          <article class="gads-priority"><h2><t t-esc="labels.priorityAlerts"/></h2><t t-if="state.data.datasets.insights.rows.length"><t t-foreach="state.data.datasets.insights.rows.slice(0, 5)" t-as="item" t-key="item.id || item.title"><div class="gads-alert-row"><span t-att-class="'gads-level is-' + item.level"><t t-esc="insightLevel(item.level)"/></span><div><strong><t t-esc="item.title"/></strong><small><t t-esc="insightDetail(item.detail)"/></small></div></div></t></t><t t-else=""><p class="gads-section-empty"><t t-esc="labels.noAlerts"/></p></t></article></section>
          <section class="gads-campaign-summary"><header><h2><t t-esc="labels.campaignSummary"/></h2><t t-if="state.data.operational.latest_active_campaign"><span><t t-esc="labels.latestActivity"/>: <b><t t-esc="state.data.operational.latest_active_campaign.name"/></b></span></t><t t-else=""><span><t t-esc="labels.noActivity"/></span></t></header><t t-foreach="state.data.filters.campaigns.slice(0, 6)" t-as="item" t-key="item.id"><article><div><strong><t t-esc="item.name"/></strong><small><t t-esc="statusLabel(item.status)"/></small></div><div><small><t t-esc="labels.cost"/></small><b><t t-esc="item.cost"/></b></div><div><small><t t-esc="labels.conversions"/></small><b><t t-esc="item.conversions"/></b></div></article></t></section>
        </t>
        <t t-else=""><section class="gads-detail-sections" role="tabpanel"><t t-foreach="datasetSections()" t-as="section" t-key="section.key"><article class="gads-detail-section"><header class="gads-detail-header"><div><h2><t t-esc="section.label"/></h2><p><t t-esc="labels.visibleRows"/>: <b><t t-esc="section.row_count"/></b><t t-if="section.source_row_count !== section.row_count"> / <t t-esc="labels.rows"/>: <b><t t-esc="section.source_row_count"/></b></t><t t-if="section.last_sync"> · <t t-esc="labels.synced"/>: <t t-esc="section.last_sync"/></t></p></div><span t-att-class="'gads-dataset-state is-' + section.state"><t t-esc="datasetState(section.state)"/></span></header><t t-if="section.rows.length"><div class="gads-detail-table" role="table"><t t-foreach="section.rows" t-as="row" t-key="row.id || (row.title + row.detail)"><article class="gads-detail-row" role="row"><div class="gads-detail-name"><strong><t t-esc="row.title"/></strong><small t-if="row.subtitle"><t t-esc="row.subtitle"/></small><small t-if="row.campaign"><t t-esc="labels.campaign"/>: <t t-esc="row.campaign"/></small><small t-if="row.detail"><t t-esc="insightDetail(row.detail)"/></small></div><div class="gads-detail-state"><span t-if="row.status"><t t-esc="statusLabel(row.status)"/></span><span t-if="row.level"><t t-esc="insightLevel(row.level)"/></span></div><div class="gads-detail-metrics" t-if="!row.level"><span><b><t t-esc="labels.impressions"/></b> <t t-esc="row.impressions"/></span><span><b><t t-esc="labels.clicks"/></b> <t t-esc="row.clicks"/></span><span><b><t t-esc="labels.cost"/></b> <t t-esc="row.cost"/></span><span><b><t t-esc="labels.conversion"/></b> <t t-esc="row.conversions"/></span></div></article></t></div></t><t t-else=""><div class="gads-section-empty"><span class="fa fa-database"/> <t t-esc="labels.emptySection"/></div></t></article></t></section></t>
      </t>
    </main>
  </t>
</templates>
