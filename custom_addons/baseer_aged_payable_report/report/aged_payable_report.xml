<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_aged_payable" model="report.paperformat">
        <field name="name">Baseer Aged Payables A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field><field name="margin_bottom">15</field>
        <field name="margin_left">11</field><field name="margin_right">11</field>
        <field name="header_line" eval="False"/><field name="header_spacing">0</field>
    </record>
    <record id="action_aged_payable_pdf" model="ir.actions.report">
        <field name="name">Aged Payables / مديونيات الموردين</field>
        <field name="model">baseer.aged.payable.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baseer_aged_payable_report.aged_payable_pdf</field>
        <field name="report_file">baseer_aged_payable_report.aged_payable_pdf</field>
        <field name="paperformat_id" ref="paperformat_aged_payable"/>
    </record>
    <template id="aged_payable_pdf">
        <t t-set="o" t-value="company_record"/>
        <t t-call="web.basic_layout">
            <div class="page bar-pdf" t-att-dir="'rtl' if arabic else 'ltr'">
                <style>
                    .bar-pdf {font-family: DejaVu Sans, Arial, sans-serif; color: #25364b; font-size: 11px;}
                    .bar-pdf h1 {font-size: 16px; margin: 0 0 5px; font-weight: 700;}
                    .bar-pdf .meta {color: #657487; line-height: 1.5; border-bottom: 1px solid #d7dde2; padding-bottom: 8px; margin-bottom: 9px;}
                    .bar-pdf .notice {background: #d9eef2; color: #566a75; padding: 6px 8px; margin: 8px 0 10px;}
                    .bar-pdf .summary {margin: 7px 0 11px; width: 100%; border-collapse: collapse;}
                    .bar-pdf .summary td {padding: 6px 8px; border: 1px solid #d7dde2;}
                    .bar-pdf .summary .label {font-size: 9px; color: #657487; display: block;}
                    .bar-pdf .summary .value {font-weight: 700; display: block; white-space: nowrap;}
                    .bar-pdf .detail {width: 100%; border-collapse: collapse; table-layout: fixed;}
                    .bar-pdf .detail thead {display: table-header-group;}
                    .bar-pdf .detail tr {page-break-inside: avoid;}
                    .bar-pdf .detail th, .bar-pdf .detail td {padding: 5px 6px; border-bottom: 1px solid #e1e5e9; vertical-align: middle;}
                    .bar-pdf .detail th {font-weight: 600; text-align: left;}
                    .bar-pdf[dir="rtl"] .detail th {text-align: right;}
                    .bar-pdf .numeric {direction: ltr; unicode-bidi: isolate; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;}
                    .bar-pdf .credit {color: #cf2732;}
                    .bar-pdf .total td {background: #d9dde0; font-weight: 700;}
                </style>
                <h1 t-esc="'مديونيات الموردين' if arabic else 'Aged Payables'"/>
                <div class="meta">
                    <div><span t-esc="company_record.name"/> · <span t-esc="company_record.currency_id.name"/></div>
                    <div><span t-esc="'حتى تاريخ' if arabic else 'As of'"/> <span dir="ltr" t-esc="report['cutoff_date']"/></div>
                    <div><span t-esc="'أُعيد حسابه عند الطباعة' if arabic else 'Recalculated at print time'"/>: <span dir="ltr" t-esc="generated_at.strftime('%Y-%m-%d %H:%M')"/></div>
                </div>
                <div class="notice" t-esc="'أرصدة قيود مرحلة وتسوياتها الموجودة وقت التشغيل؛ ليست لقطة تاريخية مجمدة. الأرصدة المدينة المقابلة منفصلة ولا تخصم من فاتورة دون تسوية.' if arabic else 'Posted balances and reconciliations available at run time; not a frozen historical snapshot. Counter-balances are separate from bills.'"/>
                <table class="summary"><tr>
                    <td><span class="label" t-esc="'مستحقات الموردين' if arabic else 'Open payables'"/><span class="value numeric" t-esc="report['summary']['payables']"/></td>
                    <td><span class="label" t-esc="'الأرصدة المدينة المقابلة' if arabic else 'Counter-balances'"/><span class="value numeric" t-esc="report['summary']['counter_balances']"/></td>
                    <td><span class="label" t-esc="'الصافي' if arabic else 'Net'"/><span class="value numeric" t-esc="report['summary']['net']"/></td>
                    <td><span class="label" t-esc="'غير مستحق' if arabic else 'Not due'"/><span class="value numeric" t-esc="report['summary']['buckets']['not_due']"/></td>
                    <td><span class="label">1-30</span><span class="value numeric" t-esc="report['summary']['buckets']['d1_30']"/></td>
                    <td><span class="label">31-60</span><span class="value numeric" t-esc="report['summary']['buckets']['d31_60']"/></td>
                    <td><span class="label">61-90</span><span class="value numeric" t-esc="report['summary']['buckets']['d61_90']"/></td>
                    <td><span class="label">90+</span><span class="value numeric" t-esc="report['summary']['buckets']['over_90']"/></td>
                </tr></table>
                <div style="color: #657487; font-size: 10px; margin-top: 7px;" t-esc="'أعمار الأرصدة المقابلة من تاريخ القيد' if arabic else 'Counter-balances aged from posting date'"/>
                <table class="summary"><tr>
                    <td t-foreach="('not_due', 'd1_30', 'd31_60', 'd61_90', 'over_90')" t-as="bucket">
                        <span class="label" t-esc="age_labels[bucket]"/>
                        <span class="value numeric" t-esc="report['summary']['counter_buckets'][bucket]"/>
                    </td>
                </tr></table>
                <table class="detail">
                    <thead><tr>
                        <th style="width: 25%;" t-esc="'المورد' if arabic else 'Supplier'"/>
                        <th style="width: 19%;" t-esc="'المستند' if arabic else 'Document'"/>
                        <th style="width: 12%;" t-esc="'التاريخ' if arabic else 'Date'"/>
                        <th style="width: 12%;" t-esc="'الاستحقاق' if arabic else 'Due date'"/>
                        <th style="width: 18%;" t-esc="'التصنيف' if arabic else 'Category'"/>
                        <th class="numeric" style="width: 14%;" t-esc="'الرصيد' if arabic else 'Balance'"/>
                    </tr></thead>
                    <tbody>
                        <tr t-foreach="report['lines']" t-as="line">
                            <td t-esc="line['partner_name']"/>
                            <td t-esc="line['move_name']"/>
                            <td dir="ltr" t-esc="line['date']"/>
                            <td dir="ltr" t-esc="line['date_maturity'] or '-'"/>
                            <td><span t-esc="kind_labels[line['kind']]"/>
                                <span t-if="line['counter_age_bucket']" t-esc="' · ' + age_labels[line['counter_age_bucket']]"/>
                            </td>
                            <td t-att-class="'numeric credit' if line['bucket'] == 'counter' else 'numeric'" t-esc="line['open']"/>
                        </tr>
                        <tr t-if="not report['lines']"><td colspan="6" t-esc="'لا توجد مديونيات مفتوحة' if arabic else 'No open payables'"/></tr>
                        <tr class="total"><td colspan="5" t-esc="'الصافي' if arabic else 'Net'"/><td class="numeric" t-esc="report['summary']['net']"/></tr>
                    </tbody>
                </table>
                <div class="footer" style="font-size: 9px; color: #657487; border-top: 1px solid #d9dfe4; padding-top: 4px;">
                    <span t-esc="company_record.name"/> · <span t-esc="company_record.currency_id.name"/>
                    <span style="float: right;"><span t-esc="'صفحة' if arabic else 'Page'"/> <span class="page"/> / <span class="topage"/></span>
                </div>
            </div>
        </t>
    </template>
</odoo>
