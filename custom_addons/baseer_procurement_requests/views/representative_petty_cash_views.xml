<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_representative_petty_cash" model="ir.actions.client">
        <field name="name">عهدة مندوب المشتريات</field>
        <field name="tag">baseer_procurement_requests.representative_petty_cash</field>
    </record>

    <record id="view_company_representative_petty_cash" model="ir.ui.view">
        <field name="name">res.company.representative.petty.cash</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="baseer_representative_petty_cash" string="عهدة مندوب المشتريات"
                      groups="base.group_erp_manager">
                    <group>
                        <button name="action_baseer_initialize_representative_petty_cash" type="object"
                                string="Initialize Representative Petty Cash" class="btn-primary"/>
                        <div class="text-muted">
                            Creates the missing shared account and general journal once for this company. It does not create a payment point or an account for each representative.
                        </div>
                        <field name="baseer_procurement_representative_petty_cash_account_id"
                               string="حساب عهدة مندوب المشتريات"
                               domain="[('company_ids', 'in', [id]), ('active', '=', True), ('reconcile', '=', True), ('account_type', 'in', ['asset_receivable', 'asset_current'])]"
                               options="{'no_create': True}"/>
                        <field name="baseer_procurement_representative_petty_cash_journal_id"
                               string="دفتر يومية عهدة مندوب المشتريات"
                               domain="[('company_id', '=', id), ('active', '=', True), ('type', '=', 'general')]"
                               options="{'no_create': True}"/>
                        <field name="baseer_procurement_representative_petty_cash_payment_journal_ids"
                               string="نقاط دفع عهدة مندوب المشتريات"
                               domain="[('company_id', '=', id), ('active', '=', True), ('type', 'in', ['bank', 'cash']), ('default_account_id.account_type', '=', 'asset_cash')]"
                               options="{'no_create': True, 'no_open': True}" widget="many2many_tags"/>
                        <label for="baseer_procurement_representative_petty_cash_payment_journal_ids"
                               string="اختر نقاط الدفع الحالية التي يسمح استخدامها للعهدة. لا ينشئ هذا الإعداد دفترًا أو طريقة دفع جديدة."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- The historical PCUST field remains visible only on historical batches.
         New batches choose the immutable representative advance instead. -->
    <record id="view_purchase_batch_representative_petty_cash" model="ir.ui.view">
        <field name="name">baseer.purchase.batch.representative.petty.cash</field>
        <field name="model">baseer.purchase.batch</field>
        <field name="inherit_id" ref="baseer_purchase_batch.view_purchase_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='procurement_custody_id']" position="attributes">
                <attribute name="invisible">state == 'draft' and not procurement_custody_id</attribute>
                <attribute name="readonly">True</attribute>
            </xpath>
            <xpath expr="//field[@name='procurement_custody_id']" position="after">
                <field name="representative_petty_cash_id" string="Representative Petty Cash"
                       options="{'no_create': True}"
                       invisible="state == 'draft' or not representative_petty_cash_id" readonly="True"
                       context="{'baseer_representative_petty_cash_request_id': procurement_request_id, 'baseer_representative_petty_cash_company_id': company_id}"
                       domain="[('company_id', '=', company_id), ('movement_type', '=', 'funding'), ('state', '=', 'posted'), ('procurement_request_id', '=', procurement_request_id)]"/>
                <field name="representative_petty_cash_representative_id" string="Selected advance representative"
                       invisible="not representative_petty_cash_id" readonly="True"/>
                <field name="representative_petty_cash_settlement_move_id" string="Representative Petty Cash settlement"
                       invisible="not representative_petty_cash_settlement_move_id" readonly="True"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="before">
                <div class="alert alert-info mb-3" role="status" invisible="not representative_petty_cash_id">
                    Payment source: <strong>Representative Petty Cash</strong>. Supplier bills are settled from the selected advance after approval; no new bank or cash payment is created.
                </div>
                <div class="row g-3 mb-3" invisible="not representative_petty_cash_id">
                    <div class="col-12 col-md-4">
                        <div class="card h-100 border-0 bg-light"><div class="card-body">
                            <div class="text-muted">Received request total</div>
                            <div class="fs-4 fw-bold" dir="ltr"><field name="procurement_request_actual_total" readonly="1"/></div>
                        </div></div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card h-100 border-0 bg-light"><div class="card-body">
                            <div class="text-muted">Supplier invoices entered</div>
                            <div class="fs-4 fw-bold" dir="ltr"><field name="amount_gross" readonly="1"/></div>
                        </div></div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card h-100 border-0 bg-primary-subtle"><div class="card-body">
                            <div class="text-muted">Available Representative Petty Cash</div>
                            <div class="fs-4 fw-bold" dir="ltr"><field name="representative_petty_cash_available_amount" readonly="1"/></div>
                        </div></div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="attributes">
                <attribute name="context">{'default_company_id': company_id, 'default_invoice_date': entry_date, 'default_payment_source_type': 'payment_method', 'form_view_ref': 'baseer_purchase_batch.view_purchase_batch_line_form', 'baseer_custody_route': procurement_custody_id}</attribute>
            </xpath>
            <xpath expr="//field[@name='procurement_request_id']" position="attributes">
                <attribute name="invisible">state == 'draft' or not procurement_request_id</attribute>
                <attribute name="readonly">True</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='is_credit']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='payment_method_line_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
                <attribute name="invisible">True</attribute>
                <attribute name="required">False</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='payment_method_line_id']" position="before">
                <field name="company_id" column_invisible="True"/>
                <field name="payment_source_type" string="Settlement method" widget="baseer_payment_settlement_selector" width="220px"/>
                <field name="representative_petty_cash_representative_id" string="Representative Petty Cash"
                       column_invisible="True" options="{'no_create': True}"
                       invisible="True" required="False"
                       domain="[('is_purchase_representative', '=', True), ('company_id', 'in', [False, company_id]), ('is_company', '=', False), ('parent_id', '=', False), ('active', '=', True)]"/>
                <field name="representative_petty_cash_available_amount" string="Available balance" width="140px"
                       column_invisible="True" readonly="1" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/following-sibling::p[1]" position="replace">
                <p class="text-muted mt-2" invisible="procurement_custody_id or representative_petty_cash_id">
                    Choose a settlement method for each invoice. Enable Credit to pay later; while it is enabled, settlement choices are unavailable. The payment date is the invoice date.
                </p>
            </xpath>
            <xpath expr="//field[@name='line_ids']/kanban/field[@name='is_credit']" position="after">
                <field name="payment_source_type"/>
                <field name="representative_petty_cash_representative_id"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/kanban//div[contains(@class, 'baseer_batch_card_footer')]/span[1]" position="replace">
                <span class="text-muted">
                    <span t-if="record.payment_source_type.raw_value === 'representative_petty_cash'">
                        <span>Representative Petty Cash — </span><field name="representative_petty_cash_representative_id"/>
                    </span>
                    <span t-elif="record.is_credit.raw_value">Credit — pay later</span>
                    <field name="payment_method_line_id" t-elif="record.payment_method_line_id.raw_value"/>
                    <span t-else="">Payment method required</span>
                </span>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_batch_line_representative_petty_cash" model="ir.ui.view">
        <field name="name">baseer.purchase.batch.line.representative.petty.cash</field>
        <field name="model">baseer.purchase.batch.line</field>
        <field name="inherit_id" ref="baseer_purchase_batch.view_purchase_batch_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_credit']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']" position="attributes">
                <attribute name="invisible">True</attribute>
                <attribute name="required">False</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']/following-sibling::div[1]" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']" position="before">
                <field name="company_id" invisible="True"/>
                <field name="payment_source_type" string="Settlement method" widget="baseer_payment_settlement_selector" readonly="batch_state == 'approved' or (batch_id and not is_current_company)"/>
                <field name="representative_petty_cash_representative_id" string="Representative Petty Cash"
                       options="{'no_create': True}"
                       invisible="True" required="False"
                       readonly="batch_state == 'approved' or (batch_id and not is_current_company)"
                       domain="[('is_purchase_representative', '=', True), ('company_id', 'in', [False, company_id]), ('is_company', '=', False), ('parent_id', '=', False), ('active', '=', True)]"/>
                <field name="representative_petty_cash_available_amount" string="Available balance" readonly="1"
                       invisible="True"/>
            </xpath>
        </field>
    </record>
</odoo>
